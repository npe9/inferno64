SYSTARG=MacOSX
<../../mkconfig
SYSTARG=MacOSX

#Configurable parameters

CONF=emu-cocoa			#default configuration
CONFLIST=emu-cocoa emu-g
CLEANCONFLIST=

INSTALLDIR=$ROOT/$SYSTARG/$OBJTYPE/bin	#path of directory where kernel is installed

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE	#set vars based on target system

# Every surviving MacOSX target is Cocoa and sets its own SYSLIBS in
# mkfile-$OBJTYPE; this is only a floor for anything that does not.
SYSLIBS= \
	-lm\
	-lpthread\
	-framework CoreFoundation\
	-framework IOKit\

# Cocoa configs (set by mkfile-arm64/amd64): AppKit owns main(); port/main.c → emumain
COCOAOBJ=
COCOAFLAGS=

<mkfile-$OBJTYPE	# arm64/amd64 set CONF/SYSLIBS/COCOA*

# Console emu-g: drop AppKit main() / Cocoa (mkfile-arm64 defaults).
<| if [ "$CONF" = emu-g ]; then echo 'COCOAOBJ='; echo 'COCOAFLAGS='; echo 'SYSLIBS=-lm -lpthread -framework CoreFoundation -framework IOKit -framework AudioToolbox -framework Foundation -framework CoreML'; fi

<| $SHELLNAME ../port/mkdevlist $CONF	#sets $IP, $DEVS, $PORT, $LIBS

# mlsrv runs a model in a process of its own. It is the only thing that links
# onnxruntime: emu cannot, because it aliases the libc allocators into the
# Inferno pool and onnxruntime uses several that the aliasing does not cover.
# See emu/port/mlsrv.c.
ORTDIR=$ROOT/MacOSX/$OBJTYPE
$INSTALLDIR/mlsrv:	../port/mlsrv.c
	cc -O2 -I$ORTDIR/include/onnxruntime -o $target ../port/mlsrv.c \
		-L$ORTDIR/lib -lonnxruntime -Wl,-rpath,$ORTDIR/lib

OBJ=\
	asm-$OBJTYPE.$O\
	os.$O\
	$CONF.root.$O\
	lock.$O\
	$DEVS\
	$PORT\

HFILES=\

CFLAGS='-DROOT="'$ROOT'"'\
	'-DOBJTYPE="'$OBJTYPE'"'\
	-DEMU -I. -I../port\
	-I$ROOT/$SYSTARG/$OBJTYPE/include\
	-I$ROOT/$SYSTARG/$OBJTYPE/include/onnxruntime\
	-I$ROOT/include -I$ROOT/libinterp\
	$CTHREADFLAGS $CFLAGS $EMUOPTIONS\

KERNDATE=`{$NDATE}

default:V:	$O.$CONF

<../port/portmkfile

# Objective-C Cocoa window backend (arm64 emu-cocoa)
%.$O:	%.m
	cc -c -fobjc-arc $CFLAGS $stem.m

# Optional -Dmain=emumain when COCOAFLAGS set (arm64 Cocoa)
main.$O:	../port/main.c
	$CC $CFLAGS $COCOAFLAGS -I. ../port/main.c

$O.$CONF:	$OBJ $COCOAOBJ $CONF.c $CONF.root.h $LIBFILES
	# main.o is sensitive to COCOAFLAGS (-Dmain=emumain); always rebuild.
	$CC $CFLAGS $COCOAFLAGS -I. ../port/main.c
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target $OBJ $COCOAOBJ $CONF.$O $LIBFILES $SYSLIBS

install:V: $O.$CONF
	cp $O.$CONF $INSTALLDIR/$CONF
	# Fresh binaries need a signature or dyld stalls in UE on modern macOS.
	codesign -s - --force $INSTALLDIR/$CONF
	# Only the default GUI binary is also installed as plain `emu`.
	case "$CONF" in
	emu-cocoa|emu)
		cp $O.$CONF $INSTALLDIR/emu
		codesign -s - --force $INSTALLDIR/emu
		;;
	esac

devfs.c:N:	../port/devfs-posix.c
