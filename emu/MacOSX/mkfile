<../../mkconfig
SYSTARG=MacOSX

#Configurable parameters

CONF=emu			#default configuration
CONFLIST=emu
CLEANCONFLIST=

INSTALLDIR=$ROOT/$SYSTARG/$OBJTYPE/bin	#path of directory where kernel is installed

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE	#set vars based on target system

# Default for 386/power (Carbon); arm64 overrides via mkfile-arm64
SYSLIBS= \
	-lm\
	-framework Carbon -framework QuickTime\
	-lpthread\
	-framework CoreFoundation\
	-framework IOKit\

# Cocoa configs (set by mkfile-arm64): AppKit owns main(); port/main.c → emumain
COCOAOBJ=
COCOAFLAGS=

<mkfile-$OBJTYPE	# arm64 overrides CONF/SYSLIBS/COCOA*

#
# The no-Cocoa configs: emu-g (console) and emu-cpu (the CPU server).
#
# These link no AppKit and have no main() from main-cocoa.m, so they
# create no NSApplication -- which is the point of emu-cpu.  macOS App
# Nap suspends a Cocoa app with no window on screen, and a headless
# emu-cocoa serving Styx froze completely and repeatedly because of it.
# A process with no NSApplication cannot be napped at all, which beats
# asking not to be.
#
<| case "$CONF" in emu-g|emu-cpu) echo 'COCOAOBJ='; echo 'COCOAFLAGS='; echo 'SYSLIBS=-lm -lpthread -framework CoreFoundation -framework IOKit -framework AudioToolbox';; esac

<| $SHELLNAME ../port/mkdevlist $CONF	#sets $IP, $DEVS, $PORT, $LIBS

OBJ=\
	asm-$OBJTYPE.$O\
	os.$O\
	$CONF.root.$O\
	lock.$O\
	$DEVS\
	$PORT\

HFILES=\

CFLAGS='-DROOT="'$ROOT'"'\
	'-DOBJTYPE="'$OBJTYPE'"'\
	-DEMU -I. -I../port\
	-I$ROOT/$SYSTARG/$OBJTYPE/include\
	-I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp\
	$CTHREADFLAGS $CFLAGS $EMUOPTIONS\

KERNDATE=`{$NDATE}

default:V:	$O.$CONF

<../port/portmkfile

# Objective-C Cocoa window backend (arm64 emu-cocoa)
%.$O:	%.m
	cc -c -fobjc-arc $CFLAGS $stem.m

# Optional -Dmain=emumain when COCOAFLAGS set (arm64 Cocoa)
main.$O:	../port/main.c
	$CC $CFLAGS $COCOAFLAGS -I. ../port/main.c

$O.$CONF:	$OBJ $COCOAOBJ $CONF.c $CONF.root.h $LIBFILES
	# main.o is sensitive to COCOAFLAGS (-Dmain=emumain); always rebuild.
	$CC $CFLAGS $COCOAFLAGS -I. ../port/main.c
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target $OBJ $COCOAOBJ $CONF.$O $LIBFILES $SYSLIBS

install:V: $O.$CONF
	cp $O.$CONF $INSTALLDIR/$CONF
	# Fresh binaries need a signature or dyld stalls in UE on modern macOS.
	codesign -s - --force $INSTALLDIR/$CONF
	# Only the default GUI binary is also installed as plain `emu`.
	case "$CONF" in
	emu-cocoa|emu)
		cp $O.$CONF $INSTALLDIR/emu
		codesign -s - --force $INSTALLDIR/emu
		;;
	esac

devfs.c:N:	../port/devfs-posix.c
