<../mkconfig

#
#	The tables limbo -t generates carry Dis frame sizes and pointer
#	maps, so there is a set of them per word size; see the rules for
#	them below.
#
DISH=w$DISWORD
CFLAGS=$CFLAGS -I$DISH

LIB=libinterp.a

OFILES=\
	alt.$O\
	comp-$OBJTYPE.$O\
	conv.$O\
	crypt.$O\
	dec.$O\
	dlm-$TARGMODEL.$O\
	draw.$O\
	freetype.$O\
	gc.$O\
	geom.$O\
	heap.$O\
	heapaudit.$O\
	ipint.$O\
	link.$O\
	load.$O\
	loader.$O\
	math.$O\
#	prefab.$O\
	raise.$O\
	readmod.$O\
	runt.$O\
	sign.$O\
	stack.$O\
	tk.$O\
	validstk.$O\
	xec.$O\
	das-$OBJTYPE.$O\
	keyring.$O\
	string.$O\

HFILES=\
	$ROOT/include/interp.h\
	$ROOT/include/isa.h\
	$ROOT/include/pool.h\
	$DISH/runt.h\
	tab.h\

MODULES=\
	../module/runt.m\
	../module/sys.m\
	../module/draw.m\
	../module/prefab.m\
	../module/math.m\
	../module/tk.m\
	../module/keyring.m\
	../module/loader.m\
	../module/freetype.m\
	../module/ipints.m\
	../module/crypt.m\
	keyringif.m\

<$ROOT/mkfiles/mksyslib-$SHELLTYPE

#
#	Everything limbo generates here describes a Dis frame -- how wide
#	its words are, how big the interpreter's temporaries are at the
#	bottom of it, what the pointer map of a builtin's arguments is --
#	so there is one set per word size, in w$DISWORD.  A kernel or an
#	emu that links this library has to look there too; see the CFLAGS
#	of the boards under os/inferno.
#
#
#	limbo -a writes the C shape of a Dis frame, and a frame holds the
#	interpreter's temporaries, whose size follows the word, so these
#	are per-width too.
#
$DISH/runt.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -a -I../module ../module/runt.m > $target

$DISH/keyringif.h:D:	$MODULES keyringif.m
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -a -I../module keyringif.m > $target

$DISH/bench.h:D:../module/bench.m
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -a -I../module ../module/bench.m > $target

$DISH/sysmod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Sys -I../module ../module/runt.m > $target

$DISH/keyring.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Keyring -I../module keyringif.m > $target

$DISH/drawmod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Draw -I../module ../module/runt.m > $target

$DISH/prefabmod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Prefab -I../module ../module/runt.m > $target

$DISH/tkmod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Tk -I../module ../module/runt.m > $target

$DISH/mathmod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Math -I../module ../module/runt.m > $target

$DISH/loadermod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Loader -I../module ../module/runt.m > $target

$DISH/freetypemod.h:D: $MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Freetype -I../module ../module/runt.m > $target

$DISH/ipintsmod.h:D:	$MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t IPints -I../module ../module/ipints.m > $target

$DISH/benchmod.h:D: ../module/bench.m
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Bench -I../module ../module/bench.m > $target

$DISH/cryptmod.h:D:	$MODULES
	mkdir -p $DISH && rm -f $target && limbo -W $DISWORD -t Crypt -I../module ../module/runt.m > $target

xec.$O:		optab.h  $ROOT/include/pool.h
tk.$O:		$ROOT/include/tk.h  $ROOT/include/pool.h
draw.$O: 	$ROOT/include/draw.h $ROOT/include/drawif.h
prefab.$O: 	$ROOT/include/draw.h\
		$ROOT/include/prefab.h

runt.$O:	$DISH/sysmod.h
prefab.$O:	$DISH/prefabmod.h
draw.$O:	$DISH/drawmod.h
tk.$O:		$ROOT/include/draw.h $DISH/tkmod.h
math.$O:	$DISH/mathmod.h
keyring.$O:	$DISH/keyring.h ipint.h $DISH/keyringif.h
crypt.$O:	ipint.h $DISH/runt.h $DISH/cryptmod.h
ipint.$O:	ipint.h $DISH/ipintsmod.h
loader.$O:	$DISH/loadermod.h
freetype.$O:	$DISH/freetypemod.h $ROOT/include/freetype.h
math.$O:	$ROOT/include/mathi.h

das-spim.c:N:	das-mips.c
comp-spim.c:N:	comp-mips.c

# optab.h:	$ROOT/include/isa.h mkoptab
#	$SHELLNAME mkoptab > $target

#	Do not remove optab.h, because the script that builds
#	it works only on UNIX and Plan 9.

nuke:EV:	nuke-std
	rm -rf w4 w8
