module Maps

// a generic hash map, header-only: every declaration here is a
// template instantiated into the importing module, so there is no
// maps.dis.  the key's hash and equality are closures given to
// newmap; the importer supplies them (see tests/type/usemaps.e).
// the methods are templates on the type, instantiated with it, and
// the hash and equality helpers below are inline functions, copied
// into the importer too.

const PATH = "/dis/lib/maps.dis"

type Entry[K, V] struct {
	key K
	val V
	next ref Entry[K, V]
}

type Map[K, V] struct {
	buckets []ref Entry[K, V]
	n int
	hash func(K) int
	eq func(K, K) int
}

func newmap[K, V](nbuckets int, hash func(K) int, eq func(K, K) int) ref Map[K, V] {
	if nbuckets < 1 {
		nbuckets = 1
	}
	return ref Map[K, V]{buckets: [nbuckets]ref Entry[K, V], n: 0, hash: hash, eq: eq}
}

func (m ref Map[K, V]) bucket(k K) int {
	h := m.hash(k) % len(m.buckets)
	if h < 0 {
		h = -h
	}
	return h
}

func (m ref Map[K, V]) find(k K) ref Entry[K, V] {
	for e := m.buckets[m.bucket(k)]; e != nil; e = e.next {
		if m.eq(e.key, k) != 0 {
			return e
		}
	}
	return nil
}

func (m ref Map[K, V]) put(k K, v V) {
	e := m.find(k)
	if e != nil {
		e.val = v
		return
	}
	b := m.bucket(k)
	m.buckets[b] = ref Entry[K, V]{key: k, val: v, next: m.buckets[b]}
	m.n++
	if m.n > 2 * len(m.buckets) {
		m.grow()
	}
}

func (m ref Map[K, V]) grow() {
	old := m.buckets
	m.buckets = [2 * len(old)]ref Entry[K, V]
	for i := 0; i < len(old); i++ {
		for e := old[i]; e != nil; e = e.next {
			b := m.bucket(e.key)
			m.buckets[b] = ref Entry[K, V]{key: e.key, val: e.val, next: m.buckets[b]}
		}
	}
}

func (m ref Map[K, V]) del(k K) int {
	b := m.bucket(k)
	var prev ref Entry[K, V]
	for e := m.buckets[b]; e != nil; e = e.next {
		if m.eq(e.key, k) != 0 {
			if prev == nil {
				m.buckets[b] = e.next
			} else {
				prev.next = e.next
			}
			m.n--
			return 1
		}
		prev = e
	}
	return 0
}

func (m ref Map[K, V]) size() int {
	return m.n
}

func (m ref Map[K, V]) keys() list K {
	var l list K
	for i := len(m.buckets) - 1; i >= 0; i-- {
		for e := m.buckets[i]; e != nil; e = e.next {
			l = e.key :: l
		}
	}
	return l
}

func strhash(s string) int {
	h := 0
	for i := 0; i < len(s); i++ {
		h = h * 31 + s[i]
	}
	return h
}

func streq(a string, b string) int {
	return a == b
}

func inthash(x int) int {
	return x * 40503
}

func inteq(a int, b int) int {
	return a == b
}
