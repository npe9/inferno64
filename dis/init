fn showlocaldevs{
	for d in /dev/sd* {
		if {ftest -r $d/ctl}{
			(a q)=`{grep inquiry $d/ctl}
			echo $d':' $q
			for i in `{ls -p $d} {
				p=$d/$i
				if{~ $"i ctl raw log led}{
					;
				} {~ $"i plan9 nvram swap}{
					echo $p
				} {~ $"i 9fat}{
					showlocaldev $p dos
				} {~ $"i 9660}{
					showlocaldev $p 9660
				} {~ $"i fs}{
					showlocaldev $p kfs64
				} {~ $cdboot 1 && ~ $"i data}{
					showlocaldev $p 9660
				} {
					echo $p: unrecognized filesystem
				}
			}
		}
	}
