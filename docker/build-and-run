#!/bin/sh
# build-and-run - build the tree from source in the container, then run
# the suite against what was built.
#
# The ordinary path bind-mounts the tree read-only and boots the kernel
# binaries that are in it.  Those binaries should not be in it: the
# tree's own .gitignore says so -- "kernel binaries:
# os/inferno/<board>/i<board>" -- and the eleven that are tracked are
# tracked only because they were added on 2026-08-23 and the rule
# arrived on 2026-09-03, after which git stopped applying it to them.
# The two Pi kernels were never added, which is why the ordinary path
# cannot run those boards at all.
#
# So this path builds instead.  It copies the read-only tree, points
# mkconfig at the copy, and builds mk, the libraries, the kenc
# compilers, limbo, the Limbo userland in both Dis word sizes and the
# kernels, then runs the suite on them.  It takes minutes rather than
# seconds, and it needs nothing in the repository that the repository
# says should not be there.
#
# What it needs is a checkout and docker.  That claim was made before
# it was true: every run until now bind-mounted a working tree, where
# dis/, dis32/ and Inferno/<objtype>/lib were already full of build
# products that are not in the repository, and the copy inherited
# them.  Run against a fresh git checkout it stopped at mkroot, which
# could not find /dis/basename.dis.  The three steps below that make
# those directories and fill them are what a checkout actually needs.
set -e

cp -a /src /build
cd /build

# mkconfig carries an absolute ROOT and the host it was configured for.
# Both are the Mac's; neither is true in here.
sed -i -e 's|^ROOT=.*|ROOT=/build|' -e 's|^SYSHOST=MacOSX|SYSHOST=Linux|' mkconfig

# And the copy carries the host's object files.  mk is a timestamp
# build: it sees lib9/argv0.o newer than argv0.c, does not rebuild it,
# and ar puts a Mach-O object into a Linux archive -- after which the
# link fails with "undefined reference to argv0" and says nothing about
# why.  Every .o in this tree belongs to whatever host last built it;
# none of them belong to this one.  The board objects are safe, being
# .5 .7 .j and so on rather than .o.
find /build -name '*.o' -delete

log=/build/build.log
say() { echo "build: $*" >&2; }

say "mk"
sh makemk.sh > $log 2>&1 || { tail -20 $log >&2; exit 1; }
PATH=/build/Linux/arm64/bin:$PATH
export PATH
mk mkdirs >> $log 2>&1 || true

# mkdirs makes the empty directories lib/emptydirs names, which is the
# runtime root and not the build's own output tree.  Only the include
# directory of each Inferno/<objtype> is in the repository; bin and lib
# are build products, so a clean checkout has neither, and the first
# thing that wants one is iar, whose "cannot create
# Inferno/riscv64/lib/libinterp.a: No such file or directory" says
# nothing about a missing directory being the cause.
for d in /build/Inferno/*/; do
	mkdir -p "$d/bin" "$d/lib"
done

# The order is the dependency order, and each name here is one the
# build stopped on when it was missing.
for d in lib9 libbio utils/libregexp libmath libmp libsec; do
	say "$d"
	(cd /build/$d && mk install) >> $log 2>&1 || { tail -20 $log >&2; exit 1; }
done

say "utils (the compilers)"
(cd /build/utils && mk install) >> $log 2>&1 || { tail -20 $log >&2; exit 1; }

say "limbo"
(cd /build/limbo && mk install) >> $log 2>&1 || { tail -20 $log >&2; exit 1; }

# The Limbo userland.  A board's root file list embeds /dis/sh.dis and
# the rest of appl/cmd and appl/lib into the kernel image, and none of
# those .dis files are in the repository either -- so on a clean
# checkout mkroot stops with "don't know how to make
# /build/dis/basename.dis".  appl's own mkfile walks every subdirectory
# including danby, which does not build ("don't know how to make
# SYSMODULES") and is in no board's root; cmd and lib are what the
# roots ask for.
say "appl (the Limbo userland)"
for d in lib cmd; do
	(cd /build/appl/$d && mk install) >> $log 2>&1 ||
		{ tail -20 $log >&2; exit 1; }
done

# And again for a four-byte Dis word: virt32 is a 32-bit board and its
# root file list takes every module from /dis32, because a module
# compiled for an eight-byte word has Type descriptors a four-byte GC
# walks wrong.  mkdis stamps each source directory with .disword-N and
# removes the other, so this pass really recompiles rather than
# reinstalling what is already there.  lib/emptydirs names only the
# /dis directories, so /dis32's are made from those names.
say "appl (again, for a four-byte Dis word)"
mkdir -p /build/dis32
sed -n 's|^dis/|/build/dis32/|p' /build/lib/emptydirs | xargs mkdir -p
for d in lib cmd; do
	(cd /build/appl/$d && mk DISROOT=dis32 DISWORD=4 install) >> $log 2>&1 ||
		{ tail -20 $log >&2; exit 1; }
done

# The boards this image can run.  The Pi ones need the patched qemu of
# tools/qemu-patches; the image built from Boardsuite-pi.Dockerfile has
# it and says so by setting QEMU, and the plain one does not.  Their
# kernels build either way -- that is the point of building rather than
# shipping binaries -- but building one nothing here can boot is time
# spent for nothing.
boards="virt virts virtarm64 virt32 virt32s sifiveu"
if [ -n "$QEMU" ] && [ -x "$QEMU" ]; then
	boards="$boards raspi3b raspi4"
fi
for b in $boards; do
	say "os/inferno/$b"
	(cd /build/os/inferno/$b && mk) >> $log 2>&1 || { tail -20 $log >&2; exit 1; }
done

say "built; running the suite"

# What this image can actually run, which is not the whole list.
#
# The six Pi configurations want the patched qemu, and the suite
# refuses before it starts rather than part way through -- right, but
# it makes a bare "build" look like a failure of the build.
#
# Two more want a qemu newer than the packaged 7.2 bookworm has.
# sifive_u there does not put a -drive if=sd behind its MMC-SPI
# controller, so sifiveu comes back SD-NONE against a baseline that
# says otherwise; and the firmware package ships no riscv32 OpenSBI at
# all, so virt32s cannot start.  Both are qemu's age and not the
# board's: they pass on v10.1.3.  Boardsuite-pi.Dockerfile carries
# stock v10.1.3 riscv binaries beside the patched aarch64 one and
# names them in QEMU_RISCV64/QEMU_RISCV32, so the "all" path runs
# them and the apt-only image does not pretend to.
if [ $# -eq 0 ]; then
	set -- virtarm64 virtarm64-peer virt virts virt32 virt-peer peer-mixed
	if [ -n "$QEMU_RISCV32" ] && [ -x "$QEMU_RISCV32" ]; then
		set -- sifiveu virt32s "$@"
	fi
	if [ -n "$QEMU" ] && [ -x "$QEMU" ]; then
		set -- raspi3b raspi3b-4g raspi3b-usb raspi4 raspi4-hot \
			raspi4-usb "$@"
	fi
fi

exec /build/tools/boardsuite/run "$@"
