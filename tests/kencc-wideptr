#!/usr/bin/env python3
#
# kencc-wideptr -- find a 32-bit value reaching a 64-bit pointer add
# without its sign, in 7c -S output.
#
#	kencc-wideptr file.s [file.s ...]
#
# WHY.  An AArch64 W-register write ZEROES the upper half, so a NEGATIVE
# 32-bit value added to a pointer widens unsigned and the address lands
# 2^32 away.  libmemdraw's byteaddr had this twice and the two faults had
# different causes:
#
#	the row offset, (s32)(sizeof(u32)*p.y*i->width), where 7c dropped
#	the narrowing cast and emitted UMULL -- a 32x32->64 UNSIGNED
#	widening multiply, so a negative p.y gave a huge positive product;
#
#	the x offset, a + (p.x-np+1)/np, with NO CAST ANYWHERE, where
#	SDIVW's 32-bit result went straight into a 64-bit ADD.
#
# The second is why this scans instructions rather than casts: there is
# nothing there for a compiler to drop, so a cast-hunting audit cannot
# find it.  Both are fixed by taking the value through an s32 local,
# after which 7c emits SXTW before the ADD.
#
# A HIT IS NOT A BUG, and this matters more than the hit count.  An
# UNSIGNED 32-bit value is CORRECT zero-extended and looks identical in
# the instruction stream, so a stride like i->width*sizeof(u32) scans
# the same as a signed offset that can go negative.  The output is a
# reading list; the question to ask of each line is only ever "can that
# value be negative?".
#
# NEGATIVE CONTROL.  It has one, which is the only reason the zero means
# anything.  Compile libmemdraw/alloc.c as it was before the two fixes
# and this must name byteaddr four times (one UMULL, three x-offset
# paths); compile it as it is now and it must report none.
#
# AUDITED 2026-10-06 against the shipping libraries: libmemdraw 37
# candidates, libdraw 5, libmemlayer 0.  Per site, because a category
# reason is not an audit -- an earlier version of this note cleared all
# 42 on three category reasons, which overstated what had been read:
#
#   loadmemimage, unloadmemimage   q += i->width*sizeof(u32); width is
#                                  u32int, so the stride is unsigned
#   memfastdraw, memoptdraw        strides are p->bwidth =
#                                  sizeof(u32)*img->width, and the pixel
#                                  deltas are 0, 1, 1+copyalpha,
#                                  3+copyalpha, nb or depth/8
#   readnbit, readcmap, readbyte,  r = p->bytermin + y*p->bwidth, and y
#   readptr                        is asserted non-negative at draw.c:793
#                                  (assert(0 <= srcy ...), three of them)
#                                  with clipy() called every iteration
#   genconv                        buf + nb*p->dx, widths from a clipped
#                                  rectangle
#   writememimage                  data + (miny-r.min.y)*bpl, and miny
#                                  starts at r.min.y and increments
#   getdefont, getmemdefont        p += 4-n with n = (uintptr)p & 3
#                                  inside if(n != 0), so 1..3
#
# getmemdefont has a second site that is NOT safe on its own numbers:
#   hdr = p + Dy(r)*i->width*sizeof(u32);
# Dy(r) is a signed subtraction of atoi'd values out of the font data.
# It is safe only because allocmemimaged(r, ...) runs first and refuses
# an inverted rectangle (the badrect check added with the allocmemimage
# sizing fix).  If that guard is ever removed this site becomes live.
#
# The remainder -- rgbatoimg, newstate, and the inner ANDW sites in
# readcmap/readbyte -- are integer arithmetic, not pointer arithmetic.
# This scanner cannot tell an ADD of two integers from a pointer add, so
# it reports them; see the caution below for why that is the right way
# round.
#
# byteaddr was the only site where a genuinely negative value reached a
# pointer, and the structural reason predicts where to look next: it is
# the one function taking an ARBITRARY Point into an image whose r.min
# may be negative, while everything else advances a pointer by a stride
# it computed itself or indexes from a clipped, asserted origin.  So the
# shape concentrates wherever a CALLER-SUPPLIED coordinate or stride
# reaches pointer arithmetic -- the framebuffer paths, where the raspi3b
# session found one real site in fbcopy, whose rectangle came from
# rectsub() with no clip of its own.
#
# AND DO NOT READ A W-OP AS EVIDENCE ABOUT THE VALUE.  LSLW and ASRW
# assemble to UBFM/SBFM and zero- or sign-extend into the 64-bit
# register, which says nothing about whether the VALUE is negative: a
# left shift of a negative int is still negative.  Every clearance above
# is a statement about the value's provenance, never about the opcode.
# The raspi3b session built an operand classifier that made exactly that
# mistake and labelled byteaddr's real bug [unsigned].
#
# A CAUTION ON MAKING THIS MORE PRECISE.  Requiring the tainted result
# to be dereferenced in the same function looks like an obvious way to
# tell a pointer add from an integer add.  It is wrong here and the
# control caught it: byteaddr RETURNS the address, so that filter
# silently dropped two of the four control hits, including the UMULL.
# A filter that loses the case the control exists to catch is worse than
# the false positives it removes.
#
import re, sys

WOPS = ('ADDW','SUBW','MULW','MADDW','MSUBW','SDIVW','UDIVW','ASRW','LSLW',
        'LSRW','ANDW','ORRW','EORW','NEGW','MVNW','REMW','DIVW','MODW',
        # UMULL writes a full 64-bit register, so the W-zeroing argument does
        # not apply -- but it is an UNSIGNED 32x32 widening multiply, so a
        # negative operand gives a huge positive product.  Same destination,
        # different reason; this was byteaddr's row-offset fault.
        'UMULL','UMADDL','UMSUBL')
# MOVW Rn,Rm sign-extends; MOVWU zero-extends (and is the legitimate unsigned case)
SEXT = ('MOVW',)
REG = re.compile(r'\bR\d+\b')

def regs(s):
    return REG.findall(s)

def scan(path):
    hits = []
    func = '?'
    # last W-op that wrote each register, and whether it has been sign-extended since
    tainted = {}
    pending = {}
    for raw in open(path):
        line = raw.rstrip('\n')
        m = re.match(r'\s*TEXT\s+([A-Za-z_][A-Za-z0-9_]*)', line)
        if m:
            func = m.group(1); tainted = {}; pending = {}; continue
        m = re.match(r'\s*([A-Z][A-Z0-9.]*)\s+(.*)$', line.strip())
        if not m:
            continue
        op, args = m.group(1), m.group(2)
        rs = regs(args)
        if not rs:
            continue
        dst = rs[-1]
        if op == 'ADD' and len(rs) >= 2:
            for r in rs[:-1]:
                if tainted.get(r):
                    hits.append((func, tainted[r], r, line.strip()))
            tainted[dst] = None
            continue
        if op in SEXT:
            tainted[dst] = None       # sign-extended: safe
            continue
        if op in WOPS:
            tainted[dst] = op
            continue
        # any other write clears taint for its destination
        tainted[dst] = None
    return hits

total = 0
for path in sys.argv[1:]:
    for func, wop, reg, line in scan(path):
        print("%-28s %-7s %-4s %s" % (func, wop, reg, line))
        total += 1
print("--- candidates: %d ---" % total)
