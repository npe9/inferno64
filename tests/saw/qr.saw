// SAW proof: the Dis-compiled qr kernel, translated to LLVM by
// dis2ll.py, computes exactly the Cryptol reference spec qrspec::qr,
// for ALL 2^128 input word-tuples (discharged symbolically, not sampled).
import "qrspec.cry";
m <- llvm_load_module "qr.bc";
let contract = do {
    a <- llvm_fresh_var "a" (llvm_int 32);
    b <- llvm_fresh_var "b" (llvm_int 32);
    c <- llvm_fresh_var "c" (llvm_int 32);
    d <- llvm_fresh_var "d" (llvm_int 32);
    llvm_execute_func [llvm_term a, llvm_term b, llvm_term c, llvm_term d];
    llvm_return (llvm_term {{ qr a b c d }});
};
llvm_verify m "qr" [] false contract z3;
print "PROVED: Dis-compiled qr == Cryptol spec (all inputs)";
