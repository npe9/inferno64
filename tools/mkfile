<../mkconfig

DIRS=\
	libstyx\
	styxtest\

#
#	Two host programs that turn a Plan 9 image into the shape some
#	other boot loader insists on.  They are built with the host's own
#	compiler, not the tree's, because nothing about them is Inferno.
#
#	HOSTCC rather than $CC: the tree's $CC comes from mkconfig with
#	-c already in it, so "$CC -o aout2efi aout2efi.c" wrote a
#	relocatable object named aout2efi and mk called it done.  The
#	committed binaries were built by hand, and the rule had never
#	produced a working one.
#
HOSTCC=cc

TOOLS=\
	aout2efi\
	aout2imxrt\
	bin2ihex\

<$ROOT/mkfiles/mksubdirs

all:V:	$TOOLS
install:V: $TOOLS

aout2efi:	aout2efi.c
	$HOSTCC -o $target aout2efi.c

bin2ihex:	bin2ihex.c
	$HOSTCC -o $target bin2ihex.c

aout2imxrt:	aout2imxrt.c
	$HOSTCC -o $target aout2imxrt.c
