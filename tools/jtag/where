#!/bin/sh
#
# where [-r]
#
# What is the board doing right now?  Halts every core, names the pc
# it is sitting at, and resumes.  -r leaves it halted.
#
#	$ tools/jtag/where
#	cpu0  0x00000000000a770c  sched+0x1c
#	cpu1  0x000000000000007c  below the first symbol
#	...
#	(resumed)
#
# This is the question the port has kept asking and kept answering
# badly.  A wedged board used to be diagnosed by typing ^\ at it and
# reading a dump -- which needs somebody watching, needs the console
# to still be working, and has twice been taken from a board that had
# already recovered, so the stacks were of a healthy machine.  Here
# the board does not have to be cooperating at all.
#
# The names come from tools/jtag/ksyms, because 7l puts a Plan 9
# symbol table in the ELF and nothing on a Unix host can read it.
# Without that every line of this would be a bare hex number, which is
# what made "TRAP ... pc 0015b008" a dead end this morning; it is
# accounttime+0xc, called from clockintr+0x48.
#
# Cores 1-3 normally sit at 0x7c, in the VideoCore firmware's spin
# table, because this kernel starts no secondaries.  That is not a
# fault, and "below the first symbol" is the correct answer for it.
#
set -u
HERE=`dirname "$0"`
ROOT=`cd "$HERE/../.." && pwd`
#
# KERNEL was already overridable; IMG is its stamp, and the pair is CHECKED.
#
# The hazard here is quieter than the one alive and boot.sh had.  Those
# reported "dead" about a running board when handed the wrong ELF.  This one
# does something worse: every symbol table lookup still succeeds, so it prints
# names -- plausible, confident and wrong -- for a kernel it is not looking at.
# "accounttime+0xc" from the wrong build is a dead end that reads like a
# finding, and this file's own comments record how much that has cost.
#
# So the kernel is checked against the running one by its build stamp, and on
# a mismatch the pcs are still printed, because they are true, while the names
# are withheld.  Refusing the whole answer would throw away what the debugger
# genuinely knows; printing names would be inventing.
#
KERNEL=${KERNEL:-$ROOT/os/inferno/raspi3b/iraspi3b}
IMG=${IMG:-$ROOT/os/inferno/raspi3b/kernel8.img}
ADAPTER=${ADAPTER:-interface/ftdi/olimex-arm-usb-tiny-h.cfg}

KDADDR=`python3 "$HERE/ksyms" "$KERNEL" -g kerndate 2>/dev/null |
	awk '$3=="kerndate"{print $1}'`
WANT=
if [ -n "$KDADDR" ] && [ -r "$IMG" ]; then
	WANT=`python3 - "$IMG" "$KDADDR" <<'PYEOF'
import sys
img, addr = sys.argv[1], int(sys.argv[2], 16)
d = open(img, "rb").read()
o = addr - 0x80000
print(int.from_bytes(d[o:o+4], "little") if 0 <= o <= len(d)-4 else "")
PYEOF`
fi
TMP=${TMPDIR:-/tmp}/jtag-where.$$

#
# THE BOARD LOCK.  This halts all four cores through openocd, which does
# not queue: a second one dies with LIBUSB_ERROR_ACCESS, reading like a
# dead board rather than a busy one.  The lock had been added to the
# writers and to none of the four readers, all of which run openocd --
# this one four times.
#
# TAKEN BEFORE THE TRAP IS ARMED, and that order is deliberate: arming a
# handler before holding the lock is precisely how kinstall.sh's own
# cleanup came to overwrite the channel of the run it had been refused
# in favour of.  Before the lock there is nothing to clean up, and $TMP
# does not exist yet either.
#
. "$ROOT/tools/jtag/boardlock.sh"
boardfree || { echo "where: another openocd holds the adapter" >&2; exit 1; }
boardlock where || { echo "where: another board operation is running" >&2; exit 1; }
trap 'rm -f "$TMP"; boardunlock' 0 1 2 15

#
# HALT EACH CORE, and say so when one cannot be read.
#
# This used to halt ONCE -- which halts the current target, cpu0 -- and
# then switch targets round the loop without halting.  Reading pc on a
# core that is still running fails, the catch swallowed it, and the
# output was a single line for cpu0 with nothing to say the other three
# had not been looked at.
#
# That is not a cosmetic gap.  On a wedged board it printed "cpu0
# idle+4", which reads as "nothing is running", and the truth found by
# halting each core by hand was three cores idle and ONE working through
# clockpoll with a pc that moved between samples -- a live kernel, not a
# dead one.  An instrument that examines a quarter of the machine and
# does not say so produced the wrong conclusion.
#
# So: halt each core in turn, report the ones that refuse by name, and
# resume every core on the way out rather than only cpu0.  Leaving a core
# halted turns a diagnosis into a second fault.
#
resume_all='foreach c {0 1 2 3} { catch { targets bcm2837.cpu$c ; resume } };'
[ "${1:-}" = "-r" ] && resume_all=''

( cd "$ROOT" && timeout 120 openocd -f "$ADAPTER" -f tools/jtag/raspi3b.cfg \
	-c "init; \
	    foreach c {0 1 2 3} { \
		if {[catch { \
			targets bcm2837.cpu\$c ; halt ; \
			echo \"WHERE cpu\$c [reg pc]\" \
		    } msg]} { \
			echo \"WHERE-UNREAD cpu\$c \$msg\" \
		} \
	    }; targets bcm2837.cpu0" \
	-c "mdw ${KDADDR:-0} 1" \
	-c "$resume_all exit" ) >"$TMP" 2>&1

#
# UNANCHORED, because the marker reaches $TMP only as openocd's own echo output
# -- openocd does not print its -c arguments -- so there is no command line here
# for an unanchored match to collide with, and an anchor would lose a marker
# that openocd's other messages ran into without a newline.  (boardrun and
# netbench had to SPLIT their markers instead, because there the command is
# echoed back.)
#
if ! grep -aq 'WHERE cpu' "$TMP"; then
	echo "where: the debugger did not answer; is the adapter attached?" >&2
	grep -a 'Error' "$TMP" | head -3 >&2
	exit 1
fi

#
# Does this kernel describe the one that is running?
#
NAMES=yes
if [ -n "$KDADDR" ] && [ -n "$WANT" ]; then
	got=`awk -F': ' '/^0x/{print $2; exit}' "$TMP" | awk '{print $1}'`
	if [ -n "$got" ]; then
		gotd=`python3 -c "print(int('$got',16))" 2>/dev/null`
		if [ "$gotd" != "$WANT" ]; then
			NAMES=no
			echo "where: $KERNEL does not describe the running" \
			     "kernel (board stamp $gotd, $IMG says $WANT) --" \
			     "printing pcs WITHOUT names, which would be wrong" >&2
		fi
	fi
fi

#
# The cores that refused, first and plainly.  These lines must NOT reach
# the parser below: its fields are "WHERE cpuN pc (/64): 0x..." and an
# UNREAD line's message would land in the pc column and be printed as an
# address.
#
grep -a 'WHERE-UNREAD' "$TMP" | sed 's/^WHERE-UNREAD /where: could NOT read /'

grep -ao 'WHERE cpu.*' "$TMP" | while read -r _ cpu _ _ pc; do
	if [ "$NAMES" = no ]; then
		printf '%-5s %s  %s\n' "$cpu" "$pc" "(no name: wrong kernel)"
		continue
	fi
	name=`python3 "$HERE/ksyms" "$KERNEL" "$pc" 2>/dev/null | \
		sed -e 's/^[^ ]*  *//'`
	printf '%-5s %s  %s\n' "$cpu" "$pc" "${name:-?}"
done
[ -n "$resume_all" ] && echo "(all cores resumed)" ||
	echo "(left halted; 'resume' to go)"
