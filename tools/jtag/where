#!/bin/sh
#
# where [-r]
#
# What is the board doing right now?  Halts every core, names the pc
# it is sitting at, and resumes.  -r leaves it halted.
#
#	$ tools/jtag/where
#	cpu0  0x00000000000a770c  sched+0x1c
#	cpu1  0x000000000000007c  below the first symbol
#	...
#	(resumed)
#
# This is the question the port has kept asking and kept answering
# badly.  A wedged board used to be diagnosed by typing ^\ at it and
# reading a dump -- which needs somebody watching, needs the console
# to still be working, and has twice been taken from a board that had
# already recovered, so the stacks were of a healthy machine.  Here
# the board does not have to be cooperating at all.
#
# The names come from tools/jtag/ksyms, because 7l puts a Plan 9
# symbol table in the ELF and nothing on a Unix host can read it.
# Without that every line of this would be a bare hex number, which is
# what made "TRAP ... pc 0015b008" a dead end this morning; it is
# accounttime+0xc, called from clockintr+0x48.
#
# Cores 1-3 normally sit at 0x7c, in the VideoCore firmware's spin
# table, because this kernel starts no secondaries.  That is not a
# fault, and "below the first symbol" is the correct answer for it.
#
set -u
HERE=`dirname "$0"`
ROOT=`cd "$HERE/../.." && pwd`
#
# SERIALISE AGAINST EVERY OTHER BOARD TOOL, including the ones in other
# worktrees.  This is a READ-ONLY tool and it still needs the lock: it
# drives openocd, openocd holds the FTDI adapter exclusively, and a
# collision surfaces as LIBUSB_ERROR_ACCESS -- which reads as a dead
# board rather than a busy one.  The readers here took no lock at all
# until the raspi3b session measured it; the mechanism had been added
# to the writers and the long-runners and never to the tools either of
# us reaches for first.
#
. "$ROOT/tools/jtag/boardlock.sh"
boardfree || { echo "where: another openocd holds the adapter" >&2; exit 2; }
boardlock where || { echo "where: another board operation is running" >&2; exit 2; }

KERNEL=${KERNEL:-$ROOT/os/inferno/raspi3b/iraspi3b}
ADAPTER=${ADAPTER:-interface/ftdi/olimex-arm-usb-tiny-h.cfg}
TMP=${TMPDIR:-/tmp}/jtag-where.$$
trap 'rm -f "$TMP"; boardunlock' 0 1 2 15

tail_cmd='resume;'
[ "${1:-}" = "-r" ] && tail_cmd=''

( cd "$ROOT" && timeout 90 openocd -f "$ADAPTER" -f tools/jtag/raspi3b.cfg \
	-c "init; halt; \
	    foreach c {0 1 2 3} { \
		catch { targets bcm2837.cpu\$c ; echo \"WHERE cpu\$c [reg pc]\" } \
	    }; targets bcm2837.cpu0; $tail_cmd exit" ) >"$TMP" 2>&1

if ! grep -aq WHERE "$TMP"; then
	echo "where: the debugger did not answer; is the adapter attached?" >&2
	grep -a 'Error' "$TMP" | head -3 >&2
	exit 1
fi

#
# WHICH IMAGE THESE NAMES COME FROM.  Symbols move with every build, so a
# name is only right if $KERNEL is what the board is running -- and this
# tool is most wanted when the board is wedged, which is exactly when
# samekernel cannot ask it.  So it says where the names came from and
# leaves the reader to judge, rather than refusing (as alive and kmesg
# do, because their answers would be meaningless) or staying silent (as
# this did, which is how an unrelated variable gets printed as a fact).
#
KDA=`python3 "$HERE/ksyms" "$KERNEL" 2>/dev/null | awk '$3=="kerndate"{print $1; exit}'`
KDV=`python3 "$HERE/kread" "$KERNEL" "${KDA:-0}" 2>/dev/null`
if [ -n "$KDV" ]; then
	echo "names from $KERNEL, kerndate `python3 -c "print(int('$KDV',16))"`"
	echo "(right only if that is the kernel on the board: sh tools/jtag/samekernel)"
else
	echo "names from $KERNEL (its kerndate could not be read)"
fi

grep -a WHERE "$TMP" | while read -r _ cpu _ _ pc; do
	name=`python3 "$HERE/ksyms" "$KERNEL" "$pc" 2>/dev/null | \
		sed -e 's/^[^ ]*  *//'`
	printf '%-5s %s  %s\n' "$cpu" "$pc" "${name:-?}"
done
[ -n "$tail_cmd" ] && echo "(resumed)" || echo "(left halted; 'resume' to go)"
