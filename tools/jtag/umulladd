#!/usr/bin/env python3
#
# Find every place a kernel adds an UNTRUNCATED 32x32->64 multiply to a
# 64-bit value -- the signature of a narrowing cast that 7c dropped.
#
#	python3 tools/jtag/umulladd os/inferno/raspi3b/kernel8.img
#	python3 tools/jtag/umulladd <img> <elf>
#
# WHY A SCANNER AND NOT A SOURCE GREP.  The defect is a code-generation
# artifact: the source says (s32)(...) and the instruction stream simply has no
# narrowing in it.  tests/kencc-narrowcast.sh proves the compiler still does it
# and names the shape; this answers the question that decides whether a kernel
# is safe to boot, which is whether there is an instance in THIS one.  Same
# division of labour as kencc-brloop.sh against kencc-selfbranch.sh, and the
# same reason: the synthetic probe passed for a loader that was emitting the
# defect into every real kernel it linked.
#
# WHAT IT FOUND.  byteaddr() in libmemdraw/alloc.c computed a row offset as
#
#	(s32)(sizeof(u32)*p.y*i->width)
#
# and 7c emitted UMULL with no truncation, so for a NEGATIVE p.y the 32-bit
# wrap survived into the high word and the result was
#
#	byteaddr(i, i->r.min) = bdata + i->width * 2^32
#
# exactly -- which is why the raspi3b fault address was 0x3008c6c40, a clean
# small constant above a plausible pool pointer, identical across two kernels
# and two boots.  Fixing byteaddr moved the high word from 3 to 1 rather than to
# 0, which is what said there was a SECOND site and is why this exists.
#
# NEGATIVE CONTROL DONE, which is the only reason the 0 is worth printing.
# With byteaddr reverted to the broken shape and the kernel relinked, it reports
# exactly one candidate and names it:
#
#	umulladd:   byteaddr+0x10 at 0xe7c34: UMULL -> x5 reaches a 64-bit ADD
#	            at 0xe7c40 with no SXTW
#	umulladd: 1 candidate(s)
#
# and 0 with the fix restored.  A scanner that has only ever reported zero is
# indistinguishable from a scanner that cannot report anything.
#
# IT IS A HEURISTIC AND SAYS SO.  An UMULL whose result is legitimately 64-bit
# and then added to a 64-bit quantity is correct code, and this cannot tell that
# apart from a dropped narrowing.  So it reports CANDIDATES with their enclosing
# symbol, for a human to read, and the thing that makes the list short enough to
# read is bounding the scan to text -- see undefimm, which reports about two
# thousand false hits unbounded because ASCII in the string section decodes as
# instructions.
#
import sys, subprocess, os

def sym_table(elf):
    out = subprocess.run(['python3',
            os.path.join(os.path.dirname(__file__), 'ksyms'), elf],
            capture_output=True, text=True).stdout
    syms, etext = [], None
    for l in out.splitlines():
        f = l.split()
        if len(f) < 3:
            continue
        try:
            v = int(f[0], 16)
        except ValueError:
            continue
        syms.append((v, f[2]))
        if f[2] == 'etext':
            etext = v
    syms.sort()
    return syms, etext

def owner(syms, a):
    lo, hi = 0, len(syms)
    while lo < hi:
        mid = (lo + hi) // 2
        if syms[mid][0] <= a:
            lo = mid + 1
        else:
            hi = mid
    if lo == 0:
        return '?', 0
    return syms[lo-1][1], a - syms[lo-1][0]

def is_umull(w):
    # UMADDL/UMULL: sf=1 op54=00 op31=101 U=1 ... Ra=31 for UMULL
    return (w & 0xFFE08000) == 0x9BA00000

def is_madd32(w):
    return (w & 0xFFE08000) == 0x1B000000

#
# THE CLASS IS WIDER THAN UMULL, and the board proved it.  With the row-offset
# fix in, byteaddr still returned bdata + 2^32, from
#
#	SDIVW	R3,R5		a 32-bit result; an AArch64 W write ZEROES
#	ADD	R10,R5,R0	the top half, so -1 widens to 2^32-1
#
# and there is no cast in that source at all: C requires an int added to a
# pointer to widen WITH ITS SIGN, and the widening is simply absent.  So any
# instruction that writes a W register can feed a bad pointer, not just UMULL.
#
# Which makes the false-positive rate the whole design problem: an UNSIGNED
# 32-bit value is CORRECT zero-extended, and nothing in the instruction stream
# says which a given value is.  So this reports two tiers -- the UMULL tier,
# which is narrow and was the original finding, and the wide tier, which is a
# reading list and is printed only with -a.
#
W32 = [
    (0xFFE0FC00, 0x1AC00C00, 'SDIVW'),
    (0xFFE0FC00, 0x1AC00800, 'UDIVW'),
    (0xFFE08000, 0x1B000000, 'MADDW'),
    (0x7F200000, 0x0B000000, 'ADDW'),
    (0x7F200000, 0x4B000000, 'SUBW'),
    (0x7F800000, 0x13000000, 'ASRW/SBFM'),
    (0x7F800000, 0x53000000, 'LSLW/UBFM'),
]

def w32_kind(w):
    if (w >> 31) != 0:           # sf=1 is the 64-bit form; not a W write
        return None
    for mask, val, name in W32:
        if (w & mask) == val:
            return name
    return None

def is_sxtw(w):
    # SBFM x,w,0,31 -- the sign-extending widen a narrowing cast must emit
    return (w & 0xFFC0FC00) == 0x93407C00

def rd(w):
    return w & 0x1f

#
# PROVENANCE, so the wide tier shrinks to the part worth reading.
#
# An UNSIGNED 32-bit value is CORRECT zero-extended, so the wide tier's size is
# not its finding -- 112 candidates, of which a peer cleared libmemdraw's 37 and
# libdraw's 5 by checking signs one at a time, and I cleared screenbcm's five by
# hand with ONE real site among them.  Doing that for the rest by hand is not a
# plan.
#
# But the instruction stream does carry the distinction, in the LOAD: MOVW is a
# sign-extending 32-bit load (a signed int) and MOVWU is zero-extending (an
# unsigned one).  Likewise ASRW and SDIVW are signed operations where LSRW and
# UDIVW are unsigned.  So trace the flagged producer's operands backwards and
# classify:
#
#	signed    an operand traces to MOVW, SDIVW, ASRW or a negative
#	          immediate  ->  READ THIS ONE
#	unsigned  every operand traces to MOVWU, LSRW or UDIVW  ->  correct
#	          zero-extended
#	unknown   the trace ran out of window  ->  read it, cheaply
#
# THIS IS A NARROWING, AND A NARROWING IS THE DANGEROUS KIND OF EDIT.  A peer
# tightened their source-side version of this scan by requiring the tainted
# value to be dereferenced in the same function, which dropped TWO OF FOUR
# control hits -- including the UMULL -- because byteaddr RETURNS the address
# rather than using it.  A filter that loses the case its control exists to
# catch is worse than the false positives it removes, and it is invisible unless
# the control is re-run AFTER the change.  So this classifier does not suppress
# anything: every candidate is still printed, with its class, and the control is
# re-run after each change to it.
#
#
# THE ENCODINGS ARE TAKEN FROM INSTRUCTIONS WHOSE IDENTITY IS KNOWN, not from
# memory of the manual.  The first version had LDRSW's unsigned-offset form as
# 0xB8800000, which is the register/indexed form, so the trace never recognised
# the sign-extending load of p.y and the classifier called byteaddr's real UMULL
# bug `[unsigned]' -- twice, because the first re-run of the control blamed the
# shift and I fixed that instead.  Checked against the linked kernel's own
# bytes: `MOVW p+12(FP),R5' is 0xb98037e5, so the mask is 0xB9800000.
#
SIGNED_OPS = [
    (0xFFC00000, 0xB9800000, 'MOVW ld'),    # LDRSW, unsigned offset
    (0xFFE00C00, 0xB8A00800, 'MOVW ld'),    # LDRSW, register offset
    (0xFFE0FC00, 0x1AC00C00, 'SDIVW'),
    (0x7F800000, 0x13000000, 'ASRW/SBFM'),
]
UNSIGNED_OPS = [
    (0xFFC00000, 0xB9400000, 'MOVWU ld'),   # LDR (32-bit, zero-extends)
    (0xFFE0FC00, 0x1AC00800, 'UDIVW'),
    (0xFFE0FC00, 0x1AC02400, 'LSRW'),
]
#
# LSLW/UBFM IS NOT EVIDENCE OF UNSIGNEDNESS and was in the list above until the
# control said otherwise.  UBFM zero-extends into the 64-bit register, but that
# says nothing about the VALUE: a left shift of a negative int is still
# negative in 32-bit two's complement.  With it listed as unsigned, this
# classifier labelled byteaddr's real UMULL bug `[unsigned]' -- advice pointing
# a reader AWAY from the one site the control exists to catch.
#
# Caught by re-running the negative control AFTER adding the classifier, which
# is the only way a narrowing is ever caught.  A shift is now traced THROUGH
# rather than treated as a verdict.
#

def classify_src(w):
    for mask, val, name in SIGNED_OPS:
        if (w & mask) == val:
            return 'signed', name
    for mask, val, name in UNSIGNED_OPS:
        if (w & mask) == val:
            return 'unsigned', name
    return None, None

def reads_of(w):
    """The registers an instruction READS.  Rn always; Rm only when bits
    16..20 really are a register.

    The first version returned both unconditionally, and for a bitfield
    instruction -- SBFM/UBFM, which is what LSLW and ASRW assemble to -- bits
    16..20 are part of `imms', so it invented a register number.  Tracing
    through that garbage register found an unrelated unsigned writer and the
    classifier reported byteaddr's real UMULL bug as `[unsigned]'.  Third
    control re-run in a row to catch a mislabel, each one a different cause:
    a shift treated as a verdict, a wrong LDRSW encoding, and now a register
    that does not exist.
    """
    rn = (w >> 5) & 0x1f
    # Bitfield (SBFM/UBFM/BFM) and arithmetic/logical IMMEDIATE forms have no Rm.
    if (w & 0x1F800000) in (0x13000000, 0x33000000):    # bitfield
        return [rn]
    if (w & 0x1F000000) in (0x11000000, 0x12000000):    # add/sub imm, logical imm
        return [rn]
    return [rn, (w >> 16) & 0x1f]

def provenance(words, k, regs, depth=4, back=16):
    """Walk backwards for the writers of `regs`; return the strongest class.

    THE SEARCH POSITION HAS TO TRAVEL WITH THE REGISTER.  Four control re-runs
    found four different reasons this mislabelled byteaddr's UMULL, and this was
    the last and the real one: each trace restarted its backward scan at k-1, so
    when the writer of R2 was the LSLW at k-1 and the LSLW reads R2 again, the
    next hop re-found THE SAME LSLW and the chain never reached the
    sign-extending move behind it.  The hop has to continue from BEFORE the
    instruction already credited.

    The other three, kept because each is a distinct way a classifier lies:
    treating a shift as evidence of unsignedness, an LDRSW mask copied from
    memory instead of from the linked kernel's bytes, and inventing an Rm for a
    bitfield instruction that has none.
    """
    seen = 'unknown'
    todo = [(r, depth, k - 1) for r in regs if r != 31]
    while todo:
        r, d, start = todo.pop()
        if d <= 0:
            continue
        for j in range(start, max(k - 1 - back, -1), -1):
            w = words[j]
            if rd(w) != r:
                continue
            c, _ = classify_src(w)
            if c == 'signed':
                return 'signed'
            if c == 'unsigned':
                if seen == 'unknown':
                    seen = 'unsigned'
            else:
                todo.extend((x, d - 1, j - 1)
                            for x in reads_of(w) if x != 31)
            break
    return seen

def add64_reads(w, r):
    # ADD (shifted register), 64-bit: sf=1 op=0 S=0 01011
    if (w & 0x7F200000) != 0x0B000000 or (w >> 31) != 1:
        return False
    rn = (w >> 5) & 0x1f
    rm = (w >> 16) & 0x1f
    return rn == r or rm == r

def main():
    if len(sys.argv) < 2:
        sys.exit("usage: umulladd <kernel8.img> [ielf]")
    #
    # Strip the flags before taking positional arguments, or `-a' is read as
    # the ELF path and the etext refusal fires with "no etext in -a".  It did.
    #
    args = [a for a in sys.argv[1:] if not a.startswith('-')]
    if not args:
        sys.exit("usage: umulladd [-a] <kernel8.img> [ielf]")
    img = args[0]
    elf = args[1] if len(args) > 1 else \
          os.path.join(os.path.dirname(img), 'iraspi3b')
    base = 0x80000
    d = open(img, 'rb').read()
    syms, etext = sym_table(elf)
    if etext is None:
        print("umulladd: no etext in %s -- REFUSING: an unbounded scan reads"
              % elf, file=sys.stderr)
        print("umulladd: the string section as instructions.  See undefimm.",
              file=sys.stderr)
        sys.exit(2)
    limit = min(len(d), etext - base)
    print("umulladd: %s, text %#x..%#x (%d words)"
          % (os.path.basename(img), base, etext, limit // 4))
    words = [int.from_bytes(d[o:o+4], 'little') for o in range(0, limit - 3, 4)]
    #
    # Look ahead a short window only.  A narrowing move that is going to happen
    # happens immediately -- gmove emits it at the cast -- so a long window buys
    # nothing but false negatives from unrelated later moves of the same
    # register.
    #
    WIN = 6
    wide = '-a' in sys.argv
    hits = 0
    widehits = 0
    byclass = {}
    for k, w in enumerate(words):
        kind = None
        if is_umull(w):
            kind = 'UMULL'
        elif wide:
            kind = w32_kind(w)
        if kind is None:
            continue
        r = rd(w)
        narrowed = False
        culprit = None
        for j in range(k+1, min(k+1+WIN, len(words))):
            v = words[j]
            if is_sxtw(v) and ((v >> 5) & 0x1f) == r:
                narrowed = True
                break
            if add64_reads(v, r):
                culprit = j
                break
            if rd(v) == r and not is_umull(v):
                break           # r overwritten; this UMULL went elsewhere
        if narrowed or culprit is None:
            continue
        a = base + 4*k
        name, off = owner(syms, a)
        cls = provenance(words, k, reads_of(w))
        byclass[cls] = byclass.get(cls, 0) + 1
        if kind == 'UMULL':
            hits += 1
        else:
            widehits += 1
        print("umulladd:   %s+%#x at %#x: %s -> x%d reaches a 64-bit ADD"
              " at %#x with no SXTW [%s]"
              % (name, off, a, kind, r, base + 4*culprit, cls))
    print("umulladd: %d UMULL candidate(s)%s"
          % (hits, (", %d wide-tier" % widehits) if wide else ""))
    if byclass:
        print("umulladd: by operand provenance: %s"
              % "  ".join("%s %d" % (c, byclass[c]) for c in sorted(byclass)))
        print("umulladd: `signed' and `unknown' are the ones to read; `unsigned'")
        print("umulladd: is correct zero-extended.  NOTHING IS SUPPRESSED -- the")
        print("umulladd: class is advice, because a narrowing filter is how a")
        print("umulladd: scan silently stops finding what it was built for.")
    print("umulladd: these are CANDIDATES -- a genuinely 64-bit UMULL added to a")
    print("umulladd: 64-bit value is correct code and looks identical here.")
    if not wide:
        print("umulladd: -a also scans every 32-bit-result instruction, which is")
        print("umulladd: the class byteaddr's x offset belonged to.  That tier is a")
        print("umulladd: reading list, not a verdict: an UNSIGNED 32-bit value is")
        print("umulladd: correct zero-extended and looks identical.")
    return 1 if hits else 0

if __name__ == '__main__':
    sys.exit(main())
