#!/bin/sh
#
# Build a raspi3b kernel and REFUSE to produce an image that was not linked.
#
#	sh tools/jtag/kbuild		     # raspi3b
#	CONF=virtarm64 sh tools/jtag/kbuild  # another aarch64 board
#
# WHY THIS EXISTS, and it is not convenience.  `mk iraspi3b' after a change
# anywhere under lib*/ EXITS 0 AND DOES NOT RELINK.  Measured, twice, in this
# directory:
#
#	$ mk iraspi3b			# after editing libmemdraw/alloc.c
#	... 7c alloc.c ... iar vu ...	# archive rebuilt
#	rc=0, "7l -o iraspi3b" ran 0 times
#
# The kernel target has no dependency edge to the library archives, so a library
# change recompiles, re-archives, and silently ships the OLD kernel.  And it is
# worse than that one step further on:
#
#	$ rm iraspi3b && mk kernel8.img
#	rc=0, no iraspi3b, kernel8.img UNCHANGED from the previous build
#
# -- exit 0, no kernel binary at all, and a stale flat image left in place ready
# to be loaded over JTAG.  kernel8.img does depend on i$CONF, so that one is mk
# declining to rebuild a missing target rather than a missing edge.
#
# WHAT IT COST.  A byteaddr() fix was applied, built, booted and judged against
# a kernel that did not contain it.  The tell was subtle and easy to misread:
# the fault MOVED (its address changed by exactly the predicted amount), so it
# looked like a partially effective fix rather than an unbuilt one.  An
# unchanged fault would have been obvious; a changed one was not.
#
# Note this is the OPPOSITE of the stale-object case this tree already records:
# there, `rm foo.7' does not force a rebuild because mk short-circuits on a
# missing object, and touching the .c is what works.  Here rm IS the fix,
# because the problem is a missing dependency rather than a short-circuit.  Two
# build hazards with opposite remedies, which is why neither is a habit worth
# forming -- check the link count instead.
#
# THE CHECK IS THE POINT: "7l -o i$CONF" must appear AT LEAST ONCE in the log.
# Exit 0 with zero links looks exactly like success.  (Two is normal when both
# targets are built fresh -- see the guard below for why it is not "exactly
# one".)
#
#
# IT TAKES NO POSITIONAL ARGUMENTS -- the board comes from CONF= in the
# environment -- and it used not to look at them, which is worse here than
# a tool that merely ignores a flag: `kbuild raspi3b' would have built the
# DEFAULT board, printed a clean build and been believed.  A wrong-board
# build that reports success is exactly the kind of thing this directory
# exists to refuse.
#
if [ $# -ne 0 ]; then
	echo "usage: CONF=<board> kbuild        (the board is an ENVIRONMENT variable)" >&2
	echo "kbuild: refusing to build -- you passed: $*" >&2
	echo "kbuild: did you mean: CONF=$1 $0" >&2
	exit 2
fi

set -u
HERE=`cd \`dirname "$0"\` && pwd`
ROOT=`cd "$HERE/../.." && pwd`
CONF=${CONF:-raspi3b}
D=$ROOT/os/inferno/$CONF
[ -d "$D" ] || { echo "kbuild: no $D" >&2; exit 2; }
LOG=${LOG:-${TMPDIR:-/tmp}/kbuild.$CONF.log}
#
# KEEP THE PREVIOUS LOG.  The diagnostic count below is only useful against
# the one before it, and this file used to overwrite its own log every run --
# so "did my change add a warning" was unanswerable twice in one session: the
# count moved 145 -> 146 between two full rebuilds of the same sources, the
# per-file breakdown printed below is only the top ten, and the file that
# gained it was outside that cut with no earlier log to diff.
#
# One rename, and `diff $LOG.prev $LOG' answers it.
#
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.prev"

PATH=$ROOT/MacOSX/arm64/bin:$PATH
export PATH

#
# Remove both targets rather than only the kernel: kernel8.img is what gets
# loaded, and leaving a stale one is the failure above.  If the build does not
# produce them, their ABSENCE is the signal, which is a better failure than a
# stale file that boots.
#
#
# ONLY raspi3b (AND ITS SIBLINGS) HAVE A FLAT IMAGE.  The first version
# hardcoded kernel8.img and so FAILED on every other board: CONF=virtarm64
# linked ivirtarm64 correctly, installed it, and then kbuild reported "the build
# failed" because mk said "don't know how to make kernel8.img".  A tool that
# reports a correct build as a failure is the shape the link-count guard below
# already got wrong once.  Ask the mkfile instead of assuming.
#
if grep -q '^kernel8.img:' "$D/mkfile" 2>/dev/null; then
	IMG=kernel8.img
else
	IMG=
fi

rm -f "$D/i$CONF" ${IMG:+"$D/$IMG"}

#
# KBUILD_FULL=1 FORCES A RECOMPILE OF EVERYTHING THE KERNEL LINKS, which is
# what a change to 7c or 7l needs and what nothing else here provides.
#
# Removing the two targets is enough for a SOURCE change: mk sees the .c is
# newer than the .7.  It is not enough for a COMPILER change -- the objects are
# newer than the sources either way, so mk recompiles nothing and the kernel is
# relinked from objects the old compiler produced.  That failure has the same
# shape as the one in the comment above and is worse, because the link DOES
# happen, so the link-count check passes and the image looks fresh.
#
# And deleting the objects is not the remedy: this tree's mk short-circuits on
# a missing object, so `rm *.7' does not force a rebuild.  Touching the sources
# does.  The list is the kernel's own: os/inferno plus the ten libraries the
# 7l line names.
#
if [ "${KBUILD_FULL:-0}" = 1 ]; then
	n=0
	for d in "$ROOT/os/inferno" "$ROOT/libinterp" "$ROOT/libdraw" 	    "$ROOT/libkern" "$ROOT/libkeyring" "$ROOT/libmath" 	    "$ROOT/libmemdraw" "$ROOT/libmemlayer" "$ROOT/libmp" 	    "$ROOT/libsec" "$ROOT/libtk"; do
		[ -d "$d" ] || continue
		c=`find "$d" \( -name '*.c' -o -name '*.s' \) -print | wc -l`
		find "$d" \( -name '*.c' -o -name '*.s' \) -exec touch {} +
		n=`expr $n + $c`
	done
	echo "kbuild: KBUILD_FULL -- touched $n sources, everything recompiles"
	echo "kbuild:   (a compiler change does not make objects stale, so this"
	echo "kbuild:   is the only way a 7c or 7l fix reaches the image)"
fi

( cd "$D" && mk "i$CONF" && { [ -z "$IMG" ] || mk "$IMG"; } ) > "$LOG" 2>&1
rc=$?

#
# ANCHORED ON PURPOSE, and checked rather than assumed.  This reads mk's
# own log, not the board console, and mk runs its commands sequentially
# with no -j here, so there is nothing to interleave -- anchored and
# unanchored counts agree on a real log (2 and 2).  If that ever stopped
# being true the anchor would UNDER-count, and an under-count makes the
# refusal below fire on a good build: loud and safe.  An anchor cannot
# produce the dangerous direction, an over-count hiding a missing link.
#
#
# THE LOADER'S NAME COMES FROM THE BOARD, not from a constant.  This counted
# "^7l -o i$CONF" whatever the board was, so on an amd64 board -- pc64, whose
# loader is 6l -- it counted ZERO and refused a build that had linked
# perfectly.  A false refusal, in the safe direction, but it meant kbuild only
# ever worked for aarch64 and said nothing about that.
#
# Derived the same way tests/kencc-selfbranch.sh does it: OBJTYPE from the
# board's own mkfile, then LD= from mkfiles/mkfile-Inferno-<objtype>.
#
LD=`grep -hoE '^OBJTYPE=[a-z0-9]+' "$D/mkfile" 2>/dev/null | head -1 |
	cut -d= -f2 |
	while read ot; do
		grep -hE '^LD=' "$ROOT/mkfiles/mkfile-Inferno-$ot" 2>/dev/null |
			head -1 | awk '{print $2}'
	done`
if [ -z "$LD" ]; then
	echo "kbuild: cannot tell which loader $CONF uses (no OBJTYPE in" >&2
	echo "kbuild: $D/mkfile, or no LD= for it in mkfiles/).  Not reporting" >&2
	echo "kbuild: a link count it would have to guess at." >&2
	exit 2
fi
links=`grep -c "^$LD -o i$CONF" "$LOG"`
echo "kbuild: mk exit $rc, $LD links $links, log $LOG"
[ -f "$LOG.prev" ] && echo "kbuild:   previous run kept at $LOG.prev (diff them for new warnings)"

#
# THE DIAGNOSTIC PATTERN, in one place because it is used four times below
# and a word list that drifts between uses is worse than no list.
#
# IT WAS A WORD LIST AND IT MISSED A REAL ERROR.  Positive-controlled against
# four diagnostics this toolchain actually emits -- produced by compiling
# deliberately broken files, not by reading the compilers:
#
#	a.c:1 function not declared: undeclared_fn          7c
#	b.c:1 syntax error, last name: x                    7c
#	c.b:7: redeclaration of local x, previously ...     limbo
#	d.b:6: nosuchvariable is not declared               limbo
#
# `warning|not declared|undefined' matched THREE of those four.  It misses
# "redeclaration of local", which is the error that cost a peer session a
# build -- caught there only because mk's exit status was nonzero.  Adding
# words does not fix the class: adding `declar' still leaves `syntax error'
# unmatched by the counting patterns below.
#
# So match the SHAPE instead.  Every diagnostic from 7c, 8c, limbo and cc
# begins with a source file and a line number; no command echo, mk line or
# `ls -l' timestamp does.  Measured: 4 of 4 diagnostics, and ZERO lines in
# two real clean kbuild logs -- where the bare `[^ ]+:[0-9]+' shape matched
# the `08:11 /path' in ls output, which is why the extension is required.
#
# The words stay, because a linker or mk failure has no file:line at all.
#
DIAG='error|warning|not declared|undefined|declar|\.[cbhsy]:[0-9]+:? '
#
# NOTE: this pattern is wider than the one previous logs were counted with,
# so the first comparison against $LOG.prev after this change will show a
# different number for reasons that are not the build.
#

if [ "$rc" -ne 0 ]; then
	echo "kbuild: the build failed" >&2
	grep -iE "$DIAG" "$LOG" | head -20 >&2
	exit 1
fi
#
# AT LEAST ONE LINK, NOT EXACTLY ONE.  The first version demanded exactly 1 and
# REFUSED A CORRECT BUILD: this mkfile links twice when both targets are built
# fresh, because i$CONF is linked again without -H7 purely for its symbol table.
# Every observation behind "exactly 1" came from the path where only one target
# needed rebuilding, and I generalised from it.
#
# Worse than being wrong, it was wrong in the direction that trains people to
# ignore the tool: it refused a good build while printing "mk exited 0 without
# linking", which was not what had happened.  A guard that fires on correct
# input is a guard that gets switched off.
#
# It was caught by re-running the negative control after editing an instrument
# -- the rule a peer earned the hard way on their own scanner, applied here the
# first time it could be.
#
if [ "$links" -lt 1 ]; then
	echo "kbuild: REFUSING -- $LD linked $links times." >&2
	echo "kbuild: mk exited 0 WITHOUT LINKING, which is the hazard this" >&2
	echo "kbuild: tool exists for: a change under lib*/ recompiles and" >&2
	echo "kbuild: re-archives, and the kernel target has no edge to the" >&2
	echo "kbuild: archives.  Whatever image is on disk is not the source" >&2
	echo "kbuild: tree's." >&2
	exit 1
fi
for f in "i$CONF" $IMG; do
	if [ ! -s "$D/$f" ]; then
		echo "kbuild: REFUSING -- $f was not produced" >&2
		exit 1
	fi
done

#
# Report the diagnostics rather than filtering them away.  This tree records a
# session where grepping the build output for a success marker hid a real
# failure, so the count is printed even when it is zero.
#
# BUT A ZERO HERE DOES NOT MEAN CLEAN, and that has to be said next to the
# number.  The count is over whatever this invocation RECOMPILED.  Touching one
# .c gave "diagnostics: 0"; touching os/inferno/raspi3b/fns.h -- which every
# port file includes -- gave 184, all of them pre-existing format mismatches in
# os/inferno/port that had been there the whole time.  So the figure answers
# "did anything I just compiled warn", not "is the tree clean", and comparing
# two runs that rebuilt different amounts compares nothing.
#
# Which is why the per-file breakdown matters more than the total: the question
# is whether any diagnostic names a file this change touched.
#
#
# DISTINCT AS WELL AS RAW, because the raw count is EMISSIONS and mk compiles
# some files more than once in a run.  ../port/alloc.c is compiled twice here,
# so its nine warnings count as eighteen -- which read as "my change added
# nine" when it had added none, and which is also why this line said 145 on
# one full rebuild and 146 on the next with identical sources: the two runs
# compiled some file a different number of times.
#
# A count of emissions is the wrong dimension for "did I add a warning", and
# the distinct count is the right one.  Both are printed, because the raw
# number is still what the per-file table below adds up to.
#
nd=`grep -ciE "$DIAG" "$LOG"`
ndu=`grep -iE "$DIAG" "$LOG" | sort -u | wc -l | tr -d ' '`
nf=`grep -iE "$DIAG" "$LOG" |
	sed 's/^warning: //;s/:.*//' | sort -u | wc -l | tr -d ' '`
echo "kbuild: diagnostics in the log: $nd emission(s), $ndu distinct, in $nf file(s)"
echo "kbuild:   (over what THIS run recompiled -- a zero is not a clean tree)"
[ "$nd" -gt 0 ] && grep -iE "$DIAG" "$LOG" |
	sed 's/^warning: //;s/:.*//' | sort | uniq -c | sort -rn | head -12

#
# And say which build this is, so a later tool reading the board can be checked
# against it: every JTAG reader here verifies kerndate and refuses on mismatch.
#
st=`grep -o "DKERNDATE='[0-9]*" "$LOG" | tail -1 | sed "s/.*'//"`
echo "kbuild: built i$CONF${IMG:+ and $IMG}, KERNDATE ${st:-unknown}"
ls -l "$D/i$CONF" ${IMG:+"$D/$IMG"}
exit 0
