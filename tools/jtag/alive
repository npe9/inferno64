#!/bin/sh
#
# Is a kernel running, and has it booted recently?  No console needed.
#
#	sh tools/jtag/alive [maxticks]
#
# Prints "alive <ticks>" and exits 0 if the clock is advancing, "dead"
# and exits 1 if it is not.  With maxticks, also requires the tick
# count to be below it, which distinguishes a kernel that has just
# booted from the one that was already running.
#
# Why this exists: every way of telling whether the board came up went
# through the serial console, and the console is the least reliable
# part of this rig -- the adapter wedges, and the screen session has
# died mid-measurement twice, which silently turns "cannot see" into
# "did not boot" and invents failures for a board that was fine.
#
# m->ticks is at mach0+0x28 and is incremented by clockintr, so it
# advances at HZ on any kernel that is alive and clocking, and it
# starts again from zero on every boot.  mach0's address comes from
# the symbol table rather than being written down, because it moves
# with every build.
#
set -u
ROOT=`cd \`dirname "$0"\`/../.. && pwd`
MAX=${1:-0}
#
# ELF and IMG travel together, and both can be overridden.
#
# Every address here is read out of the ELF's symbol table and then read out
# of the RUNNING kernel, so an ELF from one build against a kernel from
# another agrees about nothing: mach0 is somewhere else, the word at that
# address is not a tick count, and this printed "dead (ticks 0 -> 0)" about a
# board that was running perfectly.  boot.sh had the same bug and was fixed
# for it; this is the other half.
#
# So the ELF is checked before it is trusted.  kerndate is read from the board
# at the address this ELF gives, and compared with the stamp in the matching
# image.  If they disagree the answer is "cannot tell", which is a different
# thing from "dead" and is the whole point: an instrument that cannot see must
# say so rather than return a value.  Five false failures in this directory
# came from tools that returned one.
#
ELF=${ELF:-$ROOT/os/inferno/raspi3b/iraspi3b}
IMG=${IMG:-$ROOT/os/inferno/raspi3b/kernel8.img}

#
# THE BOARD LOCK, TAKEN BEFORE THE samekernel CHECK AND NOT AFTER IT.
#
# openocd does not queue: a second one dies with LIBUSB_ERROR_ACCESS,
# which boardlock.sh describes as reading like a dead board rather than
# a busy one.  The lock had been added to the WRITERS -- boardrun,
# kinstall.sh, boot.sh, hardreset -- and to none of the four readers,
# all of which run openocd.
#
# IT HAS TO BE HERE, ABOVE THE samekernel CALL, AND THAT IS THE WHOLE
# POINT RATHER THAN TIDINESS.  samekernel touches the board too, and it
# now takes the lock itself -- so with the acquisition further down,
# samekernel would lock, read, RELEASE, and only then would this script
# lock and take its own reads.  Another operator fits in that gap, which
# means the "is the tree's image what is running" guard directly above
# could be satisfied in one lock epoch and the reads it guards taken in
# another.  That is the exact failure the guard exists to prevent --
# addresses from one kernel read off a board running a different one --
# reintroduced by the lock that was supposed to help.  I put it below
# first and the refusal message came back from samekernel, which is how
# the ordering came to light.
#
# A nested call inherits instead of being refused: boardlock.sh exports
# BOARDLOCK_HELD, so samekernel below asks for a lock this script
# already holds and gets it.  Measured both ways -- an unrelated reader
# IS refused while a writer holds it, and a nested samekernel returns
# SAME -- rather than read off the code.
#
. "$ROOT/tools/jtag/boardlock.sh"
boardfree || { echo "alive: another openocd holds the adapter" >&2; exit 1; }
boardlock alive || { echo "alive: another board operation is running" >&2; exit 1; }
trap 'boardunlock' 0 1 2 15

#
# IS THE TREE'S IMAGE WHAT IS RUNNING?  Every address below comes from
# $ELF's symbol table, and symbols move with every build, so reading
# them on a board running something else lands on an unrelated variable
# and prints it as a fact.  samekernel compares kerndate -- the one
# symbol whose value the image also knows -- and refusing here is the
# point: a confident wrong answer from this tool is worse than no
# answer, which is what its own comment above says about the console.
#
SK=`sh "$ROOT/tools/jtag/samekernel" "$ELF" 2>&1`
case "$SK" in
SAME*)	;;
DIFFERENT*)
	echo "alive: CANNOT TELL -- $SK" >&2
	echo "alive: the running kernel is not $ELF, so every address from" >&2
	echo "alive: it is an unrelated variable.  Rebuild, or point ELF at" >&2
	echo "alive: the image the board is actually running." >&2
	exit 2;;
*)
	echo "alive: cannot establish which kernel is running: $SK" >&2
	exit 2;;
esac

MACH0=`python3 "$ROOT/tools/jtag/ksyms" "$ELF" 2>/dev/null |
	awk '$3=="mach0"{print $1}'`
[ -n "$MACH0" ] || { echo "alive: no mach0 symbol in $ELF" >&2; exit 2; }

#
# THE MAP MUST COME FROM THE BUILD THAT IS RUNNING, NOT THE ONE YOU HOLD.
#
# The comment above says mach0 moves with every build, which is true and does
# not imply the thing that bit a peer: they ran this from a DIFFERENT WORKTREE
# against this board, so every address came from their kernel's symbol table and
# was read out of mine.  It printed "dead (ticks 168052864 -> 168052864, not
# advancing)" -- a reading that is not alarming but MEANINGLESS, because the
# word it watched is not m->ticks in the kernel that is there.
#
# Checked in this tree: a stale ELF differs in BOTH the address and the stamp --
# kerndate@0x1d9fd8 stamp 1791056038 against kerndate@0x1d9fc8 stamp 1791023117 --
# so the comparison below has distinguishing inputs and does fire.
#
# WHICH IS WHY THE SKIP PATH IS NOW FATAL.  Every stamp test here is inside
# `if [ -n "$KDADDR" ] && [ -n "$kd" ]`, so an empty KDADDR silently skipped ALL
# of them and left this reporting ticks from an address nothing had vouched for.
# A check that can be skipped is not a check.
#
# THE REFUSAL BELOW IS UNTESTED, and that is stated rather than implied.  Every
# real kernel in this tree carries both mach0 and kerndate, so reaching it needs
# an ELF with one and not the other, which I could not construct: pointing ELF at
# an object file trips the mach0 test above first (exit 2, verified).  So it
# guards a case I could not produce -- defensive, not demonstrated, unlike the
# stamp comparison itself whose inputs ARE verified distinguishing above.
#
KDCHECK=`python3 "$ROOT/tools/jtag/ksyms" "$ELF" -g kerndate 2>/dev/null |
	awk '$3=="kerndate"{print $1}'`
[ -n "$KDCHECK" ] || {
	echo "alive: no kerndate symbol in $ELF, so this cannot verify that the" >&2
	echo "alive: ELF describes the running kernel -- refusing rather than" >&2
	echo "alive: reporting ticks from an unvouched address" >&2
	exit 2
}
TICKS=`python3 -c "print(hex(int('$MACH0',16)+0x28))"`

KDADDR=`python3 "$ROOT/tools/jtag/ksyms" "$ELF" -g kerndate 2>/dev/null |
	awk '$3=="kerndate"{print $1}'`
#
# What that image says its stamp is.  Empty if there is no readable image to
# compare against, in which case the plausibility test below is used instead.
#
WANT=
if [ -n "$KDADDR" ] && [ -r "$IMG" ]; then
	WANT=`python3 - "$IMG" "$KDADDR" <<'PYEOF'
import sys
img, addr = sys.argv[1], int(sys.argv[2], 16)
d = open(img, "rb").read()
o = addr - 0x80000
print(int.from_bytes(d[o:o+4], "little") if 0 <= o <= len(d)-4 else "")
PYEOF`
fi


#
# One debugger session reads both words, so checking the ELF costs no extra
# halt of the board.
#
read_pair() {
	timeout 90 openocd -f interface/ftdi/olimex-arm-usb-tiny-h.cfg \
		-f "$ROOT/tools/jtag/raspi3b.cfg" \
		-c init -c 'targets bcm2837.cpu0' -c halt \
		-c "mdw $TICKS 1" -c "mdw ${KDADDR:-$TICKS} 1" \
		-c resume -c shutdown 2>&1 |
	awk -F': ' '/^0x/{print $2}' | awk '{print $1}' | tr '\n' ' '
}

pair=`read_pair`
a=`echo "$pair" | awk '{print $1}'`
kd=`echo "$pair" | awk '{print $2}'`

#
# Is this ELF even describing the kernel that is running?
#
if [ -n "$KDADDR" ] && [ -n "$kd" ]; then
	got=`python3 -c "print(int('$kd',16))" 2>/dev/null`
	if [ -n "$WANT" ] && [ "$WANT" != "$got" ]; then
		echo "alive: CANNOT TELL -- $ELF does not describe the running" \
		     "kernel (board stamp $got, $IMG says $WANT)" >&2
		exit 2
	fi
	if [ -z "$WANT" ]; then
		#
		# No image to compare with, so fall back to asking whether the
		# word is a plausible build stamp at all.  A mismatched ELF
		# points at something that is not one.
		#
		if [ "$got" -lt 1600000000 ] || [ "$got" -gt 2200000000 ]; then
			echo "alive: CANNOT TELL -- the word at kerndate reads" \
			     "$got, which is not a build stamp, so $ELF does" \
			     "not describe the running kernel" >&2
			exit 2
		fi
	fi
fi

sleep 3
pair=`read_pair`
b=`echo "$pair" | awk '{print $1}'`
[ -n "$a" ] && [ -n "$b" ] || { echo "alive: no answer from the debugger" >&2; exit 2; }
da=`python3 -c "print(int('$a',16))"`
db=`python3 -c "print(int('$b',16))"`
if [ "$db" -le "$da" ]; then
	echo "dead (ticks $da -> $db, not advancing)"
	exit 1
fi
if [ "$MAX" -gt 0 ] && [ "$db" -gt "$MAX" ]; then
	echo "alive but OLD (ticks $db > $MAX): this is not a fresh boot"
	exit 1
fi
echo "alive $db (was $da)"
exit 0
