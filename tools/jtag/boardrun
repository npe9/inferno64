#!/bin/sh
#
# Run ONE command line on the board through the remote-command poller, wait
# for it to finish, and leave board.cmd harmless.
#
#	sh tools/jtag/boardrun 'drawink'
#	sh tools/jtag/boardrun -t 600 'wm/gfxstress mask 4'
#	BIND=0 sh tools/jtag/boardrun 'cat /dev/sysname'   # no /dis or #K bind
#
# The console on this desk is deaf, so the poller is how the board is driven:
# it reads os/inferno/raspi3b/board.cmd and runs what it finds.  Everything
# here exists because driving it by hand went wrong in two specific ways.
#
# A UNIQUE TOKEN PER RUN, not a fixed marker.  Completion is detected by
# echoing BR-<pid>-<epoch> at the end and waiting for that exact string, so
# an earlier run's output cannot satisfy this one's wait.  board.out is a
# rolling `screen -X hardcopy` snapshot rather than an accumulating log, which
# makes a non-unique marker look fine until the day it does not.
#
# AND board.cmd IS RESET ON EVERY EXIT, including the failures and the
# interrupts.  THE POLLER RE-RUNS WHATEVER IT FINDS: a `wm/gfxstress mask 4`
# left in place executed a second time, which was visible only as a changed
# elapsed-time figure (ms=4280 then ms=4210) on an otherwise identical line.
# The repeat is not the problem; board.cmd being a SINGLE SHARED CHANNEL is.
# kinstall.sh's probe queued behind that cycling workload and its log sat
# quiet in "pre-flight -- booting the candidate" for minutes, looking stuck
# when it was only waiting its turn.  kinstall.sh gets this right for itself
# ("Leave board.cmd harmless on every exit") and this matches it.
#
# It does NOT touch JTAG and does NOT open the serial device -- screen owns
# that, and a second opener wedges the adapter until someone unplugs it.
#
# AND IT WARNS WHEN THE COMMAND BACKGROUNDS SOMETHING, because `wm/X &' inside a
# boardrun OUTLIVES THE BOARDRUN.  This resets board.cmd and exits; the process
# it started keeps drawing into the framebuffer indefinitely, nothing here knows
# to clean it up, and nothing in the NEXT measurement knows it is there.
#
# That cost two wrong readings in ten minutes, the second after the first had
# been written up: drawink reported "FAIL box outside: 12126 of 38080 pixels ...
# within 160,32 427,119" which was a leftover wm/bounce animating under it, and
# then a wm/clock measurement came out at 910839 lines in six seconds -- 151806
# a second, for a clock that updates once a second -- which was the same
# leftover bounce and would have been published as a 44x same-client
# disagreement with a peer's host figure.
#
# A warning rather than a kill, deliberately: this cannot tell which processes
# are the caller's, and killing by guess on a board that is hard to recover is
# worse than saying so.  The actionable advice is in the message, because the
# remedy is a reboot and only the caller knows whether the next thing they do
# is a framebuffer measurement.
#
set -u
HERE=`cd \`dirname "$0"\` && pwd`
ROOT=`cd "$HERE/../.." && pwd`
CMD=$ROOT/os/inferno/raspi3b/board.cmd
OUT=$ROOT/os/inferno/raspi3b/board.out
WAIT=300
BIND=${BIND:-1}

while [ $# -gt 0 ]; do
	case $1 in
	-t)	WAIT=$2; shift 2;;
	--)	shift; break;;
	-*)	echo "boardrun: unknown option $1" >&2; exit 2;;
	*)	break;;
	esac
done
[ $# -ge 1 ] || { echo "usage: boardrun [-t seconds] 'command line'" >&2; exit 2; }

#
# ONLY RESET board.cmd IF IT IS STILL THIS RUN'S COMMAND.  The first version
# reset it unconditionally, and that turned the shared channel into a way for
# one run to break another: a boardrun killed at second 0 ran its trap at
# second 32, by which time a NEW boardrun had written its own command, and the
# dying one overwrote it with idle.  The board then ran the idle, the new run
# polled 360 seconds for a token the board had never been asked to print, and
# the console showed an RCMD that nothing in the session had issued.
#
# The token is already unique per run, so the guard needs nothing new: grep for
# it in the file before writing.  It makes the reset a compare-and-clear rather
# than a blind write, which is what a shared channel needs.
#
idle() {
	#
	# NO TOKEN MEANS THIS RUN NEVER WROTE board.cmd, so it has nothing to
	# clear and must not write.  The first version fell through to the
	# write in that case, which turned every early exit -- the usage
	# error, and now the consctl refusal below -- into the very
	# cross-run clobber the compare-and-clear was added to prevent: an
	# exit before TOK is set would overwrite a CONCURRENT run's command
	# with idle, and that run would then poll for a token the board was
	# never asked to print.
	#
	if [ -z "${TOK:-}" ]; then
		return
	fi
	# The file holds the SPLIT form ('BR'^'-pid-time'), not $TOK, so this
	# looks for the part that survives the split.  Checked: a grep for
	# "$TOK" here matched nothing, so idle() thought another run had taken
	# the channel and never reset it.
	if ! grep -q "${TOK#BR-}" "$CMD" 2>/dev/null; then
		return
	fi
	printf 'load std; echo BR-IDLE-%s\n' "`date +%s`" > "$CMD"
}
trap 'idle' 0 1 2 15

#
# PREFIXED "boardrun-note:" AND NOT "boardrun:", because the latter collides
# with the failure marker.  Every waiter in this directory's workflow keys on
# "boardrun:" to detect the timeout path, so a NOTE beginning "boardrun:" made
#
#	until grep -qaE 'MY-MARKER|boardrun:' log
#
# match instantly on a successful run, and the log was then read while the
# command was still executing.  A guard that collides with the signal it was
# added to protect.
#
#
# AND IT REFUSES A WRITE TO /dev/consctl, which is not a warning because the
# cost is not a wrong number but a DEAD POLLER.  Measured three times on this
# board: a command containing
#
#	echo rawoff > /dev/consctl
#
# prints everything up to that point and nothing after it, the token never
# appears, and NO LATER boardrun is picked up at all -- board.out keeps showing
# the old RCMD line until the board is rebooted.  Recovery is a reboot, which
# is four minutes, and the first two times it was read as a styx wedge and
# written into the plan as one.
#
# WHAT IT IS NOT: the obvious reading, that conswrite's rawon/rawoff arms block
# on kbd's QLock while consread holds it across a blocking qread of a console
# nobody can type at, IS WRONG.  Read over JTAG with the target halted, the
# QLock is free: head, tail, locked and owner all read ZERO, so the write is not
# blocked on it.  Where the poller actually stops is NOT diagnosed, and this
# refusal does not pretend to be a fix.
#
# AND ONE WORD IN THE FIRST VERSION OF THAT CLAIM WAS ASSERTED, NOT MEASURED.
# It also said "and kbd.ctl 0", concluding that the open, write and close had
# all completed.  The dump covered kbd+0x00..0x4f, and the offsets -- taken
# from the compiler rather than guessed, via
# `(int)(uintptr)&((QLock*)0)->owner' through 7c -S with the kernel's own
# flags -- are sizeof(Lock) 48, sizeof(QLock) 88, head 48, tail 56, locked 64,
# owner 72, opc 80, kbd.ctl 92.  So the four QLock words were inside the dump
# and kbd.ctl was not.  The board has since been rebooted, so the wedged state
# is gone and it cannot be measured now.  The conclusion stands on the four
# words that were read and not on the fifth.
#
# The tell was there and I read past it: the only non-zero word in the whole
# structure sat at offset 16 and resolved to qlock+140, while Lock.pc at offset
# 8 read zero -- a field that did not fit the layout I was assuming.  A field
# that does not fit the layout is a reason to go and get the layout.
#
# THE COMMANDS THAT LOOK LIKE THEY BELONG THERE ARE ON /dev/sysctl.
# conswrite dispatches its cmdtab under Qsysctl, not Qconsctl: sched,
# procdump, ilock, signfault, panic, reboot.  /dev/consctl takes rawon and
# rawoff only and silently ignores anything else, so writing a ctl word there
# does nothing useful even when it does not wedge.
#
case "$1" in
*consctl*)
	echo "boardrun: REFUSING -- this command writes to /dev/consctl," >&2
	echo "boardrun:   which stops the remote-command poller dead on this" >&2
	echo "boardrun:   board (measured 3 times; recovery is a reboot)." >&2
	echo "boardrun:   The ctl commands are on /dev/sysctl: sched, procdump," >&2
	echo "boardrun:   ilock, signfault.  /dev/consctl takes only rawon and" >&2
	echo "boardrun:   rawoff and ignores everything else." >&2
	echo "boardrun:   Override with BOARDRUN_CONSCTL=1 if you mean it." >&2
	[ "${BOARDRUN_CONSCTL:-0}" = 1 ] || exit 2
	;;
esac

case "$1" in
*'&'*)
	echo "boardrun-note: this command backgrounds something with '&', and" >&2
	echo "boardrun-note:   that process OUTLIVES this boardrun.  If the next" >&2
	echo "boardrun-note:   thing you measure reads the framebuffer (drawink," >&2
	echo "boardrun-note:   SCREEN fbloop, the damage counters), reboot first:" >&2
	echo "boardrun-note:     sh tools/jtag/boot.sh" >&2
	;;
esac

TOK=BR-$$-`date +%s`
#
# /icons IS BOUND TOO, because the kernel root creates it EMPTY and nothing
# fills it.  os/inferno/raspi3b/raspi3b's root section has "/icons /", a bare
# mount point, and libtk/parse.c:751 resolves a bare bitmap name as
# "/icons/tk/%s" -- so every Tk client printed
#
#	wmclient: tk error !failed to load bitmap on
#	  'button .Wm_t.e -bitmap exit.bit ...'
#
# for its titlebar buttons, all session, on every launch.  The files exist in
# the worktree (icons/tk/exit.bit, icons/tk/help.bit) and the styx export is
# "export /" of the worktree, so they are reachable at /n/remote/icons by the
# same mount that already serves /dis.
#
# NOTE WHAT MADE THIS HARD TO SEE: `ls /icons' SUCCEEDS.  The directory is
# there and is empty, so a probe for "does /icons exist" passes while the
# question is "are the bitmaps there".  I ran exactly that probe earlier and
# took ICONS-OK for an answer.
#
if [ "$BIND" = 1 ]; then
	PRE="load std; bind /n/remote/dis /dis; bind /n/remote/icons /icons; bind -a '#K' /dev; "
else
	PRE="load std; "
fi
#
# THE TOKEN IS ECHOED IN TWO PIECES, so the command line that the poller prints
# back does NOT contain the string the wait is looking for.
#
# Why that matters: the wait used to anchor on "^$TOK", because the poller
# echoes the whole command and the command contains "echo BR-...", so an
# unanchored match would have fired the instant the command was issued.  But
# anchoring means a token that does NOT start a line is missed -- and this
# console interleaves output without newlines, as the kernel prints from
# interrupt context into the middle of whatever a Dis process is writing.  A
# peer found exactly this in their own log counting (grep -c '^panic' missed a
# panic for four weeks because it did not begin a line) and it cost them an
# observation.
#
# So neither anchored nor unanchored is right against one token.  Splitting it
# makes them both unnecessary: sh concatenates with ^, so the board OUTPUT is
# BR-<pid>-<time> while the echoed COMMAND reads 'BR'^'-<pid>-<time>', which
# does not contain it.  The wait can then match anywhere on a line.
#
printf "%s%s; echo 'BR'^'-%s'\n" "$PRE" "$1" "${TOK#BR-}" > "$CMD"

n=0
lim=`expr $WAIT / 10`
while [ $n -le $lim ]; do
	if LC_ALL=C tr -cd '\11\12\40-\176' < "$OUT" 2>/dev/null |
	    grep -q "$TOK"; then
		LC_ALL=C tr -cd '\11\12\40-\176' < "$OUT" | grep -vE '^RCMD'
		exit 0
	fi
	sleep 10
	n=`expr $n + 1`
done

#
# Reported as a timeout rather than as a board failure, because the two are
# different and this cannot tell them apart: the poller may be busy with a
# previous command, the board may be slow, or it may be wedged.  What it can
# say is that the token did not appear, and it leaves board.cmd idle so
# whatever runs next is not queued behind this.
#
echo "boardrun: $TOK did not appear within ${WAIT}s" >&2
echo "boardrun: console tail follows; the board may be busy, slow or wedged" >&2
LC_ALL=C tr -cd '\11\12\40-\176' < "$OUT" 2>/dev/null | tail -12 >&2
exit 1
