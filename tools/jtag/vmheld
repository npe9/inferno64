#!/bin/sh
#
# Who is holding the Dis VM?  Read off a WEDGED board, over JTAG.
#
#	sh tools/jtag/vmheld
#
# WHY THIS EXISTS.  doc/open-issues-plan.ms item H4 caught the board
# wedged with dozens of Dis processes queued for the interpreter and the
# watchdog reporting "vmq waiting, runhd ready" -- work queued and nobody
# finishing.  The question is WHO HAD THE TOKEN.
#
# It reports two different things, and keeping them apart is the point:
#
#   the TOKEN, from port/dis.c's vmholderpid/vmholdertext/vmholdbeat,
#	which acquire(), release() and iyield() maintain.  This is the
#	actual answer, and comparing vmholdbeat with disbeat says whether
#	the holder has made any progress since taking it.
#
#   raspi3b's vmheldticks/maxvmheld/heldkpc/helddispc, which
#	livelockcheck() updates every tick.  THESE DO NOT MEASURE THE
#	TOKEN, despite the name: livelockcheck keys on the current running
#	process of the processor it runs on and resets whenever that
#	changes, so on four cores it is the longest single-process run on
#	cpu0.  I read 127 ticks there as "nobody held the VM for long" and
#	that did not follow.  They are still worth having -- a Dis program
#	that will not yield is what they were built for.
#
# It also PRINTS them, as VMHELD lines -- and that is why this tool is
# needed rather than the print.  When the board wedged, a process dump
# flooded the kernel's ring and wrapped it: 111 lines, every one a
# process entry, with the trigger and any VMHELD above them gone.  A
# print can be crowded out of a ring; a variable cannot.
#
# NO KERNEL CHANGE.  The numbers were already there; only a reader was
# missing.  That is worth saying because the first instinct was to make
# the ring bigger, which would have been a kernel build, an install, a
# reboot, and a wait for the fault to happen again.
#
# AND IT CHECKS THE KERNEL FIRST, like where(1) beside it.  Resolving an
# address against a kernel built from different sources is how item C1
# wasted three sessions, and it nearly happened again today: the host
# kernel had been rebuilt while the board ran, so `where` refused to name
# anything and the symbols had to come from a kernel rebuilt at the exact
# commit the card holds.  This refuses in the same way rather than
# printing confident nonsense.
#
set -u
HERE=`cd \`dirname "$0"\` && pwd`
ROOT=`cd "$HERE/../.." && pwd`
CONF=${CONF:-raspi3b}
KERNEL=${KERNEL:-$ROOT/os/inferno/$CONF/i$CONF}
IMG=${IMG:-$ROOT/os/inferno/$CONF/kernel8.img}
ADAPTER=${ADAPTER:-interface/ftdi/olimex-arm-usb-tiny-h.cfg}

if [ ! -r "$KERNEL" ]; then
	echo "vmheld: no kernel at $KERNEL" >&2
	exit 1
fi

sym() {	# $1 symbol name -> hex address, empty if absent
	python3 "$HERE/ksyms" "$KERNEL" -g "$1" 2>/dev/null |
		awk -v n="$1" '$3==n{print $1; exit}'
}

KDADDR=`sym kerndate`
A_TICKS=`sym vmheldticks`
A_MAX=`sym maxvmheld`
A_KPC=`sym heldkpc`
A_DISPC=`sym helddispc`
A_LLT=`sym livelockticks`
A_WDOG=`sym bootwdog`
A_HPID=`sym vmholderpid`
A_HTEXT=`sym vmholdertext`
A_HBEAT=`sym vmholdbeat`
A_HN=`sym vmholdn`
A_BEAT=`sym disbeat`
A_PFULL=`sym npollfull`
A_PCHAR=`sym npollchar`
A_REACH=`sym disreachcount`
#
# THE delprog CLOSE-WINDOW COUNTERS, because the printed lines are capped
# at EIGHT PER BOOT and the counters are not.
#
# dis.c prints `opening window while pid N's was still open' only while
# disraceoverlaps <= 8, and devprog.c prints `touched pid N live inside
# its own delprog close window' only while dishitcount < 8.  Counting the
# printed lines across boots therefore measures the CAP, not the race: I
# aggregated them over fourteen boots, got 118, and nearly reported it as
# an overlap count when it is 8 per boot.
#
# And the detector is SINGLE-SLOT, which is why the hit count is a floor:
# disracepid holds one pid, so a second overlapping delprog overwrites the
# first's, and whichever finishes first sets it back to -1 -- so during an
# overlap the still-open window is both unwatched and reported closed.
#
A_DRWIN=`sym disracewindows`
A_DROVL=`sym disraceoverlaps`
A_DRGC=`sym disracehits`
A_DRHIT=`sym dishitcount`
A_NHELD=`sym nvmheld`
A_GCSW=`sym gcsweeps`
A_GCBRK=`sym gcbroken`
A_GCBAD=`sym gcbadptr`	# the 6c587face guard's own counter
A_GCBADC=`sym gcbadcolor`	# and the colour tier beside it
A_GCOOA=`sym gcoutofarena`	# cursor outside the arena being swept
#
# The reader on the path that CREATES a chain.  gcbadptr above counts words
# markheap() refused and has always read zero, so an implausible word is not
# what breaks the sweep; these count poolfree() coalescing the sweep cursor
# away.  Read here in the same commit as the counters, because the line above
# is a standing reminder of what happens otherwise.
A_GCPFWD=`sym gcptrfwd`
A_GCPBACK=`sym gcptrback`
A_GCPFWDGC=`sym gcptrfwdgc`
A_GCPBACKGC=`sym gcptrbackgc`
A_GCSTOK=`sym gcstaleok`
A_GCSTBRK=`sym gcstalebrk`
A_GCSTIDLE=`sym gcstaleidle`
A_GCPFIX=`sym gcptrfixed`
A_GCNBRK=`sym gcnbroke`
A_GCBRKM=`sym gcbrokemagic`
A_GCNSTL=`sym gcnstale`
A_GCSTLM=`sym gcstalemagic`
A_GCSTLT=`sym gcstaletail`
A_GCSTLP=`sym gcstaleptr`
A_GCBUSY=`sym gcbusy`
A_GCIDLE=`sym gcidle`
A_PANICKING=`sym panicking`
A_PANICMSG=`sym panicmsg`

for v in A_TICKS A_MAX A_KPC A_DISPC; do
	eval a=\$$v
	if [ -z "$a" ]; then
		echo "vmheld: $KERNEL has no $v symbol -- wrong kernel?" >&2
		exit 1
	fi
done

#
# What the image says the stamp should be, read at kerndate's address.
#
WANT=
if [ -n "$KDADDR" ] && [ -r "$IMG" ]; then
	WANT=`python3 - "$IMG" "$KDADDR" <<'PYEOF'
import sys
img, addr = sys.argv[1], int(sys.argv[2], 16)
d = open(img, "rb").read()
o = addr - 0x80000
print(int.from_bytes(d[o:o+4], "little") if 0 <= o <= len(d)-4 else "")
PYEOF`
fi

TMP=${TMPDIR:-/tmp}/jtag-vmheld.$$
trap 'rm -f "$TMP"' 0 1 2 15

#
# mdw, one read per variable, labelled so the output can be parsed
# without depending on openocd's ordering.  ulong is 4 bytes here and
# uintptr is 8, so the pcs take two words.
#
( cd "$ROOT" && timeout 90 openocd -f "$ADAPTER" -f tools/jtag/raspi3b.cfg \
	-c "init; halt; targets bcm2837.cpu0" \
	-c "echo \"VMHELD-STAMP\"; mdw ${KDADDR:-0} 1" \
	-c "echo \"VMHELD-TICKS\"; mdw $A_TICKS 1" \
	-c "echo \"VMHELD-MAX\"; mdw $A_MAX 1" \
	-c "echo \"VMHELD-KPC\"; mdw $A_KPC 2" \
	-c "echo \"VMHELD-DISPC\"; mdw $A_DISPC 2" \
	-c "echo \"VMHELD-LLT\"; mdw ${A_LLT:-0} 1" \
	-c "echo \"VMHELD-WDOG\"; mdw ${A_WDOG:-0} 1" \
	-c "echo \"VMHELD-HPID\"; mdw ${A_HPID:-0} 1" \
	-c "echo \"VMHELD-HBEAT\"; mdw ${A_HBEAT:-0} 1" \
	-c "echo \"VMHELD-HN\"; mdw ${A_HN:-0} 1" \
	-c "echo \"VMHELD-BEAT\"; mdw ${A_BEAT:-0} 1" \
	-c "echo \"VMHELD-PFULL\"; mdw ${A_PFULL:-0} 1" \
	-c "echo \"VMHELD-PCHAR\"; mdw ${A_PCHAR:-0} 1" \
	-c "echo \"VMHELD-REACH\"; mdw ${A_REACH:-0} 1" \
	-c "echo \"VMHELD-DRWIN\"; mdw ${A_DRWIN:-0} 1" \
	-c "echo \"VMHELD-DROVL\"; mdw ${A_DROVL:-0} 1" \
	-c "echo \"VMHELD-DRGC\"; mdw ${A_DRGC:-0} 1" \
	-c "echo \"VMHELD-DRHIT\"; mdw ${A_DRHIT:-0} 1" \
	-c "echo \"VMHELD-NHELD\"; mdw ${A_NHELD:-0} 1" \
	-c "echo \"VMHELD-GCSW\"; mdw ${A_GCSW:-0} 1" \
	-c "echo \"VMHELD-GCBRK\"; mdw ${A_GCBRK:-0} 1" \
	-c "echo \"VMHELD-GCBAD\"; mdw ${A_GCBAD:-0} 1" \
	-c "echo \"VMHELD-GCBADC\"; mdw ${A_GCBADC:-0} 1" \
	-c "echo \"VMHELD-GCOOA\"; mdw ${A_GCOOA:-0} 1" \
	-c "echo \"VMHELD-GCPFWD\"; mdw ${A_GCPFWD:-0} 1" \
	-c "echo \"VMHELD-GCPBACK\"; mdw ${A_GCPBACK:-0} 1" \
	-c "echo \"VMHELD-GCPFWDGC\"; mdw ${A_GCPFWDGC:-0} 1" \
	-c "echo \"VMHELD-GCPBACKGC\"; mdw ${A_GCPBACKGC:-0} 1" \
	-c "echo \"VMHELD-GCSTOK\"; mdw ${A_GCSTOK:-0} 1" \
	-c "echo \"VMHELD-GCSTBRK\"; mdw ${A_GCSTBRK:-0} 1" \
	-c "echo \"VMHELD-GCSTIDLE\"; mdw ${A_GCSTIDLE:-0} 1" \
	-c "echo \"VMHELD-GCPFIX\"; mdw ${A_GCPFIX:-0} 1" \
	-c "echo \"VMHELD-GCNBRK\"; mdw ${A_GCNBRK:-0} 1" \
	-c "echo \"VMHELD-GCBRKM\"; mdw ${A_GCBRKM:-0} 8" \
	-c "echo \"VMHELD-GCNSTL\"; mdw ${A_GCNSTL:-0} 1" \
	-c "echo \"VMHELD-GCSTLM\"; mdw ${A_GCSTLM:-0} 8" \
	-c "echo \"VMHELD-GCSTLT\"; mdw ${A_GCSTLT:-0} 8" \
	-c "echo \"VMHELD-GCSTLP\"; mdd ${A_GCSTLP:-0} 8" \
	-c "echo \"VMHELD-GCBUSY\"; mdw ${A_GCBUSY:-0} 2" \
	-c "echo \"VMHELD-GCIDLE\"; mdw ${A_GCIDLE:-0} 2" \
	-c "echo \"VMHELD-PANICKING\"; mdw ${A_PANICKING:-0} 1" \
	-c "echo \"VMHELD-PANICMSG\"; mdb ${A_PANICMSG:-0} 160" \
	-c "echo \"VMHELD-HTEXT\"; mdb ${A_HTEXT:-0} 16" \
	-c "resume; exit" ) >"$TMP" 2>&1

if ! grep -aq VMHELD-TICKS "$TMP"; then
	echo "vmheld: the debugger did not answer; is the adapter attached?" >&2
	grep -a 'Error' "$TMP" | head -3 >&2
	exit 1
fi

val() {	# $1 label -> the first word printed after it
	awk -v l="$1" '
		$0 ~ l {seen=1; next}
		seen && /^0x/ {sub(/^[^:]*: */, ""); print $1; exit}
	' "$TMP"
}
words() {	# $1 label -> every word printed under it, one line
	awk -v l="$1" '
		$0 ~ l {seen=1; next}
		seen && /^0x/ {sub(/^[^:]*: */, ""); print; next}
		seen {exit}
	' "$TMP"
}
val2() {	# $1 label -> two words, low then high, as one 64-bit hex
	awk -v l="$1" '
		$0 ~ l {seen=1; next}
		seen && /^0x/ {sub(/^[^:]*: */, ""); print $1, $2; exit}
	' "$TMP"
}

stamp=`val VMHELD-STAMP`
ticks=`val VMHELD-TICKS`
max=`val VMHELD-MAX`
llt=`val VMHELD-LLT`
wdog=`val VMHELD-WDOG`
kpc=`val2 VMHELD-KPC`
dispc=`val2 VMHELD-DISPC`

dec() { python3 -c "print(int('$1',16))" 2>/dev/null || echo "?"; }
join64() {	# low high -> 0x<64-bit>
	set -- $1
	python3 -c "print(hex(int('$2',16)<<32 | int('$1',16)))" 2>/dev/null
}

if [ -n "$WANT" ] && [ -n "$stamp" ]; then
	gotd=`dec "$stamp"`
	if [ "$gotd" != "$WANT" ]; then
		echo "vmheld: $KERNEL does NOT describe the running kernel" >&2
		echo "vmheld:   $IMG says $WANT; the board read $gotd at that" >&2
		echo "vmheld:   image's kerndate address, which is NOT a stamp" >&2
		echo "vmheld:   -- see below." >&2
		echo "vmheld: the addresses below would be read from the wrong" >&2
		echo "vmheld: places.  Rebuild from the commit the card holds." >&2
		echo "vmheld:" >&2
		echo "vmheld: WHY THE NUMBER IS MEANINGLESS, not merely wrong." >&2
		echo "vmheld: KDADDR comes from \`sym kerndate' on the TREE's image," >&2
		echo "vmheld: and mdw then reads that address in whatever kernel is" >&2
		echo "vmheld: actually running.  kerndate moves between builds -- in" >&2
		echo "vmheld: one afternoon it sat at 0x1e7318, 0x1e7308 and" >&2
		echo "vmheld: 0x1ec308 in three kernels of the same board, 0x5000" >&2
		echo "vmheld: apart at the extremes -- so when the images differ the" >&2
		echo "vmheld: read lands on an unrelated variable.  Two such reads" >&2
		echo "vmheld: were 2738592 and 4099408436, and 2738592 is 2.74" >&2
		echo "vmheld: seconds as microseconds, i.e. plausibly a boot-time" >&2
		echo "vmheld: counter.  Do not try to decode it: it is a different" >&2
		echo "vmheld: variable, not a corrupted stamp." >&2
		exit 2
	fi
	echo "vmheld: kernel matches the board (stamp $gotd)"
fi

echo "vmheld: the CURRENT hold is `dec $ticks` ticks; the longest since boot is `dec $max` ticks"
if [ -n "$llt" ]; then
	echo "vmheld: livelockticks is `dec $llt`, bootwdog is `dec $wdog`"
	if [ "`dec $wdog`" = 0 ]; then
		echo "vmheld:   bootwdog 0 means diswdog() never arms the hardware"
		echo "vmheld:   watchdog, so a held VM wedges the board for ever"
	fi
fi

#
# THE TOKEN ITSELF, which is what the name of this tool suggests and
# what vmheldticks above does NOT measure: livelockcheck() keys on the
# running process of ONE processor and resets whenever that changes, so
# on four cores its figure is the longest single-process run on cpu0.
# Reading 127 ticks there as "nobody held the VM for long" does not
# follow, and I made exactly that mistake.
#
if [ -n "$A_HPID" ]; then
	hpid=`val VMHELD-HPID`
	hbeat=`val VMHELD-HBEAT`
	hn=`val VMHELD-HN`
	beat=`val VMHELD-BEAT`
	htext=`awk '/VMHELD-HTEXT/{s=1;next} s&&/^0x/{sub(/^[^:]*: */,"");print;exit}' "$TMP" |
		python3 -c "
import sys
b=bytes(int(x,16) for x in sys.stdin.read().split() if len(x)==2)
print(b.split(b'\0')[0].decode('ascii','replace'))" 2>/dev/null`
	if [ "`dec $hpid`" = 0 ]; then
		echo "vmheld: the interpreter token is FREE (no holder)"
	else
		echo "vmheld: the token is held by pid `dec $hpid` ($htext)"
		if [ "`dec $hbeat`" = "`dec $beat`" ]; then
			echo "vmheld:   and disbeat has NOT moved since it took it"
			echo "vmheld:   (`dec $beat`) -- the holder is stuck, not busy"
		else
			echo "vmheld:   disbeat has moved since: `dec $hbeat` -> `dec $beat`"
		fi
	fi
	echo "vmheld: handovers since boot `dec $hn`, disbeat `dec $beat`"
fi

#
# The console drain, which clock.c bounds at 64 characters a call.  If a
# wedge shows npollfull climbing, the drain loop was being trapped by a
# stuck RX line and the OLD unbounded loop would have spun there for
# ever; if npollchar is 0, the console delivered nothing and the loop is
# not involved.  Two numbers instead of inferring from pc samples.
#
if [ -n "$A_PFULL" ]; then
	pfull=`val VMHELD-PFULL`
	pchar=`val VMHELD-PCHAR`
	echo "vmheld: console drain: `dec $pchar` chars taken, `dec $pfull` calls hit the 64 bound"
	if [ "`dec $pfull`" != 0 ]; then
		echo "vmheld:   a non-zero bound count means the OLD unbounded"
		echo "vmheld:   drain would have been trapped here"
	fi
fi

if [ -n "$A_REACH" ]; then
	echo "vmheld: progpid() reached `dec \`val VMHELD-REACH\`` times (devprog's race window)"
fi

if [ -n "$A_DRWIN" ]; then
	W=`dec \`val VMHELD-DRWIN\``
	O=`dec \`val VMHELD-DROVL\``
	G=`dec \`val VMHELD-DRGC\``
	H=`dec \`val VMHELD-DRHIT\``
	echo "vmheld: delprog close windows $W, of them OVERLAPPING $O;" \
		"gc-during-window $G, /prog touched a closing pid $H"
	#
	# The hit count is a FLOOR and the line says so, because disracepid is
	# one slot: an overlapping delprog overwrites the pid being watched and
	# the first to finish clears it, so during an overlap the still-open
	# window is neither watched nor reported open.  With $O overlaps the
	# detector was blind for part of its own run.
	#
	if [ "${O:-0}" -gt 0 ]; then
		echo "vmheld:   $H is a FLOOR -- disracepid is a single slot and" \
			"$O windows overlapped, so some went unwatched"
	fi
fi

#
# The GARBAGE COLLECTOR, which is where the long holds turned out to be:
# rungc+128 and rungc+632 appeared as the last kernel pc of holds lasting
# 53 to 91 ticks.  nvmheld counts ALL of them (the console print stops at
# sixteen, which hid the rate), and gcbusy/gcidle say how much collecting
# happened with work pending versus on an idle machine.
#
#
# Plain variables, not nested backticks.  The first version wrote
# `dec \`val X\`` inside a double-quoted echo and the two levels of
# substitution did not survive: gc busy and gc idle printed as empty
# strings, which reads as "zero" and is not.
#
#
# A PANIC FIRST, because it changes what everything else means: a
# panicking process never releases the interpreter token, so the wedge
# watchdog fires and its dump crowds the panic message out of the ring.
# The message is kept in a variable for exactly that reason.
#
if [ -n "$A_PANICKING" ]; then
	pk=`val VMHELD-PANICKING`
	if [ "`dec $pk`" != 0 ]; then
		pmsg=`awk '/VMHELD-PANICMSG/{s=1;next} s&&/^0x/{sub(/^[^:]*: */,"");printf "%s ",$0} s&&!/^0x/&&NR>1{exit}' "$TMP" |
			python3 -c "
import sys
b=bytes(int(x,16) for x in sys.stdin.read().split() if len(x)==2)
print(b.split(b'\0')[0].decode('ascii','replace'))" 2>/dev/null`
		echo "vmheld: *** A PANIC IS IN PROGRESS ***"
		echo "vmheld:   $pmsg"
		echo "vmheld:   so a 'wedge' here is the panicking process never"
		echo "vmheld:   releasing the interpreter token, not a scheduler bug"
	fi
fi

if [ -n "$A_NHELD" ]; then
	nheld=`val VMHELD-NHELD`
	echo "vmheld: long VM holds since boot: `dec $nheld`"
fi
if [ -n "$A_GCSW" ]; then
	gcsw=`val VMHELD-GCSW`
	gcbrk=`val VMHELD-GCBRK`
	gcbusy=`val2 VMHELD-GCBUSY`
	gcidle=`val2 VMHELD-GCIDLE`
	gcbad=`val VMHELD-GCBAD`
	echo "vmheld: gc sweeps `dec $gcsw`, chains found BROKEN `dec $gcbrk`"
	#
	# The 6c587face guard's own counter: words markheap() refused BEFORE
	# Setmark wrote through them.  It was in the symbol table and read by
	# NOTHING -- not here, not devcons's GC-COUNTS -- so the fix had a
	# counter and no reader, which is the shape this tool exists to avoid.
	#
	echo "vmheld: bad pointers REJECTED before Setmark `dec $gcbad`"
	#
	# The second tier, a peer's check: a word that PASSES the test above --
	# aligned, above 0x1000 -- but points at a header whose color is
	# outside 0..3, so it is not a heap object.  gcbadptr tests the word;
	# this tests what the word points at, which is the case H4 recorded as
	# undetectable by construction.
	#
	if [ -n "$A_GCBADC" ]; then
		gbc=`dec \`val VMHELD-GCBADC\``
		echo "vmheld: bad COLOURS rejected before Setmark $gbc"
		#
		# A cursor outside [base, limit) of the arena being swept.  The
		# walk is bounded ABOVE by the loop and was bounded below by
		# nothing, so such a cursor used to walk forward dereferencing
		# whatever it landed on.  Nonzero here means the bound earned
		# itself; it also bumps broken-chains, so the two are not
		# independent.
		#
		if [ -n "$A_GCOOA" ]; then
			ooa=`dec \`val VMHELD-GCOOA\``
			echo "vmheld: cursor OUTSIDE the arena being swept $ooa"
			if [ "$ooa" != 0 ]; then
				echo "vmheld:   NONZERO: a cursor landed outside"
				echo "vmheld:   [base,limit) -- a corrupt size, or"
				echo "vmheld:   on a multi-context kernel a free in"
				echo "vmheld:   another arena.  Each one would have"
				echo "vmheld:   been an unbounded walk before."
			fi
		fi
		if [ "$gbc" != 0 ]; then
			echo "vmheld:   NONZERO: a plausible word pointed at"
			echo "vmheld:   something that is not a heap object, so"
			echo "vmheld:   markheap WAS about to write through it."
		fi
	fi
	echo "vmheld: gc busy `join64 "$gcbusy"`, gc idle `join64 "$gcidle"`"
	if [ "`dec $gcbrk`" != 0 ]; then
		echo "vmheld:   a broken chain makes gcsweep abandon its sweep"
		echo "vmheld:   (base = nil, return) -- see libinterp/gc.c"
	fi
	#
	# What poolfree() saw.  THESE AND gcbrk ARE THE WHOLE TEST: if the
	# sweep cursor is being coalesced away then fwd+back should account
	# for the breaks, and the magic words below should all be 0 -- a
	# coalesce zeroes the swallowed header and leaves its size alone.
	# stale-ok is the tier that would matter: a swallowed cursor whose
	# interior word still passed okbhdr(), so the sweep resumed from a
	# position nothing vouched for.  Expected zero.
	#
	if [ -n "$A_GCPFWD" ]; then
		pf=`dec \`val VMHELD-GCPFWD\``
		pb=`dec \`val VMHELD-GCPBACK\``
		pfg=`dec \`val VMHELD-GCPFWDGC\``
		pbg=`dec \`val VMHELD-GCPBACKGC\``
		so=`dec \`val VMHELD-GCSTOK\``
		sb=`dec \`val VMHELD-GCSTBRK\``
		si=`dec \`val VMHELD-GCSTIDLE\``
		#
		# SUBTRACT THE SWEEPER'S OWN BEFORE READING THIS.  The sweep
		# loop frees the block AT the cursor and advances with
		# ptr = B2NB(ptr) on the next line, so its own swallows are
		# repaired by construction.  The first reading here was "252
		# backward" on a boot with zero broken chains, and all 252
		# were the collector's.
		#
		echo "vmheld: sweep cursor swallowed by a coalesce:" \
			"forward $pf (gc's own $pfg), backward $pb (gc's own $pbg)"
		#
		# $(( )) and not expr: BSD expr EXITS 1 WHEN THE RESULT IS 0,
		# so `expr 0 - 0 || echo ?' printed "0" and then ran the
		# fallback -- and `?' is a glob, which the shell expanded
		# against the worktree root to the directory `n'.  The reported
		# number came out as "forward 0<newline>n, backward 1".  A
		# number mangled by its own error path, in the one line this
		# whole item turns on.
		#
		mf=$((pf - pfg))
		mb=$((pb - pbg))
		echo "vmheld:   BY THE MUTATOR: forward $mf, backward $mb" \
			"-- only these can outlive a quantum"
		#
		# And what the sweep found when it resumed on one.  These count
		# resumes, not swallows: gcptrstale is a single flag.
		#
		echo "vmheld: resumed on a swallowed cursor: passed okbhdr $so" \
			"(must be 0), broke $sb, not in use $si"
		#
		# With the fixup ON these three are all 0 by construction and
		# this is where the mutator's swallows land instead.  It should
		# be about mf+mb; it will not match exactly, because the three
		# above count RESUMES and this counts swallows.
		#
		if [ -n "$A_GCPFIX" ]; then
			pfx=`dec \`val VMHELD-GCPFIX\``
			echo "vmheld: mutator swallows REPAIRED by poolfree $pfx"
			if [ "$sb" != 0 ] || [ "$so" != 0 ] || [ "$si" != 0 ]; then
				echo "vmheld:   with the fixup in, a nonzero"
				echo "vmheld:   resumed-stale is a REAL finding:"
				echo "vmheld:   something swallows the cursor that"
				echo "vmheld:   poolfree's two joins do not cover."
			fi
		fi
		if [ "$so" != 0 ]; then
			echo "vmheld:   NONZERO: the sweep walked from an"
			echo "vmheld:   interior word that looked like a header."
			echo "vmheld:   That makes the two candidates in H4 one"
			echo "vmheld:   mechanism, not two -- read the plan."
		fi
		if [ -n "$A_GCNBRK" ]; then
			nbw=`val VMHELD-GCNBRK`
			nb=`dec $nbw`
			echo "vmheld: break records kept $nb (cap 8); magic words:"
			words VMHELD-GCBRKM | sed 's/^/vmheld:   /'
			echo "vmheld:   magic 0 == a coalesced-away header, which"
			echo "vmheld:   is what a swallowed cursor reads AT the"
			echo "vmheld:   merge.  A NONZERO one is not another"
			echo "vmheld:   mechanism: the address can be reallocated"
			echo "vmheld:   between the swallow and the resume, and one"
			echo "vmheld:   of these read 0x2 for exactly that reason."
			echo "vmheld:   The provenance test is resumed-stale brk"
			echo "vmheld:   matching BROKEN above, not these words."
		fi
		#
		# The stale-ok rows.  tail 1 = the cursor is a real block again,
		# because poolalloc() split the merged free block and put a
		# header back at that address: benign.  tail 0 = the address is
		# inside a block and the word there only READS like a magic, so
		# the sweep walked from a position nothing vouched for.  tail -1
		# = the bound check refused to run the test.
		#
		if [ -n "$A_GCNSTL" ]; then
			ns=`dec \`val VMHELD-GCNSTL\``
			if [ "$ns" != 0 ]; then
				echo "vmheld: stale-ok rows kept $ns (cap 8):"
				echo "vmheld:   ptr:   `words VMHELD-GCSTLP | tr '\n' ' '`"
				echo "vmheld:   magic: `words VMHELD-GCSTLM | tr '\n' ' '`"
				echo "vmheld:   tail:  `words VMHELD-GCSTLT | tr '\n' ' '`"
				echo "vmheld:   tail 1 benign (a header was put back"
				echo "vmheld:   there); tail 0 is the dangerous tier"
			fi
		fi
	fi
fi

k=`join64 "$kpc"`
d=`join64 "$dispc"`
echo "vmheld: last kernel pc during a hold $k"
[ -n "$k" ] && sh "$ROOT/tools/sym.sh" "$k" "$CONF" 2>&1 | sed 's/^/vmheld:   /'
echo "vmheld: last compiled-Dis pc during a hold $d"
echo "vmheld:   (a Dis pc is in the heap and has no kernel symbol; zero"
echo "vmheld:   means the hold was entirely in kernel C code)"
