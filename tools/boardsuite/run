#!/bin/sh
# boardsuite - boot each board configuration and check what came back.
#
# The suite each kernel runs at boot prints markers.  Reading them off
# a terminal by hand is how two mistakes got into this tree's own
# documentation: a harness that killed QEMU three seconds after the
# last marker missed USB-MOUSE-NONE and reported 38 of 38, and a marker
# regex anchored with a trailing \b missed SD-FS-CREATE-OK when another
# process printed on the same line.  Both looked like board regressions
# and neither was.  This script exists so that class of mistake is made
# once, in one place, where it can be fixed.
#
# It also runs the configurations the default boot does not reach.  Two
# branches of sdhcibcm.c only run under a particular card or a
# particular controller, and until now each was covered by a boot
# someone did by hand and remembered to do.
#
# A configuration that fails is booted a second time, because the timed
# checks lose events under host load and gain none: a busy machine makes
# a healthy board report -FAIL.  A run that passes on the retry says so
# rather than looking like a clean run.
#
# usage:  tools/boardsuite/run [-v] [config ...]
#         tools/boardsuite/run -l        list the configurations
#         tools/boardsuite/run -b        record baselines instead of checking
#         tools/boardsuite/run -b -f     record even a shrinking baseline
#
# QEMU must be the patched build; see tools/qemu-patches/README.  Set
# QEMU= to point at it.

set -e

here=`dirname "$0"`
root=`cd "$here/../.." && pwd`
QEMU=${QEMU:-/Users/npe/src/qemu-v10.1.3/build/qemu-system-aarch64}
work=${BOARDSUITE_WORK:-${TMPDIR:-/tmp}/boardsuite}
timeout=${BOARDSUITE_TIMEOUT:-240}
settle=${BOARDSUITE_SETTLE:-6}		# after the last marker; 3 is too few
verbose=false
record=false
force=false

configs='raspi3b raspi3b-4g raspi4 raspi4-hot virtarm64 sifiveu virt virt32'

# Each configuration: the kernel, the QEMU arguments, the line that
# says the board is done printing, and the evidence lines that make
# this configuration worth running as well as the marker set.
config_kernel() {
	case $1 in
	raspi3b|raspi3b-4g)	echo "$root/os/inferno/raspi3b/iraspi3b";;
	raspi4|raspi4-hot)	echo "$root/os/inferno/raspi4/iraspi4";;
	virtarm64)		echo "$root/os/inferno/virtarm64/ivirtarm64";;
	sifiveu)		echo "$root/os/inferno/sifiveu/isifiveu";;
	virt)			echo "$root/os/inferno/virt/ivirt";;
	virt32)			echo "$root/os/inferno/virt32/ivirt32";;
	esac
}

# The Pi boards need the patched build -- most of what their suites
# drive is not in a stock qemu at all.  The others are ordinary machines
# and want the system qemu for their architecture; nothing in
# tools/qemu-patches touches them.
config_qemu() {
	case $1 in
	raspi*|virtarm64)	echo "$QEMU";;
	sifiveu|virt)		echo "${QEMU_RISCV64:-`command -v qemu-system-riscv64`}";;
	virt32)			echo "${QEMU_RISCV32:-`command -v qemu-system-riscv32`}";;
	esac
}

config_args() {
	case $1 in
	raspi3b)
		echo "-M raspi3b -m 1G -drive file=$work/sd16.img,if=sd,format=raw";;
	raspi3b-4g)
		echo "-M raspi3b -m 1G -drive file=$work/sd4g.img,if=sd,format=raw";;
	raspi4)
		echo "-M raspi4b -m 2G -drive file=$work/sd16b.img,if=sd,format=raw";;
	raspi4-hot)
		echo "-M raspi4b -m 2G -drive file=$work/sd16c.img,if=sd,format=raw -global bcm2838-thermal.temperature=85000";;
	virtarm64)
		echo "-M virt -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-device,drive=blk0 -netdev user,id=n0 -device virtio-net-device,netdev=n0";;
	sifiveu)
		echo "-M sifive_u -bios none";;
	virt)
		echo "-M virt -bios none -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-device,drive=blk0";;
	virt32)
		echo "-M virt -bios none";;
	esac
}

# The line that says a board has finished printing.  This has to be the
# LAST marker, not the last interesting one: on the Pi boards the mouse
# check waits out its own timeout and reports after RASPI*-SH-OK, so
# waiting for the board marker and sleeping a few seconds is a race the
# machine wins whenever it is busy -- it cost this tree a "38 of 38"
# that was really 39, and cost this script a false regression on its
# first day out.  Waiting for the marker that really comes last turns
# that race into a timeout with a name in it.
config_last() {
	case $1 in
	raspi3b|raspi3b-4g)	echo 'USB-MOUSE';;
	raspi4|raspi4-hot)	echo 'USB-MOUSE';;
	virtarm64|virt)		echo 'ROOT-CMDS-OK';;
	sifiveu)		echo 'SIFIVEU-SH-OK';;
	virt32)			echo 'VIRT32-INIT-OK';;
	esac
}

# Lines that must appear.  These are the point of the configuration:
# the marker set alone cannot tell these runs apart, because the marker
# is the same and only what it says differs.
config_evidence() {
	case $1 in
	raspi3b)
		echo 'from firmware clock 1'
		echo 'csd v1';;
	raspi3b-4g)
		echo 'from firmware clock 1'
		echo 'csd v2';;
	raspi4)
		echo 'from capabilities'
		echo 'die 24\.';;
	raspi4-hot)
		echo 'die 85\.';;
	virtarm64|sifiveu|virt|virt32)
		;;
	esac
}

# The card each configuration wants.  Blank is fine: the kfs check
# reams what it is given, and the capacity checks read the card's own
# CSD rather than anything written here.  Separate files per
# configuration so two runs cannot race on one image.
config_card() {
	case $1 in
	raspi3b)	echo "sd16.img 16m";;
	raspi3b-4g)	echo "sd4g.img 4g";;
	raspi4)		echo "sd16b.img 16m";;
	raspi4-hot)	echo "sd16c.img 16m";;
	*)		;;		# no card
	esac
}

usage() {
	echo "usage: $0 [-v] [-l] [-b [-f]] [config ...]" >&2
	exit 1
}

while [ $# -gt 0 ]; do
	case $1 in
	-v)	verbose=true; shift;;
	-b)	record=true; shift;;
	-f)	force=true; shift;;
	-l)	for c in $configs; do echo "$c"; done; exit 0;;
	-*)	usage;;
	*)	break;;
	esac
done

[ $# -gt 0 ] && configs="$*"

if [ ! -x "$QEMU" ]; then
	echo "boardsuite: no patched QEMU at $QEMU (set QEMU=)" >&2
	echo "boardsuite: the Pi configurations need it; see tools/qemu-patches/README" >&2
	exit 2
fi

mkdir -p "$work"

# A blank card of the given size.  Sparse: the 4G one costs nothing
# until something writes to it, and nothing here writes 4G.
makecard() {
	[ -z "$1" ] && return
	f="$work/$1"
	case $2 in
	16m)	bytes=16777216;;
	4g)	bytes=4294967296;;
	*)	echo "boardsuite: unknown card size $2" >&2; exit 2;;
	esac
	if [ -f "$f" ] && [ `wc -c < "$f"` -eq $bytes ]; then
		return
	fi
	rm -f "$f"
	dd if=/dev/zero of="$f" bs=1 count=0 seek=$bytes 2>/dev/null
}

# A FAT16 image, for the one check that wants a filesystem rather than a
# blank card: os/inferno/init/virtinit.b's blkcheck() reads sector 0 of
# /dev/sdF0/data and requires the 0x55AA boot signature.  Writing those
# two bytes into a blank file would satisfy the letter of that and none
# of the point, so this makes a real filesystem.
makefat() {
	f="$work/$1"
	[ -f "$f" ] && return 0
	if command -v hdiutil >/dev/null 2>&1; then
		hdiutil create -size 16m -fs MS-DOS -volname BOARDSUITE \
			-layout NONE -ov "$work/fatmk" >/dev/null 2>&1 || return 1
		mv "$work/fatmk.dmg" "$f" || return 1
		return 0
	fi
	for mk in mkfs.vfat mkfs.fat; do
		if command -v $mk >/dev/null 2>&1; then
			dd if=/dev/zero of="$f" bs=1 count=0 seek=16777216 2>/dev/null
			$mk -F 16 "$f" >/dev/null 2>&1 && return 0
			rm -f "$f"
			return 1
		fi
	done
	return 1
}

# Markers, as a sorted set.  No trailing word boundary: a marker can be
# followed immediately by another process's output on the same line,
# which is exactly what hid SD-FS-CREATE-OK once.
markers() {
	grep -oE '\b[A-Z][A-Z0-9]+(-[A-Z0-9]+)*-(OK|NONE|FAIL|ACCEPTED)' "$1" |
		sort -u
}

status=0

# One boot of one configuration.  Leaves the log, the marker set, the
# diff and the missing-evidence list in $work, and echoes the reasons it
# failed -- empty means it passed.
attempt() {
	c=$1
	log="$work/$c.log"
	got="$work/$c.markers"
	base="$here/$c.markers"
	rm -f "$log"
	last=`config_last $c`

	# shellcheck disable=SC2046
	"$qemu" `config_args $c` -display none -serial file:"$log" \
		-kernel "$kernel" >/dev/null 2>&1 &
	pid=$!

	waited=0
	while [ $waited -lt $timeout ]; do
		if [ -f "$log" ] && grep -q "$last" "$log"; then
			break
		fi
		if ! kill -0 $pid 2>/dev/null; then
			break
		fi
		sleep 2
		waited=`expr $waited + 2`
	done

	# Output after the last marker still has to land.  This is a flush
	# window, not a race against a check that has not reported yet --
	# config_last names the marker that really comes last, so that
	# race is gone.
	sleep $settle
	kill $pid 2>/dev/null || true
	wait $pid 2>/dev/null || true

	if ! grep -q "$last" "$log" 2>/dev/null; then
		echo "never reached $last in ${timeout}s"
		return
	fi

	markers "$log" > "$got"
	: > "$work/$c.missing"
	rm -f "$work/$c.diff" "$work/$c.faildiff"
	grep -- '-FAIL' "$got" | sort > "$work/$c.failed" || true

	$record && return

	if [ ! -f "$base" ]; then
		echo "no baseline at $base (run with -b once, after reading the log)"
		return
	fi

	fail=''
	diff -u "$base" "$got" > "$work/$c.diff" || fail="$fail markers"

	# Failures a board is known to have.  Some boards reach a shell and
	# then fail every check that wants a module their root does not
	# carry; that is worth recording exactly rather than either hiding
	# it or refusing to watch the board at all.  The set has to match:
	# a new -FAIL fails the run, and so does one that went away, since
	# a debt that got paid should be written down.
	grep -- '-FAIL' "$got" | sort > "$work/$c.failed"
	if [ -f "$here/$c.expected" ]; then
		diff -u "$here/$c.expected" "$work/$c.failed" \
			> "$work/$c.faildiff" || fail="$fail known-FAIL-set"
	elif [ -s "$work/$c.failed" ]; then
		fail="$fail -FAIL"
	fi

	config_evidence $c | while read -r e; do
		[ -z "$e" ] && continue
		grep -qE "$e" "$log" || echo "$e"
	done > "$work/$c.missing"
	[ -s "$work/$c.missing" ] && fail="$fail evidence"

	echo $fail
}

for c in $configs; do
	kernel=`config_kernel $c`
	if [ -z "$kernel" ]; then
		echo "boardsuite: no such configuration: $c" >&2
		status=2
		continue
	fi
	if [ ! -f "$kernel" ]; then
		echo "$c: FAIL no kernel at $kernel (mk it first)"
		status=1
		continue
	fi

	qemu=`config_qemu $c`
	if [ -z "$qemu" ] || [ ! -x "$qemu" ]; then
		echo "$c: FAIL no qemu for this board (looked for `config_qemu $c`)"
		status=1
		continue
	fi

	makecard `config_card $c`
	case $c in virt|virtarm64) needfat=true;; *) needfat=false;; esac
	if $needfat && ! makefat fat16.img; then
		echo "$c: FAIL no way to make a FAT16 image here (hdiutil or mkfs.vfat)"
		echo "    BLK-OK needs a filesystem, not a blank card; see the README"
		status=1
		continue
	fi

	fail=`attempt $c`
	retried=false

	# Several of these checks time themselves against the system timer
	# and compare a count to what the elapsed time predicts.  Host load
	# only ever costs them events, never gains them -- run this while
	# something else has the CPU and ARMTIMER, ARMTIMER-INTR and SYSTMR
	# will report -FAIL for a board that is fine, which is the same
	# one-sided error the checks themselves handle by taking a best of
	# several.  So a failing configuration is booted once more.  A real
	# regression fails twice; a starved run passes the second time and
	# says it needed to, because a retry that is not reported is a
	# suite that hides a flake.
	if [ -n "$fail" ] && ! $record; then
		case "$fail" in
		*"no baseline"*|*"no kernel"*)	;;
		*)	fail=`attempt $c`; retried=true;;
		esac
	fi

	got="$work/$c.markers"
	log="$work/$c.log"
	base="$here/$c.markers"

	if $record; then
		if [ -n "$fail" ]; then
			echo "$c: FAIL $fail"
			status=1
			continue
		fi
		n=`wc -l < "$got" | tr -d ' '`
		# A run that stopped early produces a subset, and a subset
		# recorded as a baseline is a regression written down as
		# the new truth -- which is the failure this whole script
		# exists to prevent, so the code prevents it rather than
		# the README asking nicely.  -f is for the case where the
		# markers really did go away and you mean it.
		if [ -f "$base" ] && ! $force; then
			o=`wc -l < "$base" | tr -d ' '`
			if [ "$n" -lt "$o" ]; then
				echo "$c: FAIL refusing to record $n markers over a baseline of $o"
				echo "    lost:" `comm -23 "$base" "$got" | tr '\n' ' '`
				echo "    read $log first; -f records it anyway"
				status=1
				continue
			fi
		fi
		cp "$got" "$base"
		if [ -s "$work/$c.failed" ]; then
			cp "$work/$c.failed" "$here/$c.expected"
			echo "$c: recorded $n markers in $base, and `wc -l < "$work/$c.failed" | tr -d ' '` known -FAIL"
		else
			rm -f "$here/$c.expected"
			echo "$c: recorded $n markers in $base"
		fi
		continue
	fi

	n=`wc -l < "$got" 2>/dev/null | tr -d ' '`
	known=''
	if [ -s "$work/$c.failed" ]; then
		known=" and `wc -l < "$work/$c.failed" | tr -d ' '` known -FAIL"
	fi
	if [ -z "$fail" ]; then
		if $retried; then
			echo "$c: ok $n markers$known (on the second boot; the first was starved)"
		else
			echo "$c: ok $n markers$known"
		fi
	else
		echo "$c: FAIL $fail ($n markers, log $log)"
		[ -s "$work/$c.diff" ] && sed -n '3,$p' "$work/$c.diff" | sed 's/^/    /'
		[ -s "$work/$c.faildiff" ] && sed -n '3,$p' "$work/$c.faildiff" | sed 's/^/    /'
		if [ -s "$work/$c.missing" ]; then
			while read -r m; do
				echo "    missing evidence: $m"
			done < "$work/$c.missing"
		fi
		status=1
	fi

	if $verbose; then
		sed 's/^/    /' "$got"
	fi
done

exit $status
