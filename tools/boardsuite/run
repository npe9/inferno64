#!/bin/sh
# boardsuite - boot each board configuration and check what came back.
#
# The suite each kernel runs at boot prints markers.  Reading them off
# a terminal by hand is how two mistakes got into this tree's own
# documentation: a harness that killed QEMU three seconds after the
# last marker missed USB-MOUSE-NONE and reported 38 of 38, and a marker
# regex anchored with a trailing \b missed SD-FS-CREATE-OK when another
# process printed on the same line.  Both looked like board regressions
# and neither was.  This script exists so that class of mistake is made
# once, in one place, where it can be fixed.
#
# It also runs the configurations the default boot does not reach.  Two
# branches of sdhcibcm.c only run under a particular card or a
# particular controller, and until now each was covered by a boot
# someone did by hand and remembered to do.
#
# A configuration that fails is booted a second time, because the timed
# checks lose events under host load and gain none: a busy machine makes
# a healthy board report -FAIL.  A run that passes on the retry says so
# rather than looking like a clean run.
#
# usage:  tools/boardsuite/run [-v] [config ...]
#         tools/boardsuite/run -l        list the configurations
#         tools/boardsuite/run -b        record baselines instead of checking
#         tools/boardsuite/run -b -f     record even a shrinking baseline
#
# QEMU must be the patched build; see tools/qemu-patches/README.  Set
# QEMU= to point at it.

set -e

here=`dirname "$0"`
root=`cd "$here/../.." && pwd`
QEMU=${QEMU:-/Users/npe/src/qemu-v10.1.3/build/qemu-system-aarch64}
# One directory per checkout, and a lock inside it.
#
# This used to be ${TMPDIR}/boardsuite flat, with nothing in the name
# to say which tree it belonged to.  Two suites running at once out of
# two git worktrees -- which is an ordinary thing to be doing here --
# therefore shared the card images, the per-configuration logs, the
# generated helper scripts and the host-forwarded ports.  There is no
# collision message for any of that: one suite's makecard truncates and
# rewrites a card while the other has a kernel booted from it, and both
# append to the same per-configuration log that the marker diff is read
# out of afterwards.  While two suites share this directory the marker
# count is not evidence of anything.
#
# Found while chasing a raspi3b-2eth failure, which it did not turn out
# to explain -- that one was config_last naming a marker that is no
# longer last, and is fixed there.  The sharing is a real hole
# regardless, and it is the one that can be closed: the host-forwarded
# ports cannot, because the guest end of them is compiled into the
# init.  See tools/boardsuite/README.
work=${BOARDSUITE_WORK:-${TMPDIR:-/tmp}/boardsuite-`basename "$root"`}
timeout=${BOARDSUITE_TIMEOUT:-240}
settle=${BOARDSUITE_SETTLE:-6}		# after the last marker; 3 is too few
verbose=false
record=false
force=false

configs='raspi3b raspi3b-4g raspi3b-usb raspi3b-2eth raspi4 raspi4-hot raspi4-usb raspi4-2eth virtarm64 virtarm64-msi virtarm64-nvme virtarm64-xhci virtarm64-gicv3 virtarm64-efi virtarm64-noscan virtarm64-acpi virtarm64-peer sifiveu virt virts virt32 virt32s virt-peer peer-mixed'

# Each configuration: the kernel, the QEMU arguments, the line that
# says the board is done printing, and the evidence lines that make
# this configuration worth running as well as the marker set.
# Is anything in the tree newer than this kernel?
#
# This suite does not build.  config_kernel() names a kernel that has
# to exist already, and for a long time nothing checked that it was
# newer than the sources it came from -- so a run made after an edit
# but before "mk install" measured the PREVIOUS kernel and said
# nothing was wrong, which is the worst possible answer.  Three
# re-runs in one session were spent that way before it was noticed;
# doc/inferno-ports.ms has the account.
#
# Deliberately conservative, and deliberately not a per-board
# dependency list.  A guessed list is worse than no check at all,
# because it reads as authoritative while missing exactly the shared
# file -- os/inferno/port/pci.c, appl/cmd/usb/usbd.b -- that caused
# the mistake it is meant to catch.  This can say stale when an
# unrelated file was touched; it cannot say fresh when the kernel is
# old.  .dis is in the list because a kernel embeds its root: a
# rebuilt /dis/usb/usbd.dis makes the kernel around it stale even
# though no .c changed.
#
# find stops at the first hit through the pipe, so this costs one
# directory walk and usually much less.  doc and tools are pruned
# because editing this file or a .ms is not a reason to relink nine
# kernels.  BOARDSUITE_NOSTALECHECK=1 skips it, which is what a bare
# checkout in a container wants: everything there has one mtime and
# the ordering among them means nothing.
#
# Asking mk instead was tried and does not work.  Every board mkfile
# compiles $CONF.c with -DKERNDATE=<now>, so the kernel is always out
# of date by mk's own reckoning and "mk -n install" prints a full
# relink whether anything changed or not.  That is also why the
# false positives this check does produce cost nothing: a board that
# does not link the file you touched is still cleared by the "mk it
# first" the message asks for, because that mk relinks regardless.
#
# os/inferno/boot is pruned along with doc and tools.  Nothing under it
# is compiled into a board kernel -- it is the boot loaders, which are
# separate programs with their own targets -- and leaving it in meant
# that editing a comment in the EFI loader failed fourteen board arms
# that have no EFI loader in them.
#
# So are os/9front and os/osprey, which are other kernels in the same
# checkout and are not linked into any of these, and every board
# directory except the one this kernel came from.  Each board mkfile
# reaches ../port, ../init and ../ip and nothing else -- sifiveu also
# ../riscv, pc64 also ../pc -- so a board's kernel being older than
# another board's source says nothing at all, and it said it loudly:
# a change in os/inferno/virtarm64 failed fourteen arms three separate
# times in one afternoon, each time costing a full rebuild and a
# twenty-minute re-run to learn nothing.  The libraries are still
# scanned, because they really are linked in.
newer_source_than() {
	[ -n "$BOARDSUITE_NOSTALECHECK" ] && return
	# Every board directory but this kernel's own.  Derived from the
	# kernel path, the way the configuration file below is.
	bdir=`dirname "$1"`
	prunes=
	for d in "$root"/os/inferno/*; do
		[ -d "$d" ] || continue
		case `basename "$d"` in
		port|ip|init|riscv|pc)	continue;;
		esac
		[ "$d" = "$bdir" ] && continue
		prunes="$prunes -path $d -prune -o"
	done
	# shellcheck disable=SC2086
	find "$root" \
		-name .git -prune -o \
		-path "$root/doc" -prune -o \
		-path "$root/tools" -prune -o \
		-path "$root/os/inferno/boot" -prune -o \
		-path "$root/os/9front" -prune -o \
		-path "$root/os/osprey" -prune -o \
		$prunes \
		-name '*.root.s' -prune -o \
		-name '*.root.h' -prune -o \
		\( -name '*.c' -o -name '*.h' -o -name '*.s' \
		   -o -name '*.b' -o -name '*.m' -o -name '*.dis' \) \
		-newer "$1" -print 2>/dev/null |
	while read f; do
		# $CONF.c is generated from the board's configuration file
		# by the mkfile, and regenerated whenever that
		# configuration changes -- so without this every other
		# board's kernel looks stale the moment one board is
		# touched, which is not a theory: rebuilding virt32 after
		# an edit to its configuration made os/inferno/virt32/
		# virt32.c newer than iraspi3b and failed four Pi arms.
		# Recognised by the extensionless configuration file
		# sitting beside it, which is what makes pc64dev.c a
		# generated file too and an ordinary foo.c not one.  The
		# configuration itself is checked below; that is the
		# dependency this generated file stands for.
		case "$f" in
		*.c)	d=`dirname "$f"`
			b=`basename "$f" .c`
			[ -f "$d/$b" ] && continue
			# A source in a shared directory counts only if this
			# board compiled it.  ../port and ../ip hold files
			# every board can reach and no board links all of;
			# os/inferno/port/acpi.c is read by virtarm64 and by
			# nothing else, and without this it made every Pi and
			# riscv kernel stale -- with a "mk it first" that
			# could not clear it, because mk correctly declines to
			# relink a kernel that does not depend on the file.
			# The object beside the kernel is the evidence: a
			# board that compiled acpi.c has an acpi.$O in its own
			# directory and a board that did not has nothing.
			case "$d" in
			"$root"/os/inferno/port|"$root"/os/inferno/ip)
				ls "$bdir/$b".? >/dev/null 2>&1 || continue;;
			esac;;
		esac
		echo "$f"
		break
	done > "$work/stale"
	if [ -s "$work/stale" ]; then
		cat "$work/stale"
		return 0
	fi
	# The board's own configuration file, which names its drivers and
	# its root list and has no extension for the pattern above to
	# catch.  Derived from the kernel path rather than passed in:
	# config_kernel() answers .../virtarm64/ivirtarm64, and the
	# configuration beside it is that with the leading i dropped.
	conf=`dirname "$1"`/`basename "$1" | sed 's/^i//'`
	if [ -f "$conf" ] && [ "$conf" -nt "$1" ]; then
		echo "$conf"
	fi
	return 0
}

config_kernel() {
	case $1 in
	raspi3b|raspi3b-4g|raspi3b-usb|raspi3b-2eth)
				echo "$root/os/inferno/raspi3b/iraspi3b";;
	raspi4|raspi4-hot|raspi4-usb|raspi4-2eth)
				echo "$root/os/inferno/raspi4/iraspi4";;
	virtarm64|virtarm64-msi|virtarm64-nvme|virtarm64-xhci|virtarm64-gicv3|virtarm64-peer)
				echo "$root/os/inferno/virtarm64/ivirtarm64";;
	# The a.out rather than the ELF: the EFI loader reads the format
	# bootkern() has always read, and "mk ivirtarm64.a" in the board
	# directory makes it from the same objects as the ELF.  Naming it
	# here is also what puts it under the staleness check.
	virtarm64-efi|virtarm64-noscan|virtarm64-acpi)
				echo "$root/os/inferno/virtarm64/ivirtarm64.a";;
	sifiveu)		echo "$root/os/inferno/sifiveu/isifiveu";;
	virt|virt-peer|peer-mixed)
				echo "$root/os/inferno/virt/ivirt";;
	virts)			echo "$root/os/inferno/virts/ivirts";;
	virt32)			echo "$root/os/inferno/virt32/ivirt32";;
	virt32s)		echo "$root/os/inferno/virt32s/ivirt32s";;
	esac
}

# The Pi boards need the patched build -- most of what their suites
# drive is not in a stock qemu at all.  The others are ordinary machines
# and want the system qemu for their architecture; every patch in
# tools/qemu-patches is BCM-specific and none of them touches -M virt.
# virtarm64 was pointed at the patched binary because that binary was
# to hand, not because it needed one: the same 31 markers and 15 known
# -FAIL come back from a stock qemu-system-aarch64, checked.  That
# matters beyond tidiness -- it is what lets six of the eight run in a
# container that installs qemu from a package rather than building one.
config_qemu() {
	case $1 in
	raspi*)			echo "$QEMU";;
	virtarm64|virtarm64-msi|virtarm64-nvme|virtarm64-xhci|virtarm64-gicv3|virtarm64-efi|virtarm64-noscan|virtarm64-acpi|virtarm64-peer)
				echo "${QEMU_AARCH64:-`command -v qemu-system-aarch64`}";;
	sifiveu|virt|virts|virt-peer|peer-mixed)
				echo "${QEMU_RISCV64:-`command -v qemu-system-riscv64`}";;
	virt32|virt32s)		echo "${QEMU_RISCV32:-`command -v qemu-system-riscv32`}";;
	esac
}

config_args() {
	case $1 in
	raspi3b)
		echo "-M raspi3b -m 1G -drive file=$work/sd16.img,if=sd,format=raw";;
	raspi3b-4g)
		echo "-M raspi3b -m 1G -drive file=$work/sd4g.img,if=sd,format=raw";;
	raspi4-2eth)
		# The same two adapters on the Pi 4's xHCI rather than the
		# Pi 3B's DWC2, so the pair is exercised on both of this
		# tree's USB host controllers.  raspi4init takes the same
		# change as raspi3binit; without this arm that half of it
		# would be compiled and never run.
		echo "-M raspi4b -m 2G -drive file=$work/sd16g.img,if=sd,format=raw -netdev user,id=n0 -device usb-lan9514,netdev=n0,mac=52:54:00:12:34:56 -netdev user,id=n1,net=10.0.3.0/24 -device usb-net,netdev=n1,mac=52:54:00:12:34:58";;
	raspi3b-2eth)
		# Two USB ethernets on one board: the Pi's own LAN9514 and
		# a CDC ECM adapter, on separate SLIRP networks so the two
		# interfaces cannot be confused for one.  Before this
		# existed, usbd started an etherusb for each and both
		# served a directory named "ether" mounted MREPL over
		# /net.alt -- the second replaced the first, and a board
		# with two adapters had one interface.
		#
		# n1 is 10.0.3.0/24 because a second interface on the same
		# subnet in one stack is a routing question, not a driver
		# one, and this configuration is about the driver.  The
		# second interface is configured statically for the reason
		# the init gives: one devip stack holds udp!*!68 once, and
		# the first interface's DHCP proc has it for its lease.
		echo "-M raspi3b -m 1G -drive file=$work/sd16f.img,if=sd,format=raw -netdev user,id=n0 -device usb-lan9514,netdev=n0,mac=52:54:00:12:34:56 -netdev user,id=n1,net=10.0.3.0/24 -device usb-net,netdev=n1,mac=52:54:00:12:34:58";;
	raspi3b-usb)
		# The richer run: a USB stick and the Pi's own network
		# adapter.  doc/raspi3b-completion-plan.ms has described
		# this configuration since the drivers were written and
		# nothing ever ran it twice the same way -- it was a
		# command someone typed and remembered.
		#
		# usb-lan9514 is this tree's own model (qemu-patches
		# 0003), not qemu's usb-net: usb-net is CDC ECM, and the
		# SMSC half of appl/cmd/usb/etherusb.b -- a thousand
		# lines of vendor requests, command words and receive
		# status -- has no other way to execute.
		echo "-M raspi3b -m 1G -drive file=$work/sd16d.img,if=sd,format=raw -drive if=none,id=d0,file=$work/usb16.img,format=raw -device usb-storage,drive=d0 -netdev user,id=n0 -device usb-lan9514,netdev=n0 -device usb-mouse -device usb-kbd -device usb-tablet";;
	raspi4)
		echo "-M raspi4b -m 2G -drive file=$work/sd16b.img,if=sd,format=raw";;
	raspi4-hot)
		echo "-M raspi4b -m 2G -drive file=$work/sd16c.img,if=sd,format=raw -global bcm2838-thermal.temperature=85000";;
	virtarm64)
		# virtio-blk-pci,disable-legacy=on, not virtio-blk-device:
		# os/inferno/virtarm64/virtarm64 links sdvirtio10 (the PCI
		# transport) and no mmio block driver at all, so the mmio
		# form this line used to carry was a disk the kernel had no
		# way to see.  disable-legacy is the other half: sdvirtio10
		# matches pcimatch(0x1AF4, 0x1040+type), the modern device
		# id, and a transitional virtio-blk-pci enumerates as
		# 1af4/1001, which that loop walks straight past.  Both
		# halves were BLK-FAIL, recorded as a known failure of the
		# board rather than of the invocation.
		echo "-M virt -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0";;
	virtarm64-gicv3)
		# The same two PCI functions as virtarm64-msi, on a GICv3
		# instead of a GICv2.  That one flag changes the whole MSI
		# mechanism underneath them: hw/arm/virt.c's create_gic()
		# gives a gic-version=2 machine an SBSA v2m frame and a
		# gic-version=3 machine an ITS, never both, so this arm
		# exercises os/inferno/virtarm64/gicv3its.c where the msi
		# arm exercises gicv2m.c, with no driver aware of the
		# difference.
		#
		# It is also the only arm that runs the GICv3 SPI path at
		# all.  That path was written, committed and never booted
		# -- every other arm takes -M virt's default v2 -- so the
		# uart at 33 and the virtio-mmio slots arriving here are
		# worth as much as the MSI half.
		echo "-M virt,gic-version=3 -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-pci,disable-legacy=on,netdev=n0";;
	virtarm64-efi)
		# The same board as virtarm64, booted the way a real arm64
		# machine boots: edk2 in pflash, an EFI system partition on
		# the first disk carrying os/inferno/boot/efi/bootaa64.efi
		# at /EFI/BOOT/BOOTAA64.EFI, and no -kernel at all.  The
		# loader reads plan9.ini, loads the kernel it names, turns
		# the MMU and the caches off and branches to it.
		#
		# ACPI is left on, which is the default, and the
		# consequence is worth stating: the loader then has no
		# device tree to pass, and the kernel boots because main()
		# falls back to finding QEMU's own DTB at the bottom of
		# DRAM.  That fallback is an artifact of QEMU.  A real
		# machine has nothing there, which is what ACPI discovery
		# is for and why this arm is not a SystemReady test.
		# acpi=off is the other half of the story: edk2 then
		# publishes a device tree, but a smaller one than QEMU's
		# with no v2m frame in it, so MSI disappears and PCI falls
		# back to INTx.  Neither configuration is complete; this is
		# the one where the drivers all run.
		echo "-M virt -cpu cortex-a57 -m 1G -drive if=pflash,format=raw,unit=0,file=$fwdir/edk2-aarch64-code.fd,readonly=on -drive if=pflash,format=raw,unit=1,file=$work/vars.fd -drive file=$work/esp.img,format=raw,if=none,id=esp0 -device virtio-blk-pci,drive=esp0 -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-pci,disable-legacy=on,netdev=n0";;
	virtarm64-noscan)
		# The same boot as virtarm64-efi with one line added to
		# plan9.ini: *nofdtscan=1, which stops main() from finding
		# QEMU's device tree by its magic at the bottom of DRAM.
		#
		# That scan is why the EFI arm passes with ACPI on and no
		# device tree from the firmware: the kernel finds QEMU's
		# tree anyway and every check passes without a line of ACPI
		# being read.  A machine that is not QEMU has nothing
		# there, so this arm is what the board does without it, and
		# it is the arm ACPI discovery will have to change.
		#
		# It still boots -- 33 markers rather than 42 -- because
		# every device-tree lookup falls back to a mem.h constant
		# and mem.h happens to describe this machine correctly.
		# That is worth being blunt about: this arm proves the tree
		# was not found, not that anything was found instead.  When
		# the ACPI path lands, the test that it does anything is
		# the falsify test the riscv boards already use -- set the
		# constant wrong and see the board take the discovered
		# value -- and not this marker count.
		#
		# No network: without a tree there is no reason to expect
		# the ip stack to come up, and an arm whose baseline is a
		# partial boot should carry as little that can drift as
		# possible.
		echo "-M virt -cpu cortex-a57 -m 1G -drive if=pflash,format=raw,unit=0,file=$fwdir/edk2-aarch64-code.fd,readonly=on -drive if=pflash,format=raw,unit=1,file=$work/vars.fd -drive file=$work/esp.img,format=raw,if=none,id=esp0 -device virtio-blk-pci,drive=esp0 -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0";;
	virtarm64-acpi)
		# No device tree anywhere, and a GICv3 with an ITS.
		#
		# This is the arm that is about SystemReady rather than
		# about QEMU.  The firmware publishes ACPI and no tree,
		# *nofdtscan=1 stops the kernel finding QEMU's own tree at
		# the bottom of DRAM, and so every address the board uses
		# past mem.h comes from the MADT and the IORT: the ITS
		# base, and the requester-id-to-DeviceID window that makes
		# a PCI function's MSI land on the right vector.  "fdt: no
		# device tree" in the log is the point of it.
		#
		# gic-version=3 because that is where the ITS is: QEMU's
		# create_gic() gives a version 2 machine a v2m frame, which
		# the MADT describes but this board reads out of the tree,
		# and the MADT's ITS entry only exists on a version 3.
		echo "-M virt,gic-version=3 -cpu cortex-a57 -m 1G -drive if=pflash,format=raw,unit=0,file=$fwdir/edk2-aarch64-code.fd,readonly=on -drive if=pflash,format=raw,unit=1,file=$work/vars.fd -drive file=$work/esp.img,format=raw,if=none,id=esp0 -device virtio-blk-pci,drive=esp0 -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-pci,disable-legacy=on,netdev=n0";;
	virtarm64-msi)
		# The same board with both devices on PCI rather than one
		# on PCI and one on virtio-mmio, which is what makes this
		# the MSI arm: -M virt's default GIC is a v2, QEMU puts an
		# SBSA GICv2m frame beside it, and each of the two PCI
		# functions takes a vector from that frame instead of the
		# INTx line it used to share.
		#
		# The network is the half that proves delivery.  The disk
		# would not: sdvirtio10's vqio() polls the used ring after
		# a one-second tsleep, so a disk whose interrupts never
		# arrive still answers every request and prints BLK-OK.
		# ethervirtio10's rxproc and txproc sleep on the queue
		# with no timeout at all, so DHCP-OK over virtio-net-pci
		# cannot happen unless a vector really arrived.
		#
		# The same FAT image and the same host ports as virtarm64:
		# the arms run one at a time, and the host rig below dials
		# 54323/54326 by name in one place.
		echo "-M virt -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-pci,disable-legacy=on,netdev=n0";;
	virtarm64-nvme)
		# The same FAT image on an NVMe controller instead of a
		# virtio-blk function, which is the whole point of the
		# arm: os/inferno/virtarm64/virtarm64 has always listed
		# sdnvme, and no configuration had ever given the board
		# an NVMe device, so the driver was linked into eight
		# kernels and had never executed an instruction.  QEMU
		# models the controller fully, so nothing needed writing
		# for this -- it needed asking for.
		#
		# The network stays on virtio-mmio, as it is on the plain
		# virtarm64 arm.  That is deliberate: it leaves exactly
		# one PCI function that matters, so the interrupt story
		# here is about that one device and not about which of
		# two took which vector.
		#
		# serial= is named rather than left to QEMU because
		# sdnvme's rctl reads it back out of the identify page;
		# a run where the controller answered from stale memory
		# rather than from the device would not print it.
		echo "-M virt -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=nvm0,format=raw -device nvme,drive=nvm0,serial=bs0001 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0";;
	virtarm64-xhci)
		# The board's third PCI driver pair, usbxhcipci and
		# usbxhci, which os/inferno/virtarm64/virtarm64 has linked
		# since it was written and no arm ever gave a device.  The
		# disk stays on virtio-blk-pci, exactly as on the plain
		# virtarm64 arm: the stick here is not a devsd unit at all
		# but a flat file usbd serves at /chan/usbdisk0, so the two
		# do not compete for a letter and BLK-OK still names sdF.
		#
		# usb-storage rather than usb-net: a second ethernet would
		# want /net.alt/ether on a devip stack that already holds
		# one, which is the collision raspi3b-2eth's comment
		# describes, and nothing about the controller needs it.
		#
		# QEMU puts a usb-storage device on the first free
		# SuperSpeed port of a qemu-xhci, which is port 1, and that
		# is the half of this arm the Pi's usbdwc cannot reach:
		# a SuperSpeed device on a SuperSpeed root hub.
		echo "-M virt -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -drive if=none,id=d0,file=$work/usbvx.img,format=raw -device qemu-xhci -device usb-storage,drive=d0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0";;
	# The riscv arms below name -m explicitly.  They used to pass none
	# at all, which meant QEMU's 128MB default while virt, virts,
	# virt32 and virt32s each compiled DRAMSIZE as 256MB and took it
	# as the top of memory: the kernels were handing out 128MB of
	# addresses the machine leaves unassigned.  The boards now size
	# themselves from the device tree, so an invocation that says
	# nothing gets a 128MB board; these say what mem.h always claimed
	# they wanted.  sifive_u's own DRAMSIZE is 128MB, so its -m makes
	# the default explicit rather than changing it.
	sifiveu)
		# if=sd, and the FU540 has no SD host controller: QEMU's
		# sifive_u puts an ssi-sd on the second SPI controller,
		# the spi@10050000 the device tree gives an mmc-spi-slot
		# child.  So this card is driven by sdspisifive.c over
		# spisifive.c -- SD command frames on a SPI bus -- and
		# not by any of the SDHCI code the Pi boards use.  The
		# board printed SD-NONE for as long as the suite ran it,
		# and the reason was only ever that nothing handed it a
		# card.
		echo "-M sifive_u -m 128M -bios none -drive file=$work/sdspi.img,if=sd,format=raw";;
	virt)
		# This kernel is the other way round: it links sdvirtiommio
		# and ethervirtiommio, so both devices are the mmio form.
		# The netdev is new -- NET-FAIL and IP-FAIL were recorded
		# here as known failures while the invocation had no
		# network device at all.
		echo "-M virt -m 256M -bios none -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-device,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0";;
	virts)
		# virt's line without -bios none: QEMU's default OpenSBI
		# runs first and enters the kernel at supervisor mode,
		# which is what this configuration is for.  The kernel
		# links at 0x80200000 rather than 0x80000000 to leave
		# OpenSBI where it loads.  Everything else is virt
		# exactly, so its marker set has to come out the same.
		echo "-M virt -m 256M -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-device,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0";;
	virt32)
		# The netdev is new: the board links ethervirtiommio as
		# of the round that fixed zc's vlong word order, and
		# without a device behind it the DHCP check has nothing
		# to answer it.  mmio, like riscv64/virt's -- this board
		# has no PCI.
		echo "-M virt -m 256M -bios none -netdev user,id=n0 -device virtio-net-device,netdev=n0";;
	virt32s)
		# The same board in supervisor mode: no -bios none, so
		# QEMU's default OpenSBI runs first and drops the kernel
		# into S-mode.  Everything else is virt32's line.
		echo "-M virt -m 256M -netdev user,id=n0 -device virtio-net-device,netdev=n0";;
	peer-mixed)
		# The riscv64 board listening for the arm64 one.  The two
		# ends of this wire are different architectures running
		# different kernels, which is the only thing here that
		# puts a big-picture agreement -- byte order, header
		# layout, the ARP and IP encodings -- to a test that a
		# shared bug could not pass.  Otherwise it is virt-peer
		# exactly, host rig and hostfwd and all, so that its
		# marker set has to come out the same: the same board on
		# the same run, and the only thing changed is who is on
		# the other end of the wire.
		echo "-M virt -m 256M -bios none -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-device,drive=blk0,bus=virtio-mmio-bus.0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0,bus=virtio-mmio-bus.1 -netdev socket,id=p0,listen=:14446 -device virtio-net-device,netdev=p0,mac=52:54:00:aa:aa:01,bus=virtio-mmio-bus.2";;
	raspi4-usb)
		# The richer run again, on the board whose USB is xHCI
		# rather than dwc2.  raspi4init.b carries the same disk
		# and ethernet checks, so this is the same six markers
		# reached over a different host controller -- the one
		# thing about them the Pi 3 configuration cannot say.
		echo "-M raspi4b -m 2G -drive file=$work/sd16e.img,if=sd,format=raw -drive if=none,id=d0,file=$work/usb16b.img,format=raw -device usb-storage,drive=d0 -netdev user,id=n0 -device usb-lan9514,netdev=n0 -device usb-mouse -device usb-kbd -device usb-tablet";;
	virtarm64-peer)
		# virtarm64 with a peer link, the same shape as virt-peer
		# and on its own socket port: the two peer configurations
		# run one after the other in a full pass, and a port still
		# in TIME_WAIT from the last one is the race this suite
		# has already paid for once.  The disk stays on PCI and
		# the two networks are mmio, which is untested together
		# anywhere else -- bus.1 is 0xA000200 and bus.2
		# 0xA000400 on this machine, VIRTIO_SIZE being 0x200
		# here rather than virt's 0x1000.
		echo "-M virt -cpu cortex-a57 -m 1G -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-pci,disable-legacy=on,drive=blk0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0,bus=virtio-mmio-bus.1 -netdev socket,id=p0,listen=:14445 -device virtio-net-device,netdev=p0,mac=52:54:00:aa:aa:01,bus=virtio-mmio-bus.2";;
	virt-peer)
		# The same board as virt, plus a second network device
		# joined to another guest, and every virtio device on a
		# bus named rather than left to the daemon: with two nets
		# the guest's ether0 has to be the slirp one and ether1
		# the peer, and qemu hands out unnamed mmio slots from
		# the top down, so leaving it to order works until it
		# does not.  bus.1 is 0x10002000 and bus.2 0x10003000;
		# ethervirtiommio scans ascending, so the numbering
		# follows.
		echo "-M virt -m 256M -bios none -drive file=$work/fat16.img,if=none,id=blk0,format=raw -device virtio-blk-device,drive=blk0,bus=virtio-mmio-bus.0 -netdev user,id=n0,hostfwd=tcp::54323-:54323,hostfwd=udp::54326-:54326 -device virtio-net-device,netdev=n0,bus=virtio-mmio-bus.1 -netdev socket,id=p0,listen=:14444 -device virtio-net-device,netdev=p0,mac=52:54:00:aa:aa:01,bus=virtio-mmio-bus.2";;
	esac
}

# The other guest, for a configuration that has one.
#
# This is the second half of "test the networking": everything else
# here talks to 10.0.2.2, and slirp answers ARP, DHCP, ICMP and TCP
# out of one host process -- it would go on answering if the guest's
# own ARP were broken.  -netdev socket puts two qemus on a wire with
# nothing in between, so the thing that replies is another copy of
# this kernel and a packet arrives because both ends agreed.
#
# The peer is rig, not a board under test: no baseline, no marker set,
# no disk, and its own slirp checks fail because the hostfwd rules
# belong to the guest being checked.  What it has to say is one line,
# and config_peer_evidence says which.
config_peer() {
	case $1 in
	peer-mixed)
		echo "-M virt -cpu cortex-a57 -m 1G -netdev user,id=n0 -device virtio-net-device,netdev=n0,bus=virtio-mmio-bus.1 -netdev socket,id=p0,connect=127.0.0.1:14446 -device virtio-net-device,netdev=p0,mac=52:54:00:aa:aa:02,bus=virtio-mmio-bus.2";;
	virtarm64-peer)
		echo "-M virt -cpu cortex-a57 -m 1G -netdev user,id=n0 -device virtio-net-device,netdev=n0,bus=virtio-mmio-bus.1 -netdev socket,id=p0,connect=127.0.0.1:14445 -device virtio-net-device,netdev=p0,mac=52:54:00:aa:aa:02,bus=virtio-mmio-bus.2";;
	virt-peer)
		echo "-M virt -bios none -netdev user,id=n0 -device virtio-net-device,netdev=n0,bus=virtio-mmio-bus.1 -netdev socket,id=p0,connect=127.0.0.1:14444 -device virtio-net-device,netdev=p0,mac=52:54:00:aa:aa:02,bus=virtio-mmio-bus.2";;
	esac
}

# The other guest's kernel and qemu, when they are not this
# configuration's own.  peer-mixed is the reason these exist: its two
# ends are different architectures, so the second guest is a different
# binary run by a different emulator.
config_peer_kernel() {
	case $1 in
	peer-mixed)	echo "$root/os/inferno/virtarm64/ivirtarm64";;
	*)		config_kernel $1;;
	esac
}

config_peer_qemu() {
	case $1 in
	peer-mixed)	echo "${QEMU_AARCH64:-`command -v qemu-system-aarch64`}";;
	*)		config_qemu $1;;
	esac
}

config_peer_evidence() {
	case $1 in
	virt-peer|virtarm64-peer|peer-mixed)
		echo 'peer: 525400aaaa02 is 192\.168\.77\.2'
		echo 'PEER-DIAL-OK'
		echo 'PEER-ARP-OK 192\.168\.77\.1';;
	esac
}

# The QMP port a configuration wants, or nothing.
#
# mousecheck() has never once run to completion in this tree: with no
# mouse attached it says USB-MOUSE-NONE, which is the right answer and
# also the only one it has ever given.  A usb-mouse alone does not help
# -- an emulated mouse that nobody moves says nothing either -- so the
# suite opens qemu's monitor and sends the motion and the two button
# presses the check is looking for.  A TCP port rather than a unix
# socket because a unix socket path must fit in 104 bytes and a work
# directory under TMPDIR does not always leave room.
config_qmp() {
	case $1 in
	raspi3b-usb)	echo 14447;;
	raspi4-usb)	echo 14448;;
	esac
}

# Is every one of these patterns in the log yet?  config_last names one
# for most boards and two for the ones where nothing is reliably last;
# they are markers, so none of them has a space in it and the caller
# passes them unquoted on purpose.
allseen() {
	seenlog=$1
	shift
	[ -f "$seenlog" ] || return 1
	for seenpat in "$@"; do
		grep -q "$seenpat" "$seenlog" || return 1
	done
	return 0
}

# The line that says a board has finished printing.  This has to be the
# LAST marker, not the last interesting one: on the Pi boards the mouse
# check waits out its own timeout and reports after RASPI*-SH-OK, so
# waiting for the board marker and sleeping a few seconds is a race the
# machine wins whenever it is busy -- it cost this tree a "38 of 38"
# that was really 39, and cost this script a false regression on its
# first day out.  Waiting for the marker that really comes last turns
# that race into a timeout with a name in it.
config_last() {
	case $1 in
	raspi3b|raspi3b-4g)	echo 'USB-MOUSE';;
	# With a mouse attached the mouse check reports as soon as it
	# has what it wants rather than waiting out its timeout, so the
	# marker that made it last on every other Pi configuration is
	# not last here.  The shell's is.
	raspi3b-usb)		echo 'RASPI3B-SH-OK';;
	# Two markers, both required, because on these two neither one is
	# reliably last.  The pointer check reports when its own timeout
	# runs out and the shell marker comes after the kfs ream, and the
	# two ethernets' DHCP and ping tests push the ream late enough
	# that the order between them depends on how busy the host is.
	# Waiting for USB-MOUSE alone killed qemu six seconds later, in
	# the middle of "kfs: reaming the file system", and reported the
	# two markers after it as a board regression -- five times in a
	# row on a loaded machine, while the identical qemu command line
	# by hand reached both in about a minute.  This is the same race
	# the comment above describes, on the other side of it.
	raspi3b-2eth)		echo 'USB-MOUSE'; echo 'RASPI3B-SH-OK';;
	raspi4-2eth)		echo 'USB-MOUSE'; echo 'RASPI4-SH-OK';;
	raspi4|raspi4-hot)	echo 'USB-MOUSE';;
	raspi4-usb)		echo 'RASPI4-SH-OK';;
	virtarm64|virtarm64-msi|virtarm64-nvme|virtarm64-xhci|virtarm64-gicv3|virtarm64-efi|virtarm64-noscan|virtarm64-acpi|virtarm64-peer)	echo 'ROOT-CMDS-OK';;
	virt|virts|virt-peer|peer-mixed)	echo 'ROOT-CMDS-OK';;
	sifiveu)		echo 'SIFIVEU-SH-OK';;
	virt32|virt32s)		echo 'VIRT32-INIT-OK';;
	esac
}

# Lines that must appear.  These are the point of the configuration:
# the marker set alone cannot tell these runs apart, because the marker
# is the same and only what it says differs.
config_evidence() {
	case $1 in
	raspi3b)
		echo 'from firmware clock 1'
		echo 'csd v1';;
	raspi3b-4g)
		echo 'from firmware clock 1'
		echo 'csd v2';;
	raspi4-2eth)
		# The same two lines as raspi3b-2eth: what this arm adds
		# is the controller underneath them.
		echo 'ETHERUSB serving /net\.alt/ether mac 525400123456 \(SMSC LAN95xx'
		echo 'ETHERUSB serving /net\.alt/ether1 mac 525400123458 \(CDC ECM'
		echo 'ETHER2-ADDR-OK ip=10\.0\.3\.15 gw=10\.0\.3\.2';;
	raspi3b-2eth)
		echo 'from firmware clock 1'
		# Both adapters, named apart, and the second one carrying
		# traffic.  The MACs distinguish them, and the invocation
		# names both rather than letting QEMU derive them from
		# device order, so these lines check the kernel's report
		# against something the command line states.  A run where
		# one instance served both directories, or where the
		# second replaced the first, cannot produce them together.
		echo 'ETHERUSB serving /net\.alt/ether mac 525400123456 \(SMSC LAN95xx'
		echo 'ETHERUSB serving /net\.alt/ether1 mac 525400123458 \(CDC ECM'
		# And the second interface's own address, on a subnet the
		# first one has no route to.
		echo 'ETHER2-ADDR-OK ip=10\.0\.3\.15 gw=10\.0\.3\.2';;
	raspi3b-usb)
		echo 'from firmware clock 1'
		# The markers alone cannot tell this configuration apart
		# from a board that decided it had no disk and no
		# network: DISK-READ-OK and ETHER-DHCP-OK are the same
		# words whichever code printed them.  These are the lines
		# only the real path can print -- an address that came
		# from a DHCP exchange over the LAN9514, and a file
		# written through SCSI WRITE(10) and read back.
		echo 'ETHER-DHCP-OK ip=10\.0\.2\.15 gw=10\.0\.2\.2'
		echo 'DISK-WRITE-OK pi\.txt [0-9]+ bytes read back'
		# Named and alone: a stale stick lists pi.txt beside it,
		# so this is what proves the image was made fresh.  The
		# tail is [^ ]*$ and not a bare $ because the board's
		# console ends its lines with CR LF -- a $ anchored
		# straight after the name matches nothing, which cost a
		# run to work out.
		echo 'DISK-DOS-OK /n/dos: usb\.txt[^ ]*$'
		echo 'DISK-READ-OK usb\.txt'
		# 6 is right (4) and middle (2) together.  A mouse that
		# enumerated and moved but whose buttons landed on the
		# wrong bits gives USB-MOUSE-FAIL, so the marker alone
		# carries this -- but the number is what says which
		# direction usbd's remap went.
		echo 'USB-MOUSE-OK [0-9]+ events, motion and buttons 6'
		echo 'USB-KBD-OK [0-9]+ chars'
		# The tablet's two lines say different things and both
		# are needed.  The first is usbd's own: the bit offsets
		# it derived from the report descriptor, which no fixed
		# decode could have known -- x sixteen bits wide at bit
		# 8, past five button bits and three of padding.  The
		# second is the coordinate that came out the other end,
		# three quarters along a 640-pixel screen and a quarter
		# down a 480-pixel one, which is the point the monitor
		# commanded in the tablet's own 0..32767 units.  A
		# relative decode cannot land there.
		echo 'HID report pointer on [^ ]*: 48-bit report, x absolute at 8\+16'
		echo 'USB-TABLET-OK absolute 479 119 on 640x480';;
	raspi4)
		echo 'from capabilities'
		echo 'die 24\.';;
	raspi4-hot)
		echo 'die 85\.';;
	raspi4-usb)
		echo 'from capabilities'
		echo 'ETHER-DHCP-OK ip=10\.0\.2\.15 gw=10\.0\.2\.2'
		echo 'DISK-WRITE-OK pi\.txt [0-9]+ bytes read back'
		echo 'DISK-DOS-OK /n/dos: usb\.txt[^ ]*$'
		echo 'DISK-READ-OK usb\.txt'
		echo 'HID report pointer on [^ ]*: 48-bit report, x absolute at 8\+16'
		echo 'USB-TABLET-OK absolute 479 119 on 640x480';;
	virtarm64-peer)
		# Which disk answered, and not merely that one did.
		# virtinit's blkcheck() used to open /dev/sdF0/data by
		# name; it now looks for the first unit under #S with a
		# data file, so that an arm can hand the board a different
		# controller and still be the same test.  The cost of
		# looking is that BLK-OK stopped naming what it found -- a
		# board with two disks would pass on either.  So the name
		# is checked here instead, per arm, and on this one it is
		# the virtio-blk function.
		echo 'BLK-OK /dev/sdF0/data'
		# Both halves: the peer lines this arm shares with the
		# riscv peer configurations, and the device-tree lines
		# only an arm64 kernel prints.  It needs its own arm and
		# it needs to come first, because a case takes the first
		# match and the shared arm below would otherwise swallow
		# it and check neither.
		echo 'peer: 525400aaaa01 is 192\.168\.77\.1'
		echo 'PEER-ARP-OK 192\.168\.77\.2'
		echo 'fdt: pci ecam @ 0x4010000000 size 0x10000000'
		echo 'fdt: pl011 @ 0x9000000 size 0x1000'
		echo '^[0-9a-f]+ 80000000 [0-9]+';;
	virt-peer|peer-mixed)
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		echo 'peer: 525400aaaa01 is 192\.168\.77\.1'
		echo 'PEER-ARP-OK 192\.168\.77\.2';;
	virts)
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		# virt and virts share an init and a root, so they print
		# the same marker set and only these tell them apart:
		# the kernel's own banner, and OpenSBI's, which is
		# firmware rather than payload but says the machine was
		# started at supervisor mode -- this configuration's
		# whole point.
		echo 'conf virts \('
		echo 'Domain0 Next Mode *: S-mode'
		# The memory top, for the reason the virt arm gives:
		# conf.topofmem comes from the tree and stops at the
		# blob, so at -m 256M it is 0x8fe00000.
		echo '^[0-9a-f]+ 8fe00000 [0-9]+';;
	virt32s)
		# These two boards share an init, so they print the same
		# five markers and the marker set cannot tell them
		# apart.  Two different lines are needed and they say
		# different things.  "conf virt32s" is printed by the
		# kernel out of its own conffile, so it is the one that
		# says which payload booted -- point config_kernel at
		# ivirt32 and this is what fails.  OpenSBI's banner is
		# firmware, not payload: it appears whenever -bios none
		# is absent, so it says the machine was started at
		# supervisor mode, which is this configuration's whole
		# point, but on its own it would not notice the wrong
		# kernel.
		echo 'conf virt32s \('
		echo 'Domain0 Next Mode *: S-mode'
		echo 'ip=10\.0\.2\.15 ipmask=255\.255\.255\.0 ipgw=10\.0\.2\.2'
		echo 'IP32-OK'
		# The memory top, for the reason the virt arm gives:
		# conf.topofmem comes from the tree and stops at the
		# blob, so at -m 256M it is 0x8fe00000.
		echo '^[0-9a-f]+ 8fe00000 [0-9]+';;
	virt)
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		# conf virt, for the same reason virts has its own.
		echo 'conf virt \('
		# The memory top.  xalloc prints its extent as
		# "base top size"; the middle field is conf.topofmem,
		# which archconfinit() takes from the device tree and
		# then trims to the tree's own address, since QEMU's
		# riscv machines put the blob at dram_end-2MB, inside
		# the range confinit() hands out.  At -m 256M that is
		# 0x8fe00000 and not 0x90000000.  The first and third
		# fields move with the kernel image, so neither is
		# matched.
		echo '^[0-9a-f]+ 8fe00000 [0-9]+';;
	virt32)
		# conf virt32, for the same reason virt32s has its own:
		# the two share an init and print the same markers, so
		# the kernel's own banner is what says which one ran.
		# The trailing \( matters: the banner reads
		# "conf virt32 (1789037284) jit 0", and a bare
		# "conf virt32" is a prefix of "conf virt32s" and would
		# match the other board's log as happily as this one's.
		echo 'conf virt32 \('
		# ETHER32-OK says only that #l0 appeared.  These two say
		# the wire worked: an address that came out of a real
		# DISCOVER/OFFER/REQUEST/ACK over the virtio-mmio NIC,
		# which needs transmit, receive and the PLIC interrupt,
		# and a ping the gateway answered.  Both are 64-bit
		# quantities away from the ring descriptors that the
		# compiler's word order used to write backwards, so a
		# regression there shows up here first.
		echo 'ip=10\.0\.2\.15 ipmask=255\.255\.255\.0 ipgw=10\.0\.2\.2'
		echo 'IP32-OK'
		# The memory top, for the reason the virt arm gives:
		# conf.topofmem comes from the tree and stops at the
		# blob, so at -m 256M it is 0x8fe00000.
		echo '^[0-9a-f]+ 8fe00000 [0-9]+';;
	sifiveu)
		# SIFIVEU-FDT-OK says the tree agreed with mem.h.  These
		# two say the discovered numbers were the ones the board
		# then used: the driver prints the base it was handed
		# (gembase, seeded from the DTB), not the constant, and
		# it is the same address the tree reported.  Point the
		# seed at the wrong node and the driver line changes
		# with it.
		echo 'fdt: gem base 0x10090000 \(mem\.h GEM0 0x10090000\)'
		echo 'ethersifivegem: 0x10090000'
		# The SD markers say the block device answered.  This
		# line says which controller answered it: the JEDEC id
		# is read by spisifive.c off the other SPI controller at
		# boot, so a run where the SPI layer never came up
		# cannot print it, and the SD checks below it run on
		# that same layer.
		echo 'spi spi0-nor at 0x10040000: jedec'
		echo 'SD 16-block RW \(SD-MULTIBLOCK-OK\)'
		echo 'SD-FS-OK \(kfs-on-sd works\)'
		# The memory top.  -M sifive_u is a 128MB machine, so
		# this reads 0x87e00000: the tree's 0x88000000 trimmed
		# to the 2MB the blob sits in.  Before the board sized
		# itself from the tree it read 0x88000000 and the tree
		# was inside the pool.
		echo '^[0-9a-f]+ 87e00000 [0-9]+';;
	virtarm64)
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		# This board reads QEMU's own device tree, and nothing in
		# the marker set says so: the markers are the same words
		# whether the bases came from the tree or from mem.h.
		# These are the lines only the real path can print.  The
		# ECAM line is deliberately the anchor rather than the
		# memory one -- it does not depend on what -m the
		# invocation passes, so it still proves the tree was
		# found and parsed if that flag ever changes.
		echo 'fdt: pci ecam @ 0x4010000000 size 0x10000000'
		echo 'fdt: pl011 @ 0x9000000 size 0x1000'
		# And this is what proves the size the tree reported was
		# acted on rather than merely printed.  xalloc prints its
		# extent as "base top size"; the middle field is
		# conf.topofmem, and archconfinit() takes it from the
		# tree.  At -m 1G that is 0x80000000.  Before the tree
		# was read it was 0x50000000, a quarter of the machine,
		# because DRAMSIZE said 256MB.  The first and third
		# fields are PGROUND(end) and the difference, so both
		# move with the kernel image and neither is checked --
		# this used to read '1069756416 bytes free' and would
		# have had to be retyped after every commit that changed
		# the image size.
		echo '^[0-9a-f]+ 80000000 [0-9]+'
		;;
	virtarm64-nvme)
		# The arm exists for this line.  sdN is sdnvme's own
		# letter, fixed in its SDifc, so a board that fell back to
		# the virtio disk would say sdF here and pass every marker
		# regardless -- BLK-OK and FS-OK are the same words
		# whichever controller answered.  This is what says the
		# NVMe namespace is the one that was read.
		echo 'BLK-OK /dev/sdN0/data'
		# And that the controller came up far enough to say how
		# many queues it got, which is the last thing nvmeenable()
		# prints before devsd will open a unit at all.
		# ... and which interrupt it took.  80 is the GICv2m
		# frame's first SPI, and this arm's network is on
		# virtio-mmio, so sdnvme is the only caller of the router
		# and has to get the base vector -- which checks the
		# allocator starts where MSI_TYPER says it does, something
		# the two-device msi arm cannot say on its own.
		echo 'sdN \(nvme\): using [0-9]+ submit queues, irq 80 msi-x'
		# And delivery, which nothing above proves.  wcmd() calls
		# nvmeintr() itself while it waits, so a controller whose
		# vector never arrives still completes every command and
		# prints all of the above -- the polled-disk trap that
		# BLK-OK fell into on the virtio arm before gicedge().  The
		# handler counts only the calls that came with a trap
		# frame, so this line cannot be printed by the polling.
		echo 'nvme: first interrupt, irq 80 msi-x'
		# The frame itself, as on the msi arm: the doorbell
		# self-test has to have passed or pcimsirouter is nil and
		# the two lines above would read intx.
		echo 'MSI-DOORBELL-OK'
		;;
	virtarm64-xhci)
		# The virtio disk is still the one devsd offers, and the
		# USB stick is not a devsd unit at all -- so this line
		# says the two disks on this arm did not get confused
		# with each other.
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		# The word that decides the arm.  "super" is usbd's own
		# report of which of portattach()'s two paths it took,
		# and it can only say it if hp->superspeed named this
		# port -- which is the mask usbxhci.c built by reading
		# the Supported Protocol name string a byte at a time,
		# getting "U" and three zeroes, and matching nothing.
		# With that mask empty devusb makes one flat high-speed
		# root hub, the same device enumerates as "full", and
		# every USB marker below is printed anyway.  So the four
		# of them together do not distinguish the fixed driver
		# from the broken one; this line does.
		echo 'usbd: ep2\.0: port 1: super ep3\.0 vid 46f4 did 0001'
		# Two root hubs, which is the other half of the same
		# mask: four high-speed ports and four SuperSpeed, out
		# of the eight qemu-xhci provides.
		echo 'usbd: 2 root hub\(s\)'
		# And the medium, read through usbd's Bulk-Only
		# Transport code -- SCSI over the device's two bulk
		# endpoints, every transfer of it waiting on the event
		# ring.  Nothing in usbxhci.c polls that ring: waitrun()
		# sleeps until interrupt() wakes it, so a controller
		# whose vector never arrived would time out here rather
		# than quietly complete.  These markers are delivery
		# evidence in a way the nvme arm's BLK-OK is not.
		echo 'USB-DISK-OK /chan/usbdisk0'
		echo 'USB-READ-OK usb\.txt'
		echo 'USB-WRITE-OK xhci\.txt [0-9]+ bytes read back'
		# And the vector.  This is the third of the board's four
		# PCI drivers to take one, and the only one whose whole
		# marker set is already delivery evidence: waitrun() in
		# usbxhci.c sleeps until interrupt() wakes it and nothing
		# polls the event ring, so a controller whose vector never
		# arrived times out rather than quietly completing -- the
		# opposite of sdvirtio10's used ring and sdnvme's wcmd().
		echo 'usbxhci: 0x1b36 0xd: irq 80 msi-x'
		echo 'usbxhci: first interrupt, irq 80 msi-x'
		# 80 and 81, from one frame, to two functions.  A disk at
		# 81 is not itself new -- virtarm64-msi has the network at
		# 80 and the disk at 81.  What is new is which kind of
		# device has the bottom of the frame: usbinit() runs the
		# host controllers before devsd probes its units, so here
		# it is the xHCI, where on virtarm64 it is the disk (the
		# only caller) and on virtarm64-msi the network.  A board
		# that handed out one vector twice would print the same
		# two lines above and fail here.
		echo 'sdF \(virtio10\): irq 81 msi-x'
		echo 'MSI-DOORBELL-OK'
		;;
	virtarm64-acpi)
		# Nothing came from a device tree, because there was not
		# one.  This line first, because every line under it is
		# only interesting given this one.
		echo 'fdt: no device tree'
		# The MADT: a GICv3 distributor, a redistributor range,
		# and an ITS.  The bases are matched as digits, not as
		# QEMU's values, for the same reason the gicv3 arm's
		# widths are -- what is asserted is that they were read.
		echo 'acpi: madt gicv3 dist @ 0x[0-9a-f]+'
		echo 'acpi: madt redist @ 0x[0-9a-f]+'
		echo 'acpi: madt its @ 0x[0-9a-f]+, ACPI-ITS-OK'
		# The IORT, which is the msi-map property's job done by a
		# table: which requester ids this window covers and what
		# DeviceID the first of them becomes.
		echo 'acpi: iort rid 0x[0-9a-f]+\.\.0x[0-9a-f]+ -> devid 0x[0-9a-f]+, ACPI-IORT-OK'
		# And the ITS driver running on what the tables said, with
		# two PCI functions on distinct LPIs and an interrupt that
		# arrived.
		#
		# The ITS base is proved by these lines: there is no device
		# tree and no mem.h constant for it, so the only place it
		# can have come from is the MADT.  The IORT window is not,
		# and saying so matters -- QEMU's window is the identity,
		# which is also what ridtodevid() falls back to when there
		# is no window at all, so a machine whose IORT says
		# something else is what would tell the two apart and this
		# is not that machine.
		echo 'its: gicv3 @ 0x[0-9a-f]+ translate'
		echo '#l0: irq 8192 msi-x'
		echo 'sdF: first interrupt, irq 8193 msi-x'
		echo 'BLK-OK /dev/sdF0/data'
		echo 'DHCP-OK'
		# And memory sized from the firmware's map rather than from
		# mem.h.  The two numbers on this line are the falsify test
		# the riscv boards use for plicbase, in one line: mem.h
		# would say 0x50000000 and the machine has twice that, so a
		# board that ignored the map would lose half its memory.
		echo 'conf: memtop 0x[0-9a-f]+ from the loader \(mem.h would say 0x50000000\)';;
	virtarm64-noscan)
		# The scan is off, the tree was not found, and the board
		# booted anyway on its compiled-in constants.  All three
		# lines matter: the first says the switch reached the
		# kernel, the second that it did what it says, and the
		# third that what is left still runs.
		echo 'conf: the device-tree scan at PHYSDRAM is off'
		echo 'fdt: no device tree'
		echo 'ACPI-RSDP-OK'
		echo 'BLK-OK /dev/sdF0/data';;
	virtarm64-efi)
		# The loader, in its own words: it found plan9.ini, read the
		# name of the kernel out of it, and got far enough to print
		# "boot" before handing over.  Nothing else in this suite
		# produces these two lines, because nothing else has a boot
		# loader at all.
		echo 'bootfile=/ikernel'
		# "boot" on a line of its own, which is the last thing the
		# loader prints before ExitBootServices.  Anchored at the
		# front only, and with the carriage return the firmware's
		# console puts there spelled out: the UEFI console ends
		# every line CRLF, so "^boot$" matches nothing.
		echo '^boot.$'
		# The RSDP, from the EFI configuration table.  This is the
		# pointer ACPI discovery will be read through when it is
		# written, and it is here now, so the arm records that the
		# firmware hands it over and the loader passes it on.
		echo '\*acpi=0x[0-9a-f]+'
		# And the kernel, past the handoff: the MMU and the caches
		# were turned off and it built its own tables, found its
		# uart, enumerated PCI and reached Dis.
		echo 'Inferno/arm64 virt'
		echo 'BLK-OK /dev/sdF0/data'
		echo 'DHCP-OK'
		# With ACPI on, the tree the kernel falls back to is QEMU's
		# own rather than edk2's, and QEMU's has the v2m frame in
		# it -- so MSI works here where it does not under acpi=off.
		# Worth pinning: it is the one line that says which of the
		# two device trees this arm actually got.
		echo 'MSI-DOORBELL-OK';;
	virtarm64-gicv3)
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		# The ITS found, sized from its own registers, and its
		# tables and command queue accepted.  Checked rather than
		# assumed because every field in this line came from a
		# register read: GITS_TYPER says how wide a DeviceID is
		# and how big an ITT entry is, and a driver that guessed
		# either would build tables the part walks incorrectly.
		# The widths are matched as digits, not as the 16 and 12
		# QEMU reports today.  Pinning them would fail this arm on
		# a QEMU that raised ITS_DEVBITS, which is not a
		# regression in anything here; what is worth asserting is
		# that the driver read the fields at all and printed what
		# it read.
		echo 'its: gicv3 @ 0x8080000 translate 0x8090040, [0-9]+ devid bits, itt [0-9]+ bytes'
		# LPIs, which are the thing a v2 does not have.  8192 is
		# the first INTID the architecture allows for one, so the
		# two devices landing on 8192 and 8193 says the LPI
		# allocator started where it should -- it started at zero
		# once, and the ITS refused the mapping with "invalid
		# interrupt ID 0x0".
		echo '#l0: irq 8192 msi-x'
		echo 'sdF \(virtio10\): irq 8193 msi-x'
		# And delivery.  The disk reports the first interrupt to
		# reach its handler, which is the whole chain: the device
		# wrote its EventID to GITS_TRANSLATER, the ITS walked the
		# device table to an ITT and the ITT to an LPI, the
		# collection table sent that LPI to this cpu's
		# redistributor, and trap() dispatched an INTID far above
		# anything GICD knows about.  Every step before this one
		# can be right while this line is missing: it was, for an
		# afternoon, because GICR_PROPBASER.IDbits was one too
		# small and the redistributor dropped INTID 8192 as out of
		# range without a word.
		echo 'sdF: first interrupt, irq 8193 msi-x'
		# The network half, which proves receive and not just the
		# one queue the disk uses.
		echo 'DHCP-OK'
		;;
	virtarm64-msi)
		echo 'BLK-OK /dev/sdF0/data'	# see virtarm64-peer
		# Message-signalled interrupts, end to end, in four lines.
		#
		# The first says the board found the GICv2m frame in the
		# device tree and proved it before trusting it: gicv2minit()
		# rings the doorbell with a cpu store and reads the SPI
		# back out of GICD_ISPENDR, and MSI-DOORBELL-OK is only
		# printed when that arrived.  It is worth checking on its
		# own because it is the half that was wrong first -- the
		# frame pulses the line, and a level-configured SPI drops
		# it again before it can latch.
		#
		# The next two say both PCI functions took a vector, and
		# that they took DIFFERENT ones: 80 is the frame's first
		# SPI and 81 the second, so this also checks the allocator
		# hands out one vector per device rather than the same one
		# twice.  The ether line comes first because reset() runs
		# before the sd driver's enable.
		#
		# The last is delivery rather than configuration.  A
		# device can be configured for MSI-X, print all three
		# lines above, and never raise anything -- which is
		# exactly what happened before gicedge().  sdvirtio10
		# says so the first time an interrupt actually reaches
		# its handler, and names which kind it was.
		echo 'MSI-DOORBELL-OK'
		echo '#l0: irq 80 msi-x'
		echo 'sdF \(virtio10\): irq 81 msi-x'
		echo 'sdF: first interrupt, irq 81 msi-x'
		# DHCP-OK is in the marker set and would be there over
		# INTx too, so it is not evidence by itself.  This is:
		# with the net on PCI, the only path to it is a vector.
		# ethervirtio10's rxproc and txproc sleep on the queue
		# with no timeout, so nothing polls it back to life.
		echo '#l0: virtio10: 1000Mbps port 0x10008000 irq 80'
		;;
	esac
}

# The card each configuration wants.  Blank is fine: the kfs check
# reams what it is given, and the capacity checks read the card's own
# CSD rather than anything written here.  Separate files per
# configuration so two runs cannot race on one image.
config_card() {
	case $1 in
	raspi3b)	echo "sd16.img 16m";;
	raspi3b-4g)	echo "sd4g.img 4g";;
	raspi3b-usb)	echo "sd16d.img 16m";;
	raspi3b-2eth)	echo "sd16f.img 16m";;
	raspi4-2eth)	echo "sd16g.img 16m";;
	raspi4)		echo "sd16b.img 16m";;
	raspi4-hot)	echo "sd16c.img 16m";;
	raspi4-usb)	echo "sd16e.img 16m";;
	sifiveu)	echo "sdspi.img 16m";;
	*)		;;		# no card
	esac
}

usage() {
	echo "usage: $0 [-v] [-l] [-b [-f]] [config ...]" >&2
	exit 1
}

while [ $# -gt 0 ]; do
	case $1 in
	-v)	verbose=true; shift;;
	-b)	record=true; shift;;
	-f)	force=true; shift;;
	-l)	for c in $configs; do echo "$c"; done; exit 0;;
	-*)	usage;;
	*)	break;;
	esac
done

[ $# -gt 0 ] && configs="$*"

# Only the configurations that were asked for have to have a qemu.  The
# gate used to be unconditional, which meant a machine with no patched
# build -- a container, say -- could not run the six configurations that
# do not want one.
needpatched=false
for c in $configs; do
	case $c in raspi*) needpatched=true;; esac
done
if $needpatched && [ ! -x "$QEMU" ]; then
	echo "boardsuite: no patched QEMU at $QEMU (set QEMU=)" >&2
	echo "boardsuite: the Pi configurations need it; see tools/qemu-patches/README" >&2
	exit 2
fi
for c in $configs; do
	q=`config_qemu $c`
	if [ -z "$q" ] || [ ! -x "$q" ]; then
		echo "boardsuite: $c wants a qemu that is not here: ${q:-none found}" >&2
		exit 2
	fi
done

mkdir -p "$work"

# And a lock, because a per-checkout directory only stops the worktree
# case.  Two runs out of the same checkout collide the same way, and
# the second one is usually a "just this one arm" re-run started while
# the full run is still going -- which is precisely how the shared-work
# bug above was mistaken for a board regression three times over.  The
# lock holds the pid, so a suite killed with ^C does not lock the tree
# out: the stale entry is noticed and taken.
if [ -f "$work/lock" ]; then
	other=`cat "$work/lock" 2>/dev/null`
	if [ -n "$other" ] && kill -0 "$other" 2>/dev/null; then
		echo "boardsuite: pid $other is already running in $work" >&2
		echo "    wait for it, or set BOARDSUITE_WORK to another directory" >&2
		exit 2
	fi
fi
echo $$ > "$work/lock"
trap 'rm -f "$work/lock"' 0 1 2 3 15

# A blank card of the given size.  Sparse: the 4G one costs nothing
# until something writes to it, and nothing here writes 4G.
makecard() {
	[ -z "$1" ] && return
	f="$work/$1"
	case $2 in
	16m)	bytes=16777216;;
	4g)	bytes=4294967296;;
	*)	echo "boardsuite: unknown card size $2" >&2; exit 2;;
	esac
	if [ -f "$f" ] && [ `wc -c < "$f"` -eq $bytes ]; then
		return
	fi
	rm -f "$f"
	dd if=/dev/zero of="$f" bs=1 count=0 seek=$bytes 2>/dev/null
}

# A FAT16 image, for the two checks that want a filesystem rather than a
# blank card.  blkcheck() reads sector 0 of /dev/sdF0/data and requires
# the 0x55AA boot signature; writing those two bytes into a blank file
# would satisfy the letter of that and none of the point, so this makes
# a real filesystem.  fsmount() then mounts the same disk with dossrv
# and reads marker.txt out of it -- "smoke.sh plants marker.txt", says
# the comment in virtinit.b, and nothing here ever did, which is what
# FS-FAIL meant on virt.  So the file is planted at creation, and a
# host that can make the filesystem but not write into it fails rather
# than handing back an image half the check cannot use.
makefat() {
	f="$work/$1"
	name=$2
	body=$3
	[ -f "$f" ] && return 0
	if command -v hdiutil >/dev/null 2>&1; then
		hdiutil create -size 16m -fs MS-DOS -volname BOARDSUITE \
			-layout NONE -ov "$work/fatmk" >/dev/null 2>&1 || return 1
		mv "$work/fatmk.dmg" "$f" || return 1
		mnt=`hdiutil attach -nobrowse "$f" 2>/dev/null |
			sed -n 's;.*\(/Volumes/[^ 	]*\).*;\1;p' | head -1`
		if [ -z "$mnt" ]; then
			rm -f "$f"
			return 1
		fi
		printf '%s\n' "$body" > "$mnt/$name" || {
			hdiutil detach "$mnt" >/dev/null 2>&1
			rm -f "$f"
			return 1
		}
		hdiutil detach "$mnt" >/dev/null 2>&1 || return 1
		return 0
	fi
	for mk in mkfs.vfat mkfs.fat; do
		if command -v $mk >/dev/null 2>&1; then
			dd if=/dev/zero of="$f" bs=1 count=0 seek=16777216 2>/dev/null
			if $mk -F 16 "$f" >/dev/null 2>&1; then
				if command -v mcopy >/dev/null 2>&1; then
					printf '%s\n' "$body" > "$work/$name"
					mcopy -i "$f" "$work/$name" "::$name" \
						>/dev/null 2>&1 || { rm -f "$f"; return 1; }
					return 0
				fi
				echo "boardsuite: no mcopy; the FAT image would carry no file" >&2
				rm -f "$f"
				return 1
			fi
			rm -f "$f"
			return 1
		fi
	done
	return 1
}

# The UEFI firmware for aarch64, which is not part of this tree.
#
# It ships with qemu, under a name that says aarch64 and a companion
# vars image that does not: there is no edk2-aarch64-vars.fd anywhere,
# and the arm one is the same 64M and works.  Copied rather than used in
# place, because the firmware writes its boot entries into the vars
# image and a run must not depend on what the last one left there.
firmware() {
	for d in /opt/homebrew/share/qemu /usr/share/qemu \
		/usr/share/edk2/aarch64 "$QEMUBIOS"; do
		[ -n "$d" ] && [ -f "$d/edk2-aarch64-code.fd" ] || continue
		[ -f "$d/edk2-arm-vars.fd" ] || continue
		echo "$d"
		return 0
	done
	return 1
}

# A FAT16 image holding an EFI system partition: the loader where the
# firmware looks for it with no boot entry configured, the kernel, and
# the plan9.ini that names the kernel.
#
# Same two host recipes as makefat and for the same reason -- hdiutil on
# a mac, mkfs.vfat and mcopy elsewhere -- and rebuilt every run rather
# than kept, because unlike a blank card its contents are the thing
# under test.
makeesp() {
	f="$work/$1"
	loader=$2
	kern=$3
	extra=$4			# extra plan9.ini lines, or empty
	rm -f "$f"
	if command -v hdiutil >/dev/null 2>&1; then
		hdiutil create -size 64m -fs MS-DOS -volname ESP \
			-layout NONE -ov "$work/espmk" >/dev/null 2>&1 || return 1
		mv "$work/espmk.dmg" "$f" || return 1
		mnt=`hdiutil attach -nobrowse "$f" 2>/dev/null |
			sed -n 's;.*\(/Volumes/[^ 	]*\).*;\1;p' | head -1`
		[ -z "$mnt" ] && { rm -f "$f"; return 1; }
		{
			mkdir -p "$mnt/EFI/BOOT" &&
			cp "$loader" "$mnt/EFI/BOOT/BOOTAA64.EFI" &&
			cp "$kern" "$mnt/ikernel" &&
			{ echo 'bootfile=/ikernel'
			  [ -n "$extra" ] && printf '%s\n' "$extra"
			  true; } > "$mnt/plan9.ini"
		} || {
			hdiutil detach "$mnt" >/dev/null 2>&1
			rm -f "$f"
			return 1
		}
		hdiutil detach "$mnt" >/dev/null 2>&1 || return 1
		return 0
	fi
	for mk in mkfs.vfat mkfs.fat; do
		command -v $mk >/dev/null 2>&1 || continue
		command -v mcopy >/dev/null 2>&1 || {
			echo "boardsuite: no mcopy; the esp would carry no loader" >&2
			return 1
		}
		dd if=/dev/zero of="$f" bs=1 count=0 seek=67108864 2>/dev/null
		$mk -F 16 "$f" >/dev/null 2>&1 || { rm -f "$f"; return 1; }
		{ echo 'bootfile=/ikernel'
		  [ -n "$extra" ] && printf '%s\n' "$extra"
		  true; } > "$work/plan9.ini"
		mmd -i "$f" ::/EFI ::/EFI/BOOT >/dev/null 2>&1
		mcopy -i "$f" "$loader" ::/EFI/BOOT/BOOTAA64.EFI >/dev/null 2>&1 &&
		mcopy -i "$f" "$kern" ::/ikernel >/dev/null 2>&1 &&
		mcopy -i "$f" "$work/plan9.ini" ::/plan9.ini >/dev/null 2>&1 ||
			{ rm -f "$f"; return 1; }
		return 0
	done
	return 1
}

# Markers, as a sorted set.  No word boundary at either end.
#
# The trailing one went first: a marker can be followed immediately by
# another process's output on the same line, which is what hid
# SD-FS-CREATE-OK.  The leading one is the same bug in a mirror and
# took longer to meet -- on a board with a mouse attached, the usb
# controller's ctl dump is still printing when USB-OK arrives, and the
# log carries "... hub 2 port 3 rUSB-OK".  A \b between "r" and "U"
# does not exist, so the marker was not there, and the run reported 38
# where the board had said 39.
#
# The cost of dropping it is that a word ending in a marker's name
# would match.  The cost of keeping it is losing markers a board really
# printed, which this suite exists to prevent.
markers() {
	grep -oE '[A-Z][A-Z0-9]+(-[A-Z0-9]+)*-(OK|NONE|FAIL|ACCEPTED)' "$1" |
		sort -u
}

# Whether a configuration wants the host end of its network checks.
# virtinit.b's network chain does not stop at the wire: it dials
# tcp!10.0.2.2!54322 and udp!10.0.2.2!54325 and wants "pong" back, and
# it announces tcp!*!54323 and udp!*!54326 and waits for someone to
# call in.  Nothing in this tree ever answered, so TCP-NET-FAIL
# "connection refused" and TCP-IN-FAIL "timeout" were the checks
# reporting, correctly, that the other end did not exist.  That is the
# same shape as BLK-FAIL and FS-FAIL: a check failing because nothing
# gave it what it tests.  os/inferno/virt/smoke.sh has answered these
# since the board was written; this is that rig, as a service the suite
# starts and stops around one boot.
config_hostnet() {
	case $1 in
	virt|virts|virt-peer|peer-mixed)	echo yes;;
	# virtarm64 and its peer reach the same checks now that their
	# root carries dossrv and ping: TCP-NET, UDP-NET and the two
	# inbound halves all dial the host rig, and without it the
	# board reported TCP-NET-FAIL "connection refused" -- the host
	# end that was never started, not the board.
	virtarm64|virtarm64-msi|virtarm64-nvme|virtarm64-xhci|virtarm64-gicv3|virtarm64-efi|virtarm64-acpi|virtarm64-peer)	echo yes;;
	esac
}

# The host end: two echo servers, a web server for Charon, and two
# clients that keep knocking until the guest has announced.  One
# process with threads rather than five, so there is one pid to stop.
hostnetpid=
hostnet_start() {
	[ -z "`config_hostnet $1`" ] && return 0
	if ! command -v python3 >/dev/null 2>&1; then
		echo "boardsuite: no python3; $1 has no host end for its network checks" >&2
		return 1
	fi
	mkdir -p "$work/http"
	printf '%s\n' '<html><body>boardsuite-http</body></html>' \
		> "$work/http/smoke.html"
	cat > "$work/hostnet.py" <<'HOSTNET'
import http.server as httpserver
import socket, socketserver, sys, threading, time

root = sys.argv[1]

# Every socket is bound here, in the main thread, before anything is
# served.  A port already in use then kills this process outright and
# the suite says so, rather than raising inside a daemon thread and
# leaving a live pid with nothing behind it -- which is what happened
# the first time, when a shadowed name took the web server out and the
# only sign was a traceback nobody read.
tcp_echo_s = socket.socket()
tcp_echo_s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
tcp_echo_s.bind(('127.0.0.1', 54322))
tcp_echo_s.listen(8)

udp_echo_s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
udp_echo_s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
udp_echo_s.bind(('127.0.0.1', 54325))

class Handler(httpserver.SimpleHTTPRequestHandler):
    def __init__(self, *a, **k):
        super().__init__(*a, directory=root, **k)
    def log_message(self, *a):
        pass

socketserver.TCPServer.allow_reuse_address = True
httpd = socketserver.TCPServer(('127.0.0.1', 8765), Handler)

def tcp_echo():
    while True:
        c, _ = tcp_echo_s.accept()
        threading.Thread(target=tcp_echo_one, args=(c,), daemon=True).start()

def tcp_echo_one(c):
    try:
        c.settimeout(10)
        c.recv(64)
        c.sendall(b'pong')
    except OSError:
        pass
    finally:
        c.close()

def udp_echo():
    while True:
        try:
            data, addr = udp_echo_s.recvfrom(64)
        except OSError:
            continue
        if data[:5] == b'hello':
            udp_echo_s.sendto(b'pong', addr)

# The guest announces late, and the hostfwd accepts the connection
# whether or not anything inside is listening yet, so a single knock
# proves nothing.  Keep knocking until one comes back "pong".
def tcp_knock():
    while True:
        s = socket.socket()
        s.settimeout(2)
        try:
            s.connect(('127.0.0.1', 54323))
            s.sendall(b'hello')
            if s.recv(64)[:4] == b'pong':
                return
        except OSError:
            pass
        finally:
            s.close()
        time.sleep(0.5)

def udp_knock():
    while True:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.settimeout(2)
        try:
            s.sendto(b'hello', ('127.0.0.1', 54326))
            if s.recvfrom(64)[0][:4] == b'pong':
                return
        except OSError:
            pass
        finally:
            s.close()
        time.sleep(0.5)

for fn in (tcp_echo, udp_echo, httpd.serve_forever, tcp_knock, udp_knock):
    threading.Thread(target=fn, daemon=True).start()

while True:
    time.sleep(3600)
HOSTNET
	python3 "$work/hostnet.py" "$work/http" >"$work/hostnet.log" 2>&1 &
	hostnetpid=$!
	# A port already in use is a sentence worth printing: without it
	# the guest reports the failure and the reason looks like the
	# guest's.
	i=0
	while [ $i -lt 20 ]; do
		if ! kill -0 $hostnetpid 2>/dev/null; then
			echo "boardsuite: host end died at once; see $work/hostnet.log" >&2
			hostnetpid=
			return 1
		fi
		if grep -q Traceback "$work/hostnet.log" 2>/dev/null; then
			echo "boardsuite: host end raised; see $work/hostnet.log" >&2
			hostnet_stop
			return 1
		fi
		i=`expr $i + 1`
		sleep 0.1
	done
	return 0
}

hostnet_stop() {
	# The guard covers the wait as well as the kill.  A bare "wait"
	# does not mean "wait for nothing", it means wait for every
	# background job in this shell -- which was harmless while the
	# host rig was the only one, and became a four-minute pause the
	# day the mouse got its own process.
	if [ -n "$hostnetpid" ]; then
		kill $hostnetpid 2>/dev/null
		wait $hostnetpid 2>/dev/null || true
	fi
	hostnetpid=
}

# The hand on the mouse and on the keyboard.  Connects to qemu's
# monitor and sends, once a second, a motion in x with a press and
# release of the right and middle buttons, and the word the keyboard
# check waits for -- which is exactly what mousecheck() and kbdcheck()
# are looking for.  It repeats rather than firing once because the
# windows it has to land in open when the guest opens /dev/pointer and
# /dev/keyboard, and nothing outside the guest knows when that is;
# events sent before then go nowhere and cost nothing.
mousepid=
mouse_start() {
	port=`config_qmp $1`
	[ -z "$port" ] && return 0
	if ! command -v python3 >/dev/null 2>&1; then
		echo "boardsuite: no python3; $1 has no way to move its mouse" >&2
		return 1
	fi
	cat > "$work/mouse.py" <<'MOUSE'
import json, socket, sys, time

port = int(sys.argv[1])
deadline = time.time() + float(sys.argv[2])

s = None
while time.time() < deadline:
    try:
        s = socket.socket()
        s.connect(('127.0.0.1', port))
        break
    except OSError:
        s = None
        time.sleep(0.5)
if s is None:
    sys.exit('no qmp port %d' % port)

f = s.makefile('rw')
f.readline()                                    # the greeting
f.write(json.dumps({'execute': 'qmp_capabilities'}) + '\n')
f.flush()
f.readline()

def send(events):
    f.write(json.dumps({'execute': 'input-send-event',
                        'arguments': {'events': events}}) + '\n')
    f.flush()
    f.readline()

# Three quarters along x and one quarter down y, in QEMU's absolute
# range (0..0x7fff, INPUT_EVENT_ABS_MAX).  QEMU routes 'abs' to an
# absolute device and 'rel' to a relative one, so the tablet takes
# these and the mouse takes the sweep below without either seeing the
# other's events.  The guest's tablet check scales the same fractions
# onto its screen and waits for that point to arrive.
ABSMAX = 0x7fff
absx = ABSMAX * 3 // 4
absy = ABSMAX // 4

while time.time() < deadline:
    send([{'type': 'abs', 'data': {'axis': 'x', 'value': absx}},
          {'type': 'abs', 'data': {'axis': 'y', 'value': absy}}])
    send([{'type': 'rel', 'data': {'axis': 'x', 'value': 8}}])
    for b in ('right', 'middle'):
        send([{'type': 'btn', 'data': {'down': True, 'button': b}}])
        send([{'type': 'btn', 'data': {'down': False, 'button': b}}])
    # The word is "hello" because the comment above the guest's own
    # call has said so since before either end of this existed.
    for k in 'hello':
        send([{'type': 'key', 'data': {'down': True,
                                       'key': {'type': 'qcode', 'data': k}}}])
        send([{'type': 'key', 'data': {'down': False,
                                       'key': {'type': 'qcode', 'data': k}}}])
    time.sleep(1)
MOUSE
	python3 "$work/mouse.py" "$port" "$timeout" >"$work/$1.mouse.log" 2>&1 &
	mousepid=$!
	return 0
}

mouse_stop() {
	if [ -n "$mousepid" ]; then
		kill $mousepid 2>/dev/null
		wait $mousepid 2>/dev/null || true
	fi
	mousepid=
}

# The USB stick is made fresh before every boot, unlike every other
# image here, because the check that reads it also writes to it:
# diskcheck() creates pi.txt, so a second boot finds two files and
# DISK-READ-OK reports whichever the directory read returns first.
# Before every boot and not once per configuration, because a
# configuration that fails is booted again and the second boot would
# otherwise get the stick the first one wrote on.
#
# The file's contents are lower case on purpose.  The first thing
# diskcheck() does with the file it finds is print it, and the marker
# extractor reads the log rather than the board's intentions: a stick
# carrying the virt image's "FS-OK boardsuite" made this configuration
# report FS-OK, a marker no check on this board prints.  Nothing on a
# disk here may be shaped like a marker.
freshstick() {
	case $1 in
	raspi3b-usb)	img=usb16.img;;
	raspi4-usb)	img=usb16b.img;;
	virtarm64-xhci)	img=usbvx.img;;
	*)		return 0;;
	esac
	rm -f "$work/$img"
	makefat $img usb.txt 'a file on the usb stick'
}

status=0

# One boot of one configuration.  Leaves the log, the marker set, the
# diff and the missing-evidence list in $work, and echoes the reasons it
# failed -- empty means it passed.
attempt() {
	c=$1
	log="$work/$c.log"
	got="$work/$c.markers"
	base="$here/$c.markers"
	rm -f "$log"
	last=`config_last $c`
	if ! freshstick "$c"; then
		echo "no way to make a FAT16 image here (hdiutil, or mkfs.vfat and mcopy)"
		return
	fi
	if ! hostnet_start "$c"; then
		echo "no host end for its network checks"
		return
	fi

	# qemu's own complaints go to a file rather than to nowhere.  An
	# emulator that refuses to start -- a disk image another process
	# still holds is the one that happens -- otherwise reports as
	# "never reached ROOT-CMDS-OK", which is true and useless.
	err="$work/$c.qemu.err"
	rm -f "$err"
	qmp=
	qmpport=`config_qmp $c`
	[ -n "$qmpport" ] && qmp="-qmp tcp:127.0.0.1:$qmpport,server=on,wait=off"
	# The EFI arm gets no -kernel: the whole point of it is that the
	# firmware finds the loader on the ESP and the loader finds the
	# kernel.  Passing one as well would be qemu doing the loader's
	# job in silence, and the arm would pass with a broken loader.
	kern=
	case $c in
	virtarm64-efi|virtarm64-noscan|virtarm64-acpi)	;;
	*)						kern="-kernel $kernel";;
	esac
	# shellcheck disable=SC2046,SC2086
	"$qemu" `config_args $c` $qmp -display none -serial file:"$log" \
		$kern >/dev/null 2>"$err" &
	pid=$!
	if ! mouse_start "$c"; then
		echo "no hand on the mouse"
		kill $pid 2>/dev/null || true
		wait $pid 2>/dev/null || true
		hostnet_stop
		return
	fi

	# The other guest, if this configuration has one.  It goes second
	# because the first one holds the listening end of the socket the
	# two of them share -- and qemu's socket netdev is not patient
	# about that: a connect= that is refused makes qemu exit at once,
	# so starting the second one in the same breath as the first is a
	# race, and it is the race that made this configuration fail one
	# run in three.  The port cannot be probed either, because the
	# listening end accepts exactly one peer and a probe would be it.
	# So: give the first one a moment, start the second, and if it
	# died in the first second start it again.
	peerlog="$work/$c.peer.log"
	peerpid=
	peerargs=`config_peer $c`
	if [ -n "$peerargs" ]; then
		peerkernel=`config_peer_kernel $c`
		peerqemu=`config_peer_qemu $c`
		if [ -z "$peerqemu" ] || [ ! -x "$peerqemu" ]; then
			echo "the other guest wants a qemu that is not here: ${peerqemu:-none found}"
			hostnet_stop
			kill $pid 2>/dev/null || true
			wait $pid 2>/dev/null || true
			return
		fi
		rm -f "$peerlog"
		try=0
		while [ $try -lt 10 ]; do
			sleep 2
			# shellcheck disable=SC2086
			"$peerqemu" $peerargs -display none -serial file:"$peerlog" \
				-kernel "$peerkernel" >/dev/null 2>"$work/$c.peer.err" &
			peerpid=$!
			sleep 1
			if kill -0 $peerpid 2>/dev/null; then
				break
			fi
			wait $peerpid 2>/dev/null || true
			peerpid=
			try=`expr $try + 1`
		done
		if [ -z "$peerpid" ]; then
			if [ -s "$work/$c.peer.err" ]; then
				echo "the other guest: `head -1 "$work/$c.peer.err"`"
			else
				echo "the other guest would not stay up"
			fi
			hostnet_stop
			kill $pid 2>/dev/null || true
			wait $pid 2>/dev/null || true
			return
		fi
	fi

	waited=0
	while [ $waited -lt $timeout ]; do
		if allseen "$log" $last; then
			break
		fi
		if ! kill -0 $pid 2>/dev/null; then
			break
		fi
		sleep 2
		waited=`expr $waited + 2`
	done

	# Output after the last marker still has to land.  This is a flush
	# window, not a race against a check that has not reported yet --
	# config_last names the marker that really comes last, so that
	# race is gone.
	sleep $settle
	kill $pid 2>/dev/null || true
	wait $pid 2>/dev/null || true
	if [ -n "$peerpid" ]; then
		kill $peerpid 2>/dev/null || true
		wait $peerpid 2>/dev/null || true
	fi
	hostnet_stop
	mouse_stop

	if ! allseen "$log" $last; then
		# Two things were wrong with what this used to report.
		#
		# Every run ends by killing qemu, and qemu writes
		# "terminating on signal 15" to stderr when it is killed,
		# so $err was never empty and the honest message below was
		# dead code.  A boot that simply ran out of time came back
		# dressed as an emulator error -- which is how three arm64
		# configurations starved by another process on the host
		# were reported as "qemu: terminating on signal 15".  The
		# teardown line is filtered out before deciding.
		#
		# And $got is left over from whatever ran last.  Returning
		# here without rewriting it made the caller's marker count
		# a number from a previous run: a log holding two markers
		# was reported as 41.  Write this run's count, even when
		# it is zero.
		markers "$log" > "$got" 2>/dev/null || : > "$got"
		if grep -v 'terminating on signal 15' "$err" 2>/dev/null | grep -q .; then
			echo "qemu: `grep -v 'terminating on signal 15' "$err" | head -1`"
		else
			echo "never reached $last in ${timeout}s"
		fi
		return
	fi

	markers "$log" > "$got"
	: > "$work/$c.missing"
	rm -f "$work/$c.diff" "$work/$c.faildiff"
	grep -- '-FAIL' "$got" | sort > "$work/$c.failed" || true

	$record && return

	if [ ! -f "$base" ]; then
		echo "no baseline at $base (run with -b once, after reading the log)"
		return
	fi

	fail=''
	diff -u "$base" "$got" > "$work/$c.diff" || fail="$fail markers"

	# Failures a board is known to have.  Some boards reach a shell and
	# then fail every check that wants a module their root does not
	# carry; that is worth recording exactly rather than either hiding
	# it or refusing to watch the board at all.  The set has to match:
	# a new -FAIL fails the run, and so does one that went away, since
	# a debt that got paid should be written down.
	grep -- '-FAIL' "$got" | sort > "$work/$c.failed"
	if [ -f "$here/$c.expected" ]; then
		diff -u "$here/$c.expected" "$work/$c.failed" \
			> "$work/$c.faildiff" || fail="$fail known-FAIL-set"
	elif [ -s "$work/$c.failed" ]; then
		fail="$fail -FAIL"
	fi

	config_evidence $c | while read -r e; do
		[ -z "$e" ] && continue
		grep -qE "$e" "$log" || echo "$e"
	done > "$work/$c.missing"

	# The other guest is rig rather than a board, so it has no
	# baseline and no marker set -- but the one thing it exists to
	# say still has to be there, or the configuration passed on the
	# strength of a conversation that only one side had.
	config_peer_evidence $c | while read -r e; do
		[ -z "$e" ] && continue
		grep -qE "$e" "$peerlog" 2>/dev/null || echo "peer: $e"
	done >> "$work/$c.missing"
	[ -s "$work/$c.missing" ] && fail="$fail evidence"

	echo $fail
}

for c in $configs; do
	kernel=`config_kernel $c`
	if [ -z "$kernel" ]; then
		echo "boardsuite: no such configuration: $c" >&2
		status=2
		continue
	fi
	if [ ! -f "$kernel" ]; then
		echo "$c: FAIL no kernel at $kernel (mk it first)"
		status=1
		continue
	fi
	newer=`newer_source_than "$kernel"`
	if [ -n "$newer" ]; then
		echo "$c: FAIL kernel older than $newer (mk it first)"
		echo "    $kernel"
		echo "    set BOARDSUITE_NOSTALECHECK=1 to run it anyway"
		status=1
		continue
	fi

	qemu=`config_qemu $c`
	if [ -z "$qemu" ] || [ ! -x "$qemu" ]; then
		echo "$c: FAIL no qemu for this board (looked for `config_qemu $c`)"
		status=1
		continue
	fi

	makecard `config_card $c`
	# virts belongs on this list as much as virt does -- it carries the
	# same fat16.img in its qemu line.  It ran only because virt comes
	# before it in $configs and had already made the image; asked for
	# on its own with an empty work directory, qemu had no such file.
	case $c in virt|virts|virtarm64|virtarm64-msi|virtarm64-nvme|virtarm64-xhci|virtarm64-gicv3|virtarm64-efi|virtarm64-noscan|virtarm64-acpi|virt-peer|virtarm64-peer|peer-mixed) needfat=true;; *) needfat=false;; esac
	if $needfat && ! makefat fat16.img marker.txt 'FS-OK boardsuite'; then
		echo "$c: FAIL no way to make a FAT16 image here (hdiutil or mkfs.vfat)"
		echo "    BLK-OK needs a filesystem, not a blank card; see the README"
		status=1
		continue
	fi

	# The EFI arm needs three things this suite does not otherwise
	# touch: the firmware, a writable copy of its variable store, and
	# an EFI system partition with the loader and the kernel on it.
	# All three are made here rather than in config_args, because a
	# missing one has to be reported as itself and not as a board that
	# never printed its last marker.
	fwdir=
	case $c in
	virtarm64-efi)		espextra=;;
	virtarm64-noscan|virtarm64-acpi)
				espextra='*nofdtscan=1';;
	esac
	case $c in
	virtarm64-efi|virtarm64-noscan|virtarm64-acpi)	wantsesp=true;;
	*)						wantsesp=false;;
	esac
	if $wantsesp; then
		loader=$root/os/inferno/boot/efi/bootaa64.efi
		if [ ! -f "$loader" ]; then
			echo "$c: FAIL no loader at $loader"
			echo "    mk bootaa64.efi in os/inferno/boot/efi"
			status=1
			continue
		fi
		fwdir=`firmware` || {
			echo "$c: FAIL no aarch64 UEFI firmware on this host"
			echo "    wanted edk2-aarch64-code.fd and edk2-arm-vars.fd;"
			echo "    set QEMUBIOS to the directory holding them"
			status=1
			continue
		}
		cp "$fwdir/edk2-arm-vars.fd" "$work/vars.fd" || {
			echo "$c: FAIL could not copy the firmware variable store"
			status=1
			continue
		}
		if ! makeesp esp.img "$loader" "$kernel" "$espextra"; then
			echo "$c: FAIL no way to make an EFI system partition here"
			echo "    wanted hdiutil, or mkfs.vfat with mmd and mcopy"
			status=1
			continue
		fi
	fi

	fail=`attempt $c`
	retried=false

	# Several of these checks time themselves against the system timer
	# and compare a count to what the elapsed time predicts.  Host load
	# only ever costs them events, never gains them -- run this while
	# something else has the CPU and ARMTIMER, ARMTIMER-INTR and SYSTMR
	# will report -FAIL for a board that is fine, which is the same
	# one-sided error the checks themselves handle by taking a best of
	# several.  So a failing configuration is booted once more.  A real
	# regression fails twice; a starved run passes the second time and
	# says it needed to, because a retry that is not reported is a
	# suite that hides a flake.
	# Retried when recording too, which it did not used to be.  A
	# starved run is exactly what must not become a baseline, and the
	# second boot is the remedy already written for it: refusing to
	# record is right, but refusing when one more boot would have
	# passed spends a twenty-configuration run to learn the host was
	# busy.
	if [ -n "$fail" ]; then
		case "$fail" in
		*"no baseline"*|*"no kernel"*|*"kernel older"*)	;;
		*)	fail=`attempt $c`; retried=true;;
		esac
	fi

	got="$work/$c.markers"
	log="$work/$c.log"
	base="$here/$c.markers"

	if $record; then
		if [ -n "$fail" ]; then
			echo "$c: FAIL $fail"
			status=1
			continue
		fi
		n=`wc -l < "$got" | tr -d ' '`
		# A run that stopped early produces a subset, and a subset
		# recorded as a baseline is a regression written down as
		# the new truth -- which is the failure this whole script
		# exists to prevent, so the code prevents it rather than
		# the README asking nicely.  -f is for the case where the
		# markers really did go away and you mean it.
		if [ -f "$base" ] && ! $force; then
			o=`wc -l < "$base" | tr -d ' '`
			if [ "$n" -lt "$o" ]; then
				echo "$c: FAIL refusing to record $n markers over a baseline of $o"
				echo "    lost:" `comm -23 "$base" "$got" | tr '\n' ' '`
				echo "    read $log first; -f records it anyway"
				status=1
				continue
			fi
			# Counting is not enough, and this cost a baseline
			# before it was noticed.  A check that printed
			# USB-MOUSE-OK and now prints USB-MOUSE-FAIL loses
			# one line and gains one, so the count does not
			# move and the shrink test above sees nothing --
			# and -b writes the failure down as the new truth,
			# which is exactly the thing this block exists to
			# prevent.  So: any name that was -OK in the
			# baseline and is now -FAIL or -NONE is a
			# regression whatever the total says.
			for m in `sed -n 's/-OK$//p' "$base"`; do
				grep -qx "$m-OK" "$got" && continue
				if grep -qxE "$m-(FAIL|NONE)" "$got"; then
					echo "$c: FAIL refusing to record $m-OK degraded to" \
						`grep -xE "$m-(FAIL|NONE)" "$got"`
					echo "    read $log first; -f records it anyway"
					status=1
					continue 2
				fi
			done
		fi
		cp "$got" "$base"
		if [ -s "$work/$c.failed" ]; then
			cp "$work/$c.failed" "$here/$c.expected"
			echo "$c: recorded $n markers in $base, and `wc -l < "$work/$c.failed" | tr -d ' '` known -FAIL"
		else
			rm -f "$here/$c.expected"
			echo "$c: recorded $n markers in $base"
		fi
		continue
	fi

	n=`wc -l < "$got" 2>/dev/null | tr -d ' '`
	known=''
	if [ -s "$work/$c.failed" ]; then
		known=" and `wc -l < "$work/$c.failed" | tr -d ' '` known -FAIL"
	fi
	if [ -z "$fail" ]; then
		if $retried; then
			echo "$c: ok $n markers$known (on the second boot; the first was starved)"
		else
			echo "$c: ok $n markers$known"
		fi
	else
		echo "$c: FAIL $fail ($n markers, log $log)"
		[ -s "$work/$c.diff" ] && sed -n '3,$p' "$work/$c.diff" | sed 's/^/    /'
		[ -s "$work/$c.faildiff" ] && sed -n '3,$p' "$work/$c.faildiff" | sed 's/^/    /'
		if [ -s "$work/$c.missing" ]; then
			while read -r m; do
				echo "    missing evidence: $m"
			done < "$work/$c.missing"
		fi
		status=1
	fi

	if $verbose; then
		sed 's/^/    /' "$got"
	fi
done

exit $status
