#!/bin/sh
#
# Compile every source a kernel actually links, with the flags that kernel
# actually uses, and report the diagnostics kencc does not fail on.
#
#	sh tools/kaudit            # raspi3b
#	sh tools/kaudit pc64       # another config
#	PAT='not declared' sh tools/kaudit
#
# WHY THIS EXISTS.  7c exits 0 and WRITES AN OBJECT for a call to a function
# that is not declared in the translation unit:
#
#	void zz(void){ gg_nosuch(); }     exit=0  object=YES
#	    function not declared: gg_nosuch
#
# so `mk` sees success, archives the object, and prints no
# "exit status=exit(1)".  Neither an exit-status check nor a grep for
# clang's "error:" (which kencc never prints) sees it.  The link backstops it
# only when NO symbol of that name exists anywhere -- a misspelling onto a
# real symbol compiles, links, and misbehaves at runtime with nothing to find.
#
# The case that stays silent is a call to a function defined in ANOTHER file,
# i.e. the ordinary cross-file call with a missing extern.  When the callee is
# defined later in the same file with a different type, kencc has both
# declarations to compare, prints "external redeclaration of:" as well, and
# DOES fail -- which is why the easy-to-notice shape is the unrepresentative
# one.  doc/open-issues-plan.ms H4.
#
# HOW IT AVOIDS THE TWO MISTAKES THAT MADE THE FIRST SWEEP USELESS.  Done by
# hand this produced twelve findings and all twelve were artifacts:
#
#   WRONG FLAGS.  raspi3b.c is compiled with '-DKERNDATE='$KERNDATE by the
#   mkfile.  A hand invocation without it reports "name not declared:
#   KERNDATE" -- a real diagnostic about a build that never happens.
#
#   WRONG FILE SET.  Sweeping ../port/*.c flagged eleven files (devboot,
#   devpci, portclock, rdb and others) with plausible misses like "function
#   not declared: segflush".  NONE of them is linked into raspi3b: they are
#   other boards' port files read against this board's headers.
#
# So both come from `mk -n -a`, which prints every recipe WITHOUT RUNNING ANY
# of them.  The flags are the build's own, including per-file defines, and the
# file set is exactly what this kernel compiles.  Neither is guessed here.
#
# IT DOES NOT TOUCH THE TREE.  Every object goes to a temp directory, so
# i$CONF and kernel8.img are never replaced -- which matters because
# tools/jtag/{vmheld,kstack,where,wedgediag} verify the board's kerndate
# against kernel8.img and refuse on mismatch, and tools/jtag/kmesg reads an
# address with no such check at all.  Relinking mid-experiment disarms the
# first four and silently misleads the fifth.
#
# WHAT HAS ACTUALLY BEEN RUN.  raspi3b: 110 sources, 0 findings for the
# declaration patterns.  virtarm64: 98 sources, 2 findings, both
# "conversion of pointer to shorter integer" and both examined (one is
# devkprof's by-design ulong profile range, one is a print format).  The
# can-it-fire check was PAT='shorter integer' on raspi3b, which produced two
# findings -- so this tool has been shown capable of reporting, not only of
# saying nothing.  It found one real bug on its first control run: PADDR()
# returning ulong into xhole()'s uintptr.
#
# NOT run on: pc64, or any non-arm64 config.  The PATH line below assumes a
# MacOSX/<arch>/bin toolchain, so on another host that is the first thing
# that will need changing.
#
# PATTERNS THAT ARE NOT WORTH ADDING, measured rather than guessed.
#
# `used and not set` and `set and not used` look like the uninitialised-variable
# class and in this kernel they are dominated by ONE structural false positive:
# error() never returns -- it raises -- and kencc does not know that, so any
#
#	switch(x){ case A: v = 1; break; default: error(Egreg); }
#	... use v ...
#
# reports "used and not set: v" although v is set on every path that continues.
# Checked on all three hits before believing them:
#
#	devusb.c:936   isotiming()   max   -- default: error(Egreg)
#	devsd.c:1357   sdwrite()     ifc sdev
#	devcons.c:958                o
#
# So that pattern is high-noise here and is deliberately NOT in the default
# PAT.  Pass it explicitly if you want it, and expect to verify each hit
# against an error() path before filing anything.
#
set -u
HERE=`cd \`dirname "$0"\` && pwd`
ROOT=`cd "$HERE/.." && pwd`
CONF=${1:-raspi3b}
PAT=${PAT:-'not declared|redeclaration|type clash|incompatible'}
DIR=$ROOT/os/inferno/$CONF

[ -d "$DIR" ] || { echo "kaudit: no such config: $DIR" >&2; exit 1; }

PATH=$ROOT/MacOSX/$(uname -m | sed 's/^arm64$/arm64/')/bin:$PATH
export PATH
command -v mk >/dev/null || { echo "kaudit: mk not on PATH" >&2; exit 1; }

TMP=${TMPDIR:-/tmp}/kaudit.$$
mkdir -p "$TMP" || exit 1
trap 'rm -rf "$TMP"' 0 1 2 15

cd "$DIR" || exit 1

#
# -n prints recipes, -a pretends everything is out of date.  Without -a an
# up-to-date tree prints nothing at all and the audit silently examines no
# files -- which reads exactly like a clean result.
#
mk -n -a "i$CONF" > "$TMP/recipes" 2>"$TMP/mkerr" || {
	echo "kaudit: mk -n failed:" >&2
	head -5 "$TMP/mkerr" >&2
	exit 1
}

#
# A compile line ends in the source file, and carries no -o, so 7c would
# write the object into the tree.  Insert -o into the temp directory instead.
#
awk -v tmp="$TMP" '
	#
	# LEADING WHITESPACE IS NOT OPTIONAL TO ALLOW FOR.  mk prints the
	# recipes it would run for THIS mkfile own targets at column 0 and
	# the ones inherited through other rules TAB-INDENTED.  A pattern
	# anchored at column 0 matched 39 of 110 sources here -- every board
	# file and not one of ../port or ../ip -- and reported "clean" over a
	# third of the kernel without saying it was a third.
	#
	/^[ \t]*[0-9a-z]+c .*\.c$/ {
		src = $NF
		$NF = ""
		cmd = $0
		sub(/^[ \t]+/, "", cmd)
		printf "%s-o %s/o.7 %s\n", cmd, tmp, src
	}' "$TMP/recipes" > "$TMP/cmds"

n=`grep -c . "$TMP/cmds"`
if [ "$n" = 0 ]; then
	echo "kaudit: no compile lines found in the recipes for i$CONF." >&2
	echo "kaudit: that is a FAILURE of this tool, not a clean audit." >&2
	exit 2
fi

#
# WHAT THIS DOES NOT COVER, said in the output rather than left to be assumed.
#
# The board mkfile links PREBUILT ARCHIVES -- $LIBFILES -- so no library source
# appears in its recipes and none is audited.  Measured: 0 of the compile lines
# name a file under libtk, libinterp, libmemdraw or libsec.
#
# That is not academic.  A peer hit exactly the bug this tool is for, in
# libtk/ebind.c: a `static announce(Tk*)` colliding with kern.h's
# `announce(char*, char*)`, which Inferno's lib9.h reaches and the host's does
# not -- clean on MacOSX/arm64, fatal under 7c.  This tool would NOT have found
# it, because libtk is outside the set it can see.
#
# So "clean" below means clean for the kernel's OWN sources.  Auditing a
# library means running this in that library's directory against its own
# mkfile, which is a different invocation and not this one.
#
echo "kaudit: $CONF, $n sources, flags and file set from mk -n -a"
echo "kaudit: NOT covered -- the prebuilt archives this kernel links:"
awk '/^[ \t]*[0-9a-z]+l .*-o i/ {
	for(i = 1; i <= NF; i++)
		if($i ~ /\.a$/) {
			sub(/.*\//, "", $i)
			printf "kaudit:   %s\n", $i
		}
	exit
}' "$TMP/recipes"
echo "kaudit: matching: $PAT"
hits=0
files=0
while read -r cmd; do
	src=`echo "$cmd" | awk '{print $NF}'`
	files=$((files+1))
	( eval "$cmd" ) > "$TMP/out" 2>&1
	st=$?
	if grep -qE "$PAT" "$TMP/out"; then
		hits=$((hits+1))
		echo "--- $src (exit $st):"
		grep -E "$PAT" "$TMP/out" | sed 's/^/    /'
	elif [ $st -ne 0 ]; then
		#
		# A hard failure with none of the patterns in it is still a
		# finding: reported separately rather than counted as clean,
		# because "the audit found nothing" and "the file would not
		# build" are different answers.
		#
		hits=$((hits+1))
		echo "--- $src DID NOT COMPILE (exit $st), and no pattern matched:"
		grep -v '^$' "$TMP/out" | head -4 | sed 's/^/    /'
	fi
done < "$TMP/cmds"

echo "kaudit: $files compiled, $hits with findings"
[ "$hits" = 0 ] && echo "kaudit: clean for $CONF's OWN sources -- the archives above are unaudited"
exit 0
