+/**
+ * sdbus_is_occupied: does this bus already hold a device?
+ *
+ * An SD bus takes one device.  A controller whose bus is already
+ * occupied -- by an SDIO function, say -- must not have a card moved
+ * onto it.
+ */
+bool sdbus_is_occupied(SDBus *sdbus);
+
+/**
+ * sdbus_holds_card: does this bus hold a removable SD card?
+ *
+ * True only for a card in a slot, not for a soldered-down device such
+ * as an eMMC or an SDIO function.  Pin routing switches the card slot
+ * between controllers; it does not move parts that are wired to one.
+ */
+bool sdbus_holds_card(SDBus *sdbus);
+
+/**
