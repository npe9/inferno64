+
+/* ------------------------------------------------------------------ *
+ * SDIO
+ *
+ * An I/O-only function: it answers the SDIO command set and none of
+ * the memory-card one.  CMD8, ACMD41 and CMD9 are absent from the
+ * protocol table on purpose, so a driver that probes with the memory
+ * sequence is told the command is unsupported rather than being
+ * quietly indulged.
+ * ------------------------------------------------------------------ */
+
+static void sdio_reset_registers(SDState *sd)
+{
+    memset(sd->cccr, 0, sizeof(sd->cccr));
+    memset(sd->fn1, 0, sizeof(sd->fn1));
+    sd->cccr[CCCR_REVISION]   = 0x32;   /* CCCR/FBR 3.00, SDIO spec 3.00 */
+    sd->cccr[CCCR_SD_SPEC]    = 0x03;
+    sd->cccr[CCCR_IO_ENABLE]  = 0x00;   /* no function enabled yet */
+    sd->cccr[CCCR_IO_READY]   = 0x00;
+    sd->cccr[CCCR_BUS_CONTROL] = 0x00;  /* 1-bit bus */
+    sd->cccr[CCCR_CAPABILITY] = 0x17;   /* SDC|SMB|SBS|S4MI */
+    sd->cccr[CCCR_BLKSIZE_LO] = 0x00;
+    sd->cccr[CCCR_BLKSIZE_HI] = 0x02;   /* 512 */
+    /* The function's own FBR says what it is: a standard I/O function. */
+    sd->fn1[0x00] = 0x00;
+    sd->fn1[0x01] = 0x00;
+    sd->io_rsp = 0;
+    sd->io_ocr = 0;
+}
+
+/*
+ * The R5 response is the card status byte in bits 15:8 and, for a
+ * read or a read-after-write, the register value in bits 7:0.
+ */
+static uint32_t sdio_r5(SDState *sd, uint8_t data, bool error)
+{
+    uint32_t flags = 0;
+
+    if (error) {
+        flags |= 1 << 14;               /* ILLEGAL_COMMAND */
+    }
+    if (sd->state == sd_transfer_state) {
+        flags |= 1 << 12;               /* IO_CURRENT_STATE = CMD */
+    }
+    return flags | data;
+}
+
+/* Is fn:addr a register this function actually has? */
+static uint8_t *sdio_reg(SDState *sd, unsigned int fn, unsigned int addr)
+{
+    if (fn == 0) {
+        if (addr < SDIO_CCCR_SIZE) {
+            return &sd->cccr[addr];
+        }
+        /* The FBR for function 1 is aliased into function 0's space. */
+        if (addr >= 0x100 && addr < 0x100 + 0x100) {
+            return &sd->fn1[addr - 0x100];
+        }
+        return NULL;
+    }
+    if (fn == 1 && addr < SDIO_FN1_SIZE) {
+        return &sd->fn1[addr];
+    }
+    return NULL;
+}
+
+/* Is function fn allowed to move data yet? */
+static bool sdio_function_ready(SDState *sd, unsigned int fn)
+{
+    if (fn == 0) {
+        return true;                    /* function 0 is always reachable */
+    }
+    if (fn > SDIO_NFUNC) {
+        return false;
+    }
+    return (sd->cccr[CCCR_IO_ENABLE] & (1 << fn)) &&
+           (sd->cccr[CCCR_IO_READY] & (1 << fn));
+}
+
+/* CMD5 */
+static sd_rsp_type_t sd_cmd_IO_SEND_OP_COND(SDState *sd, SDRequest req)
+{
+    uint32_t window = req.arg & 0x00ffffff;
+
+    if (sd->state != sd_idle_state && sd->state != sd_ready_state) {
+        return sd_invalid_state_for_cmd(sd, req);
+    }
+
+    /*
+     * A zero argument is an enquiry: report the functions present and
+     * the voltage window, with the ready bit clear.  A non-zero one
+     * asks for that window, and the card comes ready if it can supply
+     * it.
+     */
+    sd->io_ocr = SDIO_OCR_VOLTAGE | (SDIO_NFUNC << 28);
+    if (window != 0) {
+        if (!(window & SDIO_OCR_VOLTAGE)) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "SDIO: requested voltage window 0x%06x is not "
+                          "supported\n", window);
+            sd->io_rsp = sd->io_ocr;
+            return sd_r4;
+        }
+        sd->io_ocr |= 1u << 31;         /* ready */
+        /*
+         * An I/O-only card has no CID, so there is no CMD2 to issue:
+         * it goes straight to the identification state, where CMD3
+         * publishes its relative address.
+         */
+        sd->state = sd_identification_state;
+    }
+    sd->io_rsp = sd->io_ocr;
+    return sd_r4;
+}
+
+/* CMD52 */
+static sd_rsp_type_t sd_cmd_IO_RW_DIRECT(SDState *sd, SDRequest req)
+{
+    unsigned int fn = (req.arg >> 28) & 7;
+    unsigned int addr = (req.arg >> 9) & 0x1ffff;
+    bool write = !!(req.arg & (1u << 31));
+    bool raw = !!(req.arg & (1 << 27));
+    uint8_t val = req.arg & 0xff;
+    uint8_t *reg;
+
+    if (sd->state != sd_transfer_state) {
+        return sd_invalid_state_for_cmd(sd, req);
+    }
+
+    reg = sdio_reg(sd, fn, addr);
+    if (reg == NULL) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "SDIO: CMD52 to function %u address 0x%05x, which this "
+                      "function does not have\n", fn, addr);
+        sd->io_rsp = sdio_r5(sd, 0, true);
+        return sd_r5;
+    }
+
+    if (write) {
+        uint8_t old = *reg;
+
+        *reg = val;
+        /*
+         * Enabling a function makes it ready; the two registers are
+         * separate so that a driver can be seen to wait for the second
+         * after writing the first.
+         */
+        if (fn == 0 && addr == CCCR_IO_ENABLE) {
+            sd->cccr[CCCR_IO_READY] = val & ((1 << (SDIO_NFUNC + 1)) - 2);
+        }
+        sd->io_rsp = sdio_r5(sd, raw ? *reg : old, false);
+    } else {
+        sd->io_rsp = sdio_r5(sd, *reg, false);
+    }
+    return sd_r5;
+}
+
+/* CMD53 */
+static sd_rsp_type_t sd_cmd_IO_RW_EXTENDED(SDState *sd, SDRequest req)
+{
+    unsigned int fn = (req.arg >> 28) & 7;
+    unsigned int addr = (req.arg >> 9) & 0x1ffff;
+    unsigned int count = req.arg & 0x1ff;
+    bool write = !!(req.arg & (1u << 31));
+    bool block = !!(req.arg & (1 << 27));
+    bool incr = !!(req.arg & (1 << 26));
+    unsigned int len;
+
+    if (sd->state != sd_transfer_state) {
+        return sd_invalid_state_for_cmd(sd, req);
+    }
+    if (!sdio_function_ready(sd, fn)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "SDIO: CMD53 to function %u before it was enabled and "
+                      "ready (IOEx 0x%02x, IORx 0x%02x)\n", fn,
+                      sd->cccr[CCCR_IO_ENABLE], sd->cccr[CCCR_IO_READY]);
+        sd->io_rsp = sdio_r5(sd, 0, true);
+        return sd_r5;
+    }
+
+    /* A count of zero means 512, in either mode. */
+    len = count ? count : 512;
+    if (block) {
+        if (len != 1) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "SDIO: CMD53 asks for %u blocks; this function "
+                          "moves one block per command\n", len);
+            sd->io_rsp = sdio_r5(sd, 0, true);
+            return sd_r5;
+        }
+        len = 512;
+    }
+    if (len > sizeof(sd->data)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "SDIO: CMD53 transfer of %u bytes is too long\n", len);
+        sd->io_rsp = sdio_r5(sd, 0, true);
+        return sd_r5;
+    }
+    if (sdio_reg(sd, fn, addr) == NULL ||
+        (incr && sdio_reg(sd, fn, addr + len - 1) == NULL)) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "SDIO: CMD53 covers function %u addresses 0x%05x..0x%05x, "
+                      "which run past the end of its register space\n",
+                      fn, addr, addr + len - 1);
+        sd->io_rsp = sdio_r5(sd, 0, true);
+        return sd_r5;
+    }
+
+    sd->sdio_fn = fn;
+    sd->sdio_addr = addr;
+    sd->sdio_incr = incr;
+    sd->sdio_write = write;
+    sd->io_rsp = sdio_r5(sd, 0, false);
+
+    if (write) {
+        sd->state = sd_receivingdata_state;
+        sd->data_start = addr;
+        sd->data_offset = 0;
+        sd->data_size = len;
+        return sd_r5;
+    }
+
+    /* Gather the bytes the host is about to read. */
+    for (unsigned int i = 0; i < len; i++) {
+        uint8_t *reg = sdio_reg(sd, fn, incr ? addr + i : addr);
+
+        sd->data[i] = reg ? *reg : 0;
+    }
+    sd->state = sd_sendingdata_state;
+    sd->data_start = addr;
+    sd->data_offset = 0;
+    sd->data_size = len;
+    return sd_r5;
+}
+
+/* Hand back a CMD53 write once the whole transfer has arrived. */
+static void sdio_complete_write(SDState *sd)
+{
+    for (unsigned int i = 0; i < sd->data_size; i++) {
+        uint8_t *reg = sdio_reg(sd, sd->sdio_fn,
+                                sd->sdio_incr ? sd->sdio_addr + i
+                                              : sd->sdio_addr);
+        if (reg) {
+            *reg = sd->data[i];
+        }
+    }
+}
+
+static const SDProto sd_proto_sdio = {
+    .name = "SDIO",
+    .cmd = {
+        [0]  = {0, sd_bc,  "GO_IDLE_STATE", sd_cmd_GO_IDLE_STATE},
+        [3]  = {0, sd_bcr, "SEND_RELATIVE_ADDR", sd_cmd_SEND_RELATIVE_ADDR},
+        [5]  = {9, sd_bcr, "IO_SEND_OP_COND", sd_cmd_IO_SEND_OP_COND},
+        [7]  = {0, sd_ac,  "(DE)SELECT_CARD", sd_cmd_DE_SELECT_CARD},
+        [15] = {0, sd_ac,  "GO_INACTIVE_STATE", sd_cmd_GO_INACTIVE_STATE},
+        [52] = {9, sd_ac,  "IO_RW_DIRECT", sd_cmd_IO_RW_DIRECT},
+        [53] = {9, sd_adtc, "IO_RW_EXTENDED", sd_cmd_IO_RW_EXTENDED},
+    },
+};
+
 static const SDProto sd_proto_spi = {
     .name = "SPI",
     .cmd = {
@@ -2866,6 +3214,34 @@ static void sdmmc_common_class_init(ObjectClass *klass, const void *data)
     sc->get_readonly = sd_get_readonly;
 }
 
+/* An SDIO function is soldered down and always present. */
+static bool sdio_get_inserted(SDState *sd)
+{
+    return true;
+}
+
+static void sdio_realize(DeviceState *dev, Error **errp)
+{
+    SDState *sd = SDMMC_COMMON(dev);
+
+    if (sd->blk) {
+        error_setg(errp, "An SDIO function takes no drive");
+        return;
+    }
+    sd->spec_version = SD_PHY_SPECv3_01_VERS;
+}
+
+static void sdio_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    SDCardClass *sc = SDMMC_COMMON_CLASS(klass);
+
+    dc->desc = "SDIO I/O function";
+    dc->realize = sdio_realize;
+    sc->proto = &sd_proto_sdio;
+    sc->get_inserted = sdio_get_inserted;
+}
+
 static void sd_class_init(ObjectClass *klass, const void *data)
 {
     DeviceClass *dc = DEVICE_CLASS(klass);
@@ -2937,6 +3313,11 @@ static const TypeInfo sd_types[] = {
         .parent         = TYPE_SDMMC_COMMON,
         .class_init     = emmc_class_init,
     },
+    {
+        .name           = TYPE_SD_IO,
+        .parent         = TYPE_SDMMC_COMMON,
+        .class_init     = sdio_class_init,
+    },
 };
 
 DEFINE_TYPES(sd_types)
