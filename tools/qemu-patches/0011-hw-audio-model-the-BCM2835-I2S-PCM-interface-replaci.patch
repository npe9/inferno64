+++ b/include/hw/audio/bcm2835_i2s.h
@@ -0,0 +1,56 @@
+/*
+ * BCM2835 I2S/PCM audio interface
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef BCM2835_I2S_H
+#define BCM2835_I2S_H
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_BCM2835_I2S "bcm2835-i2s"
+OBJECT_DECLARE_SIMPLE_TYPE(BCM2835I2SState, BCM2835_I2S)
+
+/* Both FIFOs are 64 words deep on this SoC. */
+#define BCM2835_I2S_FIFO_DEPTH 64
+
+struct BCM2835I2SState {
+    SysBusDevice busdev;
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* The PCM clock, from the clock manager's pcm mux. */
+    Clock *clk;
+
+    /*
+     * Raised when a threshold or error condition needs attention.  The
+     * FIFOs themselves are advanced on demand rather than by this
+     * timer; see the comment in the .c file.
+     */
+    QEMUTimer *timer;
+
+    uint32_t cs;
+    uint32_t mode;
+    uint32_t rxc;
+    uint32_t txc;
+    uint32_t dreq;
+    uint32_t inten;
+    uint32_t intstc;
+    uint32_t gray;
+
+    uint32_t txfifo[BCM2835_I2S_FIFO_DEPTH];
+    uint32_t rxfifo[BCM2835_I2S_FIFO_DEPTH];
+    uint32_t txlen, txhead;
+    uint32_t rxlen, rxhead;
+
+    /* When the serialiser last consumed or produced a frame. */
+    int64_t last_frame_ns;
+};
+
+#endif
