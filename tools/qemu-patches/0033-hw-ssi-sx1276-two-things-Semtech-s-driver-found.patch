From ec3397e2a413f12ad5e05391628f89a089f755d1 Mon Sep 17 00:00:00 2001
From: Noah Evans <noah.evans@gmail.com>
Date: Sat, 19 Sep 2026 06:59:48 -0400
Subject: [PATCH 33/33] hw/ssi/sx1276: two things Semtech's driver found

Both are this model reading one register page's rules onto the other.

Being in FSK is not an error.  It is where the part sits out of reset,
and the datasheet says LongRangeMode only changes in sleep, so every
driver that wants LoRa passes through FSK sleep to get there.  This
model logged a guest error for the passage itself, which Semtech's
driver in drivers/lora/loramac-node/sx127x.c provoked five times in one
boot.  What is worth refusing is asking an unmodelled modem to transmit
or receive, so that is what it refuses now.

And the read-only registers are read-only in LoRa mode only.  0x1a is
RegPktRssiValue on that page and RegAfcFei on the other, which a driver
writes: their init walks an FSK register table, and refusing those
writes was wrong.  RegVersion stays read-only either way.

With both fixed, samples/drivers/lora/send on mps2/an385 runs against
this model with no guest-error output at all: 'SX127x version 0x12
found' and then 'Data sent!' every second.  Neither fault was reachable
by the driver this model was written beside, because that driver only
ever uses the LoRa page.
---
 hw/ssi/sx1276.c | 39 ++++++++++++++++++++++++++++++++++-----
 1 file changed, 34 insertions(+), 5 deletions(-)

diff --git a/hw/ssi/sx1276.c b/hw/ssi/sx1276.c
index df54d78..0b7d926 100644
--- a/hw/ssi/sx1276.c
+++ b/hw/ssi/sx1276.c
@@ -212,9 +212,22 @@ static void sx1276_set_opmode(SX1276State *s, uint8_t val)
 
     s->regs[R_OPMODE] = val;
 
+    /*
+     * Being in FSK is not an error: it is where a part sits out of
+     * reset, and the datasheet says LongRangeMode can only be changed
+     * in sleep, so every driver that wants LoRa passes through FSK
+     * sleep to get there.  This model complained about the passage
+     * itself until Semtech's driver did it five times in one boot.
+     * What is worth refusing is asking an unmodelled modem to do
+     * something -- transmit or receive -- which is the test below.
+     */
     if (!sx1276_lora(s)) {
-        qemu_log_mask(LOG_GUEST_ERROR,
-                      "sx1276: FSK/OOK mode is not modelled\n");
+        if (now == MODE_TX || now == MODE_RXCONTINUOUS ||
+            now == MODE_RXSINGLE) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "sx1276: mode %d asked of the FSK modem, which is "
+                          "not modelled\n", now);
+        }
         return;
     }
 
@@ -246,14 +259,30 @@ static void sx1276_reg_write(SX1276State *s, uint8_t addr, uint8_t val)
         sx1276_update_irq(s);
         return;
     case R_VERSION:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "sx1276: write to read-only register 0x%02x\n", addr);
+        return;
     case R_RXNBBYTES:
     case R_FIFORXCURRENTADDR:
     case R_PKTSNRVALUE:
     case R_PKTRSSIVALUE:
     case R_RSSIVALUE:
-        qemu_log_mask(LOG_GUEST_ERROR,
-                      "sx1276: write to read-only register 0x%02x\n", addr);
-        return;
+        /*
+         * Read-only in LoRa mode and something else entirely in FSK:
+         * 0x1a is RegPktRssiValue on this page and RegAfcFei on the
+         * other, which a driver writes.  Semtech's own driver walks an
+         * FSK register table during init -- that is how the modem is
+         * switched, since LongRangeMode only changes in sleep -- and
+         * refusing those writes was this model reading one page's rules
+         * onto the other.  RegVersion above is read-only either way.
+         */
+        if (sx1276_lora(s)) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "sx1276: write to read-only LoRa register 0x%02x\n",
+                          addr);
+            return;
+        }
+        break;
     default:
         break;
     }
