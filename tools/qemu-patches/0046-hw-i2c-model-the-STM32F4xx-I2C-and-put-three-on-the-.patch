From 0f95a035ef721d03336c31542f7b31482d506da0 Mon Sep 17 00:00:00 2001
From: Noah Evans <noah.evans@gmail.com>
Date: Tue, 22 Sep 2026 09:47:16 -0400
Subject: [PATCH] hw/i2c: model the STM32F4xx I2C and put three on the
 netduinoplus2

The F4's I2C is the one peripheral on this part whose registers can
all be right and whose driver still hangs, because three of its flags
are cleared by reading one register and then touching another, in that
order and no other: SB by reading SR1 then writing DR, ADDR by reading
SR1 then SR2.  Until ADDR is cleared the part stretches SCL, so a
receive begins when SR2 is read and not when the address is
acknowledged -- which is why ACK and POS have to be arranged before
that read, and why there are three receive procedures in RM0090 27.3.3
and not one.

This models those rules rather than assuming them.  A DR write without
the SR1 read leaves SB set and sends nothing, as silicon does.  The
receive shift register behind DR is modelled too, so BTF means what it
means: DR and the shift register both full.  Without it the two-byte
and three-from-the-end procedures are ceremony around a register file
and a driver that skipped them would pass here and hang on a board.

ACK is applied when a byte arrives, not when the guest reads it, and
POS moves that decision on by one byte, which is the whole reason the
two-byte procedure exists.  A NAKed byte is the last one.

Each controller names its bus after itself, so a part goes on one of
them by name:

	-device ds1338,bus=i2c2,address=0x68

The three unimplemented-device stubs at 0x40005400, 0x40005800 and
0x40005c00 go, and ds1338 is implied by the machine so it can be
fitted.  Master mode, seven-bit addressing; slave mode, ten-bit
addressing, SMBus, PEC, DMA and the clock rate are not modelled --
CCR, TRISE and FREQ are stored and nothing is timed by them.

Verified with Inferno's #J on a netduinoplus2 and a ds1338 on I2C2:
the bus probe finds 0x68 and nothing on I2C3, and seven bytes written
into the NVRAM at offset 8 read back byte for byte, one, two and three
at a time -- which is each of the three receive procedures in turn.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 hw/arm/Kconfig                 |   2 +
 hw/arm/stm32f405_soc.c         |  28 +-
 hw/i2c/Kconfig                 |   4 +
 hw/i2c/meson.build             |   1 +
 hw/i2c/stm32f4xx_i2c.c         | 469 +++++++++++++++++++++++++++++++++
 include/hw/i2c/stm32f4xx_i2c.h |  81 ++++++
 6 files changed, 582 insertions(+), 3 deletions(-)
 create mode 100644 hw/i2c/stm32f4xx_i2c.c
 create mode 100644 include/hw/i2c/stm32f4xx_i2c.h

diff --git a/hw/arm/Kconfig b/hw/arm/Kconfig
index cdca611..28e665e 100644
--- a/hw/arm/Kconfig
+++ b/hw/arm/Kconfig
@@ -144,6 +144,7 @@ config NETDUINOPLUS2
     default y
     depends on TCG && ARM
     select STM32F405_SOC
+    imply DS1338
 
 config OLIMEX_STM32_H405
     bool
@@ -410,6 +411,7 @@ config STM32F405_SOC
     select STM32F4XX_EXTI
     select CC1120
     select SPLIT_IRQ
+    select STM32F4XX_I2C
 
 config B_L475E_IOT01A
     bool
diff --git a/hw/arm/stm32f405_soc.c b/hw/arm/stm32f405_soc.c
index 3083223..fa281d2 100644
--- a/hw/arm/stm32f405_soc.c
+++ b/hw/arm/stm32f405_soc.c
@@ -43,6 +43,7 @@ static const uint32_t adc_addr[] = { 0x40012000, 0x40012100, 0x40012200,
                                      0x40012300, 0x40012400, 0x40012500 };
 static const uint32_t spi_addr[] =   { 0x40013000, 0x40003800, 0x40003C00,
                                        0x40013400, 0x40015000, 0x40015400 };
+static const uint32_t i2c_addr[] =   { 0x40005400, 0x40005800, 0x40005C00 };
 #define EXTI_ADDR                      0x40013C00
 
 #define SYSCFG_IRQ               71
@@ -50,6 +51,9 @@ static const int usart_irq[] = { 37, 38, 39, 52, 53, 71, 82, 83 };
 static const int timer_irq[] = { 28, 29, 30, 50 };
 #define ADC_IRQ 18
 static const int spi_irq[] =   { 35, 36, 51, 0, 0, 0 };
+/* each I2C has two: event, then error */
+static const int i2c_irq[][2] = { {31, 32}, {33, 34}, {72, 73} };
+static const char *i2c_name[] = { "i2c1", "i2c2", "i2c3" };
 
 /*
  * The nine GPIO ports, a kilobyte apart from 0x40020000.  Only A and B
@@ -107,6 +111,10 @@ static void stm32f405_soc_initfn(Object *obj)
         object_initialize_child(obj, "spi[*]", &s->spi[i], TYPE_STM32F2XX_SPI);
     }
 
+    for (i = 0; i < STM_NUM_I2CS; i++) {
+        object_initialize_child(obj, "i2c[*]", &s->i2c[i], TYPE_STM32F4XX_I2C);
+    }
+
     for (i = 0; i < STM_NUM_GPIOS; i++) {
         object_initialize_child(obj, "gpio[*]", &s->gpio[i],
                                 TYPE_STM32F4XX_GPIO);
@@ -278,6 +286,23 @@ static void stm32f405_soc_realize(DeviceState *dev_soc, Error **errp)
         sysbus_connect_irq(busdev, 0, qdev_get_gpio_in(armv7m, spi_irq[i]));
     }
 
+    /*
+     * I2C controllers.  Each names its bus after itself, so a part
+     * is fitted to one of them by that name: a ds1338 on I2C2 is
+     *   -device ds1338,bus=i2c2,address=0x68
+     */
+    for (i = 0; i < STM_NUM_I2CS; i++) {
+        dev = DEVICE(&(s->i2c[i]));
+        qdev_prop_set_string(dev, "name", i2c_name[i]);
+        if (!sysbus_realize(SYS_BUS_DEVICE(&s->i2c[i]), errp)) {
+            return;
+        }
+        busdev = SYS_BUS_DEVICE(dev);
+        sysbus_mmio_map(busdev, 0, i2c_addr[i]);
+        sysbus_connect_irq(busdev, 0, qdev_get_gpio_in(armv7m, i2c_irq[i][0]));
+        sysbus_connect_irq(busdev, 1, qdev_get_gpio_in(armv7m, i2c_irq[i][1]));
+    }
+
     /* EXTI device */
     for (i = 0; i < STM_NUM_GPIOS; i++) {
         dev = DEVICE(&s->gpio[i]);
@@ -324,9 +349,6 @@ static void stm32f405_soc_realize(DeviceState *dev_soc, Error **errp)
     create_unimplemented_device("IWDG",        0x40003000, 0x400);
     create_unimplemented_device("I2S2ext",     0x40003000, 0x400);
     create_unimplemented_device("I2S3ext",     0x40004000, 0x400);
-    create_unimplemented_device("I2C1",        0x40005400, 0x400);
-    create_unimplemented_device("I2C2",        0x40005800, 0x400);
-    create_unimplemented_device("I2C3",        0x40005C00, 0x400);
     create_unimplemented_device("CAN1",        0x40006400, 0x400);
     create_unimplemented_device("CAN2",        0x40006800, 0x400);
     create_unimplemented_device("PWR",         0x40007000, 0x400);
