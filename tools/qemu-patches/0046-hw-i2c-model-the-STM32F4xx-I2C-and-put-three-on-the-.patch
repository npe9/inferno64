+#ifndef HW_STM32F4XX_I2C_H
+#define HW_STM32F4XX_I2C_H
+
+#include "hw/sysbus.h"
+#include "hw/i2c/i2c.h"
+#include "qom/object.h"
+
+#define STM32F4XX_I2C_CR1     0x00
+#define STM32F4XX_I2C_CR2     0x04
+#define STM32F4XX_I2C_OAR1    0x08
+#define STM32F4XX_I2C_OAR2    0x0c
+#define STM32F4XX_I2C_DR      0x10
+#define STM32F4XX_I2C_SR1     0x14
+#define STM32F4XX_I2C_SR2     0x18
+#define STM32F4XX_I2C_CCR     0x1c
+#define STM32F4XX_I2C_TRISE   0x20
+#define STM32F4XX_I2C_FLTR    0x24
+
+#define TYPE_STM32F4XX_I2C "stm32f4xx-i2c"
+OBJECT_DECLARE_SIMPLE_TYPE(STM32F4xxI2CState, STM32F4XX_I2C)
+
+struct STM32F4xxI2CState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion mmio;
+    I2CBus *bus;
+    char *name;
+    qemu_irq evt_irq;
+    qemu_irq err_irq;
+
+    uint32_t cr1;
+    uint32_t cr2;
+    uint32_t oar1;
+    uint32_t oar2;
+    uint32_t dr;
+    uint32_t sr1;
+    uint32_t sr2;
+    uint32_t ccr;
+    uint32_t trise;
+    uint32_t fltr;
+
+    /*
+     * State the register file does not hold.  sr1_read is the first
+     * half of the two-register clearing sequences; shift is the
+     * receive shift register behind DR, which is what makes BTF mean
+     * anything.
+     */
+    bool sr1_read;
+    uint8_t shift;
+    bool shift_full;
+    bool xfer;
+    bool recv;
+    bool rxdone;
+    uint32_t rxcnt;
+};
+
+#endif /* HW_STM32F4XX_I2C_H */
