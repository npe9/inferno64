diff --git a/hw/i2c/stm32f4xx_i2c.c b/hw/i2c/stm32f4xx_i2c.c
new file mode 100644
index 0000000..03e6f26
--- /dev/null
+++ b/hw/i2c/stm32f4xx_i2c.c
@@ -0,0 +1,469 @@
+/*
+ * STM32F4xx I2C controller
+ *
+ * Copyright (c) 2026 Inferno RIO <noah.evans@gmail.com>
+ *
+ * Permission is hereby granted, free of charge, to any person obtaining a copy
+ * of this software and associated documentation files (the "Software"), to deal
+ * in the Software without restriction, including without limitation the rights
+ * to use, copy, modify, merge, publish, distribute, sublicense, and/or sell
+ * copies of the Software, and to permit persons to whom the Software is
+ * furnished to do so, subject to the following conditions:
+ *
+ * The above copyright notice and this permission notice shall be included in
+ * all copies or substantial portions of the Software.
+ *
+ * THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+ * IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+ * FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL
+ * THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+ * LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
+ * OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
+ * THE SOFTWARE.
+ *
+ * Master mode only, seven-bit addressing, written from RM0090 rev 21
+ * section 27 -- in particular the event table (EV5 to EV8_2) in 27.3.3,
+ * which is the part of this peripheral a driver gets wrong.
+ *
+ * The three rules that table states, and that this model enforces
+ * rather than assumes, because a model that ignores them lets a driver
+ * that would hang on silicon pass here:
+ *
+ *  - SB is cleared by reading SR1 and then writing DR.  A DR write
+ *    without the SR1 read does not send the address and leaves SB set.
+ *  - ADDR is cleared by reading SR1 and then SR2, in that order, and
+ *    nothing happens on the bus until it is: the part stretches the
+ *    clock.  So reception starts when SR2 is read, not when the
+ *    address is acknowledged.
+ *  - There is a shift register behind DR.  RxNE says DR is full; BTF
+ *    says DR and the shift register both are.  The two-byte and
+ *    three-byte-from-the-end receive procedures are written in terms
+ *    of BTF and are meaningless without it, so it is modelled: a
+ *    transfer moves bytes on demand, but through two stages.
+ *
+ * ACK is applied when a byte is received, not when the driver gets
+ * round to reading it, and POS moves that decision on by one byte --
+ * which is the whole of why the two-byte receive procedure exists.
+ *
+ * Not modelled: slave mode, ten-bit addressing, SMBus, PEC, DMA,
+ * arbitration loss and bus errors, and clock rate -- CCR, TRISE, FREQ
+ * and FLTR are stored and read back and nothing is timed by them.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/i2c/stm32f4xx_i2c.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+
+#define CR1_PE          (1 << 0)
+#define CR1_START       (1 << 8)
+#define CR1_STOP        (1 << 9)
+#define CR1_ACK         (1 << 10)
+#define CR1_POS         (1 << 11)
+#define CR1_SWRST       (1 << 15)
+
+#define CR2_ITERREN     (1 << 8)
+#define CR2_ITEVTEN     (1 << 9)
+#define CR2_ITBUFEN     (1 << 10)
+
+#define SR1_SB          (1 << 0)
+#define SR1_ADDR        (1 << 1)
+#define SR1_BTF         (1 << 2)
+#define SR1_ADD10       (1 << 3)
+#define SR1_STOPF       (1 << 4)
+#define SR1_RXNE        (1 << 6)
+#define SR1_TXE         (1 << 7)
+#define SR1_BERR        (1 << 8)
+#define SR1_ARLO        (1 << 9)
+#define SR1_AF          (1 << 10)
+#define SR1_OVR         (1 << 11)
+#define SR1_PECERR      (1 << 12)
+#define SR1_TIMEOUT     (1 << 14)
+#define SR1_SMBALERT    (1 << 15)
+
+#define SR1_EVENTS      (SR1_SB | SR1_ADDR | SR1_ADD10 | SR1_STOPF | SR1_BTF)
+#define SR1_BUFEVENTS   (SR1_RXNE | SR1_TXE)
+#define SR1_ERRORS      (SR1_BERR | SR1_ARLO | SR1_AF | SR1_OVR | \
+                         SR1_PECERR | SR1_TIMEOUT | SR1_SMBALERT)
+
+/* the bits of SR1 a driver may clear by writing zero to them */
+#define SR1_WRITABLE    SR1_ERRORS
+
+#define SR2_MSL         (1 << 0)
+#define SR2_BUSY        (1 << 1)
+#define SR2_TRA         (1 << 2)
+
+static void stm32f4xx_i2c_update_irq(STM32F4xxI2CState *s)
+{
+    int evt, err;
+
+    evt = (s->cr2 & CR2_ITEVTEN) &&
+          ((s->sr1 & SR1_EVENTS) ||
+           ((s->cr2 & CR2_ITBUFEN) && (s->sr1 & SR1_BUFEVENTS)));
+    err = (s->cr2 & CR2_ITERREN) && (s->sr1 & SR1_ERRORS);
+
+    qemu_set_irq(s->evt_irq, !!evt);
+    qemu_set_irq(s->err_irq, !!err);
+}
+
+/* abandon whatever is on the bus and go back to idle */
+static void stm32f4xx_i2c_idle(STM32F4xxI2CState *s)
+{
+    if (s->xfer) {
+        i2c_end_transfer(s->bus);
+    }
+    s->xfer = false;
+    s->recv = false;
+    s->rxdone = false;
+    s->rxcnt = 0;
+    s->shift_full = false;
+    s->sr1_read = false;
+    s->sr2 = 0;
+}
+
+static void stm32f4xx_i2c_reset_regs(STM32F4xxI2CState *s)
+{
+    s->cr1 = 0;
+    s->cr2 = 0;
+    s->oar1 = 0;
+    s->oar2 = 0;
+    s->dr = 0;
+    s->sr1 = 0;
+    s->sr2 = 0;
+    s->ccr = 0;
+    s->trise = 2;
+    s->fltr = 0;
+    s->shift = 0;
+    stm32f4xx_i2c_idle(s);
+}
+
+/*
+ * Pull bytes in while there is room for them.  A byte is acknowledged
+ * if ACK is set when it arrives; with POS the ACK bit applies to the
+ * byte after the one in DR, which is how the two-byte procedure NAKs
+ * the second byte while the first is still being received.  A NAKed
+ * byte is the last one: the master has said so on the wire.
+ */
+static void stm32f4xx_i2c_rxfill(STM32F4xxI2CState *s)
+{
+    bool nak;
+
+    while (s->xfer && s->recv && !s->rxdone) {
+        if (!(s->sr1 & SR1_RXNE)) {
+            s->dr = i2c_recv(s->bus);
+            s->sr1 |= SR1_RXNE;
+        } else if (!s->shift_full) {
+            s->shift = i2c_recv(s->bus);
+            s->shift_full = true;
+            s->sr1 |= SR1_BTF;
+        } else {
+            break;
+        }
+
+        nak = !(s->cr1 & CR1_ACK) &&
+              (!(s->cr1 & CR1_POS) || s->rxcnt >= 1);
+        s->rxcnt++;
+        if (nak) {
+            i2c_nack(s->bus);
+            s->rxdone = true;
+        }
+    }
+}
+
+static void stm32f4xx_i2c_start(STM32F4xxI2CState *s)
+{
+    /*
+     * A repeated START is a START while a transfer is in progress; the
+     * bus is not released, so the transfer is left alone here and the
+     * address that follows re-addresses the part.
+     */
+    s->sr1 |= SR1_SB;
+    s->sr2 |= SR2_MSL | SR2_BUSY;
+    s->sr1_read = false;
+}
+
+static void stm32f4xx_i2c_stop(STM32F4xxI2CState *s)
+{
+    /*
+     * The data already received stays readable: DR and the shift
+     * register are not touched, only the bus is.
+     */
+    if (s->xfer) {
+        i2c_end_transfer(s->bus);
+        s->xfer = false;
+    }
+    s->recv = false;
+    s->rxdone = false;
+    s->rxcnt = 0;
+    s->sr1 &= ~(SR1_TXE | SR1_SB | SR1_ADDR);
+    s->sr2 &= ~(SR2_MSL | SR2_BUSY | SR2_TRA);
+    s->sr1_read = false;
+}
+
+static void stm32f4xx_i2c_send_addr(STM32F4xxI2CState *s, uint8_t byte)
+{
+    bool recv = byte & 1;
+
+    s->sr1 &= ~SR1_SB;
+    s->sr1_read = false;
+
+    if (i2c_start_transfer(s->bus, byte >> 1, recv)) {
+        /* nothing answered: AF, and the driver sends a STOP */
+        s->sr1 |= SR1_AF;
+        s->xfer = false;
+        return;
+    }
+
+    s->xfer = true;
+    s->recv = recv;
+    s->rxdone = false;
+    s->rxcnt = 0;
+    s->shift_full = false;
+    s->sr1 &= ~(SR1_TXE | SR1_BTF | SR1_RXNE);
+    s->sr1 |= SR1_ADDR;
+    s->sr2 = SR2_MSL | SR2_BUSY | (recv ? 0 : SR2_TRA);
+}
+
+static void stm32f4xx_i2c_send_data(STM32F4xxI2CState *s, uint8_t byte)
+{
+    s->dr = byte;
+    if (i2c_send(s->bus, byte)) {
+        s->sr1 |= SR1_AF;
+        s->sr1 &= ~(SR1_TXE | SR1_BTF);
+        return;
+    }
+    /* the byte is gone: DR and the shift register are both empty */
+    s->sr1 |= SR1_TXE | SR1_BTF;
+}
+
+static uint64_t stm32f4xx_i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    STM32F4xxI2CState *s = opaque;
+    uint32_t v;
+
+    switch (addr) {
+    case STM32F4XX_I2C_CR1:
+        return s->cr1;
+    case STM32F4XX_I2C_CR2:
+        return s->cr2;
+    case STM32F4XX_I2C_OAR1:
+        return s->oar1;
+    case STM32F4XX_I2C_OAR2:
+        return s->oar2;
+    case STM32F4XX_I2C_DR:
+        v = s->dr;
+        if (s->sr1 & SR1_RXNE) {
+            s->sr1 &= ~SR1_RXNE;
+            if (s->shift_full) {
+                s->dr = s->shift;
+                s->shift_full = false;
+                s->sr1 &= ~SR1_BTF;
+                s->sr1 |= SR1_RXNE;
+            }
+            stm32f4xx_i2c_rxfill(s);
+            stm32f4xx_i2c_update_irq(s);
+        }
+        return v;
+    case STM32F4XX_I2C_SR1:
+        s->sr1_read = true;
+        return s->sr1;
+    case STM32F4XX_I2C_SR2:
+        /*
+         * EV6: ADDR is cleared here, by the second read of the pair,
+         * and only then does the part let the transfer go on.
+         */
+        if (s->sr1_read && (s->sr1 & SR1_ADDR)) {
+            s->sr1 &= ~SR1_ADDR;
+            s->sr1_read = false;
+            if (s->recv) {
+                stm32f4xx_i2c_rxfill(s);
+            } else {
+                s->sr1 |= SR1_TXE;
+            }
+            stm32f4xx_i2c_update_irq(s);
+        }
+        return s->sr2;
+    case STM32F4XX_I2C_CCR:
+        return s->ccr;
+    case STM32F4XX_I2C_TRISE:
+        return s->trise;
+    case STM32F4XX_I2C_FLTR:
+        return s->fltr;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: bad offset 0x%" HWADDR_PRIx "\n", __func__, addr);
+        return 0;
+    }
+}
+
+static void stm32f4xx_i2c_write(void *opaque, hwaddr addr, uint64_t val64,
+                                unsigned size)
+{
+    STM32F4xxI2CState *s = opaque;
+    uint32_t val = val64;
+
+    switch (addr) {
+    case STM32F4XX_I2C_CR1:
+        if (val & CR1_SWRST) {
+            stm32f4xx_i2c_reset_regs(s);
+            s->cr1 = val & ~CR1_SWRST;
+            break;
+        }
+        s->cr1 = val & ~(CR1_START | CR1_STOP);
+        if (!(val & CR1_PE)) {
+            stm32f4xx_i2c_idle(s);
+            s->sr1 = 0;
+            break;
+        }
+        if (val & CR1_STOP) {
+            stm32f4xx_i2c_stop(s);
+        }
+        if (val & CR1_START) {
+            stm32f4xx_i2c_start(s);
+        }
+        break;
+    case STM32F4XX_I2C_CR2:
+        s->cr2 = val;
+        break;
+    case STM32F4XX_I2C_OAR1:
+        s->oar1 = val;
+        break;
+    case STM32F4XX_I2C_OAR2:
+        s->oar2 = val;
+        break;
+    case STM32F4XX_I2C_DR:
+        if (s->sr1 & SR1_SB) {
+            /*
+             * EV5: the address.  Without the SR1 read that goes with
+             * it this write does not start anything -- SB stays set
+             * and the part waits, which is what silicon does.
+             */
+            if (s->sr1_read) {
+                stm32f4xx_i2c_send_addr(s, val);
+            } else {
+                s->dr = val;
+            }
+        } else if (s->xfer && !s->recv) {
+            stm32f4xx_i2c_send_data(s, val);
+        } else {
+            s->dr = val;
+        }
+        break;
+    case STM32F4XX_I2C_SR1:
+        /* the error bits are write-zero-to-clear; the rest are read-only */
+        s->sr1 &= val | ~SR1_WRITABLE;
+        break;
+    case STM32F4XX_I2C_SR2:
+        break;                          /* read-only */
+    case STM32F4XX_I2C_CCR:
+        s->ccr = val;
+        break;
+    case STM32F4XX_I2C_TRISE:
+        s->trise = val;
+        break;
+    case STM32F4XX_I2C_FLTR:
+        s->fltr = val;
+        break;
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "%s: bad offset 0x%" HWADDR_PRIx "\n", __func__, addr);
+        return;
+    }
+    stm32f4xx_i2c_update_irq(s);
+}
+
+static const MemoryRegionOps stm32f4xx_i2c_ops = {
+    .read = stm32f4xx_i2c_read,
+    .write = stm32f4xx_i2c_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid.min_access_size = 1,
+    .valid.max_access_size = 4,
+};
+
+static void stm32f4xx_i2c_reset(DeviceState *dev)
+{
+    stm32f4xx_i2c_reset_regs(STM32F4XX_I2C(dev));
+}
+
+static void stm32f4xx_i2c_init(Object *obj)
+{
+    STM32F4xxI2CState *s = STM32F4XX_I2C(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->mmio, obj, &stm32f4xx_i2c_ops, s,
+                          TYPE_STM32F4XX_I2C, 0x400);
+    sysbus_init_mmio(sbd, &s->mmio);
+    sysbus_init_irq(sbd, &s->evt_irq);
+    sysbus_init_irq(sbd, &s->err_irq);
+}
+
+/*
+ * The bus is created here rather than in instance_init so that it can
+ * carry the controller's name.  A machine with three of these has
+ * three busses, and -device ...,bus=i2c2 can only pick one of them out
+ * if they are not all called the same thing.
+ */
+static void stm32f4xx_i2c_realize(DeviceState *dev, Error **errp)
+{
+    STM32F4xxI2CState *s = STM32F4XX_I2C(dev);
+
+    s->bus = i2c_init_bus(dev, s->name ?: "i2c");
+}
+
+static const Property stm32f4xx_i2c_properties[] = {
+    DEFINE_PROP_STRING("name", STM32F4xxI2CState, name),
+};
+
+static const VMStateDescription vmstate_stm32f4xx_i2c = {
+    .name = TYPE_STM32F4XX_I2C,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(cr1, STM32F4xxI2CState),
+        VMSTATE_UINT32(cr2, STM32F4xxI2CState),
+        VMSTATE_UINT32(oar1, STM32F4xxI2CState),
+        VMSTATE_UINT32(oar2, STM32F4xxI2CState),
+        VMSTATE_UINT32(dr, STM32F4xxI2CState),
+        VMSTATE_UINT32(sr1, STM32F4xxI2CState),
+        VMSTATE_UINT32(sr2, STM32F4xxI2CState),
+        VMSTATE_UINT32(ccr, STM32F4xxI2CState),
+        VMSTATE_UINT32(trise, STM32F4xxI2CState),
+        VMSTATE_UINT32(fltr, STM32F4xxI2CState),
+        VMSTATE_BOOL(sr1_read, STM32F4xxI2CState),
+        VMSTATE_UINT8(shift, STM32F4xxI2CState),
+        VMSTATE_BOOL(shift_full, STM32F4xxI2CState),
+        VMSTATE_BOOL(xfer, STM32F4xxI2CState),
+        VMSTATE_BOOL(recv, STM32F4xxI2CState),
+        VMSTATE_BOOL(rxdone, STM32F4xxI2CState),
+        VMSTATE_UINT32(rxcnt, STM32F4xxI2CState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void stm32f4xx_i2c_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    device_class_set_legacy_reset(dc, stm32f4xx_i2c_reset);
+    dc->realize = stm32f4xx_i2c_realize;
+    dc->vmsd = &vmstate_stm32f4xx_i2c;
+    device_class_set_props(dc, stm32f4xx_i2c_properties);
+}
+
+static const TypeInfo stm32f4xx_i2c_info = {
+    .name          = TYPE_STM32F4XX_I2C,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(STM32F4xxI2CState),
+    .instance_init = stm32f4xx_i2c_init,
+    .class_init    = stm32f4xx_i2c_class_init,
+};
+
+static void stm32f4xx_i2c_register_types(void)
+{
+    type_register_static(&stm32f4xx_i2c_info);
+}
+
+type_init(stm32f4xx_i2c_register_types)
