diff --git a/include/hw/misc/bcm2835_pwm.h b/include/hw/misc/bcm2835_pwm.h
new file mode 100644
index 0000000..c9cc601
--- /dev/null
+++ b/include/hw/misc/bcm2835_pwm.h
@@ -0,0 +1,47 @@
+/*
+ * BCM2835 PWM emulation
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef BCM2835_PWM_H
+#define BCM2835_PWM_H
+
+#include "hw/sysbus.h"
+#include "hw/clock.h"
+#include "qom/object.h"
+
+#define TYPE_BCM2835_PWM "bcm2835-pwm"
+OBJECT_DECLARE_SIMPLE_TYPE(BCM2835PwmState, BCM2835_PWM)
+
+/* The data FIFO is shared by both channels and holds 16 words. */
+#define BCM2835_PWM_FIFO_LEN 16
+
+struct BCM2835PwmState {
+    SysBusDevice busdev;
+    MemoryRegion iomem;
+
+    /*
+     * The serialiser clock, from the clock manager's "pwm" mux.  A
+     * channel cannot be enabled until the guest has programmed
+     * CM_PWMCTL and CM_PWMDIV, which is what makes this non-zero.
+     */
+    Clock *clk;
+
+    uint32_t ctl;
+    uint32_t sta;
+    uint32_t dmac;
+    uint32_t rng1;
+    uint32_t dat1;
+    uint32_t rng2;
+    uint32_t dat2;
+
+    uint32_t fifo[BCM2835_PWM_FIFO_LEN];
+    uint32_t fifo_head;
+    uint32_t fifo_len;
+};
+
+#endif
