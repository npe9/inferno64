From f0146204c15f686374ebc8cfece7a37ab7493053 Mon Sep 17 00:00:00 2001
From: Noah Evans <noah.evans@gmail.com>
Date: Sun, 6 Sep 2026 19:59:13 -0400
Subject: [PATCH 07/16] hw/misc: model the BCM2835 PWM, and wire it into the
 raspi peripherals

PWM_OFFSET was defined in raspi_platform.h and nothing was mapped
there -- not even an unimplemented stub -- so a guest reached
unassigned memory.  On a Pi this block drives the analogue audio jack
and whatever is on GPIO 12/13/18/19.

Model the two channels, their range and data registers, the shared
16-word FIFO with its full and empty flags, and the status register.
The register layout, reset values and bit meanings are from the BCM2835
ARM Peripherals datasheet and Linux's pwm-bcm2835, not from any
particular guest driver.

The serialiser clock comes from the clock manager's "pwm" mux, so a
channel enabled before CM_PWMCTL and CM_PWMDIV are programmed is
reported as a guest error rather than silently doing nothing -- which
is what it does on hardware, and is unpleasant to debug there.

Protocol violations are reported rather than tolerated: a write to a
full FIFO raises WERR1, a read of the write-only FIFO raises RERR1, an
access to an unknown offset raises BERR, and reserved bits in CTL are
named.  CLRF1 is self-clearing and reads back as zero.

What is deliberately not modelled: nothing consumes the FIFO on its
own and no waveform reaches a pin, so the GAPO bits never come on by
themselves and a duty cycle cannot be measured here.  That is stated
in the file rather than left for someone to discover.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BtE1mJ79fHUqzyPBaSgBKx
---
 hw/arm/bcm2835_peripherals.c         |  10 +
 hw/misc/bcm2835_pwm.c                | 329 +++++++++++++++++++++++++++
 hw/misc/meson.build                  |   1 +
 include/hw/arm/bcm2835_peripherals.h |   2 +
 include/hw/misc/bcm2835_pwm.h        |  47 ++++
 5 files changed, 389 insertions(+)
 create mode 100644 hw/misc/bcm2835_pwm.c
 create mode 100644 include/hw/misc/bcm2835_pwm.h

diff --git a/hw/arm/bcm2835_peripherals.c b/hw/arm/bcm2835_peripherals.c
index 8a1e72d..8543d4d 100644
--- a/hw/arm/bcm2835_peripherals.c
+++ b/hw/arm/bcm2835_peripherals.c
@@ -55,6 +55,7 @@ static void bcm2835_peripherals_init(Object *obj)
 
     /* Thermal */
     object_initialize_child(obj, "thermal", &s->thermal, TYPE_BCM2835_THERMAL);
+    object_initialize_child(obj, "pwm", &s->pwm, TYPE_BCM2835_PWM);
 
     /* GPIO */
     object_initialize_child(obj, "gpio", &s->gpio, TYPE_BCM2835_GPIO);
@@ -231,6 +232,15 @@ static void bcm2835_peripherals_realize(DeviceState *dev, Error **errp)
     memory_region_add_subregion(&s_base->peri_mr, THERMAL_OFFSET,
                 sysbus_mmio_get_region(SYS_BUS_DEVICE(&s->thermal), 0));
 
+    /* PWM */
+    qdev_connect_clock_in(DEVICE(&s->pwm), "clk",
+                          qdev_get_clock_out(DEVICE(&s_base->cprman), "pwm-out"));
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->pwm), errp)) {
+        return;
+    }
+    memory_region_add_subregion(&s_base->peri_mr, PWM_OFFSET,
+                sysbus_mmio_get_region(SYS_BUS_DEVICE(&s->pwm), 0));
+
     /* Map MPHI to the peripherals memory map */
     mphi_mr = sysbus_mmio_get_region(SYS_BUS_DEVICE(&s_base->mphi), 0);
     memory_region_add_subregion(&s_base->peri_mr, MPHI_OFFSET, mphi_mr);
diff --git a/hw/misc/bcm2835_pwm.c b/hw/misc/bcm2835_pwm.c
new file mode 100644
index 0000000..f9417e0
--- /dev/null
+++ b/hw/misc/bcm2835_pwm.c
@@ -0,0 +1,329 @@
+/*
+ * BCM2835 PWM emulation
+ *
+ * Two pulse-width modulators sharing a 16-word data FIFO.  On a
+ * Raspberry Pi these drive the analogue audio jack and whatever is
+ * wired to GPIO 12/13/18/19 -- a servo, a backlight, an LED.
+ *
+ * Register layout, reset values and bit meanings are from the BCM2835
+ * ARM Peripherals datasheet (section 9) and Linux's pwm-bcm2835
+ * driver, not from any particular guest driver.
+ *
+ * WHAT THIS DOES NOT MODEL.  There is no serialiser running in the
+ * background: nothing consumes the FIFO on its own and no waveform
+ * reaches a pin, so the GAPO status bits are never raised on their own
+ * and a guest cannot measure a duty cycle here.  What is modelled is
+ * everything a driver actually programs and reads back -- the control
+ * and status registers, the range and data registers, the FIFO with
+ * its full and empty flags, and the error reporting that goes with
+ * them.  That is the part a driver gets wrong; the analogue output is
+ * not something an emulator can hand back anyway.
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/misc/bcm2835_pwm.h"
+#include "hw/qdev-clock.h"
+#include "migration/vmstate.h"
+
+#define R_CTL   0x00
+#define R_STA   0x04
+#define R_DMAC  0x08
+#define R_RNG1  0x10
+#define R_DAT1  0x14
+#define R_FIF1  0x18
+#define R_RNG2  0x20
+#define R_DAT2  0x24
+
+/* CTL */
+#define CTL_PWEN1   (1 << 0)    /* channel 1 enable */
+#define CTL_MODE1   (1 << 1)    /* 0 = PWM, 1 = serialiser */
+#define CTL_RPTL1   (1 << 2)    /* repeat last word when the FIFO empties */
+#define CTL_SBIT1   (1 << 3)    /* state of the output when idle */
+#define CTL_POLA1   (1 << 4)    /* invert the output */
+#define CTL_USEF1   (1 << 5)    /* take data from the FIFO, not DAT1 */
+#define CTL_CLRF1   (1 << 6)    /* clear the FIFO; write-only, reads 0 */
+#define CTL_MSEN1   (1 << 7)    /* 0 = PWM algorithm, 1 = mark/space */
+#define CTL_PWEN2   (1 << 8)
+#define CTL_MODE2   (1 << 9)
+#define CTL_RPTL2   (1 << 10)
+#define CTL_SBIT2   (1 << 11)
+#define CTL_POLA2   (1 << 12)
+#define CTL_USEF2   (1 << 13)
+#define CTL_MSEN2   (1 << 15)
+
+#define CTL_WRITABLE  0x0000bfff    /* bit 14 is reserved */
+
+/* STA */
+#define STA_FULL1   (1 << 0)
+#define STA_EMPT1   (1 << 1)
+#define STA_WERR1   (1 << 2)    /* wrote to a full FIFO */
+#define STA_RERR1   (1 << 3)    /* read from an empty FIFO */
+#define STA_GAPO1   (1 << 4)
+#define STA_GAPO2   (1 << 5)
+#define STA_GAPO3   (1 << 6)
+#define STA_GAPO4   (1 << 7)
+#define STA_BERR    (1 << 8)    /* bus error */
+#define STA_STA1    (1 << 9)    /* channel 1 transmitting */
+#define STA_STA2    (1 << 10)
+#define STA_STA3    (1 << 11)
+#define STA_STA4    (1 << 12)
+
+/* The bits a guest clears by writing one to them. */
+#define STA_W1C     (STA_WERR1 | STA_RERR1 | STA_BERR | \
+                     STA_GAPO1 | STA_GAPO2 | STA_GAPO3 | STA_GAPO4)
+
+static void bcm2835_pwm_fifo_clear(BCM2835PwmState *s)
+{
+    s->fifo_head = 0;
+    s->fifo_len = 0;
+}
+
+static void bcm2835_pwm_update_sta(BCM2835PwmState *s)
+{
+    s->sta &= ~(STA_FULL1 | STA_EMPT1 | STA_STA1 | STA_STA2);
+
+    if (s->fifo_len == BCM2835_PWM_FIFO_LEN) {
+        s->sta |= STA_FULL1;
+    }
+    if (s->fifo_len == 0) {
+        s->sta |= STA_EMPT1;
+    }
+    /*
+     * A channel reports itself transmitting while it is enabled.  In
+     * FIFO mode it stops when the FIFO runs dry, unless RPTL says to
+     * keep repeating the last word.
+     */
+    if (s->ctl & CTL_PWEN1) {
+        if (!(s->ctl & CTL_USEF1) || s->fifo_len || (s->ctl & CTL_RPTL1)) {
+            s->sta |= STA_STA1;
+        }
+    }
+    if (s->ctl & CTL_PWEN2) {
+        if (!(s->ctl & CTL_USEF2) || s->fifo_len || (s->ctl & CTL_RPTL2)) {
+            s->sta |= STA_STA2;
+        }
+    }
+}
+
+static void bcm2835_pwm_fifo_push(BCM2835PwmState *s, uint32_t value)
+{
+    if (s->fifo_len == BCM2835_PWM_FIFO_LEN) {
+        /*
+         * The datasheet says a write to a full FIFO is ignored and
+         * raises WERR1.  Say so: silently dropping it is how a driver
+         * that never checks the full flag survives here and loses data
+         * on real hardware.
+         */
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_pwm: write to a full FIFO\n");
+        s->sta |= STA_WERR1;
+        return;
+    }
+    s->fifo[(s->fifo_head + s->fifo_len) % BCM2835_PWM_FIFO_LEN] = value;
+    s->fifo_len++;
+}
+
+static void bcm2835_pwm_check_enable(BCM2835PwmState *s, uint32_t old)
+{
+    uint32_t started = s->ctl & ~old & (CTL_PWEN1 | CTL_PWEN2);
+
+    if (started && clock_get_hz(s->clk) == 0) {
+        /*
+         * The serialiser has no clock until the guest programs
+         * CM_PWMCTL and CM_PWMDIV in the clock manager, with the 0x5a
+         * password.  A channel enabled before that would sit there
+         * doing nothing on real hardware, which is a confusing thing
+         * to debug, so name it here.
+         */
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_pwm: channel enabled while the PWM clock is "
+                      "stopped; program CM_PWMCTL and CM_PWMDIV first\n");
+    }
+}
+
+static uint64_t bcm2835_pwm_read(void *opaque, hwaddr offset, unsigned size)
+{
+    BCM2835PwmState *s = (BCM2835PwmState *)opaque;
+
+    switch (offset) {
+    case R_CTL:
+        /* CLRF1 is write-only and always reads back as zero. */
+        return s->ctl & ~CTL_CLRF1;
+    case R_STA:
+        bcm2835_pwm_update_sta(s);
+        return s->sta;
+    case R_DMAC:
+        return s->dmac;
+    case R_RNG1:
+        return s->rng1;
+    case R_DAT1:
+        return s->dat1;
+    case R_RNG2:
+        return s->rng2;
+    case R_DAT2:
+        return s->dat2;
+
+    case R_FIF1:
+        /*
+         * The FIFO is write-only: it is the input to the serialiser,
+         * not a readable buffer.  The datasheet gives RERR1 for a read
+         * of an empty FIFO, which is what this always is.
+         */
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_pwm: read of the write-only data FIFO\n");
+        s->sta |= STA_RERR1;
+        return 0;
+
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_pwm: read of unknown offset 0x%02"HWADDR_PRIx
+                      "\n", offset);
+        s->sta |= STA_BERR;
+        return 0;
+    }
+}
+
+static void bcm2835_pwm_write(void *opaque, hwaddr offset, uint64_t value,
+                              unsigned size)
+{
+    BCM2835PwmState *s = (BCM2835PwmState *)opaque;
+    uint32_t old;
+
+    switch (offset) {
+    case R_CTL:
+        if (value & ~(uint64_t)CTL_WRITABLE) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "bcm2835_pwm: reserved bits set in CTL 0x%08x\n",
+                          (uint32_t)value);
+        }
+        old = s->ctl;
+        s->ctl = value & CTL_WRITABLE;
+        if (s->ctl & CTL_CLRF1) {
+            bcm2835_pwm_fifo_clear(s);
+            s->ctl &= ~CTL_CLRF1;       /* self-clearing */
+        }
+        bcm2835_pwm_check_enable(s, old);
+        break;
+
+    case R_STA:
+        /* The error and gap bits are cleared by writing one to them. */
+        s->sta &= ~(value & STA_W1C);
+        break;
+
+    case R_DMAC:
+        s->dmac = value;
+        break;
+
+    case R_RNG1:
+        s->rng1 = value;
+        break;
+
+    case R_DAT1:
+        s->dat1 = value;
+        break;
+
+    case R_RNG2:
+        s->rng2 = value;
+        break;
+
+    case R_DAT2:
+        s->dat2 = value;
+        break;
+
+    case R_FIF1:
+        bcm2835_pwm_fifo_push(s, value);
+        break;
+
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_pwm: write to unknown offset 0x%02"HWADDR_PRIx
+                      "\n", offset);
+        s->sta |= STA_BERR;
+        break;
+    }
+}
+
+static const MemoryRegionOps bcm2835_pwm_ops = {
+    .read = bcm2835_pwm_read,
+    .write = bcm2835_pwm_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static const VMStateDescription vmstate_bcm2835_pwm = {
+    .name = TYPE_BCM2835_PWM,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(ctl, BCM2835PwmState),
+        VMSTATE_UINT32(sta, BCM2835PwmState),
+        VMSTATE_UINT32(dmac, BCM2835PwmState),
+        VMSTATE_UINT32(rng1, BCM2835PwmState),
+        VMSTATE_UINT32(dat1, BCM2835PwmState),
+        VMSTATE_UINT32(rng2, BCM2835PwmState),
+        VMSTATE_UINT32(dat2, BCM2835PwmState),
+        VMSTATE_UINT32_ARRAY(fifo, BCM2835PwmState, BCM2835_PWM_FIFO_LEN),
+        VMSTATE_UINT32(fifo_head, BCM2835PwmState),
+        VMSTATE_UINT32(fifo_len, BCM2835PwmState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void bcm2835_pwm_init(Object *obj)
+{
+    BCM2835PwmState *s = BCM2835_PWM(obj);
+
+    s->clk = qdev_init_clock_in(DEVICE(s), "clk", NULL, NULL, 0);
+
+    memory_region_init_io(&s->iomem, obj, &bcm2835_pwm_ops, s,
+                          TYPE_BCM2835_PWM, 0x28);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+}
+
+static void bcm2835_pwm_reset(DeviceState *dev)
+{
+    BCM2835PwmState *s = BCM2835_PWM(dev);
+
+    s->ctl = 0;
+    s->dmac = 0;
+    /* The datasheet's reset value for both range registers is 0x20. */
+    s->rng1 = 0x20;
+    s->rng2 = 0x20;
+    s->dat1 = 0;
+    s->dat2 = 0;
+    bcm2835_pwm_fifo_clear(s);
+    s->sta = 0;
+    bcm2835_pwm_update_sta(s);
+}
+
+static void bcm2835_pwm_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "BCM2835 PWM";
+    device_class_set_legacy_reset(dc, bcm2835_pwm_reset);
+    dc->vmsd = &vmstate_bcm2835_pwm;
+}
+
+static const TypeInfo bcm2835_pwm_info = {
+    .name          = TYPE_BCM2835_PWM,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(BCM2835PwmState),
+    .class_init    = bcm2835_pwm_class_init,
+    .instance_init = bcm2835_pwm_init,
+};
+
+static void bcm2835_pwm_register_types(void)
+{
+    type_register_static(&bcm2835_pwm_info);
+}
+
+type_init(bcm2835_pwm_register_types)
