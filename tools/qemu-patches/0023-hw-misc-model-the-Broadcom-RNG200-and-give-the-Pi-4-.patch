diff --git a/include/hw/misc/bcm2838_rng200.h b/include/hw/misc/bcm2838_rng200.h
new file mode 100644
index 0000000..1a2598d
--- /dev/null
+++ b/include/hw/misc/bcm2838_rng200.h
@@ -0,0 +1,32 @@
+/*
+ * Broadcom RNG200 (BCM2711 "brcm,bcm2711-rng200") emulation
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ */
+
+#ifndef BCM2838_RNG200_H
+#define BCM2838_RNG200_H
+
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_BCM2838_RNG200 "bcm2838-rng200"
+OBJECT_DECLARE_SIMPLE_TYPE(BCM2838Rng200State, BCM2838_RNG200)
+
+#define BCM2838_RNG200_FIFO_MAX 255
+
+struct BCM2838Rng200State {
+    SysBusDevice busdev;
+    MemoryRegion iomem;
+
+    uint32_t rng_ctrl;
+    uint32_t rng_soft_reset;
+    uint32_t rbg_soft_reset;
+    uint32_t int_status;
+
+    uint32_t fifo_depth;                        /* qdev property */
+    uint32_t fifo[BCM2838_RNG200_FIFO_MAX];
+    uint32_t fifo_count;
+};
+
+#endif
