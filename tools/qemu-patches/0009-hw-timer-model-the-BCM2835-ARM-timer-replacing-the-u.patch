@@ -0,0 +1,46 @@
+/*
+ * BCM2835 ARM timer emulation
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef BCM2835_ARMTIMER_H
+#define BCM2835_ARMTIMER_H
+
+#include "hw/sysbus.h"
+#include "hw/ptimer.h"
+#include "qom/object.h"
+
+#define TYPE_BCM2835_ARMTIMER "bcm2835-armtimer"
+OBJECT_DECLARE_SIMPLE_TYPE(BCM2835ArmTimerState, BCM2835_ARMTIMER)
+
+struct BCM2835ArmTimerState {
+    SysBusDevice busdev;
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /*
+     * The APB clock the block is driven from.  On a Pi this is the
+     * core clock, nominally 250MHz, and the fact that it moves when
+     * the firmware scales the core is a property of the hardware
+     * rather than of this model.
+     */
+    uint32_t freq;
+
+    ptimer_state *timer;
+
+    uint32_t load;
+    uint32_t control;
+    uint32_t reload;
+    uint32_t predivider;
+    int int_level;
+
+    /* Base of the free-running counter, in nanoseconds. */
+    int64_t freerun_base_ns;
+    uint32_t freerun_base;
+};
+
+#endif
