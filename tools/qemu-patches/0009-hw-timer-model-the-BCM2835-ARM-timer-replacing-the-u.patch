diff --git a/hw/timer/bcm2835_armtimer.c b/hw/timer/bcm2835_armtimer.c
new file mode 100644
index 0000000..c0f3f94
--- /dev/null
+++ b/hw/timer/bcm2835_armtimer.c
@@ -0,0 +1,358 @@
+/*
+ * BCM2835 ARM timer emulation
+ *
+ * The datasheet calls this "an SP804, but it is not fully compatible",
+ * and the differences are the interesting part: a 23-bit rather than a
+ * 32-bit mode, an extra pre-divider between the APB clock and the
+ * counter, and a second, free-running counter with its own prescaler
+ * that the SP804 does not have at all.  A driver written against a
+ * stock SP804 gets the countdown roughly right and the free-running
+ * counter not at all.
+ *
+ * Register layout, reset values and bit meanings are from the BCM2835
+ * ARM Peripherals datasheet (section 14), not from any guest driver.
+ *
+ * WHAT THIS DOES NOT MODEL.  The datasheet documents a "free running
+ * counter" and a halt-in-debug bit whose behaviour depends on the
+ * VideoCore side; the debug halt is ignored here.  Everything a driver
+ * programs -- load, reload, pre-divider, prescale, the two counters
+ * and the interrupt -- is modelled.
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/timer/bcm2835_armtimer.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "migration/vmstate.h"
+
+#define R_LOAD          0x00
+#define R_VALUE         0x04    /* read-only */
+#define R_CONTROL       0x08
+#define R_IRQ_ACK       0x0c    /* write-only */
+#define R_RAW_IRQ       0x10    /* read-only */
+#define R_MASKED_IRQ    0x14    /* read-only */
+#define R_RELOAD        0x18
+#define R_PREDIVIDER    0x1c
+#define R_FREERUN       0x20    /* read-only */
+
+#define CTRL_23BIT      (1 << 1)    /* 0 = 16-bit counter, 1 = 23-bit */
+#define CTRL_PRESCALE   (3 << 2)    /* 0 = /1, 1 = /16, 2 = /256 */
+#define CTRL_PRESCALE_SHIFT 2
+#define CTRL_INT_ENABLE (1 << 5)
+#define CTRL_ENABLE     (1 << 7)
+#define CTRL_HALT_DEBUG (1 << 8)
+#define CTRL_FREERUN_EN (1 << 9)
+#define CTRL_FREERUN_PS (0xff << 16)
+#define CTRL_FREERUN_PS_SHIFT 16
+
+#define CTRL_RESET      0x003e0020  /* datasheet reset value */
+#define PREDIVIDER_RESET 0x0000007d
+
+#define PREDIVIDER_MASK 0x3ff
+
+static uint32_t bcm2835_armtimer_prescale(BCM2835ArmTimerState *s)
+{
+    switch ((s->control & CTRL_PRESCALE) >> CTRL_PRESCALE_SHIFT) {
+    case 0:  return 1;
+    case 1:  return 16;
+    case 2:  return 256;
+    default:
+        /* The datasheet leaves 3 undefined; the SoC treats it as /1. */
+        return 1;
+    }
+}
+
+/* The rate the countdown counter runs at. */
+static uint32_t bcm2835_armtimer_rate(BCM2835ArmTimerState *s)
+{
+    uint32_t div = (s->predivider & PREDIVIDER_MASK) + 1;
+
+    return s->freq / (div * bcm2835_armtimer_prescale(s));
+}
+
+static void bcm2835_armtimer_update_irq(BCM2835ArmTimerState *s)
+{
+    qemu_set_irq(s->irq, s->int_level && (s->control & CTRL_INT_ENABLE));
+}
+
+static void bcm2835_armtimer_tick(void *opaque)
+{
+    BCM2835ArmTimerState *s = (BCM2835ArmTimerState *)opaque;
+
+    s->int_level = 1;
+    bcm2835_armtimer_update_irq(s);
+}
+
+/*
+ * The free-running counter is a plain up-counter: it has no interrupt
+ * and nothing to schedule, so it is computed on demand from the
+ * virtual clock rather than stepped.
+ */
+static uint32_t bcm2835_armtimer_freerun(BCM2835ArmTimerState *s)
+{
+    uint32_t ps = ((s->control & CTRL_FREERUN_PS) >> CTRL_FREERUN_PS_SHIFT) + 1;
+    int64_t elapsed;
+
+    if (!(s->control & CTRL_FREERUN_EN)) {
+        return s->freerun_base;
+    }
+    elapsed = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->freerun_base_ns;
+    return s->freerun_base +
+           (uint32_t)(elapsed * (s->freq / ps) / NANOSECONDS_PER_SECOND);
+}
+
+/* Latch the free-running counter so a rate or enable change is seamless. */
+static void bcm2835_armtimer_freerun_latch(BCM2835ArmTimerState *s)
+{
+    s->freerun_base = bcm2835_armtimer_freerun(s);
+    s->freerun_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+}
+
+static void bcm2835_armtimer_reload(BCM2835ArmTimerState *s, uint32_t value,
+                                    bool reload_now)
+{
+    uint32_t limit = value;
+
+    /*
+     * In 16-bit mode the counter only has 16 bits, whatever the guest
+     * loaded.  Saying so is the difference between a driver that finds
+     * its long timeout truncated here and one that finds it on the
+     * board.
+     */
+    if (!(s->control & CTRL_23BIT)) {
+        if (value > 0xffff) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "bcm2835_armtimer: load 0x%x does not fit the "
+                          "16-bit counter; set CONTROL bit 1 for 23-bit\n",
+                          value);
+        }
+        limit &= 0xffff;
+    } else {
+        limit &= 0x7fffff;
+    }
+    if (limit == 0) {
+        limit = 1;
+    }
+    ptimer_set_limit(s->timer, limit, reload_now);
+}
+
+static void bcm2835_armtimer_restart(BCM2835ArmTimerState *s)
+{
+    uint32_t rate = bcm2835_armtimer_rate(s);
+
+    ptimer_transaction_begin(s->timer);
+    if (rate == 0) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_armtimer: pre-divider and prescale leave a "
+                      "zero counter rate\n");
+        ptimer_stop(s->timer);
+    } else {
+        ptimer_set_freq(s->timer, rate);
+        bcm2835_armtimer_reload(s, s->load, true);
+        if (s->control & CTRL_ENABLE) {
+            ptimer_run(s->timer, 0);
+        } else {
+            ptimer_stop(s->timer);
+        }
+    }
+    ptimer_transaction_commit(s->timer);
+}
+
+static uint64_t bcm2835_armtimer_read(void *opaque, hwaddr offset,
+                                      unsigned size)
+{
+    BCM2835ArmTimerState *s = (BCM2835ArmTimerState *)opaque;
+
+    switch (offset) {
+    case R_LOAD:
+        return s->load;
+    case R_VALUE:
+        return ptimer_get_count(s->timer);
+    case R_CONTROL:
+        return s->control;
+    case R_RAW_IRQ:
+        return s->int_level;
+    case R_MASKED_IRQ:
+        return s->int_level && (s->control & CTRL_INT_ENABLE);
+    case R_RELOAD:
+        return s->reload;
+    case R_PREDIVIDER:
+        return s->predivider;
+    case R_FREERUN:
+        return bcm2835_armtimer_freerun(s);
+
+    case R_IRQ_ACK:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_armtimer: read of the write-only IRQ ack "
+                      "register\n");
+        return 0;
+
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_armtimer: read of unknown offset 0x%02"
+                      HWADDR_PRIx "\n", offset);
+        return 0;
+    }
+}
+
+static void bcm2835_armtimer_write(void *opaque, hwaddr offset,
+                                   uint64_t value, unsigned size)
+{
+    BCM2835ArmTimerState *s = (BCM2835ArmTimerState *)opaque;
+
+    switch (offset) {
+    case R_LOAD:
+        /* Writing LOAD reloads the counter immediately. */
+        s->load = value;
+        ptimer_transaction_begin(s->timer);
+        bcm2835_armtimer_reload(s, value, true);
+        ptimer_transaction_commit(s->timer);
+        break;
+
+    case R_RELOAD:
+        /*
+         * RELOAD sets the value the counter takes at its *next* wrap,
+         * without disturbing the count in progress.  That is the whole
+         * difference between the two registers, and it is why a driver
+         * changing a periodic rate should use this one.
+         */
+        s->reload = value;
+        s->load = value;
+        ptimer_transaction_begin(s->timer);
+        bcm2835_armtimer_reload(s, value, false);
+        ptimer_transaction_commit(s->timer);
+        break;
+
+    case R_CONTROL:
+        bcm2835_armtimer_freerun_latch(s);
+        s->control = value;
+        bcm2835_armtimer_restart(s);
+        bcm2835_armtimer_update_irq(s);
+        break;
+
+    case R_IRQ_ACK:
+        s->int_level = 0;
+        bcm2835_armtimer_update_irq(s);
+        break;
+
+    case R_PREDIVIDER:
+        s->predivider = value & PREDIVIDER_MASK;
+        bcm2835_armtimer_restart(s);
+        break;
+
+    case R_VALUE:
+    case R_RAW_IRQ:
+    case R_MASKED_IRQ:
+    case R_FREERUN:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_armtimer: write to the read-only register at "
+                      "0x%02" HWADDR_PRIx "\n", offset);
+        break;
+
+    default:
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "bcm2835_armtimer: write to unknown offset 0x%02"
+                      HWADDR_PRIx "\n", offset);
+        break;
+    }
+}
+
+static const MemoryRegionOps bcm2835_armtimer_ops = {
+    .read = bcm2835_armtimer_read,
+    .write = bcm2835_armtimer_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .impl.min_access_size = 4,
+    .impl.max_access_size = 4,
+};
+
+static const VMStateDescription vmstate_bcm2835_armtimer = {
+    .name = TYPE_BCM2835_ARMTIMER,
+    .version_id = 1,
+    .minimum_version_id = 1,
+    .fields = (const VMStateField[]) {
+        VMSTATE_UINT32(load, BCM2835ArmTimerState),
+        VMSTATE_UINT32(control, BCM2835ArmTimerState),
+        VMSTATE_UINT32(reload, BCM2835ArmTimerState),
+        VMSTATE_UINT32(predivider, BCM2835ArmTimerState),
+        VMSTATE_INT32(int_level, BCM2835ArmTimerState),
+        VMSTATE_INT64(freerun_base_ns, BCM2835ArmTimerState),
+        VMSTATE_UINT32(freerun_base, BCM2835ArmTimerState),
+        VMSTATE_PTIMER(timer, BCM2835ArmTimerState),
+        VMSTATE_END_OF_LIST()
+    }
+};
+
+static void bcm2835_armtimer_init(Object *obj)
+{
+    BCM2835ArmTimerState *s = BCM2835_ARMTIMER(obj);
+
+    memory_region_init_io(&s->iomem, obj, &bcm2835_armtimer_ops, s,
+                          TYPE_BCM2835_ARMTIMER, 0x24);
+    sysbus_init_mmio(SYS_BUS_DEVICE(s), &s->iomem);
+    sysbus_init_irq(SYS_BUS_DEVICE(s), &s->irq);
+}
+
+static void bcm2835_armtimer_realize(DeviceState *dev, Error **errp)
+{
+    BCM2835ArmTimerState *s = BCM2835_ARMTIMER(dev);
+
+    s->timer = ptimer_init(bcm2835_armtimer_tick, s, PTIMER_POLICY_LEGACY);
+}
+
+static void bcm2835_armtimer_reset(DeviceState *dev)
+{
+    BCM2835ArmTimerState *s = BCM2835_ARMTIMER(dev);
+
+    s->load = 0;
+    s->control = CTRL_RESET;
+    s->reload = 0;
+    s->predivider = PREDIVIDER_RESET;
+    s->int_level = 0;
+    s->freerun_base = 0;
+    s->freerun_base_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    ptimer_transaction_begin(s->timer);
+    ptimer_stop(s->timer);
+    ptimer_transaction_commit(s->timer);
+    bcm2835_armtimer_update_irq(s);
+}
+
+static const Property bcm2835_armtimer_properties[] = {
+    /* The APB clock; the Pi's core clock, nominally 250MHz. */
+    DEFINE_PROP_UINT32("clock-frequency", BCM2835ArmTimerState, freq,
+                       250000000),
+};
+
+static void bcm2835_armtimer_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->desc = "BCM2835 ARM timer";
+    dc->realize = bcm2835_armtimer_realize;
+    device_class_set_legacy_reset(dc, bcm2835_armtimer_reset);
+    dc->vmsd = &vmstate_bcm2835_armtimer;
+    device_class_set_props(dc, bcm2835_armtimer_properties);
+}
+
+static const TypeInfo bcm2835_armtimer_info = {
+    .name          = TYPE_BCM2835_ARMTIMER,
+    .parent        = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(BCM2835ArmTimerState),
+    .class_init    = bcm2835_armtimer_class_init,
+    .instance_init = bcm2835_armtimer_init,
+};
+
+static void bcm2835_armtimer_register_types(void)
+{
+    type_register_static(&bcm2835_armtimer_info);
+}
+
+type_init(bcm2835_armtimer_register_types)
