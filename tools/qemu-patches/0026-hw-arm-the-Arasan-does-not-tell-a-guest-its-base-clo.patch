From f75ac9b5597f1b98f2f3a15e03ed56abf77eb453 Mon Sep 17 00:00:00 2001
From: Noah Evans <noah.evans@gmail.com>
Date: Wed, 9 Sep 2026 06:53:17 -0400
Subject: [PATCH] hw/arm: the Arasan does not tell a guest its base clock, so
 stop doing it

bcm2835_peripherals.c gives the Arasan a capabilities register with 52
in the base-clock field, from a constant whose comment says "default
clocks etc." -- an invented number.  A real BCM2835 does not report a
usable base clock there.  Linux's drivers/mmc/host/sdhci-iproc.c marks
brcm,bcm2835-sdhci with missing_caps and substitutes a table of its
own, and that table carries max block size, 3.3V and high speed and no
base clock at all; the frequency comes from the clock the firmware
reports instead.

So a guest that configures its divisors from this register passes here
and cannot work on the board, which is the whole class of bug this
matters for: the model was answering a question the hardware refuses.
Clearing bits 15:8 leaves the rest of the register alone and makes a
guest go where the hardware sends it.

emmc2 is deliberately left as it was, and gets its own constant to say
so.  sdhci-iproc does not mark the BCM2711's emmc2 missing_caps, so
that controller is expected to describe itself and a guest is right to
believe it.  The two controllers now differ in the model because they
differ on the part.

Guests that already do the right thing are unaffected: Linux takes its
capabilities from the quirk table rather than this register, and U-Boot
passes the clock in.  A guest that trusted the field will now find it
zero, which is what the hardware gives it.

Verified with an Inferno kernel that asks capabilities first and the
firmware second, and names which answered.  Before: "base 52MHz from
capabilities / 2 = about 26MHz" on both boards.  After: raspi3b reads
"base 50MHz from firmware clock 1 undivided", the path a Pi 3B takes,
and raspi4 still reads "base 52MHz from capabilities" on emmc2, the
path a Pi 4 takes.  Both branches of that driver are now exercised by
the two boards' default runs, where before both boards took the same
one and the other was reachable only by editing this constant.  39
markers on raspi3b, unchanged.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 hw/arm/bcm2835_peripherals.c | 16 ++++++++++++++--
 hw/arm/bcm2838_peripherals.c | 12 +++++++++---
 2 files changed, 23 insertions(+), 5 deletions(-)

diff --git a/hw/arm/bcm2835_peripherals.c b/hw/arm/bcm2835_peripherals.c
index 39e00cd..634945b 100644
--- a/hw/arm/bcm2835_peripherals.c
+++ b/hw/arm/bcm2835_peripherals.c
@@ -20,8 +20,20 @@
 /* Peripheral base address on the VC (GPU) system bus */
 #define BCM2835_VC_PERI_BASE 0x7e000000
 
-/* Capabilities for SD controller: no DMA, high-speed, default clocks etc. */
-#define BCM2835_SDHC_CAPAREG 0x52134b4
+/*
+ * Capabilities for the Arasan SD controller: no DMA, high-speed, and
+ * no base clock.
+ *
+ * The base-clock field (bits 15:8) is deliberately zero.  A real
+ * BCM2835's Arasan does not tell a driver its clock through this
+ * register -- Linux's sdhci-iproc marks the part missing_caps and
+ * substitutes its own capabilities, which carry high speed and 3.3V
+ * and no base clock at all, taking the frequency from the clock the
+ * firmware reports instead.  A model that answers 52MHz here lets a
+ * guest configure its divisors from a number the hardware will not
+ * give it, and pass.
+ */
+#define BCM2835_SDHC_CAPAREG 0x52100b4
 
 /*
  * According to Linux driver & DTS, dma channels 0--10 have separate IRQ,
diff --git a/hw/arm/bcm2838_peripherals.c b/hw/arm/bcm2838_peripherals.c
index 605645a..83b57db 100644
--- a/hw/arm/bcm2838_peripherals.c
+++ b/hw/arm/bcm2838_peripherals.c
@@ -18,8 +18,14 @@
 /* Lower peripheral base address on the VC (GPU) system bus */
 #define BCM2838_VC_PERI_LOW_BASE 0x7c000000
 
-/* Capabilities for SD controller: no DMA, high-speed, default clocks etc. */
-#define BCM2835_SDHC_CAPAREG 0x52134b4
+/*
+ * Capabilities for emmc2, which is a different controller from the
+ * Arasan and is treated differently: Linux's sdhci-iproc does not mark
+ * the BCM2711's emmc2 missing_caps, so this one is expected to
+ * describe itself and a guest is right to believe it.  That is why it
+ * keeps a base clock where bcm2835_peripherals.c's Arasan does not.
+ */
+#define BCM2838_EMMC2_CAPAREG 0x52134b4
 
 static void bcm2838_peripherals_init(Object *obj)
 {
@@ -91,7 +97,7 @@ static void bcm2838_peripherals_realize(DeviceState *dev, Error **errp)
     object_property_set_uint(OBJECT(&s->emmc2), "sd-spec-version", 3,
                              &error_abort);
     object_property_set_uint(OBJECT(&s->emmc2), "capareg",
-                             BCM2835_SDHC_CAPAREG, &error_abort);
+                             BCM2838_EMMC2_CAPAREG, &error_abort);
     object_property_set_bool(OBJECT(&s->emmc2), "pending-insert-quirk", true,
                              &error_abort);
     if (!sysbus_realize(SYS_BUS_DEVICE(&s->emmc2), errp)) {
-- 
