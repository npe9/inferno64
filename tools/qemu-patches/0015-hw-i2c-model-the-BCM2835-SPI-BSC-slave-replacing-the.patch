+++ b/include/hw/i2c/bcm2835_bscsl.h
@@ -0,0 +1,52 @@
+/*
+ * BCM2835 SPI/BSC slave
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef BCM2835_BSCSL_H
+#define BCM2835_BSCSL_H
+
+#include "hw/i2c/i2c.h"
+#include "system/memory.h"
+#include "qom/object.h"
+
+#define TYPE_BCM2835_BSCSL "bcm2835-bscsl"
+OBJECT_DECLARE_SIMPLE_TYPE(BCM2835BscSlState, BCM2835_BSCSL)
+
+/*
+ * The datasheet does not state the depth.  Its level fields are five
+ * bits and its interrupt thresholds go to seven eighths, which puts it
+ * at 16 like the rest of this PrimeCell-shaped family.  The guest
+ * driver measures it rather than assuming it.
+ */
+#define BCM2835_BSCSL_FIFO_DEPTH 16
+
+struct BCM2835BscSlState {
+    I2CSlave parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    uint32_t cr;
+    uint32_t rsr;
+    uint32_t slv;
+    uint32_t ifls;
+    uint32_t imsc;
+    uint32_t ris;
+    uint32_t dmacr;
+    uint32_t gpustat;
+    uint32_t hctrl;
+
+    uint8_t rxfifo[BCM2835_BSCSL_FIFO_DEPTH];
+    uint8_t txfifo[BCM2835_BSCSL_FIFO_DEPTH];
+    uint32_t rxlen, rxhead;
+    uint32_t txlen, txhead;
+
+    bool rxbusy, txbusy;
+};
+
+#endif
