+++ b/include/hw/misc/bcm2835_smi.h
@@ -0,0 +1,59 @@
+/*
+ * BCM2835 Secondary Memory Interface
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This work is licensed under the terms of the GNU GPL, version 2 or later.
+ * See the COPYING file in the top-level directory.
+ */
+
+#ifndef BCM2835_SMI_H
+#define BCM2835_SMI_H
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+#include "qom/object.h"
+
+#define TYPE_BCM2835_SMI "bcm2835-smi"
+OBJECT_DECLARE_SIMPLE_TYPE(BCM2835SmiState, BCM2835_SMI)
+
+/*
+ * The datasheet gives the FIFO as 64 words.  Note that SMIFD's count
+ * fields are six bits, so a full 64-word FIFO cannot be expressed
+ * through them; see the comment on smifd_count() in the .c file.
+ */
+#define BCM2835_SMI_FIFO_DEPTH 64
+
+struct BCM2835SmiState {
+    SysBusDevice busdev;
+    MemoryRegion iomem;
+    qemu_irq irq;
+
+    /* The SMI clock, from the clock manager's smi mux. */
+    Clock *clk;
+    QEMUTimer *timer;
+
+    uint32_t cs;
+    uint32_t length;
+    uint32_t address;
+    uint32_t dsr[4];
+    uint32_t dsw[4];
+    uint32_t dc;
+    uint32_t dcs;
+    uint32_t da;
+    uint32_t dd;
+
+    uint32_t fifo[BCM2835_SMI_FIFO_DEPTH];
+    uint32_t len, head;
+
+    /* High-tide mark of the FIFO count during the last transfer. */
+    uint32_t hightide;
+
+    /* The programmed transfer in progress. */
+    uint32_t remaining;
+    int64_t start_ns;
+    bool active;
+    bool writing;
+};
+
+#endif
