diff --git a/include/hw/gpio/stm32f4xx_gpio.h b/include/hw/gpio/stm32f4xx_gpio.h
new file mode 100644
index 0000000..00e894e
--- /dev/null
+++ b/include/hw/gpio/stm32f4xx_gpio.h
@@ -0,0 +1,75 @@
+/*
+ * STM32F4xx GPIO
+ *
+ * Copyright (c) 2026 Noah Evans
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ *
+ * The same block as the STM32L4x5's, which QEMU already models, less
+ * the two registers the F4 has not got: BRR at 0x28 and ASCR at 0x2c.
+ * Adapted from hw/gpio/stm32l4x5_gpio.c rather than written afresh,
+ * because it is the same ST peripheral and pretending otherwise would
+ * mean two models of one thing drifting apart.  Register map and reset
+ * values from RM0090.
+ */
+
+/*
+ * The reference used is the STMicroElectronics RM0351 Reference manual
+ * for STM32L4x5 and STM32L4x6 advanced Arm ® -based 32-bit MCUs.
+ * https://www.st.com/resource/en/reference_manual/rm0090.pdf
+ */
+
+#ifndef HW_STM32F4XX_GPIO_H
+#define HW_STM32F4XX_GPIO_H
+
+#include "hw/sysbus.h"
+#include "qom/object.h"
+
+#define TYPE_STM32F4XX_GPIO "stm32f4xx-gpio"
+OBJECT_DECLARE_SIMPLE_TYPE(Stm32f4xxGpioState, STM32F4XX_GPIO)
+
+#define NUM_GPIOS 9
+#define GPIO_NUM_PINS 16
+
+struct Stm32f4xxGpioState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion mmio;
+
+    /* GPIO registers */
+    uint32_t moder;
+    uint32_t otyper;
+    uint32_t ospeedr;
+    uint32_t pupdr;
+    uint32_t idr;
+    uint32_t odr;
+    uint32_t lckr;
+    uint32_t afrl;
+    uint32_t afrh;
+
+    /* GPIO registers reset values */
+    uint32_t moder_reset;
+    uint32_t ospeedr_reset;
+    uint32_t pupdr_reset;
+
+    /*
+     * External driving of pins.
+     * The pins can be set externally through the device
+     * anonymous input GPIOs lines under certain conditions.
+     * The pin must not be in push-pull output mode,
+     * and can't be set high in open-drain mode.
+     * Pins driven externally and configured to
+     * output mode will in general be "disconnected"
+     * (see `get_gpio_pinmask_to_disconnect()`)
+     */
+    uint16_t disconnected_pins;
+    uint16_t pins_connected_high;
+
+    char *name;
+    Clock *clk;
+    qemu_irq pin[GPIO_NUM_PINS];
+};
+
+#endif
