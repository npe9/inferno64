From b8b5f88b40f0364d1f5da12df81a8f569da2ebec Mon Sep 17 00:00:00 2001
From: Noah Evans <noah.evans@gmail.com>
Date: Tue, 22 Sep 2026 07:18:08 -0400
Subject: [PATCH 41/41] hw/gpio: model the STM32F4xx GPIO, and the backup SRAM
 with it

The F405 SoC mapped its nine GPIO ports as unimplemented devices, so a
guest could not drive a chip select, a reset line or an interrupt pin --
which is most of what a board does with a radio on SPI.

The block is the same ST peripheral the L4x5 has, less the two
registers the F4 has not got: BRR at 0x28 and ASCR at 0x2c.  So this is
adapted from hw/gpio/stm32l4x5_gpio.c rather than written afresh, since
two models of one thing would drift apart.  Reset values from RM0090
8.4: only ports A and B come out of reset with anything in them, and
for the same reason in both cases -- PA13-15 and PB3-4 are the debug
port, alive before any software runs.

It does not require its clk input, as the L4 model does.  The L4 SoC
has an RCC with a clock output per port; the F405's is
hw/misc/stm32_rcc.c, a plain register file, so requiring it would mean
no port could ever realize.  Modelling the block is what is claimed
here, not the clock tree.

Every pin is wired to the system configuration controller, which
already declared 16 * 9 inputs for exactly this and passes the selected
one to EXTI.

And the backup SRAM: 4K at 0x40024000, the "+4" in the datasheet's
"192+4 KB", ordinary memory to the core once BKPSRAMEN is set.  A
guest that used it as memory found nothing there and took a bus fault.

Signed-off-by: Noah Evans <noah.evans@gmail.com>
---
 hw/arm/stm32f405_soc.c           |  69 ++++-
 hw/gpio/meson.build              |   1 +
 hw/gpio/stm32f4xx_gpio.c         | 468 +++++++++++++++++++++++++++++++
 hw/gpio/trace-events             |   6 +
 include/hw/arm/stm32f405_soc.h   |  15 +
 include/hw/gpio/stm32f4xx_gpio.h |  75 +++++
 6 files changed, 625 insertions(+), 9 deletions(-)
 create mode 100644 hw/gpio/stm32f4xx_gpio.c
 create mode 100644 include/hw/gpio/stm32f4xx_gpio.h

diff --git a/hw/arm/stm32f405_soc.c b/hw/arm/stm32f405_soc.c
index c8684e2..3083223 100644
--- a/hw/arm/stm32f405_soc.c
+++ b/hw/arm/stm32f405_soc.c
@@ -27,6 +27,7 @@
 #include "system/address-spaces.h"
 #include "system/system.h"
 #include "hw/arm/stm32f405_soc.h"
+#include "hw/gpio/stm32f4xx_gpio.h"
 #include "hw/qdev-clock.h"
 #include "hw/misc/unimp.h"
 
@@ -49,6 +50,30 @@ static const int usart_irq[] = { 37, 38, 39, 52, 53, 71, 82, 83 };
 static const int timer_irq[] = { 28, 29, 30, 50 };
 #define ADC_IRQ 18
 static const int spi_irq[] =   { 35, 36, 51, 0, 0, 0 };
+
+/*
+ * The nine GPIO ports, a kilobyte apart from 0x40020000.  Only A and B
+ * come out of reset with anything in them, and for the same reason in
+ * both cases: PA13-15 and PB3-4 are the debug port, which is alive
+ * before any software runs (RM0090 8.4).
+ */
+static const struct {
+    hwaddr addr;
+    const char *name;
+    uint32_t moder_reset;
+    uint32_t ospeedr_reset;
+    uint32_t pupdr_reset;
+} gpio_cfg[STM_NUM_GPIOS] = {
+    { 0x40020000, "A", 0xa8000000, 0x00000000, 0x64000000 },
+    { 0x40020400, "B", 0x00000280, 0x000000c0, 0x00000100 },
+    { 0x40020800, "C", 0x00000000, 0x00000000, 0x00000000 },
+    { 0x40020c00, "D", 0x00000000, 0x00000000, 0x00000000 },
+    { 0x40021000, "E", 0x00000000, 0x00000000, 0x00000000 },
+    { 0x40021400, "F", 0x00000000, 0x00000000, 0x00000000 },
+    { 0x40021800, "G", 0x00000000, 0x00000000, 0x00000000 },
+    { 0x40021c00, "H", 0x00000000, 0x00000000, 0x00000000 },
+    { 0x40022000, "I", 0x00000000, 0x00000000, 0x00000000 },
+};
 static const int exti_irq[] =  { 6, 7, 8, 9, 10, 23, 23, 23, 23, 23, 40,
                                  40, 40, 40, 40, 40} ;
 
@@ -82,6 +107,11 @@ static void stm32f405_soc_initfn(Object *obj)
         object_initialize_child(obj, "spi[*]", &s->spi[i], TYPE_STM32F2XX_SPI);
     }
 
+    for (i = 0; i < STM_NUM_GPIOS; i++) {
+        object_initialize_child(obj, "gpio[*]", &s->gpio[i],
+                                TYPE_STM32F4XX_GPIO);
+    }
+
     object_initialize_child(obj, "exti", &s->exti, TYPE_STM32F4XX_EXTI);
 
     s->sysclk = qdev_init_clock_in(DEVICE(s), "sysclk", NULL, NULL, 0);
@@ -150,6 +180,14 @@ static void stm32f405_soc_realize(DeviceState *dev_soc, Error **errp)
     }
     memory_region_add_subregion(system_memory, CCM_BASE_ADDRESS, &s->ccm);
 
+    memory_region_init_ram(&s->bkpsram, NULL, "STM32F405.bkpsram", BKPSRAM_SIZE,
+                           &err);
+    if (err != NULL) {
+        error_propagate(errp, err);
+        return;
+    }
+    memory_region_add_subregion(system_memory, BKPSRAM_BASE_ADDRESS, &s->bkpsram);
+
     armv7m = DEVICE(&s->armv7m);
     qdev_prop_set_uint32(armv7m, "num-irq", 96);
     qdev_prop_set_uint8(armv7m, "num-prio-bits", 4);
@@ -241,6 +279,28 @@ static void stm32f405_soc_realize(DeviceState *dev_soc, Error **errp)
     }
 
     /* EXTI device */
+    for (i = 0; i < STM_NUM_GPIOS; i++) {
+        dev = DEVICE(&s->gpio[i]);
+        qdev_prop_set_string(dev, "name", gpio_cfg[i].name);
+        qdev_prop_set_uint32(dev, "mode-reset", gpio_cfg[i].moder_reset);
+        qdev_prop_set_uint32(dev, "ospeed-reset", gpio_cfg[i].ospeedr_reset);
+        qdev_prop_set_uint32(dev, "pupd-reset", gpio_cfg[i].pupdr_reset);
+        busdev = SYS_BUS_DEVICE(dev);
+        if (!sysbus_realize(busdev, errp)) {
+            return;
+        }
+        sysbus_mmio_map(busdev, 0, gpio_cfg[i].addr);
+        /*
+         * Every pin to the system configuration controller, which
+         * already declares 16 * 9 inputs for exactly this and passes
+         * the selected one on to EXTI.
+         */
+        for (int j = 0; j < 16; j++) {
+            qdev_connect_gpio_out(dev, j,
+                qdev_get_gpio_in(DEVICE(&s->syscfg), i * 16 + j));
+        }
+    }
+
     dev = DEVICE(&s->exti);
     if (!sysbus_realize(SYS_BUS_DEVICE(&s->exti), errp)) {
         return;
@@ -277,15 +337,6 @@ static void stm32f405_soc_realize(DeviceState *dev_soc, Error **errp)
     create_unimplemented_device("timer[9]",    0x40014000, 0x400);
     create_unimplemented_device("timer[10]",   0x40014400, 0x400);
     create_unimplemented_device("timer[11]",   0x40014800, 0x400);
-    create_unimplemented_device("GPIOA",       0x40020000, 0x400);
-    create_unimplemented_device("GPIOB",       0x40020400, 0x400);
-    create_unimplemented_device("GPIOC",       0x40020800, 0x400);
-    create_unimplemented_device("GPIOD",       0x40020C00, 0x400);
-    create_unimplemented_device("GPIOE",       0x40021000, 0x400);
-    create_unimplemented_device("GPIOF",       0x40021400, 0x400);
-    create_unimplemented_device("GPIOG",       0x40021800, 0x400);
-    create_unimplemented_device("GPIOH",       0x40021C00, 0x400);
-    create_unimplemented_device("GPIOI",       0x40022000, 0x400);
     create_unimplemented_device("CRC",         0x40023000, 0x400);
     create_unimplemented_device("Flash Int",   0x40023C00, 0x400);
     create_unimplemented_device("BKPSRAM",     0x40024000, 0x400);
diff --git a/hw/gpio/meson.build b/hw/gpio/meson.build
index 5205741..5ebc4fb 100644
--- a/hw/gpio/meson.build
