TARGMODEL=	Osprey
TARGSHTYPE=	rc
CPUS=		amd64

O=		6
OS=		v851ok0q26

AR=		ar
ARFLAGS=	vu

AS=		6a
ASFLAGS=

CC=		6c
#	Osprey kernel code is self-contained: it sees only its own headers
#	under os/osprey and the shared, flavor-independent ones in include.
CFLAGS=		-wFV -I$ROOT/$SYSTARG/$OBJTYPE/include -I$ROOT/$SYSTARG/include -I$ROOT/include
ANSICPP= -p

LD=		6l
LDFLAGS=

SYSLIBS=-lc

YACC=		yacc
YFLAGS=		-d
