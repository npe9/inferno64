TARGMODEL=	Inferno
TARGSHTYPE=	sh
CPUS=		thumb
OBJDIR=		Inferno/thumb		#force everything to point to inferno directory

O=		t
OS=		v851ok0q2t6j

AR=		iar
ARFLAGS=	vu
ARPREFIX=

# 5a assembles the ARM assembler syntax; -t marks the object Thumb so
# that tl encodes it with the Thumb encodings.
AS=		5a
ASFLAGS=	-t

# an ARMv7-M core is 32 bit, so a Dis word is four bytes
DISWORD=	4

CC=		tc
CFLAGS=		-wFV -I$ROOT/Inferno/thumb/include -I$ROOT/include
ANSICPP= -p

# -M: the target is an ARMv7-M core, which has no ARM state.  See
# utils/tl/l.h.
LD=		tl
LDFLAGS=	-M

SYSLIBS=	#-lc

YACC=		iyacc
YFLAGS=		-d
