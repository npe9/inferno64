TARGMODEL=	Inferno
TARGSHTYPE=	sh
CPUS=		thumb
OBJDIR=		Inferno/thumb		#force everything to point to inferno directory

O=		t
OS=		v851ok0q2t6j

AR=		iar
ARFLAGS=	vu
ARPREFIX=

# 5a assembles the ARM assembler syntax; -t marks the object Thumb so
# that tl encodes it with the Thumb encodings.
AS=		5a
ASFLAGS=	-t

# an ARMv7-M core is 32 bit, so a Dis word is four bytes
DISWORD=	4

CC=		tc
CFLAGS=		-wFV -I$ROOT/Inferno/thumb/include -I$ROOT/include
ANSICPP= -p

LD=		tl
# -M: an ARMv7-M core has no ARM state, so refuse to emit an ARM
#     instruction rather than silently emit one that would fault.
#     See utils/tl/l.h.
# -t: put C string constants in the text segment rather than the data
#     segment (utils/tl/pass.c, symbol type SSTRING).  Every board built
#     for this target runs its text from flash and copies its whole data
#     segment into RAM at boot, so a string literal that is never written
#     costs RAM for nothing.
LDFLAGS=	-M -t

SYSLIBS=	#-lc

YACC=		iyacc
YFLAGS=		-d
