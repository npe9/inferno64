TARGMODEL=	Inferno
TARGSHTYPE=	sh
CPUS=		aarch64
OBJDIR=		Inferno/aarch64		#force everything to point to inferno directory

O=		7
OS=		7

AR=		iar
ARFLAGS=	vu
ARPREFIX=

AS=		7a
ASFLAGS=

CC=		7c
#
# -DDISCTXREG here, not only in the boards.  An aarch64 kernel builds
# its libraries through this file (SYSTARG=os), and its own files
# through the board mkfile, which carries the flag: so libinterp was
# compiled with curP an ordinary global while virtarm64 and raspi3b
# declared it an external register, and the link failed with
# "secmain: undefined: disctxinit" the first time interp.h changed and
# forced libinterp to rebuild.  It had been working on objects built
# earlier through mkfile-Inferno-aarch64, which does carry it.
#
CFLAGS=		-wFV -DDISCTXREG -I$ROOT/Inferno/aarch64/include -I$ROOT/include
ANSICPP= -p

LD=		7l
LDFLAGS=

SYSLIBS=	#-lc

YACC=		iyacc
YFLAGS=		-d
