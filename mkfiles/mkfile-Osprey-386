TARGMODEL=	Osprey
TARGSHTYPE=	rc
CPUS=		386

O=		8
OS=		v851ok0q26

AR=		iar		# the tree's own archiver: the host ar does not take these flags and does not write a Plan 9 archive
ARFLAGS=	vu

AS=		8a
ASFLAGS=

CC=		8c
#	Osprey kernel code is self-contained: it sees only its own headers
#	under os/osprey and the shared, flavor-independent ones in include.
CFLAGS=		-wFV -I$ROOT/$SYSTARG/$OBJTYPE/include -I$ROOT/$SYSTARG/include -I$ROOT/include
ANSICPP= -p

LD=		8l
LDFLAGS=

SYSLIBS=-lc

YACC=		yacc
YFLAGS=		-d
