TARGMODEL=	Inferno
TARGSHTYPE=	sh
CPUS=		riscv64
OBJDIR=		Inferno/riscv64		#force everything to point to inferno directory

O=		j
OS=		j

AR=		iar
ARFLAGS=	vu
ARPREFIX=

AS=		ja
ASFLAGS=

CC=		jc
CFLAGS=		-wFV -I$ROOT/Inferno/riscv64/include -I$ROOT/include
ANSICPP= -p

LD=		jl
# -t: put C string constants in the text segment rather than the data
#     segment (utils/jl/pass.c, symbol type SSTRING).  A board that runs
#     its text from flash, or simply does not want a copy of every print
#     format in RAM, keeps them there.  See doc/xip.ms.
LDFLAGS=	-t

SYSLIBS=	#-lc

YACC=		iyacc
YFLAGS=		-d
