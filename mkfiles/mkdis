BINTARG=${TARG:%=$DISBIN/%}
MODDIR=$ROOT/module
SYS_MODULE=${SYSMODULES:%=$MODDIR/%}
# -z makes the compiler emit newaz rather than newa, i.e. array[n] of T
# is zero-filled instead of holding whatever the heap block last held.
# Dis specifies newa's non-pointer space as *undefined* (see doc/dis.ms
# under "newa, newaz"), so this is opt-in by design and both are
# correct; without it, code that allocates an array and accumulates
# into it - rather than fully overwriting it - silently reads a
# previous allocation's data. That is invisible until a heap block gets
# reused, which is exactly what makes it expensive to debug: it looks
# like a data-dependent numerical bug, not an allocation bug. The
# measured cost is negligible (single-digit ms to zero ~1GB), so this
# tree takes the guarantee everywhere rather than relying on every
# author to know that Limbo doesn't give it.
LIMBOFLAGS=-z -I$MODDIR

all:V:		$TARG

install:V:	$BINTARG

installall:V:	install

clean:V: 	clean-std

nuke:V:		nuke-std

$DISBIN/%.dis:	%.dis
	rm -f $DISBIN/$stem.dis && cp $stem.dis $DISBIN/$stem.dis

%.dis:		$MODULES $SYS_MODULE

%.dis:		%.b
	limbo $LIMBOFLAGS -gw $stem.b

%.s:		%.b
	limbo $LIMBOFLAGS -w -G -S $stem.b

%.install:V:	$DISBIN/%.dis
%.installall:V:	$DISBIN/%.dis

clean-std:V:
	rm -f *.dis *.sbl

nuke-std:V:	clean-std
	cd $DISBIN; rm -f $TARG
