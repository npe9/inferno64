BINTARG=${TARG:%=$DISBIN/%}
MODDIR=$ROOT/module
SYS_MODULE=${SYSMODULES:%=$MODDIR/%}
#
#	-z: array[N] of a pointer-free type (real, int, byte) is
#	documented (doc/dis.ms, "newa, newaz") to come back with
#	undefined non-pointer contents -- newa's own contract, not an
#	allocator defect.  -z emits newaz instead, which zeroes them.
#	Already found, fixed and verified safe tree-wide on a sibling
#	branch (session memory inferno-rio-array-zeroinit-bug: full appl
#	rebuild, fem(2)/pde(2) results digit-for-digit identical, single-
#	digit ms cost even at ~1GB) but never ported to this one -- this
#	branch's own pc64 GPF hunt hit what looks like the same shape
#	live: os/inferno/init/disinit.b:175's `b := array[64] of byte`
#	followed by a short sys->read() leaves whatever this port's pool
#	arena previously held in the unread tail, and a later slice/
#	string/big conversion over that tail can hand destroy() an
#	already-freed pointer (doc/inferno-ports.ms, "movp: bad dv-freed"
#	-- 20/25 boots, identical address every time). See doc/inferno-
#	ports.ms.
#
LIMBOFLAGS=-I$MODDIR -W $DISWORD -z

#
#	A module compiled for one Dis word size is not the module for the
#	other, and the .dis left in the source directory carries no mark
#	saying which it is.  Every .dis therefore depends on a stamp named
#	for the width, and making the stamp removes the other one, so that
#	changing DISWORD rebuilds rather than quietly reinstalling what is
#	already there.
#
DISSTAMP=.disword-$DISWORD

$DISSTAMP:
	rm -f .disword-* && touch $target

all:V:		$TARG

install:V:	$BINTARG

installall:V:	install

clean:V: 	clean-std

nuke:V:		nuke-std

$DISBIN/%.dis:	%.dis
	rm -f $DISBIN/$stem.dis && cp $stem.dis $DISBIN/$stem.dis

%.dis:		$MODULES $SYS_MODULE $DISSTAMP

%.dis:		%.b
	limbo $LIMBOFLAGS -gw $stem.b

%.s:		%.b
	limbo $LIMBOFLAGS -w -G -S $stem.b

%.install:V:	$DISBIN/%.dis
%.installall:V:	$DISBIN/%.dis

clean-std:V:
	rm -f *.dis *.sbl .disword-*

nuke-std:V:	clean-std
	cd $DISBIN; rm -f $TARG
