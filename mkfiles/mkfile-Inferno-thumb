TARGMODEL=	Inferno
TARGSHTYPE=	rc
CPUS=		thumb

O=		t
OS=		v851ok0q2t6j

AR=		iar
ARFLAGS=	vu

# 5a assembles the ARM assembler syntax; -t marks the object Thumb so
# that tl encodes it with the Thumb encodings.  There is no separate
# Thumb assembler.
AS=		5a
ASFLAGS=	-t

# an ARMv7-M core is 32 bit, so a Dis word is four bytes
DISWORD=	4

CC=		tc
CFLAGS=		-wFV -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/Inferno/include -I$ROOT/include
ANSICPP= -p

# -M says the target is an ARMv7-M core, which has no ARM state: tl then
# refuses to emit any ARM instruction rather than emitting one that would
# fault.  See utils/tl/l.h.
LD=		tl
LDFLAGS=	-M

SYSLIBS=	#-lc

YACC=		iyacc
YFLAGS=		-d
