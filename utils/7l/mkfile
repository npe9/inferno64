<../../mkconfig

TARG=7l

OFILES=\
	asm.$O\
	asmout.$O\
	bits.$O\
	check.$O\
	cnam.$O\
	dyn.$O\
	elf.$O\
	enam.$O\
	list.$O\
	mod.$O\
	noop.$O\
	obj.$O\
	optab.$O\
	pass.$O\
	pobj.$O\
	span.$O\
	sub.$O\
