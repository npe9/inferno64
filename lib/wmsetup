# /dis/sh script
# wm defines "menu" and "delmenu" builtins
load std
prompt='% ' ''
fn % {$*}
autoload=std
home=/usr/^"{cat /dev/user}

if {! {~ wm ${loaded}}} {
	echo wmsetup must run under wm >[1=2]
	raise usage
}

fn wmrun {
	args := $*
	{
		pctl newpgrp
		fn wmrun
		$args
	} > /chan/wmstdout >[2] /chan/wmstderr &
}

# Launch a RISC OS-style !App folder (a directory containing !Boot
# and !Run) so its toolbar-minimize icon comes from the folder's
# own icons/<base>.bit. Implemented as a thin wrapper around the
# /lib/wmapp shell script so plumber rules and command-line callers
# can use the same logic (`/lib/wmapp /usr/inferno/!Calc`).
fn wmapp {
	args := $*
	{
		pctl newpgrp
		fn wmapp
		fn wmrun
		/lib/wmapp $args
	} > /chan/wmstdout >[2] /chan/wmstderr &
}

fn cd {
	builtin cd $*;
	rescue 'bad redir' {} {
		echo cwd `{pwd} > /chan/shctl
	} >[2] /dev/null
}

plumber -v /lib/plumbing >/chan/wmstdout >[2=1]
wmrun wm/pinboard
# Seed desktop icons once /chan/pinboard is up (auto-grid layout).
{
	sleep 1
	if {ftest -e /chan/pinboard} {
		echo clear >/chan/pinboard
		echo 'pin /Apps/!Shell
pin /Apps/!Coffee
pin /Apps/!Manual
pin /Apps/!Draw3d
pin /Apps/!Filer' >/chan/pinboard
		# ls /Apps yields full paths (/Apps/!TempleFoo); match on basename.
		for a in `{ls /Apps} {
			base := `{basename $a}
			if {~ $base '!Temple*'} {
				echo pin $a >/chan/pinboard
			}
		}
	}
} >/chan/wmstdout >[2=1] &
