# sh initialisation here
load std

user = `{cat /dev/user}
home = /usr/^$user
bind -c '#U*'^$emuwdir /n/local
cd /n/local
#cd $home

# build the user's namespace in $home/
and {ftest -e $home/namespace}	{@{builtin cd $home; nsbuild}}

# Run the user's profile
and {ftest -e $home/lib/profile}	{@{builtin cd $home; run lib/profile}}
