10 REM a quick tour of the pieces fizzbuzz.bas and greet.bas don't reach
20 REM countdown by STEP -2, with trailing ";" keeping it on one line
30 FOR I = 10 TO 1 STEP -2
40 PRINT I;
50 NEXT I
60 PRINT ""
70 IF 3 < 5 THEN PRINT "3 < 5"
80 IF 5 <= 5 THEN PRINT "5 <= 5"
90 IF 7 > 2 THEN PRINT "7 > 2"
100 PRINT "ABS(0-8) ="; ABS(0 - 8)
110 PRINT "VAL(42)+1 ="; VAL("42") + 1
120 PRINT "INT(7.9) ="; INT(7.9)
130 END
