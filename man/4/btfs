.TH BTFS 4
.SH NAME
btfs, btbench, bthid \- Bluetooth Low Energy as a file system
.SH SYNOPSIS
.B bt/btfs
[
.B -u5
] [
.BI -m " mountpoint"
] [
.BI -k " keyfile"
] [
.BI -K " keydir"
] [
.BI -a " seconds"
] [
.I controller ...
]
.PP
.B bt/btbench
[
.I controller
[
.I mountpoint
[
.I keyfile
[
.I mode
[
.I controller2
]
]
]
]
]
.PP
.B bt/bthid
[
.B -v
] [
.BI -m " mountpoint"
] [
.BI -k " keyfile"
] [
