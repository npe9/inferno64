<$ROOT/9front-src/$objtype/mkfile

DIRS=port $CPUS

default:V:	all

install clean all:V:
	for(i in port $objtype)@{
		echo $i
		cd $i
		mk $MKFLAGS $target
	}

cleantest:V:
	@{cd test && mk $MKFLAGS clean}

clean:V: cleantest

nuke:V: clean
	rm -f $ROOT/9front/$objtype/lib/libmp.a

installall:V:
	for(objtype in $CPUS) mk $MKFLAGS install

everything:V:
	rm -f */*.[$OS]
	for(objtype in 386)@{
		echo $objtype
		mk $MKFLAGS install
	}
	rm -f */*.[$OS]

test:VQ:
	cd test && mk test
	

# really dev tools more than tests
test.$O: test.c $ROOT/9front-src/$objtype/include/u.h $ROOT/9front-src/sys/include/mp.h port/dat.h
	$CC -Iport test.c

$O.test: test.$O $ROOT/9front/$objtype/lib/libmp.a
	$LD -o $O.test test.$O

bigtest.$O: bigtest.c $ROOT/9front-src/$objtype/include/u.h $ROOT/9front-src/sys/include/mp.h port/dat.h
	$CC -Iport bigtest.c

$O.bigtest: bigtest.$O $ROOT/9front/$objtype/lib/libmp.a
	$LD -o $O.bigtest bigtest.$O

allout:
	objtype=arm; mk; mk 5.test 5.bigtest
	objtype=amd64; mk; mk 6.test 6.bigtest
	objtype=386; mk; mk 8.test 8.bigtest

cleanout:
	rm -f [568].* *.[568]
