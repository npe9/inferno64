<$ROOT/9front-src/$objtype/mkfile

TARG =	faxreceive\
	faxsend\

OFILES=\
	fax2modem.$O\
	file.$O\
	modem.$O\
	subr.$O\

RECEIVE=\
	$OFILES\
	receive.$O\
	fax2receive.$O\

SEND=\
	$OFILES\
	send.$O\
	fax2send.$O\

BIN=$ROOT/9front/$objtype/bin/aux

<$ROOT/9front-src/sys/src/cmd/mkmany

$O.faxreceive: $RECEIVE
	$LD -o $target $prereq

$O.faxsend: $SEND
	$LD -o $target $prereq

install.rc:V:
	mkdir /sys/lib/fax
	cp receiverc /sys/lib/fax
