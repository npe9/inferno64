<$ROOT/9front-src/$objtype/mkfile

SCRIPTS=\
	changes\
	pull\
	push\
	scan\
	setupdirs\
	
TARG=\
	applychanges\
	applylog\
	compactdb\
	updatedb\

OFILES=\
	db.$O\
	util.$O\

HFILES=all.h

BIN=$ROOT/9front/$objtype/bin/replica
<$ROOT/9front-src/sys/src/cmd/mkmany

$O.applychanges: revproto.$O

${SCRIPTS:%=$BIN/%}:
	for(i in $target){
		echo '#!/bin/rc'
		echo 'exec $ROOT/9front/rc/bin/replica/'^`{basename $i}^' $*'
	} >$i
	chmod +x $target

install:V: ${TARG:%=$BIN/%} ${SCRIPTS:%=$BIN/%}
