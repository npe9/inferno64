NPROC=1
<$ROOT/9front-src/$objtype/mkfile

all:V: install

install:V: genall gencall
	./genall

# ugh. sources's build process can't hack absolute path names.
# we're in $ROOT/9front-src/sys/src/ape/lib/ap/syscall.
gencall:D: ../../../../libc/9syscall/mkfile	# $ROOT/9front-src/sys/src/libc/9syscall/mkfile
	{
		echo '#!/usr/bin/env rc'
		sed -n -e 's/seek/_SEEK/g' -e '/switch/,/\$AS /p' $prereq
	} >$target
	chmod +x $target

nuke clean:V:
	rm -f *.[$OS] *.s gencall

installall:V:
	for(objtype in $CPUS) mk install
