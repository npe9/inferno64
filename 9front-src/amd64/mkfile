#
# The per-architecture mkfile every 9front library and command mkfile
# includes.  This one is not upstream's: it names this tree's
# compilers and archiver, and puts the results in the target tree
# beside the 9front kernel's, rather than in /amd64/lib and /amd64/bin
# on a 9front machine.  scripts/import-9front.sh leaves it alone when
# it re-imports.
#
# ROOT must be in the environment.  Everything below, and every mkfile
# the import rewrote, is written in terms of it.
#

# 9front's mkfiles are written for rc, and a recursive mk does not
# inherit a MKSHELL given on the command line, so it is set here where
# every one of them includes it
# the shell every recipe here runs under.  mkrc parses rc's syntax;
# this makes it run rc as well, through mkshell() in utils/mk/Posix.c.
# The name is MKSH, not MKSHELL: mkfiles already in this tree set
# MKSHELL and have always been built under sh whatever it said.
MKSH=$RCSHELL

<$ROOT/9front-src/sys/src/mkfile.proto

CC=6c
LD=6l
O=6
AS=6a

# this tree's archiver and yacc, not the host's
AR=iar
ARFLAGS=vu
YACC=iyacc

# 9front's own headers, and nothing from the Inferno side: a 9front
# program sees the system it is being built for and no other
INCLUDES=-I$ROOT/9front-src/$objtype/include -I$ROOT/9front-src/sys/include
CFLAGS=$CFLAGS $INCLUDES

BIN=$ROOT/9front/$objtype/bin
LIBDIR=$ROOT/9front/$objtype/lib
