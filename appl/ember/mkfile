<../../mkconfig

# ember libraries and commands, built with the C bootstrap compiler
# and installed under $ROOT/dis/ember.

EMBER=$ROOT/$OBJDIR/bin/ember
IFLAGS=-I$ROOT/ember/module -I$ROOT/appl/cmd/ember -I.

TARG=\
	json.dis\
	jsonfmt.dis\
	emberepl.dis\
	emberls.dis\

all:V:	$TARG

%.dis:	%.e
	$EMBER $IFLAGS -o $target $stem.e || (rm -f $target; exit 1)

jsonfmt.dis:	json.ei
emberepl.dis:	replline.ei
emberls.dis:	json.ei

install:V:	all
	mkdir -p $ROOT/dis/ember
	for i in $TARG; do
		cp $i $ROOT/dis/ember/$i
	done

clean:V:
	rm -f *.dis
