<../../mkconfig

# Work-alikes of the systems surveyed in Ted Nelson's Computer Lib/Dream
# Machines (1974): a hypertext browser, algorithmic-composition and video
# synthesis demos, a branching-alternatives editor, a CAI lesson engine, a
# Little Man Computer, an ELIZA-style conversational script, and the
# TRAC/BASIC/APL languages it surveys alongside them. plugin/ holds the
# pure library modules (Tutor, Eliza, Toycpu) that the corresponding
# command wrappers below load at runtime, the same split appl/danby uses.

DIRS=\
	plugin\

TARG=\
	apl.dis\
	basic.dis\
	computermovie.dis\
	eliza.dis\
	fantics.dis\
	hypercube.dis\
	hyperdoc.dis\
	ix.dis\
	synth.dis\
	thinkertoy.dis\
	trac.dis\
	tutor.dis\
	toycpu.dis\
	videosynth.dis\

DISBIN=$ROOT/$DISROOT/dreammachines

#
# The .m files these depend on, so that changing one rebuilds what
# includes it.
#
# BEFORE the line that includes mkdis, not after.  mk evaluates
# assignments in the order it reads them and mkdis computes
# SYS_MODULE=${SYSMODULES:%=$MODDIR/%} as soon as it is read, so a
# SYSMODULES set below that line is set after the only thing that reads
# it.  Absent altogether, mk takes the undefined variable for a target
# and "mk install" here stopped with "don't know how to make
# 'SYSMODULES'" before compiling anything -- and a whole-tree
# "mk install" stops with it, so every directory after this one in
# appl/mkfile's DIRS was silently not rebuilt.
#
SYSMODULES=\
	bufio.m\
	draw.m\
	dreammachines/eliza.m\
	dreammachines/toycpu.m\
	dreammachines/tutor.m\
	math.m\
	math/camerapath.m\
	math/draw3d.m\
	math/polyfill.m\
	sys.m\
	tk.m\
	tkclient.m\
	tone.m\
	wmclient.m\


<$ROOT/mkfiles/mkdis
<$ROOT/mkfiles/mksubdirs
