module Gen

// Dis instruction assembly, a port of ember/gen.c: the instruction
// list, temporaries, operand addressing, branch folding, pc and
// descriptor resolution, and the instruction-selection tables of
// optab.c.  every importer must hand its types instance down with
// usetypes() and its own com instance is the only user of the list.

const PATH = "/dis/ember/gen.dis"

