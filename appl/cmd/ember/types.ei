module Types

// the self-hosted compiler's shared data structures -- syntax nodes,
// types, declarations, descriptors, case tables -- and the port of
// ember/types.c: construction, sizing and layout, equivalence classes,
// module interfaces, pointer maps, link signatures, conversions and
// type printing.  nodes and types refer to each other, so they share
// one module.  the op codes match ember/parse.c's; parse.e keeps its
// own copy of the same generated list.

const PATH = "/dis/ember/types.dis"

