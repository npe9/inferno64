<../../../mkconfig

# the self-hosted ember compiler, in ember: built with the C
# bootstrap compiler ($EMBER), installed under $ROOT/dis/ember.

EMBER=$ROOT/$OBJDIR/bin/ember
IFLAGS=-I$ROOT/ember/module -I.

TARG=\
	lex.dis\
	types.dis\
	lexdump.dis\
	parse.dis\
	fold.dis\
	iface.dis\
	check.dis\
	astdump.dis\
	chkdump.dis\

all:V:	$TARG

%.dis:	%.e
	$EMBER $IFLAGS -o $target $stem.e || (rm -f $target; exit 1)

lexdump.dis:	lex.ei
parse.dis:	lex.ei types.ei
types.dis:	lex.ei
fold.dis:	types.ei
iface.dis:	types.ei parse.ei fold.ei
check.dis:	types.ei fold.ei iface.ei
chkdump.dis:	types.ei parse.ei iface.ei check.ei
astdump.dis:	lex.ei parse.ei types.ei

install:V:	all
	mkdir -p $ROOT/dis/ember
	cp $TARG $ROOT/dis/ember/

clean:V:
	rm -f $TARG

nuke:V:	clean
