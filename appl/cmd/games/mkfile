DISBIN=$ROOT/dis/games

<$ROOT/mkfiles/mkdis

# mkdis copies into $DISBIN and does not make it, and /dis/games is in
# .gitignore like every other dis subdirectory, so on a fresh checkout
# there is nowhere to copy to and the first install fails.  The
# directories that already exist were made by whoever first built the
# tree; this one makes its own.
$DISBIN/%.dis:	%.dis
	$MKDIR $DISBIN && rm -f $DISBIN/$stem.dis && cp $stem.dis $DISBIN/$stem.dis
