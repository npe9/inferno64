<../../../mkconfig

DIRS=\
	prep\

TARG=\
	efsck.dis\
	efs.dis\
	mkefs.dis\
	efsdump.dis\
	kfs64.dis\
	kfs.dis\
	mbr.dis\
	mkext.dis\
	mkfs.dis\
	kfscmd.dis\
	format.dis\
	ftl.dis\

SYSMODULES=\
	styx.m\
	styxservers.m\
	daytime.m\
	arg.m\
	sys.m\
	draw.m\
	bufio.m\
	string.m\

DISBIN=$ROOT/$DISROOT/disk

<$ROOT/mkfiles/mkdis
<$ROOT/mkfiles/mksubdirs

#
# efs.m is the format.  Without these, a change to the module
# definition rebuilds nothing -- mk tracks .b files and not the .m they
# include -- and the programs load a library whose adts no longer match,
# which arrives as "link typecheck Efs->Dev.open()" at run time.  That
# happened three times before the dependency was written down.
#
efs.dis mkefs.dis efsdump.dis efsck.dis:	$ROOT/module/efs.m
