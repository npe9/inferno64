# raspi3b - Raspberry Pi 3 Model B (BCM2837, 4x Cortex-A53, AArch64)
#
# One kernel image, kernel8.img, for both the board and the emulator: the
# Pi firmware loads it raw at 0x80000 and enters core 0 at EL2 with the
# other cores in armstub8's spin table, and qemu-system-aarch64 -M raspi3b
# -kernel kernel8.img does the same (see qemu.sh).  Console is the PL011
# on GPIO 14/15 (config.txt: enable_uart=1, dtoverlay=disable-bt).

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ssl
	cap
	kprof
	sd
	draw
	pointer
	usb
	ether		netif
# A packet radio at #W/radio0.  Real only when qemu is given
# "-machine raspi3b,radio=on", which fits an SX1276 to SPI0; on a real
# Pi it is whatever is wired to the header.  See doc/radio-plan.ms.
	radio
	ip	ip ipv6 ipaux ptclbsum parseip eipfmt classmask equivip parseether iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat


ip
	tcp
	udp
	ipifc
	icmp
	icmp6


link
	usbdwc
	ethermedium
	loopbackmedium
# spipiradio brings up SPI0 and the three GPIOs the radio uses, then
# asks sx127x.c whether a part is there.  Here rather than in port
# because links() runs after poolinit() and trapinit(), which a driver
# that allocates and takes an interrupt needs.
	spipiradio

