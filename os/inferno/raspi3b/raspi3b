# raspi3b - Raspberry Pi 3 Model B (BCM2837, 4x Cortex-A53, AArch64)
#
# One kernel image, kernel8.img, for both the board and the emulator: the
# Pi firmware loads it raw at 0x80000 and enters core 0 at EL2 with the
# other cores in armstub8's spin table, and qemu-system-aarch64 -M raspi3b
# -kernel kernel8.img does the same (see qemu.sh).  Console is the PL011
# on GPIO 14/15 (config.txt: enable_uart=1, dtoverlay=disable-bt).

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ssl
	cap
	kprof
#
# prof: the Dis profiler's device, #P, which prof(1) binds.
#
# kprof above profiles the KERNEL -- it samples the ARM pc and tells you
# that the board is eighty per cent idle in markheap and rungc.  It cannot
# say anything about a Limbo program, and on this board the programs are
# where the work is: etherusb touches every frame, efs every block.  #P
# samples the Dis pc instead, per module, which is what prof(1) reports.
#
	prof
	sd
	draw
	pointer
	usb
	wifi
	ether		netif
	ip	ip ipv6 ipaux ptclbsum parseip eipfmt classmask equivip parseether iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat


