#
# /prof, for prof(1) to bind #P onto.  A bind needs its mount point to
# exist, and the failure without it names the device rather than the
# missing directory: "cannot bind prof device to /prof: file does not
# exist".
#
	/prof	/
#
# /appl, as a mount point and nothing else.  prof(1) reports function and
# line numbers, so it needs the Limbo SOURCE and the .sbl beside it, not
# the .dis: findb() asks the object for the path the compiler recorded --
# /appl/cmd/disbench.b -- and findsbl() derives the symbol file from that.
# Neither is in this kernel's root and neither should be.  The board
# already mounts the whole host worktree on /n/remote, so
#
#	bind /n/remote/appl /appl
#
# gives the profiler every module's source and symbols for nothing.  That
# is why "prof -f" printed no profile at all for a run with thousands of
# samples in it: every module was skipped for want of a source file, and
# the loop that skips them says nothing.
#
	/appl	/
	/n/bt	/
	/n/efs	/
	/n/efscrash	/
	/n/dos	/
	/n/dos2	/
	/n/remote	/
