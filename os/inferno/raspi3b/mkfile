<../../../mkconfig

#Configurable parameters

CONF=raspi3b
CONFLIST=raspi3b

SYSTARG=$OSTARG
OBJTYPE=aarch64
INSTALLDIR=$ROOT/Inferno/$OBJTYPE/bin

IPDIR=../ip
INITDIR=../init
PORTDIR=../port

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

# The built-in root goes in the text segment rather than the data
# segment: utils/data2s/data2s.c -t puts RODATA on its GLOBL and the
# linker lays it out with the string constants.  See doc/xip.ms.
ROOTINTEXT=1

<| $SHELLNAME ../port/mkdevlist $CONF

# QEMU -M virt (64 bit), same address layout as armv7's own board
# (verified via -machine dumpdtb regardless of -cpu cortex-a15 vs
# cortex-a72 -- see mem.h); RAM starts at 0x40000000.
KTZERO=0x80000

OBJ=\
	l.$O\
	auth.$O\
	clock.$O\
	main.$O\
	mmu.$O\
	cachebcm.$O\
	trap.$O\
	tod.$O\
	mul64fract.$O\
	fdt.$O\
	stubs.$O\
	i2cbcm.$O\
	spibcm.$O\
	gpiobcm.$O\
	mailbox.$O\
	$CONF.root.$O\
	$IP\
	$DEVS\
	$ETHERS\
	$LINKS\
	$PORT\
	$MISC\
	$OTHERS\

LIBNAMES=${LIBS:%=lib%.a}
LIBDIRS=$LIBS

HFILES=\
	mem.h\
	dat.h\
	io.h\

CFLAGS=-wFV -I. -I../port -I../ip -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp
KERNDATE=`{$NDATE}

default:V: i$CONF

install:V: i$CONF
	cp i$CONF $INSTALLDIR/i$CONF

# $LIBNAMES and $LIBFILES both, and the second is the point: lib%.a is a
# virtual target (portmkfile), so it rebuilds a library but never counts
# as newer than the kernel.  A kernel linked before a libinterp change
# therefore stayed linked, and testing it tested the old code -- which
# cost a probe hunt where the instrumented kernel never contained the
# instrument.  $LIBFILES names the .a files themselves, which do have
# times.
i$CONF: $OBJ $CONF.c $CONF.root.h $LIBNAMES $LIBFILES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target -H7 -T$KTZERO -R4096 -l $OBJ $CONF.$O $LIBFILES
	cp $target $INSTALLDIR/$target

# Raw flat image for a real Pi 3: the VideoCore firmware loads kernel8.img
# byte-for-byte at 0x80000 and jumps there (no ELF loader), so strip the
# ELF wrapper down to the loadable segments at their link addresses.  See
# README.hardware.  (7l -H6 packs segments contiguously and would put .data
# at the wrong address, so lay them out from the ELF program headers.)
kernel8.img: i$CONF mkrawimg.py
	python3 mkrawimg.py i$CONF kernel8.img $KTZERO

boot:V: kernel8.img
	echo 'kernel8.img + config.txt are ready for the Pi FAT boot partition'
	echo '(also needs the Pi firmware: bootcode.bin start.elf fixup.dat)'

<../port/portmkfile

../init/$INIT.dis:	../init/$INIT.b
	cd ../init; mk $INIT.dis

clock.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
main.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

devether.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
netif.$O:	../port/netif.h
ethervirtiommio.$O:	../port/netif.h ../port/etherif.h
$IP devip.$O:	$IPDIR/ip.h

tod.$O:	../port/tod.c
	$CC $CFLAGS ../port/tod.c

mul64fract.$O:	../port/mul64fract.c

fdt.$O:	../port/fdt.c
	$CC $CFLAGS ../port/fdt.c

pciecam.$O:	../port/pciecam.c
	$CC $CFLAGS ../port/pciecam.c
	$CC $CFLAGS ../port/mul64fract.c

devuart.$O:	../port/devuart.c
	$CC $CFLAGS ../port/devuart.c

