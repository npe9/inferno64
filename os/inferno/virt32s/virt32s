# virt32 - QEMU -M virt, 32-bit RISC-V (RV32)
#
# The riscv32 analogue of os/inferno/virt (riscv64): same QEMU virt
# machine, same memory map (verified separately via this host's own
# qemu-system-riscv32 -machine dumpdtb, not assumed from the riscv64
# board), but a completely different kernel toolchain -- zc/za/zl
# (thechar z, Richard Miller's original Plan 9 RISC-V compiler), not
# jc/ja/jl.  za has no CSR read/write operand form and no F-register
# file at all; see virt32/l.s for what that required.
#
# Serial-console-only first boot, the same scope armv7's own config
# started from: no ether/ip (ethervirtiommio pulls in the netif/ip
# stack this pass doesn't need), no screen (memlayer/memdraw/draw),
# no SD, no virtio input, no PCI, no entropy device (virt's own board
# comment: randomvirt wants a libsec newer than the one this tree
# shares). Widening this to match virt's full device list can follow
# once the console path itself is proven on real QEMU.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	cap
	kprof

lib
	interp
	keyring
	sec
	mp
	kern

port
	alarm
	alloc
	allocb
	bo
	chan
	dev
	dial
	dis
	discall
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
	sysfile
	taslock
	xalloc

	archvirt

misc
	uartvirt
	screennone
	randomvirt32

mod
	sys
	keyring
	crypt

init
	virt32init

code
	int main_pool_pcnt = 20;
	int heap_pool_pcnt = 20;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
