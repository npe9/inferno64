	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ether		netif
	ip	ip ipv6 ipaux ptclbsum parseip eipfmt classmask equivip parseether iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat
	cap
	kprof

ip
	tcp
	udp
	ipifc
	icmp
	icmp6

lib
	interp
	keyring
	sec
	mp
	kern

port
	alarm
	alloc
	allocb
	bo
	chan
	dev
	dial
	dis
	discall
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
	sysfile
	taslock
	xalloc

	archvirt

# The same driver os/inferno/virt links on riscv64, copied unchanged
# but for its header comment: it is MMIO registers and ring structures
# with no arch-specific asm, and the ring fields are fixed widths, not
# machine words.
link
	ethervirtiommio
	ethermedium
	loopbackmedium

misc
	uartvirt
	screennone
	randomvirt32

mod
	sys
	keyring
	crypt

init
	virt32init

code
	int main_pool_pcnt = 20;
	int heap_pool_pcnt = 20;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
