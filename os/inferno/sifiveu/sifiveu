# sifiveu - the SiFive Unleashed, riscv64
#
# Reconstructed from the generated sifiveu.c that pr/riscv-native-boards
# carried without the configuration it was generated from, the same way
# os/inferno/virt/virt and os/inferno/spike/spike were.  The devices,
# links, modules, uart, protocols and pool sizes below are the ones that
# file names; the portable objects are the ones this board's mkfile
# links.
#
# The generated sifiveu.c names dynlddevtab, so the configuration it
# came from asked for the real dynamic loader.  libdynld has no riscv64
# member -- libdynld/dynld-386.c through libdynld/dynld-spim.c and no
# more -- so this asks for os/inferno/port/nodynld.c instead, which is
# what os/inferno/virt/virt does.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ssl
	cap
	kprof
	ether		netif
	ip	ip ipv6 ipaux iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat

ip
	udp
	tcp
	ipifc
	icmp
	icmp6

# the order matters: a library with an undefined symbol at the end
# makes the loader complain
lib
	interp
	keyring
	sec
	mp
	math
	kern
	ip

link
	ethersifivegem
	ethermedium
	loopbackmedium

# the portable kernel this board takes, and its own code beside it.
# archsifiveu and the rest are objects and nothing more; naming them
# under misc would have mkdevc build a PCArch table for them, which is
# the PC's abstraction and not this board's.
port
	alarm
	alloc
	allocb
# the board has its own auth.c, named in the mkfile
	chan
	dev
	dial
	dis
	discall
# edf wants a microsecond clock this board does not export
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
# randomsifiveu is this board's entropy; the portable random.c wants a
# libsec newer than the one this tree shares
	sysfile
	taslock
	xalloc

	archsifiveu
	randomsifiveu
	screensifiveu

# uartsifive is this board's PhysUart -- mkdevc turns a misc name
# beginning uart into <rest>physuart, so uartsifive gives
# sifivephysuart, which is what the generated sifiveu.c names.  The PWM
# and SPI controllers beside it in os/inferno/riscv are the rest of the
# FU540's own devices.
misc
	uartsifive
	pwmsifive
	spisifive

mod
	sys
	keyring
	crypt
	math
	ipints

init
	sifiveuinit

code
	int main_pool_pcnt = 40;
	int heap_pool_pcnt = 40;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
	/chan	/
	/dev	/
	/dis	/
	/env	/
	/fd	/
	/n	/
	/net	/
	/prog	/
	/tmp	/
	/osinit.dis
