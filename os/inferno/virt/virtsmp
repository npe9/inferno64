# virtsmp - virtlinux with rvsmpinit.b, the four-hart guest, as init.
#
# virtlinux - virtvm with the RISC-V Linux guest of
# scripts/mklinuxguest.sh in its root and rvlinuxinit.b, which boots it
# with vmlinux(1), as init.  Build the guest first.  virtvm is:
#
# virtvm - virt, with the hypervisor: #H on the H extension
# (vmrv.c, vmplat.c), and the M1 test of doc/genesize-plan.ms for it
# (rvtestinit.b) as init.  Otherwise the same as virt:
#
# Reconstructed from the generated virt.c that pr/riscv-native-boards
# carried without the configuration it was generated from.  The devices,
# links, modules, storage interface and protocols below are the ones
# that file names.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	sd
	ether		netif
	ip	ip ipv6 ipaux ptclbsum parseip eipfmt classmask equivip parseether iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat
	draw
	pointer
	ssl
	cap
	kprof
	usb
	vm
	iommu

ip
	tcp
	udp
	ipifc
	icmp
	icmp6

# the order matters: a library with an undefined symbol at the end
# makes the loader complain
lib
	interp
	keyring
	memlayer
	memdraw
	draw
	sec
	mp
	math
	kern
# not libip: that is the hosted helper library, and its
# readipifc.c opens and reads /net/ipifc.  A native kernel has
# its own ip stack -- the ip section above, with os/inferno/ip/
# ipaux.c -- and upstream Inferno's native configs link no ip
# library at all.

link
	ethervirtiommio
	ethervirtio10	pci
	usbxhcipci	usbxhci
	pmmc	pci
	ethermedium
	loopbackmedium
	inputvirtiommio
	rngvirtiommio
	vmrv
	rviommu

# the portable kernel this board takes, and its own code beside it.
# archvirt and the rest are objects and nothing more; naming them under
# misc would have mkdevc build a PCArch table for them, which is the
# PC's abstraction and not this board's.
port
	alarm
	alloc
	allocb
	bo
# the board has its own auth.c, named in the mkfile
	chan
	dev
	dial
	dis
	discall
# edf wants a microsecond clock this board does not export yet
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
# randomvirt is this board's entropy; the portable random.c wants a
# libsec newer than the one this tree shares
# rdb wants the kernel debugger's console queue, which this board
# does not configure
	swcursor
	sysfile
	taslock
	xalloc

	archvirt
	randomvirt
	screenvirt
	vmplat
	vuart
	vmvirtio
	vmpci

misc
	sdvirtiommio	sdscsi
	sdvirtio10	pci sdscsi virtio10mem
	sdnvme	pci
	sdmmc
	pci	pciecam
	uartvirt

mod
	sys
	keyring
	crypt
	math
	ipints
	draw

init
	rvsmpinit

code
	int main_pool_pcnt = 20;
	int heap_pool_pcnt = 20;
	int image_pool_pcnt = 20;	/* was 60; large contig poolalloc hangs under TCG */
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
# The Limbo userland, the same set os/inferno/pc64/pc64 carries.  A bare
# name whose $ROOT counterpart is a directory makes an empty directory in
# the embedded root; a name that is a file embeds its bytes.  Dis is
