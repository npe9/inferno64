# armv7 - QEMU -M virt, 32-bit ARMv7-A (cortex-a15)
#
# The ARM analogue of os/inferno/virt: one privilege level (SVC), MMU
# off, a QEMU virt machine verified against this host's own QEMU via
# -machine dumpdtb rather than assumed from documentation.  This is
# NOT the AArch64 "armvirt" row doc/inferno-ports.ms's machine table
# names -- that target needs a compiler backend (a "7" or "u" objtype)
# this tree does not have.  This is a new, smaller row beside it: 32
# bit, built on the "arm" (5c/5a/5l) toolchain that already ships here
# for the M-profile boards.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ether		netif
	ip	ip ipv6 ipaux ptclbsum parseip eipfmt classmask equivip parseether iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat
	ssl
	cap
	kprof

ip
	tcp
	udp
	ipifc
	icmp
	icmp6

lib
	interp
	keyring
	sec
	mp
	kern
# No display: this is a serial-console-only first boot, like spike's
# (see spike's own board-config comment) -- no memlayer/memdraw/draw,
# no draw/pointer devices, no swcursor.  A softscreen (matching
# virt's ramfb approach) can follow once the console path works.
# math/tk/draw's Limbo runtime libs are left off the mod list below
# (see the pc64 config's own note on 6l's span() bug); lib above is
# the C-level kernel support, not the Dis-level modules.

link
	ethervirtiommio
	ethermedium
	loopbackmedium
# inputvirtiommio (virtio mouse/keyboard) is not linked yet: its
# mousetrack() call needs devpointer.c, which pulls in draw.h/
# memdraw.h/cursor.h/screen.h -- the display stack this headless
# first boot deliberately doesn't have.  Revisit alongside a real
# screen.h.

port
	alarm
	alloc
	allocb
	bo
	chan
	dev
	dial
	dis
	discall
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
	sysfile
	taslock
	xalloc

	archv7

misc
	uartarmv7
	screennone
	randomarmv7

mod
	sys
	keyring
	crypt

init
	virtinit

code
	int main_pool_pcnt = 20;
	int heap_pool_pcnt = 20;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
# The Limbo userland, taken from /dis32: a Dis word is four bytes on
# this board, and a module compiled for eight will not load.  See
# mkfiles/mkdis and the note in mkconfig -- these are the ones
# appl/cmd and appl/lib install under DISROOT=dis32 DISWORD=4.
