<../../../mkconfig

#Configurable parameters

CONF=mps2
CONFLIST=mps2

SYSTARG=$OSTARG
OBJTYPE=thumb
INSTALLDIR=$ROOT/Inferno/$OBJTYPE/bin

INITDIR=../init
PORTDIR=../port
ARCHDIR=../armv7m

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

# The built-in root goes in the text segment, not the data segment: this
# board runs its text from flash (or, on mps2, models one that does), and
# os/inferno/armv7m/l.s copies the data segment into RAM at boot.  See
# os/inferno/port/mkroot and utils/data2s/data2s.c.
ROOTINTEXT=1

# And the boot module's decoded instruction array with it.  utils/dis2s
# lays out at build time what libinterp/load.c:/^parsemod would
# otherwise build in RAM every time the module is loaded, as a RODATA
# symbol that the linker puts in the text segment.  XIPMODS tells
# os/inferno/port/mkdevc that this board defines xipmods itself, in the
# file dis2s generates, rather than taking the empty one.  See
# doc/xip.ms.
XIPMODS=1

<| $SHELLNAME ../port/mkdevlist $CONF

# The core reads its initial stack pointer and reset address from the
# first two words of the image, so the text has to start where the
# vector table is expected: the bottom of SSRAM1.
#
# The data segment is linked into the second block of static RAM even
# though the first has room, because that is the shape a board with its
# text in flash has to use and this is where it gets rehearsed: the
# image is text immediately followed by the data, and
# os/inferno/armv7m/l.s copies the data to where it was linked before
# anything reads a variable.  -R0 stops the linker rounding the data
# address up and away from the one given here.
KTZERO=0x00000000
KDATA=0x20000000

OBJ=\
	l.$O\
	auth.$O\
	clock.$O\
	main.$O\
	mmu.$O\
	fpu.$O\
	fpiarmv7m.$O\
	fpi.$O\
	fpimem.$O\
	trap.$O\
	tod.$O\
	mul64fract.$O\
	stubs.$O\
	$CONF.root.$O\
	$CONF.prog.$O\
	$CONF.xipmod.$O\
	$CONF.flash.$O\
	$DEVS\
	$LINKS\
	$PORT\
	$MISC\
	$OTHERS\

LIBNAMES=${LIBS:%=lib%.a}
LIBDIRS=$LIBS

HFILES=\
	mem.h\
	dat.h\
	io.h\
	$ARCHDIR/armv7m.h\

CFLAGS=-wFV -I. -I$ARCHDIR -I../port -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp
KERNDATE=`{$NDATE}

default:V: i$CONF

install:V: i$CONF
	cp i$CONF $INSTALLDIR/i$CONF

# The modules whose decoded instruction arrays are built into the image.
# These are the ones a shell prompt and an ls(1) actually load, traced by
# printing every path libinterp/load.c:/^parsemod is given; between them
# they are 110616 bytes of Inst that no longer has to be built in RAM.
# A name here is the same relative name under /dis in the built-in root
# and under dis32 where it was installed, which is how the root section
# of the conf names them too.  A module whose file does not match what
# the root carries simply is not matched at load time, so the failure
# mode of getting this list wrong is losing the saving, not running the
# wrong code.
XIPDIS=\
	sh.dis\
	ls.dis\
	lib/string.dis\
	lib/bufio.dis\
	lib/filepat.dis\
	lib/readdir.dis\
	lib/env.dis\
	lib/arg.dis\

# dis32, not $DISROOT: the root section of the conf beside this file
# names /dis32 explicitly, because a Dis word is four bytes on this board
# and a module compiled for eight will not load.  These have to be the
# same files the root carries.
XIPDISFILES=${XIPDIS:%=$ROOT/dis32/%}

# A test file system for the flash device: packed by utils/mkflashfs and
# linked in as a RODATA blob, which puts it in the text segment, which is
# what a memory-mapped NOR window looks like to the kernel.  A real board
# points flashbase at its own window and needs none of this.
FLASHDIS=\
	echo.dis\
	cat.dis\

FLASHDISFILES=${FLASHDIS:%=$ROOT/dis32/%}

$CONF.flash.s: $FLASHDISFILES
	mkflashfs -o $CONF.flash.img $FLASHDISFILES
	data2s -t flashimg <$CONF.flash.img >$target
	rm -f $CONF.flash.img

# dis2s is a host tool, found on the path like data2s and ndate are.
$CONF.prog.s $CONF.xipmod.c: $INITDIR/$INIT.dis $XIPDISFILES
	$DIS2S -o $CONF.prog -c $CONF.xipmod -r $ROOT/dis32 -p /dis \
		/osinit.dis=$INITDIR/$INIT.dis $XIPDIS

i$CONF: $OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target -H4 -T$KTZERO -D$KDATA -R0 -l $OBJ $CONF.$O $LIBFILES
	cp $target $INSTALLDIR/$target

<../port/portmkfile

# After the include: portmkfile sets CLEANEXTRA empty.
CLEANEXTRA=$CONF.prog.s $CONF.xipmod.c $CONF.flash.s $CONF.flash.img

../init/$INIT.dis:	../init/$INIT.b
	cd ../init; mk 'DISWORD='$DISWORD $INIT.dis

clock.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
main.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

l.$O:	$ARCHDIR/l.s mem.h $ARCHDIR/armv7m.h
	$AS $ASFLAGS -I. $ARCHDIR/l.s

%.$O:	$ARCHDIR/%.c
	$CC $CFLAGS $ARCHDIR/$stem.c

tod.$O:	../port/tod.c
	$CC $CFLAGS ../port/tod.c

mul64fract.$O:	../port/mul64fract.c
	$CC $CFLAGS ../port/mul64fract.c

# The software floating point the Cortex-M4's missing double precision is
# emulated with.  fpi.h is $ARCHDIR's copy; ../port/fpi.c includes it by
# plain name, which -I$ARCHDIR resolves.
fpi.$O:	../port/fpi.c $ARCHDIR/fpi.h
	$CC $CFLAGS ../port/fpi.c

fpimem.$O:	../port/fpimem.c $ARCHDIR/fpi.h
	$CC $CFLAGS ../port/fpimem.c

fpiarmv7m.$O:	$ARCHDIR/fpiarmv7m.c $ARCHDIR/fpi.h

# sx127x.h carries the Radio struct, which three files share, so a change
# to it has to rebuild all three.  Said explicitly because the catch-all
# %.$O rule in $PORTDIR/portmkfile lists the headers every object has and
# not the ones a particular driver includes -- and a struct that grows a
# field while one of its users keeps the old layout does not fail to
# build, it reads a different member at run time.  That cost an afternoon
# once already, in include/pool.h; see doc/xip.ms.
devradio.$O sx127x.$O spipl022.$O:	$PORTDIR/sx127x.h

devuart.$O:	../port/devuart.c
	$CC $CFLAGS ../port/devuart.c

# qemu-system-arm -M mps2-an500 -nographic -kernel imps2
