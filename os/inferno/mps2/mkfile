<../../../mkconfig

#Configurable parameters

CONF=mps2
CONFLIST=mps2

SYSTARG=$OSTARG
OBJTYPE=thumb
INSTALLDIR=$ROOT/Inferno/$OBJTYPE/bin

INITDIR=../init
PORTDIR=../port
ARCHDIR=../armv7m

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

<| $SHELLNAME ../port/mkdevlist $CONF

# The core reads its initial stack pointer and reset address from the
# first two words of the image, so the text has to start where the
# vector table is expected: the bottom of SSRAM1.
#
# The data segment is linked into the second block of static RAM even
# though the first has room, because that is the shape a board with its
# text in flash has to use and this is where it gets rehearsed: the
# image is text immediately followed by the data, and
# os/inferno/armv7m/l.s copies the data to where it was linked before
# anything reads a variable.  -R0 stops the linker rounding the data
# address up and away from the one given here.
KTZERO=0x00000000
KDATA=0x20000000

OBJ=\
	l.$O\
	auth.$O\
	clock.$O\
	main.$O\
	mmu.$O\
	fpu.$O\
	fpiarmv7m.$O\
	fpi.$O\
	fpimem.$O\
	trap.$O\
	tod.$O\
	mul64fract.$O\
	stubs.$O\
	$CONF.root.$O\
	$DEVS\
	$LINKS\
	$PORT\
	$MISC\
	$OTHERS\

LIBNAMES=${LIBS:%=lib%.a}
LIBDIRS=$LIBS

HFILES=\
	mem.h\
	dat.h\
	io.h\
	$ARCHDIR/armv7m.h\

CFLAGS=-wFV -I. -I$ARCHDIR -I../port -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp
KERNDATE=`{$NDATE}

default:V: i$CONF

install:V: i$CONF
	cp i$CONF $INSTALLDIR/i$CONF

i$CONF: $OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target -H4 -T$KTZERO -D$KDATA -R0 -l $OBJ $CONF.$O $LIBFILES
	cp $target $INSTALLDIR/$target

<../port/portmkfile

../init/$INIT.dis:	../init/$INIT.b
	cd ../init; mk 'DISWORD='$DISWORD $INIT.dis

clock.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
main.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

l.$O:	$ARCHDIR/l.s mem.h $ARCHDIR/armv7m.h
	$AS $ASFLAGS -I. $ARCHDIR/l.s

%.$O:	$ARCHDIR/%.c
	$CC $CFLAGS $ARCHDIR/$stem.c

tod.$O:	../port/tod.c
	$CC $CFLAGS ../port/tod.c

mul64fract.$O:	../port/mul64fract.c
	$CC $CFLAGS ../port/mul64fract.c

# The software floating point the Cortex-M4's missing double precision is
# emulated with.  fpi.h is $ARCHDIR's copy; ../port/fpi.c includes it by
# plain name, which -I$ARCHDIR resolves.
fpi.$O:	../port/fpi.c $ARCHDIR/fpi.h
	$CC $CFLAGS ../port/fpi.c

fpimem.$O:	../port/fpimem.c $ARCHDIR/fpi.h
	$CC $CFLAGS ../port/fpimem.c

fpiarmv7m.$O:	$ARCHDIR/fpiarmv7m.c $ARCHDIR/fpi.h

devuart.$O:	../port/devuart.c
	$CC $CFLAGS ../port/devuart.c

# qemu-system-arm -M mps2-an500 -nographic -kernel imps2
