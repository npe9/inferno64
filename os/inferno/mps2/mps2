# mps2 - ARM MPS2 with the AN500 FPGA image: a Cortex-M7, console only.
#
# This is the board that can be run: QEMU models it, and it is a
# Cortex-M7, which is the same core the Teensy 4.1 carries.  What is
# proved here -- the vector table, the exception path, SysTick, the
# spl primitives, the exclusive monitor, and that utils/tc and utils/tl
# produce code an ARMv7-M core executes -- is shared with
# os/inferno/teensy41 and os/inferno/nucleof303 through
# os/inferno/armv7m.
#
# Serial only: no ip stack, no ethernet, no storage, no draw.
#
# The same kernel binary is also the Cortex-M4 test bench: QEMU's AN386
# image has this board's memory map and UART and an M4 in place of the
# M7, so qemu-m4.sh boots this image on a core with no double-precision
# floating point.  A console shell works there; fptest takes a usage
# fault.  That is the bench for the software double precision the
# Cortex-M4 boards need -- see doc/armv7m-ports.ms and
# doc/pycubed-plan.ms.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ssl
	cap
	kprof
# A read-only file system in addressable memory, served where it lies:
# the second provider of Dev.xip after the built-in root.  On this board
# the "flash" is a RODATA blob linked into the text segment, which is
# the same thing a memory-mapped NOR window is as far as the kernel can
# tell.  See os/inferno/port/devflashfs.c and doc/xip.ms.
	flashfs
# Board-specific files under #P, the way os/inferno/pc has always had
# them.  This board registers a few invented sensor readings through
# addarchfile(); see os/inferno/armv7m/devarch.c and os/inferno/mps2/
# archfiles.c.
	arch
# A packet radio at #W/radio0.  Real only when qemu is given
# "-machine radio=on", which fits an SX1276 to the Shield0 SPI header;
# without it sx127xinit() finds no part and the device serves an empty
# directory.  See doc/radio-plan.ms.
	radio

# the order matters: a library with an undefined symbol at the end
# makes the loader complain
lib
	interp
	keyring
	sec
	mp
	math
	kern

# the portable kernel this board takes, and its own code beside it.
# archmps2 and the rest are objects and nothing more; naming them under
# misc would have mkdevc build a PCArch table for them, which is the
# PC's abstraction and not this board's.
port
	alarm
	alloc
	allocb
# the board has its own auth.c, named in the mkfile
	chan
	dev
	dial
	dis
	discall
# edf wants a microsecond clock this board does not export
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
# randomarmv7m is the entropy these boards have; the portable random.c
# wants a libsec newer than the one this tree shares
	sysfile
	taslock
	xalloc

	archmps2
	archfiles
	randomarmv7m
	screenarmv7m
	sx127x

# uartcmsdk is this board's PhysUart -- mkdevc turns a misc name
# beginning uart into <rest>physuart, so uartcmsdk gives cmsdkphysuart.
misc
	uartcmsdk

# spipl022 brings up the Shield0 SPI and the GPIO pins the radio shield
# uses, then asks sx127x.c whether a part is there.  It is in link
# rather than port because links() runs after poolinit() and trapinit(),
# which is what a driver that allocates and takes an interrupt needs.
link
	spipl022

mod
	sys
	keyring
	crypt
	math

init
	armv7minit

# Percentages of the memory left after the kernel, so they are ceilings
# and not reservations -- except that poolsize() asks the image pool for
# its whole arena contiguously at boot and panics if it cannot get it.
# Measured on mps2 at a shell prompt after ls(1): main 367104 in use,
# heap 73728, image 0, and image has never been anything but 0 on a
# board with no draw device and no segments.  40/40/20 gives main a
# ceiling under what it is measured to need as soon as the board is
# small.  See doc/xip.ms.
code
	int main_pool_pcnt = 70;
	int heap_pool_pcnt = 25;
	int image_pool_pcnt = 5;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
# The Limbo userland, taken from /dis32: a Dis word is four bytes on
# this board, and a module compiled for eight will not load.  See
# mkfiles/mkdis and the note in mkconfig.  A bare
# name whose $ROOT counterpart is a directory makes an empty directory in
# the embedded root; a name that is a file embeds its bytes.  Dis is
# bytecode, but not architecture-independent here: its word follows the
# size of a pointer, so these are the ones appl/cmd and appl/lib install
# under DISROOT=dis32 DISWORD=4.
