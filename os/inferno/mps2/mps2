# mps2 - ARM MPS2 with the AN500 FPGA image: a Cortex-M7, console only.
#
# This is the board that can be run: QEMU models it, and it is a
# Cortex-M7, which is the same core the Teensy 4.1 carries.  What is
# proved here -- the vector table, the exception path, SysTick, the
# spl primitives, the exclusive monitor, and that utils/tc and utils/tl
# produce code an ARMv7-M core executes -- is shared with
# os/inferno/teensy41 and os/inferno/nucleof303 through
# os/inferno/armv7m.
#
# Serial only: no ip stack, no ethernet, no storage, no draw.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ssl
	cap
	kprof

# the order matters: a library with an undefined symbol at the end
# makes the loader complain
lib
	interp
	keyring
	sec
	mp
	math
	kern

# the portable kernel this board takes, and its own code beside it.
# archmps2 and the rest are objects and nothing more; naming them under
# misc would have mkdevc build a PCArch table for them, which is the
# PC's abstraction and not this board's.
port
	alarm
	alloc
	allocb
# the board has its own auth.c, named in the mkfile
	chan
	dev
	dial
	dis
	discall
# edf wants a microsecond clock this board does not export
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
# randomarmv7m is the entropy these boards have; the portable random.c
# wants a libsec newer than the one this tree shares
	sysfile
	taslock
	xalloc

	archmps2
	randomarmv7m
	screenarmv7m

# uartcmsdk is this board's PhysUart -- mkdevc turns a misc name
# beginning uart into <rest>physuart, so uartcmsdk gives cmsdkphysuart.
misc
	uartcmsdk

mod
	sys
	keyring
	crypt
	math

init
	shell

code
	int main_pool_pcnt = 40;
	int heap_pool_pcnt = 40;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
# The Limbo userland.  A bare
# name whose $ROOT counterpart is a directory makes an empty directory in
# the embedded root; a name that is a file embeds its bytes.  Dis is
# bytecode and has no architecture, so these are the files appl/cmd and
# appl/lib install for every target, not riscv64 ones.
