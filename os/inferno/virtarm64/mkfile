<../../../mkconfig

#Configurable parameters

CONF=virtarm64
CONFLIST=virtarm64

SYSTARG=$OSTARG
OBJTYPE=aarch64
INSTALLDIR=$ROOT/Inferno/$OBJTYPE/bin

IPDIR=../ip
INITDIR=../init
PORTDIR=../port

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

<| $SHELLNAME ../port/mkdevlist $CONF

# QEMU -M virt (64 bit), same address layout as armv7's own board
# (verified via -machine dumpdtb regardless of -cpu cortex-a15 vs
# cortex-a72 -- see mem.h); RAM starts at 0x40000000.
KTZERO=0x40200000	# see mem.h: the gap below is QEMU's device tree

OBJ=\
	l.$O\
	auth.$O\
	clock.$O\
	main.$O\
	mmu.$O\
	trap.$O\
	tod.$O\
	mul64fract.$O\
	fdt.$O\
	acpi.$O\
	stubs.$O\
	$CONF.root.$O\
	$IP\
	$DEVS\
	$ETHERS\
	$LINKS\
	$PORT\
	$MISC\
	$OTHERS\

LIBNAMES=${LIBS:%=lib%.a}
LIBDIRS=$LIBS

HFILES=\
	mem.h\
	dat.h\
	io.h\

CFLAGS=-wFV -I. -I../port -I../ip -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp
KERNDATE=`{$NDATE}

default:V: i$CONF

#
#	i$CONF.a comes with i$CONF, not on request.  They are two
#	wrappers around one set of objects, and the only thing that can
#	go wrong between them is one being older than the other -- which
#	happened three times in one afternoon, each time as a UEFI boot
#	that quietly ran the previous kernel.  A target that is built
#	only when somebody remembers is a target that is stale.
#
install:V: i$CONF i$CONF.a
	cp i$CONF $INSTALLDIR/i$CONF

i$CONF: $OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD -o $target -H7 -T$KTZERO -R4096 -l $OBJ $CONF.$O $LIBFILES
	cp $target $INSTALLDIR/$target

#
#	The same kernel as a Plan 9 a.out rather than an ELF.  QEMU's
#	-kernel wants ELF, which is why i$CONF is -H7; the EFI loader in
#	os/inferno/boot/efi reads an a.out, because that is the format
#	bootkern() has always read and it carries the entry, the three
#	segment sizes and nothing else.  Both come from the same objects,
#	so there is no second kernel to keep in step -- only a second
#	wrapper around one.  Not in install: nothing boots it unless
#	somebody puts it on an ESP.
#
i$CONF.a: $OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD -o $target -H2 -T$KTZERO -R4096 -l $OBJ $CONF.$O $LIBFILES

<../port/portmkfile

../init/$INIT.dis:	../init/$INIT.b
	cd ../init; mk $INIT.dis

clock.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
main.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

devether.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
netif.$O:	../port/netif.h
ethervirtiommio.$O:	../port/netif.h ../port/etherif.h
$IP devip.$O:	$IPDIR/ip.h

tod.$O:	../port/tod.c
	$CC $CFLAGS ../port/tod.c

mul64fract.$O:	../port/mul64fract.c

fdt.$O:	../port/fdt.c
	$CC $CFLAGS ../port/fdt.c

acpi.$O:	../port/acpi.c
	$CC $CFLAGS ../port/acpi.c

pciecam.$O:	../port/pciecam.c
	$CC $CFLAGS ../port/pciecam.c
	$CC $CFLAGS ../port/mul64fract.c

devuart.$O:	../port/devuart.c
	$CC $CFLAGS ../port/devuart.c

