	pci	pciecam
# gicv2m: message-signalled interrupts for the PCI devices below.  A
# GICv2 has no ITS, so QEMU's -M virt puts an SBSA v2m frame beside
# the distributor and one memory write there becomes one SPI.
	gicv2m
# gicv3its: the same job on a GICv3, where there is no frame.  The ITS
# translates (DeviceID, EventID) pairs through tables in memory into
# LPIs, so it needs a command queue, a device table, a collection
# table and one translation table per device -- and the board links
# both because which one exists is a property of the machine QEMU was
# started as, not of the kernel.
	gicv3its
# acpiarm: the MADT and the IORT, for a machine that hands the kernel
# ACPI instead of a device tree -- which is every SystemReady arm64
# machine and no QEMU direct boot.  Everything it finds is optional:
# a board with no tables falls back to the device tree, and a board
# with neither falls back to mem.h.
	acpiarm
	sdvirtio10	pci sdscsi virtio10mem
	sdnvme	pci
	screenarm
	randomvirtarm64

mod
	sys
	keyring
	crypt
# $Math and $IPints, which virt has had and this board never did.  Their
# absence is what MATH-FAIL was: "load Math Math->PATH" answering "file
# does not exist" for a module that is built into the kernel, not one
# missing from the root.
	math
	ipints
	draw

init
	virtinit

code
	int main_pool_pcnt = 20;
	int heap_pool_pcnt = 20;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
	/chan	/
	/dev	/
	/dis
	/env	/
	/fd	/
	/n	/
# styxcheck() mounts its exported /dis on /n/styx, and the static
# namespace devroot serves refuses a runtime create -- the same
# permission denied that sent fsmount() to /tmp.  So the mount point
# is in the root file list, empty, rather than made when it is wanted.
	/n/styx	/
# /n/usb, for the xhci arm's mass storage: the same reason /n/styx is
# here rather than made at boot -- devroot's static namespace refuses a
# runtime create, so a mount point that is wanted has to be in this
# list.  /tmp/dos is already taken by fscheck()'s virtio disk, and the
# two are mounted in the same namespace.
	/n/usb	/
	/net	/
	/net.alt	/
	/nvfs	/
	/prog	/
	/tmp	/
	/proc	/
	/dis/lib
	/dis/svc
	/dis/wm
	/osinit.dis
	/dis/init
	/dis/shutdown
	/dis/basename.dis
	/dis/bind.dis
	/dis/cat.dis
	/dis/cd.dis
	/dis/echo.dis
	/dis/grep.dis
	/dis/ls.dis
	/dis/mntgen.dis
# memfs, for /tmp: TMP-FAIL was "load memfs: file does not exist".
# It needs styxlib as well as the styx.dis already below: with memfs.dis
# present and styxlib.dis absent, memfs's checkload calls error() from
# inside init(), init() never returns to tmpmount(), and the boot wedges
# there -- so every later marker vanished rather than merely failing.
	/dis/memfs.dis
	/dis/lib/styxlib.dis
# dossrv, for the FAT card the suite hands this board on virtio-blk:
# FS-MKDIR-FAIL used to stop fsmount() before it got here, and with
# /tmp real the next thing it wanted was the server.  Its own imports
# (daytime, styx, arg) were already in this root.
# usbd, for the PCI xHCI controller this board has always linked and
# no arm ever gave a device.  Mass storage is usbd's own Bulk-Only
# Transport code -- there is no kernel disk driver behind it, so the
# stick never appears under #S -- and it serves the medium as a flat
# file at /chan/usbdiskN that dossrv mounts like any other.  usbd
# loads nothing but Sys, so this line is the whole addition.
	/dis/usb/usbd.dis
	/dis/dossrv.dis
# ping, for IP-FAIL: the DHCP lease above is only half of a working
# stack, and ip/ping.dis is what the check sends over it.  Its imports
# (ip, timers, rand, dial, arg) were already in this root too.
	/dis/ip/ping.dis
	/dis/mount.dis
	/dis/ns.dis
	/dis/ps.dis
	/dis/pwd.dis
	/dis/read.dis
	/dis/sh.dis
	/dis/sh/std.dis
	/dis/unmount.dis
	/dis/lib/arg.dis
	/dis/lib/bufio.dis
	/dis/lib/daytime.dis
