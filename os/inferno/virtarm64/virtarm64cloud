# virtarm64 - QEMU -M virt, 64-bit AArch64 (cortex-a72)
#
# The 64-bit analogue of os/inferno/armv7: one privilege level (EL1),
# MMU off, the same QEMU virt machine (confirmed address-for-address
# identical to armv7's board via -machine dumpdtb regardless of
# -cpu cortex-a15 vs cortex-a72 -- see mem.h).  Genuinely 64-bit: a
# real 7c/7l LP64 compiler, not a 32-bit core the way armv7 is, and
# DISWORD is the tree default (8), the same word size riscv64/virt's
# own Dis modules already use -- so this board's root file list
# reuses /dis (not /dis32) and INIT=virtinit (riscv64's own init
# program) directly, unlike virt32/armv7 which each needed a fresh
# init module for their own 4-byte Dis word.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
	env
	ether		netif
	usb
	sd
	ip	ip ipv6 ipaux ptclbsum parseip eipfmt classmask equivip parseether iproute arp chandial netlog ethermedium plan9 nullmedium pktmedium nat
	ssl
	cap
	kprof

ip
	tcp
	udp
	ipifc
	icmp
	icmp6

lib
	interp
	keyring
	sec
	mp
	math
	kern
# Framebuffer display via QEMU ramfb (screenarm.c): the draw device,
# memdraw/memlayer/draw, the software cursor and the pointer, over a
# 640x480 ramfb the host scans out.  Needs -device ramfb on the QEMU
# command line.

link
	ethervirtiommio
	ethervirtio10	pci
	ethergve	pci
	usbxhcipci	usbxhci
	ethermedium
	loopbackmedium

port
	alarm
	alloc
	allocb
	bo
	chan
	dev
	dial
	dis
	discall
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
	sysfile
	taslock
	xalloc

	archvirtarm64

misc
	uartvirtarm64
	pci	pciecam
	sdvirtio10	pci sdscsi virtio10mem
	sdnvme	pci
# screennone, not screenarm.  screenarm drives QEMU's ramfb through
# fw_cfg at the hardcoded address 0x9020000, which is where the arm64
# "virt" machine puts it and is not fw_cfg anywhere else.  On a real
# Compute Engine t2a instance this kernel reached procinit and then
# stopped dead -- 92 lines of serial output, no banner, no shell -- and
# that probe is the first thing after it that touches a fixed MMIO
# address the machine need not have.  A cloud instance has no display
# to drive anyway.
	screennone
	randomvirtarm64

mod
	sys
	keyring
	crypt

init
	virtarm64init

code
	int main_pool_pcnt = 20;
	int heap_pool_pcnt = 20;
	int image_pool_pcnt = 20;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

