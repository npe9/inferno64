<../../../mkconfig

#Configurable parameters

CONF=stm32f407
CONFLIST=stm32f407

SYSTARG=$OSTARG
OBJTYPE=thumb
INSTALLDIR=$ROOT/Inferno/$OBJTYPE/bin

INITDIR=../init
PORTDIR=../port
ARCHDIR=../armv7m
RADIODIR=../radio

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

# The built-in root goes in the text segment, not the data segment: this
# board runs its text from flash (or, on mps2, models one that does), and
# os/inferno/armv7m/l.s copies the data segment into RAM at boot.  See
# os/inferno/port/mkroot and utils/data2s/data2s.c.
ROOTINTEXT=1

# And every module's decoded instruction array with it.  utils/dis2s
# lays out at build time what libinterp/load.c:/^parsemod would
# otherwise build in RAM every time a module is loaded, as a RODATA
# symbol the linker puts in the text segment.  XIPMODS tells
# os/inferno/port/mkdevc that this board defines xipmods itself, in the
# file dis2s generates, rather than taking the empty one.
#
# This is not an optimisation here, it is the difference between having
# a shell and not.  Measured: loading /dis/sh.dis asks malloc for 73536
# bytes for its Inst array alone, against 147456 bytes of RAM in the
# whole board, and with the array in RAM the main pool reached cursize
# 115008 and the Dis heap could not get 2560 bytes from xalloc.  See
# doc/xip.ms.
XIPMODS=1

<| $SHELLNAME ../port/mkdevlist $CONF

# The text runs out of the flash at the bottom of the address map, where
# the core reads its initial stack pointer and reset address from the
# first two words.  The data segment is linked into the SRAM, and
# os/inferno/armv7m/l.s copies it out of the flash before anything reads
# a variable.  -R0 stops the linker rounding the data address up and away
# from the one given here.
KTZERO=0x08000000
KDATA=0x20000000

# This core's floating point extension is single precision only, and
# utils/tl gives every F register a double.  Adding -F to LDFLAGS names
# every function that cannot run here.  Unlike os/inferno/nucleof303,
# this board has the RAM to hold a Limbo userland, so the list matters
# and is not a curiosity; see NOTE beside this file.

OBJ=\
	l.$O\
	auth.$O\
	clock.$O\
	main.$O\
	mmu.$O\
	fpu.$O\
	fpiarmv7m.$O\
	fpi.$O\
	fpimem.$O\
	trap.$O\
	tod.$O\
	mul64fract.$O\
	stubs.$O\
	$CONF.root.$O\
	$CONF.prog.$O\
	$CONF.xipmod.$O\
	$DEVS\
	$LINKS\
	$PORT\
	$MISC\
	$OTHERS\

LIBNAMES=${LIBS:%=lib%.a}
LIBDIRS=$LIBS

HFILES=\
	mem.h\
	dat.h\
	io.h\
	$ARCHDIR/armv7m.h\

CFLAGS=-wFV -I. -I$ARCHDIR -I../port -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp
KERNDATE=`{$NDATE}

default:V: i$CONF

install:V: i$CONF i$CONF.hex
	cp i$CONF i$CONF.date i$CONF.hex $INSTALLDIR

i$CONF: $OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD $LDFLAGS -o $target -H4 -T$KTZERO -D$KDATA -R0 -l $OBJ $CONF.$O $LIBFILES
	# THE STAMP THIS IMAGE PRINTS, written down where it can be read.
	#
	# KERNDATE is a fresh number every link, it is compiled in as an
	# integer, and the only place it appears afterwards is the boot
	# line the kernel prints.  Anything wanting to ask "is the board
	# running THIS image" had to scrape it out of the build output --
	# which works only on a build that relinked, and the build that
	# matters most is the one after a failed conversion, where the
	# kernel is already current and only the hex is remade.  Then the
	# stamp came out empty and the check that catches a flash writing
	# an old image was skipped.  So: beside the image, from the same
	# recipe that compiled it in.
	echo $KERNDATE > $target.date
	cp $target $target.date $INSTALLDIR

# THE HEX IS ITS OWN TARGET, and it has to be, for two reasons that both
# cost a day.
#
# The conversion used to be the second half of the link recipe above,
# with a cp after it.  bin2ihex refuses an image that would reach past
# the ceiling -- that is the whole point of the ceiling -- and when it
# refused, the cp that followed it succeeded, so the RECIPE succeeded and
# mk reported a build.  KERNDATE went by in the output as usual.  What
# was left on disk was the previous hex, and five flashes in a row wrote
# it: a bootloader answered, mikroe-uhb printed its summary and exited
# zero, and the board came up running the image it already had.  A
# recipe's status is its LAST command's.
#
# And nothing depended on the hex, so a hex that was missing or older
# than the kernel beside it was never noticed: mk had no reason to make
# it, because the thing mk was asked for -- the kernel -- was up to
# date.  Now the dependency is written down, so asking for the hex
# rebuilds it whenever the kernel it comes from is newer.
#
# The USB HID bootloader already in this part's flash occupies the last
# 128K sector, from 0x080e0000, and reports BootStart 0xe0000 when
# asked.  An image past that cannot be written -- mikroe-uhb refuses
# rather than overwriting the only way in.
#
# 901120 and not 917504: the last 16K below the bootloader is the
# calibration store, CALBASE in mem.h, and an image that grew into it
# would overwrite what a board had measured about itself.  So the
# ceiling is the store's base and not the bootloader's.  Keep the two
# numbers in step; mem.h says the same.
#
# The rm first, and the && after, so that a refusal leaves NO hex rather
# than the last one that converted.  A stale hex beside a fresh kernel
# is the shape of the whole failure above, and it is worse than a
# missing file: a missing file stops a flashing tool at its first
# argument, and an old one gets written to the board.
i$CONF.hex: i$CONF $ROOT/tools/bin2ihex
	rm -f $target $INSTALLDIR/$target
	$ROOT/tools/bin2ihex i$CONF $KTZERO $target 901120 && cp $target $INSTALLDIR

$ROOT/tools/bin2ihex:
	cd $ROOT/tools; mk bin2ihex

# Every module the root carries.
#
# A module's decoded array costs flash for ever and saves RAM only
# while the module is loaded, so which way that trades depends on which
# is scarce.  On this part flash is 917504 usable -- the bootloader owns
# the sector above -- and RAM is 176128, and it is main that runs out:
# a pipeline as small as "ls /dis | wc -l" builds two Inst arrays in it
# and failed at cursize 80768 of 88050 with the commands left out of
# here.  In flash they cost nothing at run time.
#
# sh is the extreme case and the reason any of this exists: 73536 bytes
# of Inst against 176128 of RAM, so without XIP there is no shell.
# lil.dis is lil(1), an interpreted subset of Limbo, here to be typed at
# instead of the shell: it holds a file open in a variable rather than
# forking a process and an open for every line.  It is beside sh and not
# instead of it, so that a fault in it still leaves something to look at
# the board with.
# ed IS NOT HERE, and the ceiling is why it was looked at.  An image past
# 0xe0000 cannot be written, since the HID bootloader occupies the last
# 128K sector from there, and adding radiocal and radiocfg put this
# 13184 bytes over it.
#
# ed is the thing that should go: this board's root is devroot served
# read-only out of flash and there is nowhere on it to write, so an
# editor that cannot save is 11979 bytes for a program that can only
# ever print an error.  The shell already gets "permission denied" for a
# redirection into /tmp; see man/1/lil.
#
# sed stays, at 12633 the largest thing in the list, because a stream
# editor still works with nowhere to write -- it filters what is piped
# through it, and the stat files are what get filtered.
#
# attrdb is not here either, and for a different reason: radiocfg(1)
# used it and ran out of heap on the board even from a fresh boot, so it
# parses the attrdb(6) subset itself.  See its own comment.
# The modules this image executes in place, which depend on which init
# it carries: see xipdis-armv7minit for what the list means and
# xipdis-armv7max25 for why it is not one list.
#
# A pipe include and not "<xipdis-$INIT", because this mk does not
# expand a variable in an include filename -- it looks for a file
# called "xipdis-$INIT", warns that it is missing, and carries on with
# XIPDIS empty.  A pipe include expands it and, when the file is not
# there, stops with "bad include program status".  There is deliberately
# no default: a new init must say what it runs.
<| cat xipdis-$INIT



# dis32, not $DISROOT: the root section of the conf beside this file
# names /dis32 explicitly, because a Dis word is four bytes on this
# board and a module compiled for eight will not load.  These have to be
# the same files the root carries.
XIPDISFILES=${XIPDIS:%=$ROOT/dis32/%}

# dis2s is a host tool, found on the path like data2s and ndate are.
$CONF.prog.s $CONF.xipmod.c: $INITDIR/$INIT.dis $XIPDISFILES
	$DIS2S -o $CONF.prog -c $CONF.xipmod -r $ROOT/dis32 -p /dis \
		/osinit.dis=$INITDIR/$INIT.dis $XIPDIS

<../port/portmkfile

# After the include: portmkfile sets CLEANEXTRA empty.
CLEANEXTRA=$CONF.prog.s $CONF.xipmod.c i$CONF.hex i$CONF.date

../init/$INIT.dis:	../init/$INIT.b
	cd ../init; mk 'DISWORD='$DISWORD $INIT.dis

clock.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
main.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

l.$O:	$ARCHDIR/l.s mem.h $ARCHDIR/armv7m.h
	$AS $ASFLAGS -I. $ARCHDIR/l.s

%.$O:	$ARCHDIR/%.c
	$CC $CFLAGS $ARCHDIR/$stem.c

tod.$O:	../port/tod.c
	$CC $CFLAGS ../port/tod.c

mul64fract.$O:	../port/mul64fract.c
	$CC $CFLAGS ../port/mul64fract.c

# software floating point, for the Cortex-M4 double precision emulation
fpi.$O:	../port/fpi.c $ARCHDIR/fpi.h
	$CC $CFLAGS ../port/fpi.c

fpimem.$O:	../port/fpimem.c $ARCHDIR/fpi.h
	$CC $CFLAGS ../port/fpimem.c

fpiarmv7m.$O:	$ARCHDIR/fpiarmv7m.c $ARCHDIR/fpi.h

# radio.h carries what #W and a chip driver share, and cc1120.h what
# the chip driver and this board share, so a change to either has to
# rebuild all of them.  Said explicitly because the catch-all %.$O rule
# in $PORTDIR/portmkfile lists the headers every object has and not the
# ones a particular driver includes -- and a struct that grows a field
# while one of its users keeps the old layout does not fail to build,
# it reads a different member at run time.
devradio.$O devax25.$O devkiss.$O cc1120.$O spistm32f4.$O: $RADIODIR/radio.h
cc1120.$O spistm32f4.$O:	$RADIODIR/cc1120.h

devuart.$O:	../port/devuart.c
	$CC $CFLAGS ../port/devuart.c

# -H4 output is a raw vector image, so it is what a probe or a ROM
# bootloader wants at 0x08000000 with no conversion, and i$CONF.hex is
# the same bytes as Intel hex for loaders that want that instead.
#
# Through the USB HID bootloader a MikroElektronika board already has
# in its flash, which needs no probe and no soldering (mikroe-uhb is
# the cross-platform client; see NOTE):
#	mikroe-uhb -v istm32f407.hex
# With a probe:
#	openocd -f interface/stlink.cfg -f target/stm32f4x.cfg \
#		-c "program istm32f407 0x08000000 verify reset exit"
# On a bare F407, with none, holding BOOT0 high over a reset:
#	stm32flash -w istm32f407 -v -g 0x08000000 /dev/cu.SERIALPORT
# A clicker 2 brings out neither BOOT0 nor the bootloader's USART1
# pins; see NOTE.
#
# Under qemu, which models an STM32F405 -- the same die family.  The
# -serial arguments follow from CONSUSART in mem.h: serial_hd(0) is
# USART1, serial_hd(1) USART2, serial_hd(2) USART3.
#	qemu-system-arm -M netduinoplus2 -nographic \
#		-serial null -serial mon:stdio -kernel istm32f407
