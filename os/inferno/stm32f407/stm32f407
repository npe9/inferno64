# stm32f407 - an STM32F407: a Cortex-M4 with a megabyte of flash and
# 192K of RAM in two pieces.
#
# The core is an ARMv7-M like the ones os/inferno/mps2 and
# os/inferno/teensy41 run on, so os/inferno/armv7m is shared.  What is
# only here is the board: its clock tree and a USART.
#
# It is beside os/inferno/nucleof303 and not a variant of it.  That
# board is an F303 with 80K of RAM and its NOTE records that it cannot
# run Limbo -- the kernel's own pool floor is about 97000 bytes before
# anything is loaded.  This has 128K of SRAM and 64K of core coupled
# memory, which clears it, so this configuration carries a root file
# system and a Limbo userland and the other does not.  The two share
# the core and nothing of the part: RCC, FLASH and GPIO are at
# different addresses and the USART is a different register map.
#
# qemu models an STM32F405 as netduinoplus2, which is the same die
# family, so this is developable without the board.  What it does not
# model is GPIO -- and the SX1276 and CC1120 both need a chip select
# and an interrupt pin, so a radio here wants that written first, as
# tools/qemu-patches/0027 did for the MPS2.

dev
	root
	cons
	prog
	dup
	pipe
	mnt
	srv
	uart
# A packet radio at #W/radio0.  Real only when qemu is given
# "-machine radio=on", which fits a CC1120 to SPI2 with the pinout of a
# ccRF click in a clicker 2's mikroBUS 2; without it cc1120init() finds
# no part and the device serves an empty directory.  See
# tools/qemu-patches/0042.
	radio
# AX.25 over that packet device, at #a served on /net/ax25.  A CC1120
# does 2-FSK and not the 1200-baud AFSK on an FM carrier an APRS
# handheld wants, and its bands stop at 164MHz, so this is a
# radio-to-radio link on 868 and not a way onto the amateur network.
# See doc/ax25-plan.ms and os/inferno/radio/devax25.c.
	ax25
# And KISS, at #k, so the whole stack above can be run over a pipe with
# no radio at all.  See os/inferno/radio/devkiss.c.
	kiss
# I2C at #J: a directory per controller, and in it a data and a ctl
# file for every address that answered a probe.  The controllers are
# registered by i2cstm32f4 in the link section below; nothing is
# clocked and no pin is driven until something opens #J.
	i2c
# #P: the board's own files, from addarchfile().  adcstm32f4 puts
# /dev/adc there.  See os/inferno/armv7m/devarch.c.
	arch
	env

# the order matters: a library with an undefined symbol at the end
# makes the loader complain
lib
	interp
	keyring
	sec
	mp
	math
	kern

# the portable kernel this board takes, and its own code beside it.
# archstm32f407 and the rest are objects and nothing more; naming them
# under misc would have mkdevc build a PCArch table for them, which is
# the PC's abstraction and not this board's.
port
	alarm
	alloc
	allocb
# the board has its own auth.c, named in the mkfile
	chan
	dev
	dis
	discall
# edf wants a microsecond clock this board does not export
	dial
	exception
	exportfs
	inferno
	latin1
	nocache
	nodynld
	parse
	pgrp
	print
	proc
	qio
	qlock
# randomarmv7m is the entropy these boards have; the portable random.c
# wants a libsec newer than the one this tree shares
	sysfile
	taslock
	xalloc

	archstm32f407
	randomarmv7m
	screenarmv7m
	cc1120

# uartstm32f4 is this board's PhysUart -- mkdevc turns a misc name
# beginning uart into <rest>physuart, so uartstm32f4 gives
# stm32f4physuart.
misc
	uartstm32f4

# spistm32f4 brings up SPI2 and the GPIO pins a mikroBUS socket uses,
# then asks cc1120.c whether a part is there.  It is in link rather
# than port because links() runs after poolinit() and trapinit(), which
# is what a driver that allocates and takes an interrupt needs.
link
	spistm32f4
# i2cstm32f4 registers the two controllers a clicker 2 brings out on
# its mikroBUS sockets.  Here rather than in port for the same reason
# as spistm32f4: it is a board fact, not a portable one.
	i2cstm32f4
# adcstm32f4 converts the two mikroBUS AN pins and the part's own
# temperature, reference and battery channels into #P/adc.
	adcstm32f4
# ledstm32f4 puts the board's two lamps at #P/led.  Here so that a
# program can signal without a radio: the only other way to move a lamp
# is the radio's own ctl file, which a board that cannot find its radio
# has not got -- and that is exactly the board that needs to say so.
	ledstm32f4
# uidstm32f4 puts the part's 96-bit factory serial number at #P/uid.
# A board needs a name before a calibration can belong to it: with two
# clicker 2s here, the crystal error baked into spistm32f4.c is right
# for one of them and 64ppm wrong for the other, and no one image can
# be right for both.  The identity has to come from silicon, because
# anything the board was told is circular.  See doc/radio-plan.ms
# item 8.
	uidstm32f4

mod
	sys

init
	armv7minit

# Percentages of the memory left after the kernel, so they are ceilings
# and not reservations -- except that poolsize() asks the image pool for
# its whole arena contiguously at boot and panics if it cannot get it.
#
# 167936 bytes are left after the kernel here, and at a shell prompt
# main holds about 75K and the Dis heap the rest, so the two ceilings
# are near enough the whole of it and the split decides which pool
# fails first rather than how much there is.  These are measurements
# and not taste, and the measurement changed when the radio did.
#
# It is 50/49/1, and was 53/46/1 for a while in between.  The reason
# for the detour is worth keeping, because it was a real measurement
# of a real failure and the failure has since been fixed somewhere
# else.
#
# With a CC1120 answering -- which it began to do only when
# cc1120init() learned to wait for CHIP_RDYn -- 50/49 could not fork:
#
#	; echo rssioffset -90 >/dev/radio0/ctl
#	arena too large: main size 4096 cursize 74816 arenasize 80128
#		maxsize 81900, alloc = 4288
#	no procs for kproc
#
# The 4288 was a new process's kernel stack, wanted because the shell
# forks for a ">" redirection, and every ctl file on this board is
# written that way.  53/46 made that one redirection work, at the cost
# of ls(1) in the case where there is no radio fitted, and of a worse
# out-of-memory: at 53/46 "ls /dis | wc -l" kills the shell with "out
# of memory: main", where at 50/49 it is reported to the shell, which
# prints it and carries on.
#
# What it did not fix was the second redirection, which faulted with
# SP below the bottom of CCM -- a kernel stack allocated near the end
# of the pool and run off.  The fix is KSTACKPREALLOC in mem.h: every
# kernel stack is taken in one piece from xalloc before the pools
# exist, so a fork cannot fail for want of one however fragmented the
# pool is.  Measured under qemu with the radio fitted, five
# redirections and two reads in one boot where there used to be one
# redirection.  With that in place the split no longer decides whether
# the board can be told anything, so it is back to the one with the
# better failure.
#
# Fragmentation is why the middle of the range is the worst: the
# largest single thing the heap is asked for is the buffer bufio(2)
# makes for each open file, and whether one exists depends on where
# the previous command left its holes.
#
# image is 1 and not 0.  Nothing on this board has ever allocated from
# it -- no draw device, no segments -- and 1637 bytes is real memory
# held for nothing.  But poolsize(imagmem, 0, 1) leaves a pool whose
# maxsize is 0, and the first allocation against it would take the
# arena-extend path in poolalloc() with maxsize-arenasize going
# negative.  It fails safely there today, because ns is a signed
# intptr; 1637 bytes is not worth resting on that.  See doc/xip.ms.
code
	int main_pool_pcnt = 50;
	int heap_pool_pcnt = 49;
	int image_pool_pcnt = 1;
	int cflag = 0;
	int consoleprint = 1;
	int panicreset = 0;

root
