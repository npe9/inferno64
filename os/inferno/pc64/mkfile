<../../../mkconfig

#Configurable parameters

CONF=pc64			#default configuration
CONFLIST=pc64 pc64fp
CLEANCONFLIST=pc64 pc64fp

SYSTARG=Inferno # $OSTARG
OBJTYPE=amd64 # 386
FLAVOR=Inferno
INSTALLDIR=$ROOT/$FLAVOR/$OBJTYPE/	#path of directory where kernel is installed
#INSTALLDIR=/$OBJTYPE

# must match mem.h
REBOOTADDR=0x2000
APBOOTSTRAP=0x3000
KTZERO=0x200000

IPDIR=../ip
INITDIR=../init
PORTDIR=../port

#end configurable parameters

<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE	#set vars based on target system

KERNELSHELL=$SHELLNAME
<| $KERNELSHELL ../port/mkdevlist $CONF	#sets $IP, $DEVS, $ETHERS, $VGAS, $PORT, $MISC, $LIBS, $OTHERS

OBJ=\
	l.$O\
	regtorture.$O\
	forth.$O\
	fpu.$O\
	portclock.$O\
	tod.$O\
	main.$O\
	memmap.$O\
	memory.$O\
	mmu.$O\
	trap.$O\
	bootargs.$O\
	stubs.$O\
	$CONF.root.$O\
	$IP\
	$DEVS\
	$ETHERS\
	$LINKS\
	$PORT\
	$MISC\
	$OTHERS\

LIBNAMES=${LIBS:%=lib%.a}

HFILES=\
	mem.h\
	dat.h\
	fns.h\
	io.h\

# Written out rather than added to what mkfile-Inferno-amd64 sets,
# because the order matters: ../ip is the kernel's own ip stack and has
# to be looked in before $ROOT/include, which holds the hosted libip's
# ip.h and knows nothing of Fs.  This is the shape os/inferno/virt uses,
# down to leaving out $ROOT/Inferno/include -- a directory that does not
# exist, but naming it shifted where the two real ones sat on the search
# list enough that allocb.c and libinterp/string.c stopped seeing the
# same declaration of msize, and 6l refused to link them.
CFLAGS=-wFVT -DDISCTXREG -I. -I../port -I../ip -I../pc -I$ROOT/Inferno/$OBJTYPE/include -I$ROOT/include -I$ROOT/libinterp/w$DISWORD -I$ROOT/libinterp
KERNDATE=`{$NDATE}

default:V: i$CONF i$CONF.elf i$CONF.acid

ETHERS=`{cd ../pc; echo devether.c ether*.c | sed 's/\.c/.'$O'/g'}
AUDIO=`{cd ../pc; echo devaudio.c audio*.c | sed 's/\.c/.'$O'/g'}
VGA=`{cd ../pc; echo devvga.c screen.c vga*.c | sed 's/\.c/.'$O'/g'}
SDEV=`{cd ../pc; echo devsd.c sd*.c | sed 's/\.c/.'$O'/g'}

i$CONF: $OBJ $CONF.c $CONF.root.h $LIBNAMES
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c
	$LD -o $target -T$KTZERO -R4096 -l $OBJ $CONF.$O $LIBFILES
	$KSIZE $target

# The ELF is the same kernel in the container a PVH loader reads: a Xen
# PVH domain builder, QEMU's -kernel, Firecracker and Cloud Hypervisor
# all take the entry from its XEN_ELFNOTE_PHYS32_ENTRY note.  The a.out
# stays what a multiboot loader takes, and what the EFI loader loads.
i$CONF.elf:	i$CONF
	$ROOT/tools/aout2elf i$CONF $target

install:V: i$CONF i$CONF.elf # i$CONF.acid
	cp i$CONF $INSTALLDIR/i$CONF
	cp i$CONF.elf $INSTALLDIR/i$CONF.elf

# copies generated by the rule below
PCHEADERS=usbehci.h mp.h ahci.h yukdump.h vga.h audio.h

REPCH=`{echo $PCHEADERS | sed 's/\.h//g; s/ /|/g'}
^($REPCH)\.h:R:	../pc/\1.h
	cp $prereq .

fpu.$O: fpu.c
	$CC $CFLAGS fpu.c
inferno.main.$O: inferno.main.c
	$CC $CFLAGS inferno.main.c
main.$O: main.c
	$CC $CFLAGS main.c
memory.$O: memory.c
	$CC $CFLAGS memory.c
mmu.$O: mmu.c
	$CC $CFLAGS mmu.c
screen.$O: screen.c
	$CC $CFLAGS screen.c
squidboy.$O: squidboy.c
	$CC $CFLAGS squidboy.c
trap.$O: trap.c
	$CC $CFLAGS trap.c
vgasoft.$O: vgasoft.c
	$CC $CFLAGS vgasoft.c

%.$O: ../pc/%.c
	$CC $CFLAGS -I. -. ../pc/$stem.c

bootargs.$O: ../pc/bootargs.c
	$CC $CFLAGS -I. -. ../pc/bootargs.c

<../port/portmkfile

clock.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
devether.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
fault386.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h
main.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h rebootcode.i
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

forth.$O:	forth.h bindings.s
forth.h:	forth.head.h mkdict.awk primitives-nasm.s words-nasm.s
	cp forth.head.h $target
	cat primitives-nasm.s words-nasm.s | $AWK -f ./mkdict.awk >> $target
devforth.$O: forth.h

CLEANEXTRA=words.s primitives.s forth.h

devether.$O $ETHERS:	etherif.h ../port/netif.h
$IP devip.$O:		../ip/ip.h
$VGA mouse.$O:		screen.h ../../../include/memdraw.h

mp.$O:				mp.h apbootstrap.i
apic.$O squidboy.$O:		mp.h
archmp.$O archacpi.$O:		mp.h

$SDEV:				../port/sd.h
sdiahci.$O:			ahci.h

ether8169.$O:			../port/ethermii.h

$O.rebootcode:		rebootcode.$O
	$LD -l -R1 -s -o $target -T$REBOOTADDR $prereq
rebootcode.out:		$O.rebootcode
	dd if=$prereq of=$target bs=1 skip=40

$O.apbootstrap:		apbootstrap.$O
	$LD -l -R1 -s -o $target -T$APBOOTSTRAP $prereq
apbootstrap.out:	$O.apbootstrap
	dd if=$prereq of=$target bs=1 skip=40

# to be moved to port/interp 
bench.h:D: ../../module/bench.m
	rm -f $target && limbo -a -I../../module ../../module/bench.m > $target
benchmod.h:D:  ../../module/bench.m
	rm -f $target && limbo -t Bench -I../../module ../../module/bench.m > $target
devbench.$O: bench.h benchmod.h
$VGA screen.$O:	screen.h vga.h

# The hypervisor bench, doc/genesize-plan.ms phase 0: the reference
# q35 host with VT-d, igb (SR-IOV), NVMe and virtio behind root ports.
# "mk CONF=pc64dev vmhost-run" boots this configuration on it.
vmhost:V: i$CONF
	$ROOT/scripts/vmhost.sh build $ROOT/os/inferno/pc64/i$CONF

vmhost-run:V: vmhost
	$ROOT/scripts/vmhost.sh run

vmhost-debug:V: vmhost
	$ROOT/scripts/vmhost.sh debug

# the hypervisor's portable interface
vmx.$O svm.$O devvm.$O vmplat.$O vmpci.$O vmvirtio.$O: ../port/vm.h
vmx.$O svm.$O vmplat.$O vmpci.$O: ../pc/vm86.h
vmplat.$O vmdev.$O: ../pc/vmdev.h
vmplat.$O vmdev.$O vuart.$O: ../port/vuart.h
vtd.$O deviommu.$O: ../port/iommu.h ../pc/dmar.h
vmplat.$O vmpci.$O: ../port/vmpci.h ../port/iommu.h
vmpci.$O vmvirtio.$O vmplat.$O: ../port/vmvirtio.h
