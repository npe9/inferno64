# devvga wants a table of display devices and one of cursors, and
# mkdevc builds both from the misc names that begin vga.  The screen
# itself is the boot loader's framebuffer -- bootscreeninit in screen.c
# -- which wants nothing done to it, so the one display device is
# vgasoft's, which has no hooks at all, and the cursor is the one drawn
# into the framebuffer.  The drivers in ../pc are against the 386
# board's screen.h and do not compile against this one.
	vgasoft	+cur

