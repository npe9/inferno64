# PORTDIR is the portable kernel: .. for a machine beside it, ../../port
# for a board under an architecture.  A machine mkfile sets it before
# including this file.
PORTHFILES=\
	$PORTDIR/error.h\
	$PORTDIR/lib.h\
	$PORTDIR/portdat.h\
	$PORTDIR/portfns.h\

LIBFILES=${LIBS:%=$ROOT/Inferno/$OBJTYPE/lib/lib%.a}

CLEANEXTRA=

%.$O:	%.s
	$AS $ASFLAGS $stem.s

%.$O:	%.c
	$CC $CFLAGS $stem.c

%.$O:		$PORTDIR/%.c
		$CC $CFLAGS -I. $PORTDIR/$stem.c

%.$O:		$IPDIR/%.c
		$CC $CFLAGS -I. $IPDIR/$stem.c

&.$O:		$HFILES $PORTHFILES

$INSTALLDIR/%: %
	cp $stem $INSTALLDIR/$stem

installall:V:	install-$SHELLTYPE
all:V:		default-$SHELLTYPE

acid:V: i$CONF.acid
i$CONF.acid:V: $SHELLTYPE-i$CONF.acid

LIBHDIRS= -I$ROOT/libmp/port -I$ROOT/libsec/port

#
# The acid rules below compile every source that went into the kernel,
# and that is not only the kernel's own: srclist names libinterp's,
# libsec's and libmp's too, and they are all compiled with the board's
# CFLAGS, which begin with the board directory.  Two headers collide
# between $ROOT/include and the kernel directories, ip.h and mp.h, so
# libinterp/keyring.c's `#include <mp.h>' found os/inferno/pc64/mp.h,
# the MP/APIC table header, instead of the multiple-precision one:
# "mp.h:182 keyring.c:5 syntax error, last name: Lock".  Putting
# $ROOT/include first fixes those and breaks the kernel's own sources
# instead -- the generated $CONF.c says `#include "ip.h"' and has no
# ip.h beside it, so it needs ../ip to win.  Each file therefore gets
# the include path of the tree it came from: kernel sources as before,
# everything else with $ROOT/include ahead of the board.
#
# None of this was reachable until utils/libmach was repaired: srclist
# could not read these kernels at all, so the loop had no files and the
# acid file was one line long.
#


rc-i$CONF.acid nt-i$CONF.acid:V: i$CONF
	{
		x=i$CONF; test -e i$CONF.p9 && x=i$CONF.p9
		for (i in `{srclist -ec -r $ROOT/ $x}) {
			echo '//FILE: ' $i
			if(~ $i $ROOT/os/*)
				$CC -I. $CFLAGS $LIBHDIRS '-DKERNDATE='$KERNDATE -a $i
			if not
				$CC -I$ROOT/include -I. $CFLAGS $LIBHDIRS '-DKERNDATE='$KERNDATE -a $i
		}
		echo 'include ("'$ROOT'/lib/acid/9ferno");'
	} >i$CONF.acid

sh-i$CONF.acid:V: i$CONF
	x=i$CONF; test -e i$CONF.p9 && x=i$CONF.p9
	for i in `srclist -ec -r $ROOT/ $x`
	do
		echo '//FILE: ' $i
		case "$i" in
		$ROOT/os/*)	ACIDHDIRS= ;;
		*)		ACIDHDIRS=-I$ROOT/include ;;
		esac
		$CC $ACIDHDIRS -I. $CFLAGS $LIBHDIRS '-DKERNDATE='$KERNDATE -a $i
	done >i$CONF.acid
	echo 'include ("inferno");' >> i$CONF.acid

lib%.a:V:	$SHELLTYPE-lib%.a

rc-lib%.a nt-lib%.a:VQ:
		echo '@{builtin cd' $ROOT/lib$stem ';' mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE install'}'
		@{builtin cd $ROOT/lib$stem; mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE install}

sh-lib%.a:VQ:
		echo "(cd $ROOT/lib$stem ; mk SHELLTYPE=$SHELLTYPE SYSTARG=$SYSTARG OBJTYPE=$OBJTYPE install)"
		(cd $ROOT/lib$stem; mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE 'DISWORD='$DISWORD install)

%-rc %-nt:V:
		for(i in $CONFLIST)
			mk 'CONF='$i $stem

%-sh:V:
		for i in $CONFLIST
		do
			mk 'CONF='$i $stem
		done

clean:V:	cleanconf-$SHELLTYPE
		rm -f *.[$OS] *.root.[sh] errstr.h *.out $CLEANEXTRA

cleanconf-sh:V:
		for i in $CONFLIST $CLEANCONFLIST
		do
			rm -f $i.c i$i i$i.* $i.ver
		done

cleanconf-rc cleanconf-nt:V:
		for(i in $CONFLIST $CLEANCONFLIST)
			rm -f $i.c i$i i$i.* $i.ver

nuke-sh:QV:
		for i in $LIBDIRS
		do
			echo "(cd $ROOT/lib$i ; mk SHELLTYPE=$SHELLTYPE SYSTARG=$SYSTARG OBJTYPE=$OBJTYPE nuke)"
			(cd $ROOT/lib$i; mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE nuke)
		done

nuke-rc nuke-nt:QV:
		for (i in $LIBDIRS)
		{
			echo '@{cd $ROOT/lib$i ; mk SHELLTYPE=$SHELLTYPE SYSTARG=$SYSTARG OBJTYPE=$OBJTYPE nuke}'
			@{cd $ROOT/lib$i; mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE nuke}
		}

nuke:V:		clean nuke-$SHELLTYPE

$CONF.c:	$PORTDIR/mkdevc $CONF
		$SHELLNAME $PORTDIR/mkdevc $CONF > $CONF.c

errstr.h:	$PORTDIR/error.h
		sed 's/extern //;s,;.*/\* , = ",;s, \*/,";,' < $PORTDIR/error.h > errstr.h

$INITDIR/%.dis:	$INITDIR/%.b
		cd ../init; mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE 'DISWORD='$DISWORD $stem.dis

$ROOT/libinterp/w$DISWORD/runt.h:
		cd $ROOT/libinterp
		mk 'SHELLTYPE='$SHELLTYPE 'SYSTARG='$SYSTARG 'OBJTYPE='$OBJTYPE 'DISWORD='$DISWORD w$DISWORD/runt.h

# for culling dependencies; one per Dis word size, see libinterp/mkfile
RUNT=$ROOT/libinterp/w$DISWORD/runt.h
INTERP=$ROOT/include/interp.h

alloc.$O:	$INTERP
devdbg.$O:	$INTERP

devmnt.$O:	$ROOT/include/fcall.h
devns16552.$O:	$PORTDIR/netif.h
devns16552.$O:	ns16552.h
devpipe.$O:	$INTERP
devprof.$O:	$RUNT $INTERP
devprog.$O:	$RUNT $INTERP
devroot.$O:	errstr.h
devsign.$O:	$RUNT $INTERP
devsrv.$O:	$RUNT	$INTERP
dis.$O:	$INTERP
discall.$O:	$INTERP
exception.$O:	$RUNT	$INTERP
inferno.$O:	$RUNT	$INTERP
latin1.$O:	$PORTDIR/latin1.h
main.$O:	$PORTDIR/error.h
netif.$O:	$PORTDIR/netif.h
proc.$O:	errstr.h	$INTERP
screen.$O:	screen.h
trap.$O:	$ROOT/Inferno/$OBJTYPE/include/ureg.h

devroot.$O:	$CONF.root.h
$CONF.$O:	$CONF.root.h
$CONF.root.s $CONF.root.h: $CONF $INITDIR/$INIT.dis $PORTDIR/mkroot $ROOTFILES
	$SHELLNAME $PORTDIR/mkroot $CONF

%.i:D:	%.out
	# od rather than xd: xd is a Plan 9 program and is not among the
	# host tools this tree builds, so the rule only ever worked when
	# its output was already checked in.  -A n drops the addresses and
	# -v stops od folding repeated lines into a *.
	{ echo 'uchar '$stem'[]={'
	  od -A n -v -t x1 $stem.out |
		awk '{for(i = 1; i <= NF; i++) printf "0x%s,", $i; print ""}'
	  echo '};'; } > $target

%.$O:	$ROOT/Inferno/$OBJTYPE/include/u.h $PORTDIR/lib.h mem.h dat.h fns.h io.h $PORTDIR/error.h $PORTDIR/portdat.h $PORTDIR/portfns.h
