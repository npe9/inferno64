$AWK '
BEGIN{
		if (ARGC < 2)
			exit "usage";

		conf = ARGV[1];
		infernoroot = ENVIRON["ROOT"];
		init = ENVIRON["INIT"];
		data2s = ENVIRON["DATA2S"];
		# ROOTINTEXT asks for the files to go in the text segment
		# rather than the data segment (utils/data2s/data2s.c -t), so
		# that a kernel whose text is in flash keeps them there
		# instead of copying them into RAM at boot.  A board opts in
		# from its mkfile; see os/inferno/mps2/mkfile.
		rootintext = ENVIRON["ROOTINTEXT"] == "" ? "" : " -t";
		nroot = 0;
}
/^$/{
		next;
}
/^#/{
		next;
}
collect && /^[^	\t]/{
		collect = 0;
}
collect && section ~ "root"{
		dst[nroot] = $1;
		if (NF > 1)
			src[nroot] = infernoroot $2;
		else if (dst[nroot] == "/osinit.dis")
			src[nroot] = infernoroot "/os/inferno/init/" init ".dis";
		else
			src[nroot] = infernoroot $1;
		for(i=0; i<nroot; i++)
			if(dst[i] == dst[nroot])
				break;
		if(i == nroot)
			nroot++;
}
$0 ~ /^[^ \t]/{
		if($0 ~ "(code|dev|ether|ip|lib|link|mod|misc|port|root|vga)"){
			section = $0;
			collect = 1;
		}
		next;
}
END{
		# EXTRAROOT: files this IMAGE carries that the root section
		# does not name, as dst/src pairs with src relative to the
		# tree root, exactly as a second field in a root line is.
		#
		# WHY.  A conf has one root section and a board can build
		# several images from it -- os/inferno/stm32f407 builds a
		# shell, an AX.25 station and a satellite, selected by
		# INIT= -- and every image was carrying every file.  The
		# shell image carried the satellite modules and could not
		# run them; the satellite carried the shell and could not
		# run it.  On a part whose image ceiling is a flash
		# address that is not a tidiness question: that board had
		# its calibration store halved twice to buy back the room,
		# and the second halving was the sign that the knob was
		# the wrong one.
		#
		# An XIP module cannot do without its file, which is why
		# a per-init XIP list did not already solve this:
		# libinterp/load.c calls xipfind from parsemod(path, code,
		# length, ...), so the .dis is still read and only the
		# decoded array comes out of flash.
		#
		# NOTE FOR ANYONE EDITING THESE COMMENTS: this awk program
		# is inside a single-quoted shell string, so an apostrophe
		# here ends it and the rest of the file becomes shell.
		# That is one error message about "extra: command not
		# found" away from being obvious and was not.
		#
		# Empty for every board that does not set it, which is all
		# of them but one.
		extra = ENVIRON["EXTRAROOT"];
		if (extra != "") {
			nx = split(extra, xf, /[ \t\n]+/);
			if (nx % 2 != 0) {
				print "mkroot: EXTRAROOT wants dst/src pairs" >"/dev/stderr";
				exit 1;
			}
			for (k = 1; k <= nx; k += 2) {
				dst[nroot] = xf[k];
				src[nroot] = infernoroot xf[k+1];
				for(i=0; i<nroot; i++)
					if(dst[i] == dst[nroot])
						break;
				if(i == nroot)
					nroot++;
			}
		}

		rootdata = conf ".root.s";
		system("rm -f " rootdata);
		print("/* Generated by /os/port/mkroot */") >rootdata;
		close(rootdata);
		isdir[0] = 1;
		dotdot[0] = 0;
		qid = 1;
		for (i = 0; i < nroot; i++) {
			ncomp = split(dst[i], comp, "/");
			if (comp[1] != "" || ncomp < 2)
				continue;
			q = 0;
			for (j = 2; j <= ncomp; j++) {
				key = q "/" comp[j];
				if (walk[key] == 0) {
					walk[key] = qid;
					dotdot[qid] = q;
					q = qid++;
					name[q] = comp[j];
					if (j < ncomp)
						isdir[q] = 1;
				}
				else
					q = walk[key];
			}
			if (system("test -d " src[i]) == 0)
				isdir[q] = 1;
			else {
				if (system(data2s rootintext " root" q " <" src[i] " >>" rootdata) != 0)
					exit 1;
				print("extern unsigned char root" q "code[];");
				print("extern int root" q "len;");
			}
		}

		x = 1;
		sort[0] = 0;
		unsort[0] = 0;
		for (q = 0; q < qid; q++) {
			if (isdir[q]) {
				nchild[q] = 0;
				for (q2 = 1; q2 < qid; q2++) {
					if (dotdot[q2] == q) {
						if (nchild[q]++ == 0)
							child0[q] = x;
						sort[q2] = x++;
						unsort[sort[q2]] = q2;
					}
				}
			}
		}

		print("int rootmaxq = " qid ";");

		print("Dirtab roottab[" qid "] = {");
		for (oq = 0; oq < qid; oq++) {
			q = unsort[oq];
			if (!isdir[q])
				print("\t\"" name[q] "\",\t{" oq ", 0, QTFILE},\t", "0,\t0444,");
			else
				print("\t\"" name[q] "\",\t{" oq ", 0, QTDIR},\t", "0,\t0555,");
		}
		print("};");

		print("Rootdata rootdata[" qid "] = {");
		for (oq = 0; oq < qid; oq++) {
			q = unsort[oq];
			if (!isdir[q])
				print("\t" sort[dotdot[q]] ",\t", "root" q "code,\t", "0,\t", "&root" q "len,");
			else if (nchild[q])
				print("\t" sort[dotdot[q]] ",\t", "&roottab[" child0[q] "],\t", nchild[q] ",\tnil,");
			else
				print("\t" sort[dotdot[q]] ",\t", "nil,\t", "0,\t", "nil,");
		}
		print("};");
}
' $1 >$1.root.h
