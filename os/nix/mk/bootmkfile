BOOTLIB=$BOOTDIR/libboot.a$O

BOOTFILES=\
	bootauth.$O\
	aux.$O\
	boot.$O\
	bootcache.$O\
	bootip.$O\
	local.$O\
	embed.$O\
	settime.$O\
	sac.$O\
	paq.$O\
	printstub.$O\

$BOOTLIB(%.$O):N:	%.$O

$BOOTLIB:	${BOOTFILES:%=$BOOTLIB(%)}
	names=`{membername $newprereq}
	$AR $ARFLAGS $BOOTLIB $names
	rm $names

$BOOTFILES:	$BOOTDIR/boot.h

%.$O:	$BOOTDIR/%.c
	$CC -I$BOOTDIR $CFLAGS $BOOTDIR/$stem.c

# A boot program links against the nix user libc, which this tree does
# not build; the k8cpu configuration that names one is not built here.
boot$CONF.out: $MKDIR/parse $CONF print.$O $BOOTDIR/boot.c $BOOTLIB
	awk -v objtype=$objtype -f $MKDIR/parse -- -mkbootconf $CONF > boot$CONF.c
	$CC $CFLAGS boot$CONF.c
	$CC $CFLAGS $BOOTDIR/printstub.c
	$LD -o boot$CONF.out boot$CONF.$O $BOOTLIB printstub.$O
