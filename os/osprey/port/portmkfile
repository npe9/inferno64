MKSHELL=rc
KERNDATE=`{$NDATE}

PORTFILES=`{$KERNELSHELL $PORTDIR/mkfilelist $PORTDIR}
^($PORTFILES)\.$O'$':R:	$PORTDIR'/\1.c'
	$CC $CFLAGS -I. $PORTDIR/$stem1.c

IPFILES=`{$KERNELSHELL $PORTDIR/mkfilelist $IPDIR}
^($IPFILES)\.$O'$':R:	$IPDIR'/\1.c' $IPDIR/ip.h $IPDIR/ipv6.h
	$CC $CFLAGS -I. $IPDIR/$stem1.c

%.$O:	%.s
	$AS $AFLAGS $stem.s

%.$O:	%.c
	$CC $CFLAGS $stem.c

%.acid:	%.c
	$CC $CFLAGS -a $stem.c >$stem.acid

%.acid:	$IPDIR/%.c
	$CC $CFLAGS -a -I.  $IPDIR/$stem.c >$stem.acid

%.acid:	$PORTDIR/%.c
	$CC $CFLAGS -a -I. $PORTDIR/$stem.c >$stem.acid

installall:V:
	for(i in $CONFLIST)
		mk 'CONF='$i install

all:V:
	for(i in $CONFLIST)
		mk 'CONF='$i

clean:V:
	rm -f *.[$OS] *.i *.root.s *.rootc.c cfs.h fs.h conf.h *.out *.m errstr.h init.h reboot.h boot *.bootfs.paq bootfs.paq
	for i in $CONFLIST $CRAPLIST
	do
		mk $i.clean
	done

%.clean:V:
	rm -f $stem.c [9bz]$stem [9bz]$stem.gz [9bz]$stem.u s[9bz]$stem boot$stem.*

nuke:V:	clean
	rm -f $BOOTDIR/libboot.a$O *.elf *.rr *.acid

%.$O:	$TARGDIR/$objtype/include/u.h $PORTDIR/lib.h mem.h dat.h fns.h io.h $PORTDIR/pci.h $PORTDIR/error.h $PORTDIR/portdat.h $PORTDIR/portfns.h

$PORTDIR/systab.h:D:	$PORTDIR/sys.h $PORTDIR/mksystab
	rc $PORTDIR/mksystab $PORTDIR/sys.h > $PORTDIR/systab.h

$CONF.$O:	$CONF.c $OBJ $LIB
	$CC $CFLAGS '-DKERNDATE='$KERNDATE $CONF.c

$CONF.c:D:	$PORTDIR/mkdevc $CONF
	rc $PORTDIR/mkdevc $CONF > $CONF.c
	{ echo 'uchar configfile[]={'
	 xd -1x $CONF |
		awk '{for(i = 2; i <= NF; i++) printf "0x%s,", $i; print ""}'
	 echo 0,
	 echo '};'; } >> $CONF.c

errstr.h:D:	$PORTDIR/mkerrstr $PORTDIR/error.h
	rc $PORTDIR/mkerrstr $PORTDIR/error.h > errstr.h

%.i:D:	%.out
	{ echo 'uchar '$stem'[]={'
	 xd -1x <$stem.out |
		awk '{for(i = 2; i <= NF; i++) printf "0x%s,", $i; print ""}'
	 echo '};'; } > $target

%.db:D:	main.c
	$CC -s$stem main.c | dbfmt > $stem.db

