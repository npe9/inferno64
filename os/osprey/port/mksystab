#!/bin/rc

file=$1

cat <<'!'
#include "../port/sys.h"

typedef uintptr Syscall(va_list);

!

# The name of the implementation of a syscall is its sys.h name in lower case
# with a sys prefix, except SYSR1, whose implementation is sysr1 rather
# than syssysr1.  Written with awk rather than sed: the original used the
# Plan 9 regexp dialect, in which parentheses group without a backslash,
# and produced nothing at all on a hosted build machine.
awk '/^#define[ \t]+[A-Z0-9_]+/ {
	n = $2;
	if(n == "SYSR1")
		print n;
	else
		print "SYS" n;
}' $file |
	tr A-Z a-z |
	awk '{print "Syscall " $0 ";"}'

cat <<'!'
Syscall	sysdeath;

Syscall *systab[]={
!
sam -d $file >[2] /dev/null <<'!'
,s/#define.([A-Z0-9_]+).*/	[\1]	SYS\1,/g
,x/SYS[A-Z0-9_]+,/ | tr A-Z a-z
,x/SYSsysr1/c/sysr1
,x/SYSsys_x[0-9]*/c/sysdeath
,x v/\[......+\]/ s/\]/]	
,p
!

cat <<'!'
};

char *sysctab[]={
!

sam -d $file >[2] /dev/null <<'!'
,s/#define.([A-Z0-9_]+).*/	[\1]	"\1",/g
,x/"[A-Z0-9_]+",/ y/"[A-Z]/ | tr A-Z a-z
,x/_"/c/"
,x/Sysr1/c/Running
,x/Rendezvous/c/Rendez
,x v/\[......+\]/ s/\]/]	
,p
!

cat <<'!'
};

int nsyscall = (sizeof systab/sizeof systab[0]);
!
