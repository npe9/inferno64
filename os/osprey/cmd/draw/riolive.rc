#!/bin/rc
# build and start the draw, mouse and keyboard servers, then run rio in
# the foreground.  With the keyboard exposed and a user-level /dev/kbd,
# real keystrokes (PS/2, or QMP send-key) reach the focused window.
rm -rf /tmp/draw; mkdir -p /tmp/draw; cp /n/cd/src/draw/* /tmp/draw/; cd /tmp/draw
for(f in devdraw kshim main cursor){ 6c -I. $f.c || echo cc-$f FAIL }
6l -o draw devdraw.6 kshim.6 main.6 cursor.6 /amd64/lib/lib9p.a /amd64/lib/libmemlayer.a /amd64/lib/libmemdraw.a && echo draw-linked
6c mouse.c && 6l -o mouse mouse.6 /amd64/lib/lib9p.a && echo mouse-linked
6c kbd.c && 6l -o kbd kbd.6 /amd64/lib/lib9p.a && echo kbd-linked
/tmp/draw/draw
sleep 1
/tmp/draw/mouse
sleep 1
/tmp/draw/kbd
sleep 1
echo rio-ready
exec rio -i window
