<../../../mkconfig

SYSTARG=Osprey
OBJTYPE=amd64
<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

BIN=$ROOT/Osprey/$OBJTYPE/bin
# the container-side library, and the headers it installs
O9LIB=$ROOT/Osprey/$OBJTYPE/lib/libosprey9.a
CFLAGS=$CFLAGS -I$ROOT/Osprey/include/osprey
TARG=ring pip mig p9srv netsrv o9cat fpbits fb
OFILES=ring.$O pip.$O mig.$O p9srv.$O netsrv.$O o9cat.$O fpbits.$O fb.$O

all:V:	o9lib $TARG

install:V: o9lib $TARG
	cp $TARG $BIN/

# the container-side library and its headers, which these are built
# against: there is no mkfile above this one to order the two
o9lib:V:
	cd $ROOT/os/osprey/libosprey9; mk install

ring:	ring.$O
	$LD -l -o $target ring.$O $ROOT/Osprey/$OBJTYPE/lib/libc.a

pip:	pip.$O
	$LD -l -o $target pip.$O $ROOT/Osprey/$OBJTYPE/lib/libc.a

mig:	mig.$O
	$LD -l -o $target mig.$O $ROOT/Osprey/$OBJTYPE/lib/libc.a

p9srv:	p9srv.$O
	$LD -l -o $target p9srv.$O $O9LIB $ROOT/Osprey/$OBJTYPE/lib/libc.a

netsrv:	netsrv.$O
	$LD -l -o $target netsrv.$O $O9LIB $ROOT/Osprey/$OBJTYPE/lib/libc.a

o9cat:	o9cat.$O
	$LD -l -o $target o9cat.$O $O9LIB $ROOT/Osprey/$OBJTYPE/lib/libc.a

fpbits:	fpbits.$O
	$LD -l -o $target fpbits.$O $O9LIB $ROOT/Osprey/$OBJTYPE/lib/libc.a

fb:	fb.$O
	$LD -l -o $target fb.$O $ROOT/Osprey/$OBJTYPE/lib/libc.a

# Every one of these embeds structures the shared headers define, so
# each must be rebuilt when any of them changes.  Without this a field
# added to the map in the kernel leaves an object here reading the old
# layout, which is the bug the library exists to remove.
INC=$ROOT/Osprey/include
HFILES=\
	$INC/osprey9.h\
	$INC/osprey/ospreyabi.h\
	$INC/osprey/queue.h\
	$INC/osprey/syscall.h\
	$INC/osprey/sem.h\

%.$O:	%.c $HFILES
	$CC $CFLAGS $stem.c

clean:V:
	rm -f *.[$OS] $TARG
