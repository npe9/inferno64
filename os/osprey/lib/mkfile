<../../../mkconfig

# The policy objects link into the Osprey kernel, so they must be compiled
# against the same headers as os/osprey/pc64: the two trees disagree about
# the width of usize, and mixing them makes the loader reject the objects.
SYSTARG=Osprey
OBJTYPE=amd64
<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

LIB=$ROOT/Osprey/$OBJTYPE/lib/libosprey.a
OFILES=\
	osprey-edf.$O\
	osprey-queue.$O\
	osprey-core.$O\
	osprey-process.$O\
	osprey-runtime.$O\
	osprey-ns.$O\
	osprey-snap.$O\
	osprey-net.$O\
	osprey-sem.$O\
	osprey-select.$O\

all install:V: $OFILES $LIB

$LIB: $OFILES
	iar vu $target $prereq

# Every one of these files embeds structures the headers define, so all
# of them must be rebuilt when any header changes.  Without this a
# changed structure leaves half the library reading fields at the old
# offsets, and the kernel walks wild pointers.
HFILES=`{echo $ROOT/os/osprey/policy/*.h}

$OFILES: $HFILES

osprey-%.$O: $ROOT/os/osprey/policy/%.c
	$CC $CFLAGS -o $target $ROOT/os/osprey/policy/$stem.c
