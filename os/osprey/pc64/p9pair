	/*
	 * The microkernel does not swap.  With no swap device no page is
	 * ever paged out, so releasing or duplicating a swap reference
	 * does nothing and there are no pages to reclaim; these are the
	 * real no-swap behaviour, not a pretence.
	 */
	int needpages(void *a)		{ USED(a); return 0; }
	void kickpager(void)		{ }
	void putswap(Page *a)		{ USED(a); }
	int swapcount(uintptr a)	{ USED(a); return 0; }
	void dupswap(Page *a)		{ USED(a); }
	Image *swapimage = nil;		/* nil: no page is ever the swap image */

	/*
	 * The microkernel has no environment.  An environment is a name
	 * space thing, kept in a library operating system, not the kernel.
	 * ksetenv, newegrp, closeegrp and envcpy are reached only from
	 * init0, rfork and reboot, none of which this boot runs; they are
	 * defensive no-ops so that a kernel process exiting with a nil
	 * egrp, or any stray call, does nothing rather than fault.
	 */
	void ksetenv(char *a, char *b, int c)	{ USED(a,b,c); }
	Egrp *newegrp(void)			{ return nil; }
	void closeegrp(Egrp *a)			{ USED(a); }
	void envcpy(Egrp *a, Egrp *b)		{ USED(a,b); }
	char *getconfenv(void)			{ return nil; }

	/*
	 * The name space, the file syscalls and the process syscalls are
	 * cut from this kernel: pgrp.c, sysfile.c and sysproc.c are not
	 * linked.  A kernel process holds no file group, opens no file
	 * descriptor, mounts nothing and takes no user system call, so the
	 * name-space and syscall entry points below are never reached; a
	 * panic marks it if the assumption ever fails.  The process,
	 * rendezvous and resource-group lifecycle those files used to also
	 * hold now lives in proc.c and is linked.
	 */
	void closefgrp(Fgrp *a)			{ USED(a); panic("microkernel: closefgrp"); }
	Fgrp *dupfgrp(Fgrp *a)			{ USED(a); panic("microkernel: dupfgrp"); return nil; }
	void forceclosefgrp(void)		{ panic("microkernel: forceclosefgrp"); }
	int newfd(Chan *a, int b)		{ USED(a,b); panic("microkernel: newfd"); return -1; }
	Chan *fdtochan(int a, int b, int c, int d){ USED(a,b,c,d); panic("microkernel: fdtochan"); return nil; }
	int openmode(ulong a)			{ USED(a); panic("microkernel: openmode"); return 0; }
	Mount *newmount(Chan *a, int b, char *c){ USED(a,b,c); panic("microkernel: newmount"); return nil; }
	void mountfree(Mount *a)		{ USED(a); panic("microkernel: mountfree"); }
	int donotify(Ureg *a)
	{
		USED(a);
		if(up->procctl){
			/*
			 * Proc_stopme: a group move (ospreymovekern) has asked this
			 * process to stop on its way back to user mode, so that its
			 * registers can be taken; procctl parks it Stopped until it
			 * is readied.  Readied with Proc_exitme set, it is the old
			 * process of a moved one, and ends here.
			 */
			procctl();
			if(up->procctl == Proc_exitme)
				procctl();
			return 0;
		}
		if(ospreybuddyhas()){
			/*
			 * A declined fault reaches a legacy Plan 9 program as a note.
			 * It registered no handler (notify(2) is not wired), so the
			 * note kills it - its container exits, cleanly - instead of
			 * the microkernel panicking.  A personality process's fault
			 * still panics, so a real corruption stays visible.
			 */
			char *msg = up->nnote > 0 ? up->note[up->nnote-1]->msg : "note";
			/*
			 * If it registered a handler with notify(2), deliver the note
			 * to it: notify() builds the handler's frame and points the pc
			 * at it, so the program catches its own fault.  With no handler
			 * the note kills it cleanly.
			 */
			if(up->notify != nil){
				Ureg *nureg = notify(a, msg);
				if(nureg != nil){
					if(up->nnote > 0)
						up->nnote--;
					up->notified = 1;
					up->dbgreg = a;
					*(Ureg**)((uintptr)nureg - BY2WD) = up->noteureg;
					up->noteureg = nureg;
					return 1;		/* the handler runs */
				}
			}
			print("osprey: legacy process %s killed by note: %s\n", up->text, msg);
			ospreyexits(1);
		}
		{
			extern uintptr uregpc(void*);
			iprint("osprey: donotify for pid %d (%s), %s, user pc %#p: %s\n", up->pid, up->text,
				up->osprey == nil ? "no container" : "a container without a server", uregpc(a),
				up->nnote > 0 ? up->note[up->nnote-1]->msg : "no note");
		}
		panic("microkernel: donotify");
		return 0;
	}

	/*
	 * The microkernel's system-call interface: two calls, no more.
	 * A user program may write to the console and it may exit.  This is
	 * not the Plan 9 personality - there is no open, no bind, no name
	 * to resolve; those are a library operating system's, above the
	 * kernel.  These two are the least a program needs to run and be
	 * seen to run.  write ignores the descriptor and puts the bytes on
	 * the console through the bare 8250 path; exit does not tear the
	 * boot process down (that would panic) but idles the machine.
	 */
	extern long ospreybuddyforward(ulong, uintptr*);
	extern int ospreybuddyhas(void);
	extern uintptr ospreyxcall(va_list);
	extern void ospreyawaitreply(int);
	extern int uregok(void*);
	typedef uintptr Xsyscall(va_list);

	uintptr xpwrite(va_list list)
	{
		int fd;
		char *buf;
		long len;
		vlong off;
		char kb[256];

		fd = va_arg(list, int);
		buf = va_arg(list, char*);
		len = va_arg(list, long);
		off = va_arg(list, vlong);
		/*
		 * A legacy program that has dup'd something onto 0, 1 or 2 - a
		 * shell redirecting a pipeline's stage - writes that descriptor
		 * to the buddy, which holds the pipe.  Deciding by the number
		 * alone put a pipeline's first stage on the console and left
		 * the second reading an empty pipe; routing every write to the
		 * buddy instead would fix that too, but it turns every legacy
		 * print into a ring round trip and so into a call a note can
		 * interrupt, which the note criteria showed.  So the kernel
		 * keeps the mark: it sees every dup and close a legacy program
		 * makes, and only a redirected descriptor leaves the console
		 * path.
		 */
		/*
		 * A write that goes out to the buddy hands it the error
		 * string too, the same as any other forwarded call: see
		 * ospreysyscallout below for why up->errstr is cleared on
		 * the way out.
		 */
		if(fd >= 0 && fd < 3 && (up->buddyredir & (1 << fd)) != 0 && ospreybuddyhas()){
			up->errstr[0] = 0;
			return ospreybuddyforward(51, (uintptr*)up->s.args);	/* PWRITE */
		}
		if(fd >= 3 && ospreybuddyhas()){	/* a file descriptor: the buddy holds the file, not the console */
			up->errstr[0] = 0;
			return ospreybuddyforward(51, (uintptr*)up->s.args);	/* PWRITE */
		}
		USED(fd, off);
		if(len <= 0)
			return 0;
		if(len > (long)sizeof kb)
			len = sizeof kb;
		validaddr((uintptr)buf, len, 0);
		memmove(kb, buf, len);
		ospreyconsolewrite(kb, len);	/* the console task, or the port */
		return len;
	}
	uintptr xsleep(va_list list)
	{
		/*
		 * A legacy process - one whose text is a buddy's image - gets
		 * Plan 9's sleep(2), the milliseconds it asked for and Eintr
		 * when a note interrupts it.  Every sleep of such a process was
		 * the two-millisecond yield below for a long time, whatever it
		 * asked, which no test could tell from a short one until a
		 * member had to sleep a minute to be blocked for a move.
		 */
		if(up->buddyimage){
			long ms = va_arg(list, long);

			if(ms <= 0)
				yield();
			else
				tsleep(&up->sleep, return0, 0, ms);
			return 0;
		}
		USED(list);
		/*
		 * The program's yield-and-service call.  It puts a request in
		 * its ring, calls this, and the kernel carries the request and
		 * leaves the reply in the ring.  Reusing SLEEP's number keeps
		 * the interface to what a program's libc already has a stub
		 * for; a yield that services the ring is what it means here.
		 */
		ospreyservicecaller();
		/*
		 * Yield after servicing, so a server task the request was
		 * forwarded to gets the processor to answer it.  Without this
		 * the program's retry loop is a tight spin that starves the
		 * server and no reply ever lands.  The yield ends when the
		 * reply lands, or after two milliseconds.
		 */
		ospreyawaitreply(2);
		return 0;
	}
	/*
	 * brk_(addr): heap growth, which a real program's libc reaches
	 * through sbrk and its malloc through that.  Memory is the
	 * microkernel's own service, not a file the buddy holds, so this is
	 * answered here and never forwarded.  A legacy program - one whose
	 * text and data are a buddy image - grows the heap segment exec made
	 * a page above its image; anything else is the ordinary bss segment
	 * a program loaded by userinit has.
	 */
	uintptr xbrk(va_list list)
	{
		extern long ospreybuddybrk(uintptr);
		uintptr addr = va_arg(list, uintptr);

		if(up->buddyimage)
			return (uintptr)ospreybuddybrk(addr);
		return ibrk(addr, BSEG);
	}
	/*
	 * exec(2): the program replaces itself with another.  This is the
	 * exec a shell makes after it forks, as against the exec request a
	 * container puts on the ring to start a program beside it - the
	 * same buddy lays the binary out, but the address space it lands in
	 * is the caller's own, and the caller's descriptors survive it.
	 * Only a legacy program the buddy loaded has an image to replace.
	 */
	uintptr xexec(va_list list)
	{
		char *name = va_arg(list, char*);
		char **argv = va_arg(list, char**);

		if(!up->buddyimage)
			return (uintptr)-1;
		return (uintptr)ospreyexecself(name, argv);
	}
	/*
	 * exits(2).  The status is a string: nil, or the empty string, is
	 * success and anything else is a failure whose text is the reason.
	 * This threw the string away and always exited 0, so a program that
	 * died in sysfatal was reaped by its parent as having succeeded -
	 * every "exited with status 0" in a log said nothing at all.  The
	 * string is copied out and printed, and a non-empty one is a
	 * non-zero status.
	 */
	uintptr xexits(va_list list)
	{
		char *status;
		char ks[ERRMAX];
		int i;

		status = va_arg(list, char*);
		ks[0] = 0;
		if(status != nil){
			if(waserror())
				strcpy(ks, "exits: unreadable status");	/* not a success */
			else{
				validaddr((uintptr)status, 1, 0);
				for(i = 0; i < (int)sizeof ks - 1 && status[i] != 0; i++)
					ks[i] = status[i];
				ks[i] = 0;
				poperror();
			}
		}
		if(ks[0] != 0){
			print("osprey exec: the program exited with the status \"%s\"\n", ks);
			ospreyexits(1);
		} else
			ospreyexits(0);	/* the boot program idles; one exec started ends */
		return 0;
	}
	/*
	 * segattach maps a named segment into the program's address space.
	 * A library-OS program maps its container's ring this way and then
	 * works it in memory; this is the address-space service, one of the
	 * microkernel's four, offered as a call.  The name is validated and
	 * copied; validnamedup is the name space's and this kernel has none.
	 */
	uintptr xsegattach(va_list list)
	{
		int attr, i;
		char *name;
		uintptr va;
		ulong len;
		char kn[64];

		attr = va_arg(list, int);
		name = va_arg(list, char*);
		va = va_arg(list, uintptr);
		len = va_arg(list, ulong);
		validaddr((uintptr)name, 1, 0);
		for(i = 0; i < (int)sizeof kn - 1 && name[i] != 0; i++)
			kn[i] = name[i];
		kn[i] = 0;
		/*
		 * "code": not a named segment of the container's but a region
		 * the caller may write a program into and then run - what a
		 * library operating system needs when it loads a program
		 * itself.  The address-space service keeps its one call.
		 */
		if(strcmp(kn, "code") == 0)
			return ospreysegcode(va, len);
		if(len == 0)
			len = ospreyslicesize();	/* the whole slice */
		{
			uintptr r;
			if(waserror()){
				print("osprey user: segattach(%s) failed: %s\n", kn, up->errstr);
				return (uintptr)-1;
			}
			r = segattach(attr, kn, va, len);
			poperror();
			return r;
		}
	}

	/*
	 * select: the talk's central call, offered to a user task.  The task
	 * names arms in its own data area - a get on a ring, a down on an
	 * interrupt's semaphore - and this returns which one was ready,
	 * having performed it.  It reuses the DUP number the way SLEEP is
	 * reused for service: the program's libc already has a dup stub, and
	 * the minimal interface spends spare numbers rather than inventing an
	 * ABI.  The two words a dup carries are the arm count and the offset
	 * of the arms in the caller's data area.
	 */
	uintptr xselect(va_list list)
	{
		int narms, armoff;
		extern long ospreybuddydup(int, int);

		/*
		 * DUP's number is reused for select-over-arms, which the ring
		 * clients call.  A legacy program - one whose text and data are
		 * a buddy image - means dup(2) instead: route it to the buddy's
		 * descriptor table.  The distinguisher is up->buddyimage, not
		 * merely having a server, since a ring client has a server too
		 * and calls the real select.
		 */
		if(up->buddyimage){
			int oldfd = va_arg(list, int);
			int newfd = va_arg(list, int);
			return (uintptr)ospreybuddydup(oldfd, newfd);
		}
		narms = va_arg(list, int);
		armoff = va_arg(list, int);
		return (uintptr)ospreyselectcaller((uvlong)(ulong)armoff, narms);
	}

	uintptr xnotify(va_list list)
	{
		void *f = va_arg(list, void*);
		if(f != nil)
			validaddr((uintptr)f, sizeof(void*), 0);
		up->notify = (int(*)(void*, char*))f;
		return 0;
	}
	/*
	 * noted(2): the note handler's return.  NCONT resumes the
	 * interrupted program from the register frame notify() saved on
	 * its stack; the rest is as the cut sysproc.c had it.  A declined
	 * fault cannot exercise NCONT (the address is still bad), so the
	 * kernel posts a note by request (ReqNote, devosprey.c) for the
	 * check of it.
	 */
	uintptr xnoted(va_list list)
	{
		Ureg *nureg;
		int arg;

		arg = va_arg(list, int);
		qlock(&up->debug);
		if(up->notified){
			/*
			 * fpunoted reads the saved FPU state, which a process
			 * that never used the FPU has none of (fpsave nil,
			 * fpstate FPinit): the cut sysproc.c's caller assumed
			 * one and read address 0x340.
			 */
			if(up->fpsave != nil || (up->fpstate & FPnotify)){
				splhi();
				fpunoted(up);
				spllo();
			}
		} else if(arg != NRSTR){
			qunlock(&up->debug);
			error(Ebadarg);
		}
		qunlock(&up->debug);
		nureg = up->noteureg;
		if(!uregok(nureg)){		/* trap.c: the frame wholly in user memory */
			print("osprey: %s: bad ureg in noted\n", up->text);
			ospreyexits(1);
		}
		switch(arg){
		case NCONT:
		case NRSTR:
			up->noteureg = *(Ureg**)((uintptr)nureg-BY2WD);
			/* wet floor */
		case NSAVE:
			if(noted(up->dbgreg, nureg, arg)){
				print("osprey: %s: trap in noted\n", up->text);
				ospreyexits(1);
			}
			break;
		default:
		case NDFLT:
			noted(up->dbgreg, nureg, arg);
			print("osprey: %s: noted(%d) ends it: %s\n", up->text, arg, up->lastnote != nil ? up->lastnote->msg : "");
			ospreyexits(1);
		}
		up->notified = 0;
		return 0;
	}

	/*
	 * alarm(ms): the process asks to be sent an "alarm" note that many
	 * milliseconds from now, 0 to cancel, and gets back what was left of
	 * any alarm already set.  It is the kernel's, not the buddy's: the
	 * clock and the note are both here, and alarm.c is linked into this
	 * configuration whole - only sysproc.c, which held the two-line
	 * wrapper, is cut.
	 */
	uintptr xalarm(va_list list)
	{
		return (uintptr)procalarm(va_arg(list, ulong));
	}

	/*
	 * _nsec(): nanoseconds since the epoch.  On a 64-bit machine libc's
	 * nsec(2) takes the answer in the return register and passes no
	 * pointer, which is what the port's own sys_nsec does; the same is
	 * done here rather than forwarded, because the time of day is the
	 * machine's and the buddy has no better one.
	 */
	uintptr xnsec(va_list list)
	{
		USED(list);
		return (uintptr)todget(nil, nil);
	}

	/*
	 * rendezvous(tag, value): two processes sharing an address space
	 * meet on a tag and swap a word, the first to arrive sleeping until
	 * the second comes.  This is libthread's proccreate handing a new
	 * proc its argument, and it is the one call of the nine that is not
	 * a file, a time or a note: it is a place to block, and the place is
	 * the address space, so the kernel answers it.
	 *
	 * The body is Plan 9's sysrendezvous, which is in sysproc.c and cut
	 * from this configuration; what is not cut is the machinery it uses
	 * - the Rgrp and its hash in portdat.h, the Rendezvous process state
	 * proc.c already unwinds when a note arrives, and newrgrp in proc.c.
	 * The group itself is made on the first RFMEM fork (devosprey.c) so
	 * that a thread and the process that made it are in one, and a
	 * process that has none is alone and can only wait to be joined.
	 */
	uintptr xrendezvous(va_list list)
	{
		uintptr tag, val, new;
		Proc *p, **l;

		tag = va_arg(list, uintptr);
		new = va_arg(list, uintptr);
		if(up->rgrp == nil)
			up->rgrp = newrgrp();
		l = &REND(up->rgrp, tag);

		lock(up->rgrp);
		for(p = *l; p != nil; p = p->rendhash){
			if(p->rendtag == tag){
				*l = p->rendhash;
				val = p->rendval;
				p->rendval = new;
				unlock(up->rgrp);
				ready(p);
				return val;
			}
			l = &p->rendhash;
		}

		/* nobody there yet: sleep on the tag until the other one comes */
		up->rendtag = tag;
		up->rendval = new;
		up->rendhash = *l;
		*l = up;
		up->state = Rendezvous;
		unlock(up->rgrp);

		sched();

		return up->rendval;
	}

	Xsyscall *systab[] = {
		[5]	xselect,	/* DUP number reused: select over arms */
		[7]	xexec,		/* EXEC: the program replaces itself, its descriptors kept */
		[8]	xexits,		/* EXITS */
		[28]	xnotify,	/* NOTIFY: register a note handler */
		[29]	xnoted,		/* NOTED: the handler returns; NCONT resumes */
		[17]	xsleep,		/* SLEEP: yield and service the ring */
		[24]	xbrk,		/* BRK_: heap growth, the address-space service */
		[30]	xsegattach,	/* SEGATTACH */
		[51]	xpwrite,	/* PWRITE */
		[6]	xalarm,		/* ALARM: a note this many milliseconds from now */
		[34]	xrendezvous,	/* RENDEZVOUS: two processes of one address space meet */
		[53]	xnsec,		/* _NSEC: nanoseconds, the machine's clock */
		[60]	ospreyxcall,	/* above the Plan 9 table, which a legacy binary uses whole: a request of the task's own, answered now */
	};
	int nsyscall = nelem(systab);

	/*
	 * A call the buddy answers, and the one exception.
	 *
	 * errstr(2) is a call like any other and the buddy answers it out
	 * of the error string it keeps per container, which is right for
	 * every call the buddy served and wrong for the ones this kernel
	 * served itself: the buddy never saw those fail and has nothing to
	 * say about them.  A program that asks segattach for a segment
	 * this machine does not have gets -1 and then an empty %r, which
	 * is how the keyboard server's "segattach kbdring: " came to end
	 * in a colon and nothing.
	 *
	 * up->errstr is both the message and the flag.  A call sent out to
	 * the buddy clears it, because from then on the buddy owns the
	 * answer; a kernel-served call that fails leaves its message
	 * there through error(); and errstr(2) is answered here whenever
	 * there is one to answer with, and forwarded when there is not.
	 */
	uintptr ospreysyscallout(ulong scallnr)
	{
		enum { ERRSTR = 41 };
		uintptr *a;
		char *buf;
		long n, m;

		a = (uintptr*)up->s.args;
		if(scallnr == ERRSTR && up->errstr[0] != 0){
			buf = (char*)a[0];
			n = (long)a[1];
			if(n <= 0)
				return (uintptr)-1;
			validaddr((uintptr)buf, n, 1);
			for(m = 0; m < n - 1 && up->errstr[m] != 0; m++)
				buf[m] = up->errstr[m];
			buf[m] = 0;
			return (uintptr)(m + 1);
		}
		up->errstr[0] = 0;
		return (uintptr)ospreybuddyforward(scallnr, a);
	}

	int dosyscall(ulong scallnr, Sargs *args, uintptr *retp)
	{
		int s;

		up->insyscall = 1;
		s = spllo();
		if(!waserror()){
			if(!up->oslinux){
				validaddr((uintptr)args, sizeof(Sargs), 0);
				up->s = *args;
			}
			if(up->oslinux)
				ospreylinuxsyscall(scallnr, retp);	/* a program exec started: port/userinit.c */
			else if(scallnr < (ulong)nsyscall && systab[scallnr] != nil)
				*retp = systab[scallnr]((va_list)up->s.args);
			else if(ospreybuddyhas())	/* a Plan 9 program exec started: its server answers */
				*retp = (uintptr)ospreysyscallout(scallnr);
			else {
				print("osprey user: unimplemented syscall %uld\n", scallnr);
				*retp = (uintptr)-1;
			}
			poperror();
		} else
			*retp = (uintptr)-1;
		splx(s);
		up->insyscall = 0;
		return 0;
	}

	/*
	 * chan.c and cache.c, the name resolution and the file cache, are
	 * cut too.  Most of chan.c is name space and is stubbed below as
	 * panics: this kernel resolves no name, clones or closes no
	 * channel, walks no path.  The kernel infrastructure chan.c also
	 * held that is not name space - the reference counting, the string
	 * helpers, the device bring-up main() calls at boot - moved to
	 * kerncore.c and is linked into every configuration.  Only
	 * chandevinit is reproduced here, to drop its one name-space line:
	 * the kproc that drains the channel-close queue, which a kernel
	 * with no channels never fills.
	 */
	void chandevinit(void)
	{
		Dev **d;

		/*
		 * The one line dropped from the shared chandevinit in
		 * kerncore.c: no kproc to drain the channel-close queue,
		 * which a kernel with no channels never fills.  Iterated by
		 * pointer, not devtab[i], so no line begins with "devtab":
		 * see scripts/check-config-portlines.sh.
		 */
		for(d = devtab; *d != nil; d++)
			(*d)->init();
	}

	/*
	 * The name space proper: unreachable in a kernel that resolves no
	 * name, so each is a loud panic.
	 */
	Chan *namec(char *a, int b, int c, ulong d)
	{ USED(a,b,c,d); panic("microkernel: namec"); return nil; }
	Chan *cclone(Chan *a)		{ USED(a); panic("microkernel: cclone"); return nil; }
	void cclose(Chan *a)		{ USED(a); panic("microkernel: cclose"); }
	void ccloseq(Chan *a)		{ USED(a); panic("microkernel: ccloseq"); }
	char *chanpath(Chan *a)		{ USED(a); panic("microkernel: chanpath"); return nil; }
	int eqchantdqid(Chan *a, int b, int c, Qid d, int e)
	{ USED(a,b,c,d,e); panic("microkernel: eqchantdqid"); return 0; }
	void isdir(Chan *a)		{ USED(a); panic("microkernel: isdir"); }
	Chan *newchan(void)		{ panic("microkernel: newchan"); return nil; }
	Path *newpath(char *a)		{ USED(a); panic("microkernel: newpath"); return nil; }
	void pathclose(Path *a)		{ USED(a); panic("microkernel: pathclose"); }
	void putmhead(Mhead *a)		{ USED(a); panic("microkernel: putmhead"); }
	char *validnamedup(char *a, int b){ USED(a,b); panic("microkernel: validnamedup"); return nil; }

	/*
	 * werrstr formatted an error into a user process's error string,
	 * which a kernel process does not have, so it does nothing.  beswal
	 * (the reboot byte swap) and return0 (the sleep predicate) are not
	 * here: they are real in kerncore.c, linked into every config.
	 */
	void werrstr(char *a, ...)		{ USED(a); }

	/*
	 * auth.c and rdb.c are cut: Plan 9 authentication and the remote
	 * kernel debugger.  iseve asked whether the caller is the host
	 * owner; a microkernel has one trust domain, managed by the library
	 * operating system above it, so everyone is, and it returns true.
	 * The host-owner and host-domain writes are console file handlers
	 * this kernel has no name space to reach, so they panic.
	 */
	int iseve(void)				{ return 1; }
	long userwrite(char *a, int n)		{ USED(a,n); panic("microkernel: userwrite"); return 0; }
	long hostownerwrite(char *a, int n)	{ USED(a,n); panic("microkernel: hostownerwrite"); return 0; }
	long hostdomainwrite(char *a, int n)	{ USED(a,n); panic("microkernel: hostdomainwrite"); return 0; }

	/*
	 * The host owner and host domain that auth.c defined, and the
	 * debugger entry that rdb.c did.  eve is nil until userinit sets it
	 * with kstrdup, exactly as auth.c left it: kstrdup frees the old
	 * value, so eve must never point at a string literal.  rdb was the
	 * console's ^T debugger, which devcons still names when it arms
	 * consdebug, so it is a quiet no-op rather than a debugger this
	 * kernel does not carry.
	 */
	char *eve;
	char hostdomain[48];	/* DOMLEN in authsrv.h, not included here */
	void rdb(void)				{ }

