MKSHELL=rc
<../../../mkconfig

CONF=pc64
CONFLIST=pc64 upc64 xup64 p964 p9pair p9buddy p9linux

SYSTARG=Osprey
OBJTYPE=amd64
objtype=$OBJTYPE
<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

FLAVOR=Osprey
FLAVDIR=$ROOT/os/$FLAVOR
TARGDIR=$ROOT/$FLAVOR
PORTDIR=$FLAVDIR/port
IPDIR=$FLAVDIR/ip
BOOTDIR=$FLAVDIR/boot
PCDIR=$FLAVDIR/pc
TARGETLIB=$ROOT/$FLAVOR/$OBJTYPE/lib
PORTLIB=$FLAVDIR/kernlib
DEVCONF=$PORTDIR
INSTALLDIR=$ROOT/$FLAVOR/$OBJTYPE
KERNELSHELL=rc
# The policy directory carries its own lib.h, error.h, portdat.h and
# portfns.h for a future native port, and its headers include one another
# by plain name.  The adapter is therefore compiled with the policy
# directory on the include path and the port directory off it.
POLICYCFLAGS=$CFLAGS -I$FLAVDIR/policy -I$PORTDIR
CFLAGS=$CFLAGS -I$PORTDIR -I$IPDIR
p=9

default:V: $p$CONF

# must match mem.h
KTZERO=0xffffffff80110000
APBOOTSTRAP=0xffffffff80007000
REBOOTADDR=0x11000

DEVS=`{$KERNELSHELL $DEVCONF/mkdevlist $CONF}

# The microkernel drops the name-space, process-group and file cluster;
# the reduced list is chosen by CONF below.  What the remaining port
# code still references from the cut sources is stubbed in upc64's own
# port section.
PORTOBJCUT=pgrp.$O sysfile.$O sysproc.$O syscallfmt.$O chan.$O cache.$O auth.$O rdb.$O
PORTOBJALL=\
	alarm.$O\
	alloc.$O\
	allocb.$O\
	auth.$O\
	cache.$O\
	chan.$O\
	dev.$O\
	edf.$O\
	fault.$O\
	iomap.$O\
	memmap.$O\
	page.$O\
	parse.$O\
	pgrp.$O\
	portclock.$O\
	print.$O\
	proc.$O\
	qio.$O\
	qlock.$O\
	random.$O\
	rdb.$O\
	rebootcmd.$O\
	segment.$O\
	syscallfmt.$O\
	sysfile.$O\
	sysproc.$O\
	taslock.$O\
	tod.$O\
	xalloc.$O\
	userinit.$O\
	kerncore.$O\
	ospreyrt.$O\

PORTOBJ=`{if [ "$CONF" = upc64 -o "$CONF" = xup64 -o "$CONF" = p964 -o "$CONF" = p9pair -o "$CONF" = p9buddy -o "$CONF" = p9linux ]; then \
	for o in $PORTOBJALL; do echo $o; done | grep -vxF -e pgrp.$O -e sysfile.$O -e sysproc.$O -e syscallfmt.$O -e chan.$O -e cache.$O -e auth.$O -e rdb.$O; \
	else echo $PORTOBJALL; fi}

OBJ=\
	l.$O\
	cga.$O\
	fpu.$O\
	i8253.$O\
	i8259.$O\
	main.$O\
	memory.$O\
	mmu.$O\
	irq.$O\
	trap.$O\
	bootargs.$O\
	$CONF.root.$O\
	$CONF.rootc.$O\
	$DEVS\
	$PORTOBJ\

LIB=\
	$TARGETLIB/libospreykern.a\
	$TARGETLIB/libaml.a\
	$TARGETLIB/libosprey.a\
	$ROOT/Inferno/$OBJTYPE/lib/libsec.a\
	$ROOT/Inferno/$OBJTYPE/lib/libmp.a\
	$ROOT/Inferno/$OBJTYPE/lib/libfis.a\
	$ROOT/Inferno/$OBJTYPE/lib/libkern.a\

$TARGETLIB/libospreykern.a:V:
	{ cd $PORTLIB; mk install; }

$TARGETLIB/libosprey.a:V:
	{ cd $FLAVDIR/lib; mk install; }

$TARGETLIB/libaml.a:V:
	{ cd $FLAVDIR/libaml; mk install; }

ETHER=`{cd $PCDIR; echo devether.c ether*.c | sed 's/\.c/.'$O'/g'}
AUDIO=`{cd $PCDIR; echo devaudio.c audio*.c | sed 's/\.c/.'$O'/g'}
VGA=`{cd $PCDIR; echo devvga.c screen.c vga*.c | sed 's/\.c/.'$O'/g'}
SDEV=`{cd $PCDIR; echo sd*.c | sed 's/\.c/.'$O'/g'}

$p$CONF:	$OBJ $CONF.$O $LIB
	$LD $LDFLAGS -o $target -T$KTZERO -R4096 -l $prereq
	$KSIZE $target

install:V:	$p$CONF
	cp $p$CONF $INSTALLDIR/

install.%:V:	$p$CONF
	@{
	rfork n
	9fs $stem
	test -e /n/$stem/$p$CONF && cp /n/$stem/$p$CONF /n/$stem/$p$CONF.o
	cp $p$CONF /n/$stem/$p$CONF
	}

# copies generated by the rule below
PCHEADERS=usbehci.h screen.h mp.h io.h ahci.h \
	yukdump.h

REPCH=`{echo $PCHEADERS | sed 's/\.h//g; s/ /|/g'}
^($REPCH)\.h'$':R:	$PCDIR'/\1.h'
	cp $prereq .

REPCC1=`{$KERNELSHELL $PORTDIR/mkfilelist $PCDIR | sed 's/|/\n/g' | awk '/^[a-m]/{if(n++)printf "|";printf "%s",$0}END{print ""}'}
REPCC2=`{$KERNELSHELL $PORTDIR/mkfilelist $PCDIR | sed 's/|/\n/g' | awk '/^[n-z]/{if(n++)printf "|";printf "%s",$0}END{print ""}'}
^($REPCC1)\.$O'$':R:	$PCDIR'/\1.c'
	$CC $CFLAGS -I. -. $PCDIR/$stem1.c
^($REPCC2)\.$O'$':R:	$PCDIR'/\1.c'
	$CC -I. $CFLAGS -. $PCDIR/$stem1.c

<$BOOTDIR/bootmkfile
<$PORTDIR/portmkfile
<|$KERNELSHELL $PORTDIR/mkbootrules $CONF

l.$O rebootcode.$O apbootstrap.$O:	mem.h

$ETHER: 			$PORTDIR/etherif.h $PORTDIR/netif.h
$AUDIO:				$PORTDIR/audioif.h
ether8003.$O ether8390.$O:	ether8390.h
etheryuk.$O:			yukdump.h
$VGA mouse.$O:			screen.h $TARGDIR/include/memdraw.h
vgavesa.$O:			$TARGDIR/386/include/ureg.h

mp.$O:				mp.h apbootstrap.i
apic.$O squidboy.$O:		mp.h
archmp.$O archacpi.$O:		mp.h

sd53c8xx.$O:			$PCDIR/sd53c8xx.i
$PCDIR/sd53c8xx.i:		$PCDIR/sd53c8xx.n
	cd $PCDIR && mk sd53c8xx.i

etherm10g.$O:			$PCDIR/etherm10g2k.i $PCDIR/etherm10g4k.i
$PCDIR/etherm10g%.i:		$PCDIR/etherm10g%.fw
	cd $PCDIR && mk etherm10g$stem.i

$SDEV pmmc.$O:			$PORTDIR/sd.h
sdiahci.$O:			ahci.h
devaoe.$O sdaoe.$O:		$PORTDIR/aoe.h
sdvirtio10.$O:			$PORTDIR/virtio10.h
main.$O:			rebootcode.i

devusb.$O usbuhci.$O usbohci.$O usbehci.$O usbehcipc.$O usbxhci.$O: $PORTDIR/usb.h
usbehci.$O usbehcipc.$O:	usbehci.h

trap.$O main.$O:		$TARGDIR/include/tos.h

ether8169.$O:			$PORTDIR/ethermii.h
etherdp83820.$O:		$PORTDIR/ethermii.h
etheri225.$O:			$PORTDIR/ethermii.h
etherigbe.$O:			$PORTDIR/ethermii.h
ethervgbe.$O:			$PORTDIR/ethermii.h
ethervt6102.$O:			$PORTDIR/ethermii.h
ethervt6105m.$O:		$PORTDIR/ethermii.h

etherwpi.$O:			$PORTDIR/wifi.h
etherrt2860.$O: 		$PORTDIR/wifi.h

ethervirtio10.$O:		$PORTDIR/virtio10.h

pcipc.$O:	$PORTDIR/pci.h io.h
virtio10pc.$O:	$PORTDIR/virtio10.h

initcode.out:		init9.$O initcode.$O $TARGETLIB/libc.a
	$LD -l -R1 -s -o $target $prereq

# userinit.c embeds the boot programs as .i images; rebuild it when they change.
userinit.$O:	initcode.i userprog.i p9prog.i

# userprog.i (the file-server container) and p9prog.i (the Plan 9
# personality) are built by the scripts in cmd/p9: they compile against
# the user headers, add the 9P server and its marshalling, supply the
# libc members the host linker cannot read, and truncate to
# header+text+data.  The generic %.i:D:%.out rule would instead run od
# over a kernel-header build with none of that, so give them explicit
# rules that run the scripts.  init9.$O is the shared entry both embed.
userprog.i:	init9.$O $ROOT/os/osprey/cmd/p9/buildserver.sh \
		$ROOT/os/osprey/cmd/p9/srv9p.c $ROOT/os/osprey/cmd/p9/srv9p.h \
		$ROOT/os/osprey/port/userprog.c
	sh $ROOT/os/osprey/cmd/p9/buildserver.sh

p9prog.i:	init9.$O $ROOT/os/osprey/cmd/p9/build.sh \
		$ROOT/os/osprey/cmd/p9/main.c $ROOT/os/osprey/cmd/p9/p9shim.c \
		$ROOT/os/osprey/cmd/p9/dev9ploop.c $ROOT/os/osprey/cmd/p9/ring9p.c $ROOT/os/osprey/cmd/p9/p9pairsrv.c \
		$ROOT/os/osprey/cmd/p9/p9file.c $ROOT/os/osprey/cmd/p9/p9srv.c $ROOT/os/osprey/cmd/p9/p9buddy.c \
		$ROOT/os/osprey/port/devpipe.c $ROOT/os/osprey/port/devsrv.c $ROOT/os/osprey/cmd/p9/nsdat.h $ROOT/os/osprey/cmd/p9/dat.h \
		$ROOT/os/osprey/cmd/p9/p9linuxfile.c linuxprog.i legacyprog.i $ROOT/os/osprey/cmd/p9/blkvirtio.c $ROOT/os/osprey/cmd/p9/devlfs.c $ROOT/os/osprey/cmd/p9/xcall.s $ROOT/os/osprey/cmd/p9/pipfsrv.c $ROOT/os/osprey/cmd/p9/p9ip.c $ROOT/os/osprey/cmd/p9/p9sched.c $ROOT/os/osprey/ip/loopbackmedium.c $ROOT/os/osprey/ip/ospreymedium.c
	sh $ROOT/os/osprey/cmd/p9/build.sh

legacyprog.i:	init9.$O $ROOT/os/osprey/cmd/p9/buildlegacy.sh \
		$ROOT/os/osprey/cmd/p9/legacyp9.c
	sh $ROOT/os/osprey/cmd/p9/buildlegacy.sh

linuxprog.i:	$ROOT/os/osprey/cmd/p9/buildlinux.sh $ROOT/os/osprey/cmd/p9/linuxlegacy.c
	sh $ROOT/os/osprey/cmd/p9/buildlinux.sh

userprog.out:		init9.$O userprog.$O $TARGETLIB/libc.a
	$LD -l -R1 -s -o $target $prereq

$O.rebootcode:		rebootcode.$O
	$LD -l -R1 -s -o $target -T$REBOOTADDR $prereq
rebootcode.out:		$O.rebootcode
	tail -c +41 < $prereq > $target

$O.apbootstrap:		apbootstrap.$O
	$LD -l -R1 -s -o $target -T$APBOOTSTRAP $prereq
apbootstrap.out:	$O.apbootstrap
	tail -c +41 < $prereq > $target

sd53c8xx.i:	sd53c8xx.n
	aux/na $prereq > $target

acid:V:
	$CC -a -w main.c>acid

%.clean:V:
	rm -f $stem.c [9bz]$stem [9bz]$stem.gz boot$stem.* $O.rebootcode $O.apbootstrap $PCHEADERS

# The adapter embeds the policy layer's structures, so it must be rebuilt
# whenever one of them changes; without this the library and the adapter
# disagree about where a field is and the kernel walks wild pointers.
POLICYHFILES=`{echo $FLAVDIR/policy/*.h}

ospreyrt.$O:	$FLAVDIR/adapter/ospreyrt.c $PORTDIR/osprey.h $POLICYHFILES
	$CC $POLICYCFLAGS $FLAVDIR/adapter/ospreyrt.c

devosprey.$O:	$PORTDIR/osprey.h
