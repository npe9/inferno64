# upc64 - the Osprey microkernel: boots an Osprey task, no Plan 9 shell.
#
# The device list is cut toward the paper's kernel.  Gone are the file
# and name-space personality devices: root, pnp, pipe, proc, mnt, srv,
# shr, dup, cap, kprof, fs, and the sd and audio stacks.  What is kept is
# the message passing (osprey), address spaces (segment), the console
# (cons, uart), the machine's interrupt and scheduling bring-up (arch and
# the misc entries), rtc because the AP start path writes the warm-reset
# vector through it, and env and swap because the always-linked port code
# still calls into them.  The ether and ip stack is gone now that the
# osprey device names an interface through the ospreyetherlookup hook
# rather than calling etherlookup directly.  mnt, srv and shr leave a few
# symbols behind that the port core references but the microkernel boot
# never reaches; the port section below stubs them with a panic, so a
# stub that ever fires is a loud bug and not silent breakage.
dev
	cons
	swap
	arch
	env
	rtc
	osprey

	uart
	segment

misc
	headless
	pci		pcipc
# archgeneric first: the fallback the others inherit unset entries from.
	archgeneric	i8259 i8253
	archacpi	mp apic squidboy ec
	archmp		mp apic squidboy
	mp		apic squidboy hpet
	mtrr

	uarti8250
	uartisa
	uartpci		pci


port
	int cpuserver = 0;
	int ospreymicro = 1;

	/*
	 * Stubs for the symbols the always-linked port core references
	 * from the mnt, srv and shr devices this microkernel does not
	 * carry.  The microkernel boot mounts nothing, reads no cached
	 * file, and renames no host owner, so none of these is reached; a
	 * panic marks it loudly if the assumption ever fails.
	 */
	Chan* mntattach(Chan *a, Chan *b, char *c, int d)
	{ USED(a,b,c,d); panic("microkernel: mntattach"); return 0; }
	Chan* mntauth(Chan *a, char *b)
	{ USED(a,b); panic("microkernel: mntauth"); return 0; }
	int mntversion(Chan *a, char *b, int c, int d)
	{ USED(a,b,c,d); panic("microkernel: mntversion"); return 0; }
	void muxclose(Mnt *a)
	{ USED(a); panic("microkernel: muxclose"); }
	void mntrahinit(Mntrah *a)
	{ USED(a); panic("microkernel: mntrahinit"); }
	long mntrahread(Mntrah *a, Chan *b, uchar *c, long d, vlong e)
	{ USED(a,b,c,d,e); panic("microkernel: mntrahread"); return 0; }
	void srvrenameuser(char *a, char *b)
	{ USED(a,b); panic("microkernel: srvrenameuser"); }
	void shrrenameuser(char *a, char *b)
	{ USED(a,b); panic("microkernel: shrrenameuser"); }

	/*
	 * proctrace is the scheduler's tracing hook, a pointer devproc
	 * set; with no devproc it is nil and tracing is simply off.
	 * addbootfile is how devroot took the embedded boot files, which
	 * a microkernel has no name space to mount, so it ignores them.
	 */
	void (*proctrace)(Proc*, int, vlong) = nil;
	void addbootfile(char *a, uchar *b, ulong c)
	{ USED(a,b,c); }

bootdir
	boot
