	/*
	 * Stubs for the symbols the always-linked port core references
	 * from the mnt, srv and shr devices this microkernel does not
	 * carry.  The microkernel boot mounts nothing, reads no cached
	 * file, and renames no host owner, so none of these is reached; a
	 * panic marks it loudly if the assumption ever fails.
	 */
	Chan* mntattach(Chan *a, Chan *b, char *c, int d)
	{ USED(a,b,c,d); panic("microkernel: mntattach"); return 0; }
	Chan* mntauth(Chan *a, char *b)
	{ USED(a,b); panic("microkernel: mntauth"); return 0; }
	int mntversion(Chan *a, char *b, int c, int d)
	{ USED(a,b,c,d); panic("microkernel: mntversion"); return 0; }
	void muxclose(Mnt *a)
	{ USED(a); panic("microkernel: muxclose"); }
	void mntrahinit(Mntrah *a)
	{ USED(a); panic("microkernel: mntrahinit"); }
	long mntrahread(Mntrah *a, Chan *b, uchar *c, long d, vlong e)
	{ USED(a,b,c,d,e); panic("microkernel: mntrahread"); return 0; }
	void srvrenameuser(char *a, char *b)
	{ USED(a,b); panic("microkernel: srvrenameuser"); }
	void shrrenameuser(char *a, char *b)
	{ USED(a,b); panic("microkernel: shrrenameuser"); }

	/*
	 * proctrace is the scheduler's tracing hook, a pointer devproc
	 * set; with no devproc it is nil and tracing is simply off.
	 * addbootfile is how devroot took the embedded boot files, which
	 * a microkernel has no name space to mount, so it ignores them.
	 */
	void (*proctrace)(Proc*, int, vlong) = nil;
	void addbootfile(char *a, uchar *b, ulong c)
	{ USED(a,b,c); }

	/*
	 * The microkernel does not swap.  With no swap device no page is
	 * ever paged out, so releasing or duplicating a swap reference
	 * does nothing and there are no pages to reclaim; these are the
	 * real no-swap behaviour, not a pretence.
	 */
	int needpages(void *a)		{ USED(a); return 0; }
	void kickpager(void)		{ }
	void putswap(Page *a)		{ USED(a); }
	int swapcount(uintptr a)	{ USED(a); return 0; }
	void dupswap(Page *a)		{ USED(a); }
	Image *swapimage = nil;		/* nil: no page is ever the swap image */

	/*
	 * The microkernel has no environment.  An environment is a name
	 * space thing, kept in a library operating system, not the kernel.
	 * ksetenv, newegrp, closeegrp and envcpy are reached only from
	 * init0, rfork and reboot, none of which this boot runs; they are
	 * defensive no-ops so that a kernel process exiting with a nil
	 * egrp, or any stray call, does nothing rather than fault.
	 */
	void ksetenv(char *a, char *b, int c)	{ USED(a,b,c); }
	Egrp *newegrp(void)			{ return nil; }
	void closeegrp(Egrp *a)			{ USED(a); }
	void envcpy(Egrp *a, Egrp *b)		{ USED(a,b); }
	char *getconfenv(void)			{ return nil; }

	/*
	 * The name space, the file syscalls and the process syscalls are
	 * cut from this kernel: pgrp.c, sysfile.c and sysproc.c are not
	 * linked.  A kernel process holds no file group, opens no file
	 * descriptor, mounts nothing and takes no user system call, so the
	 * name-space and syscall entry points below are never reached; a
	 * panic marks it if the assumption ever fails.  The process,
	 * rendezvous and resource-group lifecycle those files used to also
	 * hold now lives in proc.c and is linked.
	 */
	void closefgrp(Fgrp *a)			{ USED(a); panic("microkernel: closefgrp"); }
	Fgrp *dupfgrp(Fgrp *a)			{ USED(a); panic("microkernel: dupfgrp"); return nil; }
	void forceclosefgrp(void)		{ panic("microkernel: forceclosefgrp"); }
	int newfd(Chan *a, int b)		{ USED(a,b); panic("microkernel: newfd"); return -1; }
	Chan *fdtochan(int a, int b, int c, int d){ USED(a,b,c,d); panic("microkernel: fdtochan"); return nil; }
	int openmode(ulong a)			{ USED(a); panic("microkernel: openmode"); return 0; }
	Mount *newmount(Chan *a, int b, char *c){ USED(a,b,c); panic("microkernel: newmount"); return nil; }
	void mountfree(Mount *a)		{ USED(a); panic("microkernel: mountfree"); }
	/*
	 * A note with nowhere to go, and the machine stops.  Say which
	 * process, where it was, and which note before it does: a bare
	 * panic("donotify") names none of the three, and what that costs is
	 * a reproduction cycle per guess - measured, on p9linux, at three
	 * boots and a bisection to learn what one line would have said.
	 */
	int donotify(Ureg *a)
	{
		extern uintptr uregpc(void*);

		panic("microkernel: donotify in %s (pid %lud) at user pc %#p: %s",
			up->text != nil ? up->text : "a task with no name", up->pid, (void*)uregpc(a),
			up->nnote > 0 ? up->note[up->nnote-1]->msg : "a note with no message");
		return 0;
	}
	int dosyscall(ulong a, Sargs *b, uintptr *c){ USED(a,b,c); panic("microkernel: dosyscall"); return 0; }

	/*
	 * chan.c and cache.c, the name resolution and the file cache, are
	 * cut too.  Most of chan.c is name space and is stubbed below as
	 * panics: this kernel resolves no name, clones or closes no
	 * channel, walks no path.  The kernel infrastructure chan.c also
	 * held that is not name space - the reference counting, the string
	 * helpers, the device bring-up main() calls at boot - moved to
	 * kerncore.c and is linked into every configuration.  Only
	 * chandevinit is reproduced here, to drop its one name-space line:
	 * the kproc that drains the channel-close queue, which a kernel
	 * with no channels never fills.
	 */
	void chandevinit(void)
	{
		Dev **d;

		/*
		 * The one line dropped from the shared chandevinit in
		 * kerncore.c: no kproc to drain the channel-close queue,
		 * which a kernel with no channels never fills.  Iterated by
		 * pointer, not devtab[i], so no line begins with "devtab":
		 * see scripts/check-config-portlines.sh.
		 */
		for(d = devtab; *d != nil; d++)
			(*d)->init();
	}

	/*
	 * The name space proper: unreachable in a kernel that resolves no
	 * name, so each is a loud panic.
	 */
	Chan *namec(char *a, int b, int c, ulong d)
	{ USED(a,b,c,d); panic("microkernel: namec"); return nil; }
	Chan *cclone(Chan *a)		{ USED(a); panic("microkernel: cclone"); return nil; }
	void cclose(Chan *a)		{ USED(a); panic("microkernel: cclose"); }
	void ccloseq(Chan *a)		{ USED(a); panic("microkernel: ccloseq"); }
	char *chanpath(Chan *a)		{ USED(a); panic("microkernel: chanpath"); return nil; }
	int eqchantdqid(Chan *a, int b, int c, Qid d, int e)
	{ USED(a,b,c,d,e); panic("microkernel: eqchantdqid"); return 0; }
	void isdir(Chan *a)		{ USED(a); panic("microkernel: isdir"); }
	Chan *newchan(void)		{ panic("microkernel: newchan"); return nil; }
	Path *newpath(char *a)		{ USED(a); panic("microkernel: newpath"); return nil; }
	void pathclose(Path *a)		{ USED(a); panic("microkernel: pathclose"); }
	void putmhead(Mhead *a)		{ USED(a); panic("microkernel: putmhead"); }
	char *validnamedup(char *a, int b){ USED(a,b); panic("microkernel: validnamedup"); return nil; }

	/*
	 * werrstr formatted an error into a user process's error string,
	 * which a kernel process does not have, so it does nothing.  beswal
	 * (the reboot byte swap) and return0 (the sleep predicate) are not
	 * here: they are real in kerncore.c, linked into every config.
	 */
	void werrstr(char *a, ...)		{ USED(a); }

	/*
	 * auth.c and rdb.c are cut: Plan 9 authentication and the remote
	 * kernel debugger.  iseve asked whether the caller is the host
	 * owner; a microkernel has one trust domain, managed by the library
	 * operating system above it, so everyone is, and it returns true.
	 * The host-owner and host-domain writes are console file handlers
	 * this kernel has no name space to reach, so they panic.
	 */
	int iseve(void)				{ return 1; }
	long userwrite(char *a, int n)		{ USED(a,n); panic("microkernel: userwrite"); return 0; }
	long hostownerwrite(char *a, int n)	{ USED(a,n); panic("microkernel: hostownerwrite"); return 0; }
	long hostdomainwrite(char *a, int n)	{ USED(a,n); panic("microkernel: hostdomainwrite"); return 0; }

	/*
	 * The host owner and host domain that auth.c defined, and the
	 * debugger entry that rdb.c did.  eve is nil until userinit sets it
	 * with kstrdup, exactly as auth.c left it: kstrdup frees the old
	 * value, so eve must never point at a string literal.  rdb was the
	 * console's ^T debugger, which devcons still names when it arms
	 * consdebug, so it is a quiet no-op rather than a debugger this
	 * kernel does not carry.
	 */
	char *eve;
	char hostdomain[48];	/* DOMLEN in authsrv.h, not included here */
	void rdb(void)				{ }

