MKSHELL=rc
<../../../mkconfig

CONF=u386
CONFLIST=u386

SYSTARG=Osprey
OBJTYPE=386
objtype=$OBJTYPE
<$ROOT/mkfiles/mkfile-$SYSTARG-$OBJTYPE

FLAVOR=Osprey
FLAVDIR=$ROOT/os/$FLAVOR
TARGDIR=$ROOT/$FLAVOR
PORTDIR=$FLAVDIR/port
IPDIR=$FLAVDIR/ip
BOOTDIR=$FLAVDIR/boot
PCDIR=$FLAVDIR/pc
TARGETLIB=$ROOT/$FLAVOR/$OBJTYPE/lib
PORTLIB=$FLAVDIR/kernlib
DEVCONF=$PORTDIR
INSTALLDIR=$ROOT/$FLAVOR/$OBJTYPE
KERNELSHELL=rc
# The policy directory carries its own lib.h, error.h, portdat.h and
# portfns.h for a future native port, and its headers include one another
# by plain name.  The adapter is therefore compiled with the policy
# directory on the include path and the port directory off it.
POLICYCFLAGS=$CFLAGS -I$FLAVDIR/policy -I$PORTDIR
CFLAGS=$CFLAGS -I$PORTDIR -I$IPDIR
p=9

default:V: $p$CONF

# must match mem.h
KTZERO=0xF0100020
APBOOTSTRAP=0xF0007000
REBOOTADDR=0x11000

DEVS=`{$KERNELSHELL $DEVCONF/mkdevlist $CONF}

# The microkernel drops the name-space, process-group and file cluster;
# the reduced list is chosen by CONF below.  What the remaining port
# code still references from the cut sources is stubbed in upc64's own
# port section.
PORTOBJCUT=pgrp.$O sysfile.$O sysproc.$O syscallfmt.$O chan.$O cache.$O auth.$O rdb.$O
# The Plan 9 personality's image - two megabytes of it - is linked only
# into the configurations that load one.  p9progimg.c holds it and
# p9progstub.c stands in its place elsewhere; p9progimg.c says why.
# No configuration here loads a Plan 9 personality's image, so the stub
# stands in for it always; p9progimg.c says what the two are.
P9PROGOBJ=p9progstub.$O

PORTOBJALL=\
	alarm.$O\
	alloc.$O\
	allocb.$O\
	auth.$O\
	cache.$O\
	chan.$O\
	dev.$O\
	edf.$O\
	fault.$O\
	iomap.$O\
	memmap.$O\
	page.$O\
	parse.$O\
	pgrp.$O\
	portclock.$O\
	print.$O\
	proc.$O\
	qio.$O\
	qlock.$O\
	random.$O\
	rdb.$O\
	rebootcmd.$O\
	segment.$O\
	syscallfmt.$O\
	sysfile.$O\
	sysproc.$O\
	taslock.$O\
	tod.$O\
	xalloc.$O\
	userinit.$O\
	$P9PROGOBJ\
	kerncore.$O\
	ospreyrt.$O\

# Every configuration here is a microkernel one, so the cut is always
# made: the name space, the process groups and the file cluster go.
PORTOBJ=`{for o in $PORTOBJALL; do echo $o; done | grep -vxF -e pgrp.$O -e sysfile.$O -e sysproc.$O -e syscallfmt.$O -e chan.$O -e cache.$O -e auth.$O -e rdb.$O}

OBJ=\
	l.$O\
	cga.$O\
	fpu.$O\
	i8253.$O\
	i8259.$O\
	main.$O\
	memory.$O\
	mmu.$O\
	irq.$O\
	trap.$O\
	bootargs.$O\
	$CONF.root.$O\
	$CONF.rootc.$O\
	$DEVS\
	$PORTOBJ\

LIB=\
	$TARGETLIB/libospreykern.a\
	$TARGETLIB/libaml.a\
	$TARGETLIB/libosprey.a\
	$ROOT/Inferno/$OBJTYPE/lib/libsec.a\
	$ROOT/Inferno/$OBJTYPE/lib/libmp.a\
	$ROOT/Inferno/$OBJTYPE/lib/libfis.a\
	$ROOT/Inferno/$OBJTYPE/lib/libkern.a\

# The libc the two embedded boot programs link against, and nothing
# else: this is not 9front's libc for the object type.  9front's libc
# here carries 9sys, amd64, fmt and port and no 386 machine directory,
# so the whole archive cannot be built for 386 at all; what these two
# programs want was measured instead, by linking them with no libc and
# reading what was undefined.  initcode wants five symbols: bind, open,
# exec and _exits, which are the syscall stubs, and rerrstr - which
# wants errstr, another stub, and utfecpy, which wants memccpy.  Three
# portable files and the stubs.
#
# The amd64 side takes these out of a real libc.a of 263 members; this
# archive holds what is used and says so in its name being the same.  A
# program that needs more will say which symbol, which is how this list
# was arrived at and how it should grow.
LIBCBOOT=bootsys.$O rerrstr.$O utfecpy.$O memccpy.$O
LIBCSRC=$ROOT/9front/src/libc
LIBCINC=-I$ROOT/9front/src/include -I$ROOT/9front/386/include

# The source is named rather than taken from $prereq: every $O in this
# directory also depends on the kernel's headers, so $prereq is the
# source and a dozen .h files, and 8c would be asked to compile those
# too.  These three are compiled with 9front's includes and none of the
# kernel's, the way buildserver.sh compiles the amd64 side.
rerrstr.$O:	$LIBCSRC/9sys/rerrstr.c
	$CC $LIBCINC -o $target $LIBCSRC/9sys/rerrstr.c
utfecpy.$O:	$LIBCSRC/port/utfecpy.c
	$CC $LIBCINC -o $target $LIBCSRC/port/utfecpy.c
memccpy.$O:	$LIBCSRC/port/memccpy.c
	$CC $LIBCINC -o $target $LIBCSRC/port/memccpy.c

$TARGETLIB/libc.a:	$LIBCBOOT
	$AR $ARFLAGS $target $LIBCBOOT

$TARGETLIB/libospreykern.a:V:
	{ cd $PORTLIB; mk install; }

$TARGETLIB/libosprey.a:V:
	{ cd $FLAVDIR/lib; mk install; }

$TARGETLIB/libaml.a:V:
	{ cd $FLAVDIR/libaml; mk install; }

ETHER=`{cd $PCDIR; echo devether.c ether*.c | sed 's/\.c/.'$O'/g'}
AUDIO=`{cd $PCDIR; echo devaudio.c audio*.c | sed 's/\.c/.'$O'/g'}
VGA=`{cd $PCDIR; echo devvga.c screen.c vga*.c | sed 's/\.c/.'$O'/g'}
SDEV=`{cd $PCDIR; echo sd*.c | sed 's/\.c/.'$O'/g'}

$p$CONF:	$OBJ $CONF.$O $LIB
	$LD $LDFLAGS -o $target -T$KTZERO -R4096 -l $prereq
	$KSIZE $target

install:V:	$p$CONF
	cp $p$CONF $INSTALLDIR/

install.%:V:	$p$CONF
	@{
	rfork n
	9fs $stem
	test -e /n/$stem/$p$CONF && cp /n/$stem/$p$CONF /n/$stem/$p$CONF.o
	cp $p$CONF /n/$stem/$p$CONF
	}

# No rules to import the machine layer, where pc64's mkfile has them.
# pc64 keeps its own machine sources and borrows the drivers from this
# directory, so it copies the headers it needs and compiles what it does
# not have locally; here the machine layer IS this directory, the
# default rules compile it, and mkfilelist - which lists what a build
# directory must import and not what it already has - answers with
# nothing at all.  An empty answer makes an empty regular expression,
# which mk reports as "missing operand for", and that is what those
# rules do when the two directories are the same one.

# The three generated .i files, kept as 9front wrote them.  They need
# Plan 9's own aux/na and xd, which this host does not have, so they have
# never been made here and the drivers that want them are in no
# configuration.  They are here because pc64's mkfile says "cd $PCDIR &&
# mk sd53c8xx.i" for them: without a rule of that name in this file, that
# line would find the pattern rule it came from and recur, which is a
# worse answer than "aux/na: not found".
sd53c8xx.i:	sd53c8xx.n
	aux/na $prereq > $target

uartaxp.i:	a100p.cp
	{echo 'static uchar uartaxpcp[] = {'
	 xd -1x $prereq |
		sed -e 's/^[0-9a-f]+ //' -e '/^$/d' -e 's/ ([0-9a-f][0-9a-f])/0x\1,/g'
	 echo '};'
	} > $target

etherm10g%.i:	etherm10g%.fw
	{echo 'static char fw'^$stem^'[] = {'
	 xd -1x $prereq |
		sed -e 's/^[0-9a-f]+ //' -e '/^$/d' -e 's/ ([0-9a-f][0-9a-f])/0x\1,/g'
	 echo '};'
	} > $target

<$BOOTDIR/bootmkfile
<$PORTDIR/portmkfile
<|$KERNELSHELL $PORTDIR/mkbootrules $CONF

l.$O rebootcode.$O apbootstrap.$O:	mem.h

$ETHER: 			$PORTDIR/etherif.h $PORTDIR/netif.h
$AUDIO:				$PORTDIR/audioif.h
ether8003.$O ether8390.$O:	ether8390.h
etheryuk.$O:			yukdump.h
$VGA mouse.$O:			screen.h $TARGDIR/include/memdraw.h
vgavesa.$O:			$TARGDIR/386/include/ureg.h

mp.$O:				mp.h apbootstrap.i
apic.$O squidboy.$O:		mp.h
archmp.$O archacpi.$O:		mp.h

sd53c8xx.$O:			$PCDIR/sd53c8xx.i
$PCDIR/sd53c8xx.i:		$PCDIR/sd53c8xx.n
	cd $PCDIR && mk sd53c8xx.i

etherm10g.$O:			$PCDIR/etherm10g2k.i $PCDIR/etherm10g4k.i
$PCDIR/etherm10g%.i:		$PCDIR/etherm10g%.fw
	cd $PCDIR && mk etherm10g$stem.i

$SDEV pmmc.$O:			$PORTDIR/sd.h
sdiahci.$O:			ahci.h
devaoe.$O sdaoe.$O:		$PORTDIR/aoe.h
sdvirtio10.$O:			$PORTDIR/virtio10.h
main.$O:			rebootcode.i

devusb.$O usbuhci.$O usbohci.$O usbehci.$O usbehcipc.$O usbxhci.$O: $PORTDIR/usb.h
usbehci.$O usbehcipc.$O:	usbehci.h

trap.$O main.$O:		$TARGDIR/include/tos.h

ether8169.$O:			$PORTDIR/ethermii.h
etherdp83820.$O:		$PORTDIR/ethermii.h
etheri225.$O:			$PORTDIR/ethermii.h
etherigbe.$O:			$PORTDIR/ethermii.h
ethervgbe.$O:			$PORTDIR/ethermii.h
ethervt6102.$O:			$PORTDIR/ethermii.h
ethervt6105m.$O:		$PORTDIR/ethermii.h

etherwpi.$O:			$PORTDIR/wifi.h
etherrt2860.$O: 		$PORTDIR/wifi.h

ethervirtio10.$O:		$PORTDIR/virtio10.h

pcipc.$O:	$PORTDIR/pci.h io.h
virtio10pc.$O:	$PORTDIR/virtio10.h

initcode.out:		init9.$O initcode.$O $TARGETLIB/libc.a
	$LD -l -R1 -s -o $target $prereq

# userinit.c embeds the boot programs as .i images; rebuild it when they change.
#
# The Plan 9 personality is two megabytes of them, and only four
# configurations run it.  Carrying it in the other three cost them that
# much of their image for nothing, and it was not free: 9pc64 grew past
# the conventional memory below 8MB that the EFI loader claims its load
# region from, and the loader halted with "the region the kernel links at
# is not free".  So the image is compiled in only where it is used, and
# ospreyloadp9 panics by name in a kernel built without it rather than
# loading a stub.
userinit.$O:	initcode.i userprog.i

p9progimg.$O:	p9prog.i

# userprog.i (the file-server container) and p9prog.i (the Plan 9
# personality) are built by the scripts in cmd/p9: they compile against
# the user headers, add the 9P server and its marshalling, supply the
# libc members the host linker cannot read, and truncate to
# header+text+data.  The generic %.i:D:%.out rule would instead run od
# over a kernel-header build with none of that, so give them explicit
# rules that run the scripts.  init9.$O is the entry a flat-loaded
# program takes (one read-only text segment, no libc data to store into);
# init9prog.$O is the entry a program with a data segment of its own
# takes, which also gives libc its Tos and its private words.
userprog.i:	init9.$O $ROOT/os/osprey/cmd/p9/buildserver.sh \
		$ROOT/os/osprey/cmd/p9/srv9p.c $ROOT/os/osprey/cmd/p9/srv9p.h \
		$ROOT/os/osprey/pc64/userregtorture.s \
		$ROOT/os/osprey/port/userprog.c
	sh $ROOT/os/osprey/cmd/p9/buildserver.sh

p9prog.i:	init9.$O $ROOT/os/osprey/cmd/p9/build.sh \
		$ROOT/os/osprey/cmd/p9/main.c $ROOT/os/osprey/cmd/p9/p9shim.c \
		$ROOT/os/osprey/cmd/p9/dev9ploop.c $ROOT/os/osprey/cmd/p9/ring9p.c $ROOT/os/osprey/cmd/p9/p9pairsrv.c \
		$ROOT/os/osprey/cmd/p9/p9file.c $ROOT/os/osprey/cmd/p9/p9srv.c $ROOT/os/osprey/cmd/p9/p9buddy.c \
		$ROOT/os/osprey/port/devpipe.c $ROOT/os/osprey/port/devsrv.c $ROOT/os/osprey/cmd/p9/nsdat.h $ROOT/os/osprey/cmd/p9/dat.h \
		$ROOT/os/osprey/cmd/p9/p9linuxfile.c linuxprog.i legacyprog.i faultprog.i catprog.i execprog.i shprog.i kbdsrvprog.i drawsrvprog.i rioprog.i prog2.i libcatprog.i libwcprog.i libnsprog.i rioprogp9.i libshprog.i libgenprog.i libdrawprog.i libthreadprog.i relocprog.i $ROOT/os/osprey/cmd/p9/p9exec.c $ROOT/os/osprey/cmd/p9/devtime.c $ROOT/os/osprey/cmd/p9/devnote.c $ROOT/os/osprey/cmd/p9/devinput.c $ROOT/os/osprey/cmd/p9/devdup.c $ROOT/os/osprey/cmd/p9/p9proc.c $ROOT/os/osprey/cmd/p9/p9lib.h $ROOT/os/osprey/cmd/p9/blkvirtio.c $ROOT/os/osprey/cmd/p9/devlfs.c $ROOT/os/osprey/cmd/p9/xcall.s $ROOT/os/osprey/cmd/p9/pipfsrv.c $ROOT/os/osprey/cmd/p9/p9ip.c $ROOT/os/osprey/cmd/p9/p9sched.c $ROOT/os/osprey/cmd/p9/p9kbd.c $ROOT/os/osprey/ip/loopbackmedium.c $ROOT/os/osprey/ip/ospreymedium.c
	sh $ROOT/os/osprey/cmd/p9/build.sh

# The four legacy programs link libc9.a - the C library this tree builds
