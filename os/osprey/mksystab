#!/bin/rc

file=$1

cat <<'!'
#include "sys.h"

typedef uintptr Syscall(va_list);

!

awk '/^#define[ 	]+[A-Z0-9_]+/ {n=$2; if(n=="SYSR1") n="SYSR1"; print "SYS" n}' $file |
	tr A-Z a-z |
	awk '{print "Syscall " $0 ";"}'

cat <<'!'
Syscall	sysdeath;

Syscall *systab[]={
!
sam -d $file >[2] /dev/null <<'!'
,s/#define.([A-Z0-9_]+).*/	[\1]	SYS\1,/g
,x/SYS[A-Z0-9_]+,/ | tr A-Z a-z
,x/SYSsysr1/c/sysr1
,x/SYSsys_x[0-9]*/c/sysdeath
,x v/\[......+\]/ s/\]/]	
,p
!

cat <<'!'
};

char *sysctab[]={
!

sam -d $file >[2] /dev/null <<'!'
,s/#define.([A-Z0-9_]+).*/	[\1]	"\1",/g
,x/"[A-Z0-9_]+",/ y/"[A-Z]/ | tr A-Z a-z
,x/_"/c/"
,x/Sysr1/c/Running
,x/Rendezvous/c/Rendez
,x v/\[......+\]/ s/\]/]	
,p
!

cat <<'!'
};

int nsyscall = (sizeof systab/sizeof systab[0]);
!
