+/*
+ * The host memory buffer (NVMe 1.4, 5.21.1.13).  A drive without DRAM
+ * of its own asks for one (HMPRE, HMMIN) and keeps its mapping tables
+ * in it.  Here the controller keeps a header at the start of each
+ * chunk it is lent -- a magic, the chunk's index and the buffer's
+ * generation -- written when the buffer is given and read back when it
+ * is returned, at a reset, or given again with Memory Return set, when
+ * the host says the contents are as the controller left them.  A host
+ * that writes over memory it has lent the controller is caught there,
+ * as a real drive's tables would be corrupted.  After the buffer is
+ * disabled, or the controller is reset, the controller does not touch
+ * it again.
+ */
+#define NVME_HMB_MAGIC  0x424d48554d4551ULL      /* "QEMUHMB" */
+
+static void nvme_hmb_header(NvmeHmb *h, int i, uint64_t hdr[2])
+{
+    hdr[0] = cpu_to_le64(NVME_HMB_MAGIC);
+    hdr[1] = cpu_to_le64(h->generation << 8 | i);
+}
+
+static void nvme_hmb_stamp(NvmeCtrl *n)
+{
+    NvmeHmb *h = &n->hmb;
+    uint64_t hdr[2];
+    int i;
+
+    for (i = 0; i < h->hmdlec; i++) {
+        nvme_hmb_header(h, i, hdr);
+        pci_dma_write(PCI_DEVICE(n), h->badd[i], hdr, sizeof(hdr));
+    }
+}
+
+/* the chunks whose header is not as the controller wrote it */
+static int nvme_hmb_check(NvmeCtrl *n)
+{
+    NvmeHmb *h = &n->hmb;
+    uint64_t hdr[2], got[2];
+    int i, bad = 0;
+
+    for (i = 0; i < h->hmdlec; i++) {
+        nvme_hmb_header(h, i, hdr);
+        if (pci_dma_read(PCI_DEVICE(n), h->badd[i], got, sizeof(got))) {
+            continue;       /* not reachable now (bus mastering off) */
+        }
+        if (memcmp(hdr, got, sizeof(hdr)) != 0) {
+            qemu_log_mask(LOG_GUEST_ERROR, "nvme: host memory buffer chunk "
+                          "%d at 0x%" PRIx64 " written by the host while "
+                          "lent to the controller\n", i, h->badd[i]);
+            bad++;
+        }
+    }
+    h->corrupt += bad;
+    return bad;
 }
 
+/* the buffer back to the host: checked, then never touched again */
+static void nvme_hmb_release(NvmeCtrl *n)
+{
+    if (!n->hmb.enabled) {
+        return;
+    }
+    nvme_hmb_check(n);
+    n->hmb.enabled = false;
+}
+
+static uint16_t nvme_set_feature_hmb(NvmeCtrl *n, NvmeRequest *req)
+{
+    NvmeCmd *cmd = &req->cmd;
+    uint32_t dw11 = le32_to_cpu(cmd->cdw11);
+    uint32_t hsize = le32_to_cpu(cmd->cdw12);
+    uint64_t hmdla = le32_to_cpu(cmd->cdw13) |
+                     (uint64_t)le32_to_cpu(cmd->cdw14) << 32;
+    uint32_t hmdlec = le32_to_cpu(cmd->cdw15);
+    NvmeHmb *h = &n->hmb, old = n->hmb;
+    uint64_t desc[2 * NVME_HMB_MAX_DESC], total = 0;
+    bool mr = dw11 & 2, same;
+    int i;
+
+    if (!n->params.hmpre) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    if (!(dw11 & 1)) {
+        nvme_hmb_release(n);
+        return NVME_SUCCESS;
+    }
+    if (h->enabled) {
+        return NVME_CMD_SEQ_ERROR | NVME_DNR;
+    }
+    if ((hmdla & 0xf) || hmdlec == 0 || hmdlec > NVME_HMB_MAX_DESC ||
+        (uint64_t)hsize * n->page_size < (uint64_t)n->params.hmmin * 4096) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    if (pci_dma_read(PCI_DEVICE(n), hmdla, desc, 16 * hmdlec)) {
+        return NVME_DATA_TRAS_ERROR;
+    }
+    for (i = 0; i < hmdlec; i++) {
+        uint64_t badd = le64_to_cpu(desc[2 * i]);
+        uint32_t bsize = le32_to_cpu(desc[2 * i + 1] & 0xffffffff);
+
+        if (bsize == 0 || (badd & (n->page_size - 1)) ||
+            (uint64_t)bsize * n->page_size < 4096ULL * n->id_ctrl.hmminds) {
+            return NVME_INVALID_FIELD | NVME_DNR;
+        }
+        h->badd[i] = badd;
+        h->bsize[i] = bsize;
+        total += bsize;
+    }
+    if (total != hsize) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+
+    same = old.hmdlec == hmdlec && old.mps == n->page_size &&
+           memcmp(old.badd, h->badd, hmdlec * sizeof(h->badd[0])) == 0 &&
+           memcmp(old.bsize, h->bsize, hmdlec * sizeof(h->bsize[0])) == 0;
+    h->hsize = hsize;
+    h->hmdla = hmdla;
+    h->hmdlec = hmdlec;
+    h->mps = n->page_size;
+    h->enabled = true;
+    if (mr && same) {
+        /* the memory it had before, which the host says is untouched */
+        nvme_hmb_check(n);
+    } else {
+        h->generation++;
+        nvme_hmb_stamp(n);
+    }
+    return NVME_SUCCESS;
+}
+
+static uint16_t nvme_get_feature_hmb(NvmeCtrl *n, NvmeRequest *req)
+{
+    g_autofree uint32_t *attr = g_malloc0(4096);
+    NvmeHmb *h = &n->hmb;
+
+    if (!n->params.hmpre) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    if (h->enabled) {
+        attr[0] = cpu_to_le32(h->hsize);
+        attr[1] = cpu_to_le32(h->hmdla);
+        attr[2] = cpu_to_le32(h->hmdla >> 32);
+        attr[3] = cpu_to_le32(h->hmdlec);
+    }
+    req->cqe.result = cpu_to_le32(h->enabled ? 1 : 0);
+    return nvme_c2h(n, (uint8_t *)attr, 4096, req);
+}
+
+/*
+ * Power states and autonomous transitions (5.21.1.2, 5.21.1.12).  With
+ * APST the controller, idle for an entry's ITPT, goes to its ITPS, a
+ * non-operational state, and from there on by that state's own entry;
+ * the next command brings it back to the operational state it left.
+ */
+#define NVME_APST_ITPS(e)   (((e) >> 3) & 0x1f)
+#define NVME_APST_ITPT(e)   (((e) >> 8) & 0xffffff)
+
+static bool nvme_ps_nonop(NvmeCtrl *n, int ps)
+{
+    return ps <= n->id_ctrl.npss &&
+           (le16_to_cpu(n->id_ctrl.psd[ps].reserved) >> 8) & 2;
+}
+
+static void nvme_apst_arm(NvmeCtrl *n)
+{
+    uint64_t e = n->features.apst[n->features.ps];
+
+    if (!n->apst_timer) {
+        return;
+    }
+    if (!n->features.apste || NVME_APST_ITPT(e) == 0) {
+        timer_del(n->apst_timer);
+        return;
+    }
+    timer_mod(n->apst_timer, qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) +
+              NVME_APST_ITPT(e));
+}
+
+static void nvme_apst_timer(void *opaque)
+{
+    NvmeCtrl *n = opaque;
+    uint64_t e = n->features.apst[n->features.ps];
+
+    if (!n->features.apste || NVME_APST_ITPT(e) == 0) {
+        return;
+    }
+    n->features.ps = NVME_APST_ITPS(e);
+    n->ps_transitions++;
+    nvme_apst_arm(n);
+}
+
+/* a command: out of a non-operational state, and the idle time anew */
+static void nvme_ps_busy(NvmeCtrl *n)
+{
+    n->features.psarrival = n->features.ps;
+    if (nvme_ps_nonop(n, n->features.ps)) {
+        n->features.ps = n->features.opps;
+        n->ps_transitions++;
+    }
+    nvme_apst_arm(n);
+}
+
+static uint16_t nvme_set_feature_apst(NvmeCtrl *n, NvmeRequest *req)
+{
+    uint32_t dw11 = le32_to_cpu(req->cmd.cdw11);
+    uint64_t tab[32];
+    uint16_t status;
+    int i;
+
+    if (!n->params.apst) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    status = nvme_h2c(n, (uint8_t *)tab, sizeof(tab), req);
+    if (status) {
+        return status;
+    }
+    for (i = 0; i < 32; i++) {
+        uint64_t e = le64_to_cpu(tab[i]);
+
+        /* a transition goes only to a non-operational state there is */
+        if (NVME_APST_ITPT(e) && !nvme_ps_nonop(n, NVME_APST_ITPS(e))) {
+            return NVME_INVALID_FIELD | NVME_DNR;
+        }
+        n->features.apst[i] = e;
+    }
+    n->features.apste = dw11 & 1;
+    nvme_apst_arm(n);
+    return NVME_SUCCESS;
+}
+
+static uint16_t nvme_get_feature_apst(NvmeCtrl *n, NvmeRequest *req)
+{
+    uint64_t tab[32];
+    int i;
+
+    if (!n->params.apst) {
+        return NVME_INVALID_FIELD | NVME_DNR;
+    }
+    for (i = 0; i < 32; i++) {
+        tab[i] = cpu_to_le64(n->features.apst[i]);
+    }
+    req->cqe.result = cpu_to_le32(n->features.apste);
+    return nvme_c2h(n, (uint8_t *)tab, sizeof(tab), req);
+}
