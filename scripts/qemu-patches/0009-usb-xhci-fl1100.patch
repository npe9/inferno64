+ * later.  See the COPYING file in the top-level directory.
+ */
+
+#include "qemu/osdep.h"
+#include "hw/usb.h"
+#include "qemu/module.h"
+#include "hw/pci/pci.h"
+#include "hw/qdev-properties.h"
+
+#include "hcd-xhci-pci.h"
+
+#define TYPE_FL1100_XHCI "fl1100-xhci"
+OBJECT_DECLARE_SIMPLE_TYPE(XHCIFl1100State, FL1100_XHCI)
+
+#define PCI_VENDOR_ID_FRESCO_LOGIC          0x1b73
+#define PCI_DEVICE_ID_FRESCO_LOGIC_FL1100   0x1100
+
+struct XHCIFl1100State {
+    XHCIPciState parent_obj;
+};
+
+static void fl1100_xhci_instance_init(Object *obj)
+{
+    XHCIPciState *pci = XHCI_PCI(obj);
+    XHCIState *x = &pci->xhci;
+
+    x->numports_2 = 4;
+    x->numports_3 = 4;
+    x->numintrs = 8;
+    x->numslots = 32;
+    x->off_runtime = 0x2000;
+    x->off_doorbell = 0x3000;
+    x->hcsparams2 = 0x84000054;
+    x->hcsparams3 = 0x00040001;
+    x->hccparams_or = 1 << 7;           /* NSS */
+    xhci_set_flag(x, XHCI_FLAG_SHORT_AS_SUCCESS);
+
+    pci->layout.pm = 0x40;
+    pci->layout.msi = 0x50;
+    pci->layout.msi_vectors = 8;
+    pci->layout.pcie = 0x70;
+    pci->layout.msix = 0xb0;
+    pci->layout.msix_table_bar = 2;
+    pci->layout.msix_pba_bar = 4;
+}
+
+static void fl1100_xhci_class_init(ObjectClass *klass, const void *data)
+{
+    PCIDeviceClass *k = PCI_DEVICE_CLASS(klass);
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    k->vendor_id = PCI_VENDOR_ID_FRESCO_LOGIC;
+    k->device_id = PCI_DEVICE_ID_FRESCO_LOGIC_FL1100;
+    k->subsystem_vendor_id = PCI_VENDOR_ID_FRESCO_LOGIC;
+    k->subsystem_id = PCI_DEVICE_ID_FRESCO_LOGIC_FL1100;
+    k->revision = 0x00;
+    dc->desc = "Fresco Logic FL1100 USB 3.0 host controller";
+}
+
+static const TypeInfo fl1100_xhci_info = {
+    .name          = TYPE_FL1100_XHCI,
+    .parent        = TYPE_XHCI_PCI,
+    .instance_size = sizeof(XHCIFl1100State),
+    .instance_init = fl1100_xhci_instance_init,
+    .class_init    = fl1100_xhci_class_init,
+};
+
+static void fl1100_xhci_register_types(void)
+{
+    type_register_static(&fl1100_xhci_info);
+}
+
+type_init(fl1100_xhci_register_types)
