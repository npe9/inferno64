+/* where TRB idx of the event ring is, counting across its segments */
+static dma_addr_t xhci_er_addr(XHCIInterrupter *intr, unsigned int idx)
+{
+    uint32_t i;
+
+    if (intr->er_nsegs == 0) {
+        /* one segment, as state migrated from before there were more */
+        return intr->er_start + TRB_SIZE * idx;
+    }
+    for (i = 0; i < intr->er_nsegs; i++) {
+        if (idx < intr->er_seg_size[i]) {
+            return intr->er_seg_start[i] + TRB_SIZE * idx;
+        }
+        idx -= intr->er_seg_size[i];
+    }
+    return intr->er_start;
+}
+
+/* the index of the TRB at erdp, if it is in the ring */
+static bool xhci_er_index(XHCIInterrupter *intr, dma_addr_t erdp,
+                          unsigned int *idx)
+{
+    unsigned int base = 0;
+    uint32_t i;
+
+    if (intr->er_nsegs == 0) {
+        if (erdp < intr->er_start ||
+            erdp >= intr->er_start + TRB_SIZE * intr->er_size) {
+            return false;
+        }
+        *idx = (erdp - intr->er_start) / TRB_SIZE;
+        return true;
+    }
+    for (i = 0; i < intr->er_nsegs; i++) {
+        dma_addr_t s = intr->er_seg_start[i];
+
+        if (erdp >= s && erdp < s + TRB_SIZE * intr->er_seg_size[i]) {
+            *idx = base + (erdp - s) / TRB_SIZE;
+            return true;
+        }
+        base += intr->er_seg_size[i];
+    }
+    return false;
 }
 
