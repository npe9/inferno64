+/*
+ * Scratchpad buffers (xHCI 1.0, 4.20).  A part that asks for them in
+ * HCSPARAMS2 keeps state of its own in them while it runs; here each
+ * page gets a header -- a magic, its index, a generation -- written
+ * when the controller is started and read back when it is stopped,
+ * so that a driver which gave no pages, or wrote over the ones it
+ * gave, is caught.  Like the part, the controller writes where the
+ * driver's array says, whatever is there.
+ */
+#define XHCI_SCRATCH_MAGIC 0x5243534948435851ULL    /* "QXHCISCR" */
+
+static uint32_t xhci_nscratch(XHCIState *xhci)
+{
+    uint32_t p2 = xhci->hcsparams2;
+
+    return MIN(((p2 >> 27) & 0x1f) | ((p2 >> 16) & 0x3e0), XHCI_MAXSCRATCH);
+}
+
+static void xhci_scratch_header(XHCIState *xhci, int i, uint64_t hdr[2])
+{
+    hdr[0] = cpu_to_le64(XHCI_SCRATCH_MAGIC);
+    hdr[1] = cpu_to_le64(xhci->scratch_gen << 8 | i);
+}
+
+static void xhci_scratch_start(XHCIState *xhci)
+{
+    dma_addr_t dcbaap = xhci_addr64(xhci->dcbaap_low, xhci->dcbaap_high);
+    uint64_t sba = 0, hdr[2];
+    uint32_t i, n = xhci_nscratch(xhci);
+
+    xhci->nscratch = 0;
+    if (n == 0) {
+        return;
+    }
+    ldq_le_dma(xhci->as, dcbaap, &sba, MEMTXATTRS_UNSPECIFIED);
+    if (sba == 0 || (sba & 63)) {
+        qemu_log_mask(LOG_GUEST_ERROR, "xhci: %u scratchpad buffers wanted, "
+                      "DCBAA[0] is 0x%" PRIx64 "\n", n, sba);
+    }
+    xhci->scratch_gen++;
+    for (i = 0; i < n; i++) {
+        ldq_le_dma(xhci->as, sba + 8 * i, &xhci->scratch[i],
+                   MEMTXATTRS_UNSPECIFIED);
+        if (xhci->scratch[i] == 0 || (xhci->scratch[i] & 0xfff)) {
+            qemu_log_mask(LOG_GUEST_ERROR, "xhci: scratchpad buffer %u "
+                          "is at 0x%" PRIx64 "\n", i, xhci->scratch[i]);
+        }
+        xhci_scratch_header(xhci, i, hdr);
+        dma_memory_write(xhci->as, xhci->scratch[i], hdr, sizeof(hdr),
+                         MEMTXATTRS_UNSPECIFIED);
+    }
+    xhci->nscratch = n;
+}
+
+static void xhci_scratch_stop(XHCIState *xhci)
+{
+    uint64_t hdr[2], got[2];
+    uint32_t i;
+
+    for (i = 0; i < xhci->nscratch; i++) {
+        xhci_scratch_header(xhci, i, hdr);
+        if (dma_memory_read(xhci->as, xhci->scratch[i], got, sizeof(got),
+                            MEMTXATTRS_UNSPECIFIED) != MEMTX_OK) {
+            continue;
+        }
+        if (memcmp(hdr, got, sizeof(hdr)) != 0) {
+            qemu_log_mask(LOG_GUEST_ERROR, "xhci: scratchpad buffer %u at "
+                          "0x%" PRIx64 " written by the host while the "
+                          "controller ran\n", i, xhci->scratch[i]);
+        }
+    }
+    xhci->nscratch = 0;
 }
 
