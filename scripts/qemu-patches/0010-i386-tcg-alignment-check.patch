+/*
+ * Data and stack references at CPL 3 with CR0.AM and EFLAGS.AC set are
+ * alignment-checked (SDM 6.15, #AC); the AC indexes' TLB entries make
+ * every access through them check (excp_helper.c).  Instruction fetch
+ * is not checked, nor are the implicit supervisor references a CPL 3
+ * instruction makes (descriptor tables), which use a kernel index.
+ */
+static bool x86_ac_checking(CPUX86State *env, unsigned pl)
+{
+    return pl == 3 && (env->hflags & HF_CPL_MASK) == 3 &&
+           (env->hflags & HF_AM_MASK) && (env->eflags & AC_MASK);
+}
