+/*
+ * The 16- and 32-byte forms when every access is alignment-checked
+ * (CR0.AM and EFLAGS.AC at CPL 3, the AC MMU indexes): those that
+ * require alignment check it here and raise #GP, as they do whatever
+ * AC is; those that do not are exempt from #AC, which is for 2, 4 and
+ * 8 byte data (SDM 6.15), so they go unchecked (MO_ATOM_NONE: no
+ * atomicity, so no alignment, for the TLB's check to impose).
+ */
+static MemOp gen_wide_mop(DisasContext *s, MemOp mop, bool align, int bytes)
+{
+    if (!is_mmu_index_ac(s->mem_index)) {
+        return mop | (align ? (bytes == 32 ? MO_ALIGN_32 : MO_ALIGN_16) : 0);
+    }
+    if (align) {
+        gen_helper_check_align(tcg_env, s->A0, tcg_constant_i32(bytes - 1));
+    }
+    return (mop & ~MO_ATOM_MASK) | MO_ATOM_NONE;
+}
