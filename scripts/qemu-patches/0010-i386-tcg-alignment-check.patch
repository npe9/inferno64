+/*
+ * #AC: through the alignment-checking MMU indexes (CR0.AM and EFLAGS.AC
+ * at CPL 3) every 2, 4 and 8 byte access is checked for natural
+ * alignment.  TCG drops atomicity in serial mode, so the TLB's own
+ * check (TLB_CHECK_ALIGNED, which goes by atomicity) cannot see the
+ * accesses translated code makes; they are given MO_ALIGN instead,
+ * and the unaligned-access hook raises #AC for these indexes.  The 16
+ * and 32 byte forms are gen_wide_mop's.
+ */
+static inline MemOp x86_ac_mop(int idx, MemOp mop)
+{
+    MemOp size = mop & MO_SIZE;
+
+    if (is_mmu_index_ac(idx) && size != MO_8 && size <= MO_64 &&
+        !(mop & MO_AMASK)) {
+        return mop | MO_ALIGN;
+    }
+    return mop;
+}
