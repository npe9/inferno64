+/*
+ * If SRRCTL[n].DESCTYPE is 000b, which is its reset value, the 82576
+ * uses the legacy receive descriptor on queue n (82576 datasheet,
+ * 7.1.4).  This was a stub returning false with a TODO, so every
+ * queue was written back in the advanced format, and a driver using
+ * legacy descriptors found the packet length where it looks for the
+ * status byte and never saw Descriptor Done.
+ */
+static inline bool
+igb_rx_use_legacy_descriptor(IGBCore *core, const E1000ERingInfo *r)
+{
+    return igb_rx_queue_desctyp_get(core, r) == 0;
+}
