+    VMXERR_VMLAUNCH_NOT_CLEAR   = 4,
+    VMXERR_VMRESUME_NOT_LAUNCHED = 5,
+    VMXERR_ENTRY_BAD_CONTROLS   = 7,
+    VMXERR_ENTRY_BAD_HOST_STATE = 8,
+    VMXERR_VMPTRLD_BAD_ADDR     = 9,
+    VMXERR_VMPTRLD_VMXON_PTR    = 10,
+    VMXERR_VMPTRLD_BAD_REVISION = 11,
+    VMXERR_UNSUPPORTED_FIELD    = 12,
+    VMXERR_VMWRITE_READ_ONLY    = 13,
+    VMXERR_VMXON_IN_ROOT        = 15,
+    VMXERR_ENTRY_MOV_SS         = 26,
+    VMXERR_INVEPT_INVVPID_OPERAND = 28,
+};
+
+/* interruption information, entry and exit */
+#define VMX_INTR_VALID          (1u << 31)
+#define VMX_INTR_ERROR_VALID    (1u << 11)
+#define VMX_INTR_NMI_UNBLOCK    (1u << 12)
+enum {
+    VMX_INTR_TYPE_EXTERNAL      = 0,
+    VMX_INTR_TYPE_NMI           = 2,
+    VMX_INTR_TYPE_HW_EXCEPTION  = 3,
+    VMX_INTR_TYPE_SW_INTERRUPT  = 4,
+    VMX_INTR_TYPE_PRIV_SW_EXCEPTION = 5,
+    VMX_INTR_TYPE_SW_EXCEPTION  = 6,
+    VMX_INTR_TYPE_OTHER         = 7,
+};
+
+/* guest interruptibility state */
+#define VMX_BLOCKING_STI        (1u << 0)
+#define VMX_BLOCKING_MOV_SS     (1u << 1)
+#define VMX_BLOCKING_SMI        (1u << 2)
+#define VMX_BLOCKING_NMI        (1u << 3)
+
+/* guest activity states */
+enum {
+    VMX_ACTIVITY_ACTIVE         = 0,
+    VMX_ACTIVITY_HLT            = 1,
+    VMX_ACTIVITY_SHUTDOWN       = 2,
+    VMX_ACTIVITY_WAIT_SIPI      = 3,
+};
+
+/* the segment access-rights unusable bit */
+#define VMX_AR_UNUSABLE         (1u << 16)
+
+/* EPT paging-structure entries and EPTP */
+#define VMX_EPT_R               (1ull << 0)
+#define VMX_EPT_W               (1ull << 1)
+#define VMX_EPT_X               (1ull << 2)
+#define VMX_EPT_LARGE           (1ull << 7)
+#define VMX_EPT_ADDR            0x000ffffffffff000ull
+
+/* EPT-violation exit qualification */
+#define VMX_EPTQ_READ           (1ull << 0)
+#define VMX_EPTQ_WRITE          (1ull << 1)
+#define VMX_EPTQ_FETCH          (1ull << 2)
+#define VMX_EPTQ_RWX_SHIFT      3
+#define VMX_EPTQ_GLA_VALID      (1ull << 7)
+#define VMX_EPTQ_GLA_TRANSLATED (1ull << 8)
+/* not architectural: marks a misconfiguration found by the walk */
+#define VMX_EPTQ_MISCONFIG      (1ull << 31)
+
+/* the VMCS region as this implementation lays it out */
+#define VMX_VMCS_REVISION       0x00000012
+#define VMX_VMCS_LAUNCH_STATE   8
+#define VMX_VMCS_FIELDS         16
+
+#endif
