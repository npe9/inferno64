+/*
+ * VMX.  The helpers make the checks, take the VM exits of VMX
+ * non-root operation and set the flags (VMsucceed, VMfail); they read
+ * and write their memory operands themselves, so that nothing is read
+ * or written before those checks, and operand 0's writeback is
+ * skipped.
+ */
+#ifdef CONFIG_USER_ONLY
+static void gen_VMX(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_illegal_opcode(s);
+}
+#define gen_VMXON gen_VMX
+#define gen_VMCLEAR gen_VMX
+#define gen_VMPTRLD gen_VMX
+#define gen_VMPTRST gen_VMX
+#define gen_VMREAD gen_VMX
+#define gen_VMWRITE gen_VMX
+#define gen_INVEPT gen_VMX
+#define gen_INVVPID gen_VMX
+#else
+/*
+ * The VM-exit instruction-information field (SDM tables 28-13 and
+ * 28-15) and the displacement, the exit qualification, of an
+ * instruction whose operand opn is register or memory; reg2 is the
+ * other register operand, or -1.
+ */
+static void gen_vmx_insn_info(DisasContext *s, X86DecodedInsn *decode,
+                              int opn, int reg2)
+{
+    X86DecodedOp *op = &decode->op[opn];
+    uint32_t info = (s->aflag - 1) << 7;
+    int64_t disp = 0;
+
+    if (!GUEST(s)) {
+        return;
+    }
+    if (op->has_ea) {
+        AddressParts *a = &decode->mem;
+
+        info |= a->scale;
+        info |= (s->override >= 0 ? s->override : a->def_seg) << 15;
+        info |= a->index >= 0 ? (a->index & 15) << 18 : 1 << 22;
+        info |= a->base >= 0 ? (a->base & 15) << 23 : 1 << 27;
+        disp = a->disp;
+    } else {
+        info |= 1 << 10 | (op->n & 15) << 3;
+    }
+    if (reg2 >= 0) {
+        info |= (reg2 & 15) << 28;
+    }
+    tcg_gen_st_i32(tcg_constant_i32(info), tcg_env,
+                   offsetof(CPUX86State, vmx_insn_info));
+    tcg_gen_st_i64(tcg_constant_i64(disp), tcg_env,
+                   offsetof(CPUX86State, vmx_insn_disp));
+}
+
+static void gen_vmx_prepare(DisasContext *s, X86DecodedInsn *decode, int reg2)
+{
+    gen_vmx_insn_info(s, decode, 0, reg2);
+    gen_update_cc_op(s);
+    gen_update_eip_cur(s);
+}
+
+static void gen_vmx_done(DisasContext *s, X86DecodedInsn *decode)
+{
+    set_cc_op(s, CC_OP_EFLAGS);
+    decode->op[0].unit = X86_OP_SKIP;
+}
+
+static void gen_VMXON(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_vmx_prepare(s, decode, -1);
+    gen_helper_vmxon(tcg_env, s->A0);
+    gen_vmx_done(s, decode);
+}
+
+static void gen_VMCLEAR(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_vmx_prepare(s, decode, -1);
+    gen_helper_vmclear(tcg_env, s->A0);
+    gen_vmx_done(s, decode);
+}
+
+static void gen_VMPTRLD(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_vmx_prepare(s, decode, -1);
+    gen_helper_vmptrld(tcg_env, s->A0);
+    gen_vmx_done(s, decode);
+}
+
+static void gen_VMPTRST(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_vmx_prepare(s, decode, -1);
+    gen_helper_vmptrst(tcg_env, s->A0);
+    gen_vmx_done(s, decode);
+}
+
+/* VMREAD E, G: T0 is the field */
+static void gen_VMREAD(DisasContext *s, X86DecodedInsn *decode)
+{
+    X86DecodedOp *op = &decode->op[0];
+
+    gen_vmx_prepare(s, decode, decode->op[1].n);
+    gen_helper_vmread(tcg_env, s->T0,
+                      op->has_ea ? s->A0 : tcg_constant_tl(0),
+                      tcg_constant_i32(op->has_ea ? -1 : op->n));
+    gen_vmx_done(s, decode);
+}
+
+/* VMWRITE G, E: T0 is the field */
+static void gen_VMWRITE(DisasContext *s, X86DecodedInsn *decode)
+{
+    X86DecodedOp *op = &decode->op[0];
+
+    gen_vmx_prepare(s, decode, decode->op[1].n);
+    gen_helper_vmwrite(tcg_env, s->T0,
+                       op->has_ea ? s->A0 : cpu_regs[op->n],
+                       tcg_constant_i32(op->has_ea));
+    gen_vmx_done(s, decode);
+}
+
+/* INVEPT and INVVPID G, M: T0 is the type */
+static void gen_INVEPT(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_vmx_prepare(s, decode, decode->op[1].n);
+    gen_helper_invept(tcg_env, s->T0, s->A0);
+    gen_vmx_done(s, decode);
+}
+
+static void gen_INVVPID(DisasContext *s, X86DecodedInsn *decode)
+{
+    gen_vmx_prepare(s, decode, decode->op[1].n);
+    gen_helper_invvpid(tcg_env, s->T0, s->A0);
+    gen_vmx_done(s, decode);
+}
