+/*
+ * The highest index (bits 9:1 of an encoding) of any supported field,
+ * as IA32_VMX_VMCS_ENUM reports it: VMCS_GUEST_SYSENTER_CS, 0x482a.
+ */
+#define VMX_VMCS_ENUM   0x2a
+
+/* encoding -> slot in env->vmx_field[], -1 if not supported */
+static int16_t vmcs_slot[0x8000];
+
+static void __attribute__((constructor)) vmx_init_slots(void)
+{
+    int i;
+
+    QEMU_BUILD_BUG_ON(ARRAY_SIZE(vmcs_encodings) != VMX_NFIELDS);
+    QEMU_BUILD_BUG_ON(VMX_VMCS_FIELDS + 8 * VMX_NFIELDS > 4096);
+    for (i = 0; i < ARRAY_SIZE(vmcs_slot); i++) {
+        vmcs_slot[i] = -1;
+    }
+    for (i = 0; i < VMX_NFIELDS; i++) {
+        uint16_t enc = vmcs_encodings[i];
+
+        vmcs_slot[enc] = i;
+        /* a 64-bit field's high half has an encoding of its own */
+        if (((enc >> 13) & 3) == 1) {
+            vmcs_slot[enc | 1] = i;
+        }
+    }
+}
+
+enum { VMCS_W16, VMCS_W64, VMCS_W32, VMCS_WNAT };
+
+static inline int vmcs_width(uint32_t enc)
+{
+    return (enc >> 13) & 3;
+}
+
+static int vmcs_lookup(uint32_t enc)
+{
+    /* bits 31:15 and 12 are reserved; set, the field is unsupported */
+    if (enc & 0xffff9000) {
+        return -1;
+    }
+    return vmcs_slot[enc];
+}
+
+/* the cached current VMCS; the field must be supported, full access */
+static uint64_t vmcs_get(CPUX86State *env, uint32_t enc)
+{
+    int slot = vmcs_slot[enc];
+
+    assert(slot >= 0 && !(enc & 1));
+    return env->vmx_field[slot];
+}
+
+static void vmcs_set(CPUX86State *env, uint32_t enc, uint64_t val)
+{
+    int slot = vmcs_slot[enc];
+
+    assert(slot >= 0 && !(enc & 1));
+    switch (vmcs_width(enc)) {
+    case VMCS_W16:
+        val &= 0xffff;
+        break;
+    case VMCS_W32:
+        val &= 0xffffffff;
+        break;
+    }
+    env->vmx_field[slot] = val;
+}
+
+/* write the current VMCS back to its region */
+static void vmx_flush_vmcs(CPUX86State *env)
+{
+    CPUState *cs = env_cpu(env);
+    hwaddr p = env->vmx_vmcs_ptr;
+    int i;
+
+    if (!env->vmx_vmcs_valid) {
+        return;
+    }
+    for (i = 0; i < VMX_NFIELDS; i++) {
+        x86_stq_phys(cs, p + VMX_VMCS_FIELDS + 8 * i, env->vmx_field[i]);
+    }
+    x86_stl_phys(cs, p + VMX_VMCS_LAUNCH_STATE, env->vmx_launched);
+}
+
+static void vmx_load_vmcs(CPUX86State *env, hwaddr p)
+{
+    CPUState *cs = env_cpu(env);
+    int i;
+
+    for (i = 0; i < VMX_NFIELDS; i++) {
+        env->vmx_field[i] = x86_ldq_phys(cs, p + VMX_VMCS_FIELDS + 8 * i);
+    }
+    env->vmx_launched = x86_ldl_phys(cs, p + VMX_VMCS_LAUNCH_STATE) == 1;
+    env->vmx_vmcs_ptr = p;
+    env->vmx_vmcs_valid = true;
+}
+
+/*
+ * Capability MSRs.  A control is advertised as allowed to be 1 when
+ * its feature bit (the "vmx-*" properties, FEAT_VMX_*) is set, which
+ * for TCG is limited to what this file implements (cpu.c's
+ * tcg_features); default-1 controls are allowed 0 only by the TRUE
+ * MSRs, as KVM's make_vmx_msr_value() does it.
+ */
+enum {
+    VMX_PIN_DEFAULT1 = 0x00000016,
+    VMX_PROC_DEFAULT1 = 0x0401e172,
+    VMX_EXIT_DEFAULT1 = 0x00036dff,
+    VMX_ENTRY_DEFAULT1 = 0x000011ff,
+};
+
+static uint64_t vmx_ctl_msr(uint32_t default1, uint32_t features, bool true_msr)
+{
+    uint32_t can1 = features | default1;
+    uint32_t must1 = true_msr ? default1 & ~features : default1;
+
+    return must1 | ((uint64_t)can1 << 32);
+}
+
+static uint32_t vmx_exit_features(CPUX86State *env)
+{
+    uint32_t f = env->features[FEAT_VMX_EXIT_CTLS];
+
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_LM) {
+        f |= VMX_VM_EXIT_HOST_ADDR_SPACE_SIZE;
+    }
+    return f;
+}
+
+static uint32_t vmx_entry_features(CPUX86State *env)
+{
+    uint32_t f = env->features[FEAT_VMX_ENTRY_CTLS];
+
+    if (!(env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_LM)) {
+        f &= ~VMX_VM_ENTRY_IA32E_MODE;
+    }
+    return f;
+}
+
+static bool vmx_has_secondary(CPUX86State *env)
+{
+    return env->features[FEAT_VMX_PROCBASED_CTLS] &
+           VMX_CPU_BASED_ACTIVATE_SECONDARY_CONTROLS;
+}
+
+static uint32_t vmx_secondary_features(CPUX86State *env)
+{
+    return vmx_has_secondary(env) ? env->features[FEAT_VMX_SECONDARY_CTLS] : 0;
+}
+
+static uint64_t vmx_cr0_fixed0(void)
+{
+    return CR0_PE_MASK | CR0_NE_MASK | CR0_PG_MASK;
+}
+
+static uint64_t vmx_cr4_fixed1(CPUX86State *env)
+{
+    return (uint32_t)~cr4_reserved_bits(env);
+}
+
+static uint64_t vmx_ept_vpid_cap(CPUX86State *env)
+{
+    uint64_t v = env->features[FEAT_VMX_EPT_VPID_CAPS];
+
+    if (vmx_secondary_features(env) & VMX_SECONDARY_EXEC_ENABLE_EPT) {
+        v |= MSR_VMX_EPT_UC | MSR_VMX_EPT_WB;
+    } else {
+        v &= ~0xffffffffull;
+    }
+    if (!(vmx_secondary_features(env) & VMX_SECONDARY_EXEC_ENABLE_VPID)) {
+        v &= 0xffffffffull;
+    }
+    return v;
+}
+
+bool vmx_cap_msr(CPUX86State *env, uint32_t idx, uint64_t *val)
+{
+    if (!(env->features[FEAT_1_ECX] & CPUID_EXT_VMX)) {
+        return false;
+    }
+    switch (idx) {
+    case MSR_IA32_VMX_BASIC:
+        *val = VMX_VMCS_REVISION | (4096ull << 32) | (6ull << 50) |
+               (env->features[FEAT_VMX_BASIC] & MSR_VMX_BASIC_TRUE_CTLS);
+        return true;
+    case MSR_IA32_VMX_PINBASED_CTLS:
+    case MSR_IA32_VMX_TRUE_PINBASED_CTLS:
+        *val = vmx_ctl_msr(VMX_PIN_DEFAULT1,
+                           env->features[FEAT_VMX_PINBASED_CTLS],
+                           idx == MSR_IA32_VMX_TRUE_PINBASED_CTLS);
+        return true;
+    case MSR_IA32_VMX_PROCBASED_CTLS:
+    case MSR_IA32_VMX_TRUE_PROCBASED_CTLS:
+        *val = vmx_ctl_msr(VMX_PROC_DEFAULT1,
+                           env->features[FEAT_VMX_PROCBASED_CTLS],
+                           idx == MSR_IA32_VMX_TRUE_PROCBASED_CTLS);
+        return true;
+    case MSR_IA32_VMX_EXIT_CTLS:
+    case MSR_IA32_VMX_TRUE_EXIT_CTLS:
+        *val = vmx_ctl_msr(VMX_EXIT_DEFAULT1, vmx_exit_features(env),
+                           idx == MSR_IA32_VMX_TRUE_EXIT_CTLS);
+        return true;
+    case MSR_IA32_VMX_ENTRY_CTLS:
+    case MSR_IA32_VMX_TRUE_ENTRY_CTLS:
+        *val = vmx_ctl_msr(VMX_ENTRY_DEFAULT1, vmx_entry_features(env),
+                           idx == MSR_IA32_VMX_TRUE_ENTRY_CTLS);
+        return true;
+    case MSR_IA32_VMX_MISC:
+        /* four CR3-target values; the MSR lists may hold 512 entries */
+        *val = env->features[FEAT_VMX_MISC] | (4ull << 16);
+        return true;
+    case MSR_IA32_VMX_CR0_FIXED0:
+        *val = vmx_cr0_fixed0();
+        return true;
+    case MSR_IA32_VMX_CR0_FIXED1:
+        *val = 0xffffffff;
+        return true;
+    case MSR_IA32_VMX_CR4_FIXED0:
+        *val = CR4_VMXE_MASK;
+        return true;
+    case MSR_IA32_VMX_CR4_FIXED1:
+        *val = vmx_cr4_fixed1(env);
+        return true;
+    case MSR_IA32_VMX_VMCS_ENUM:
+        *val = VMX_VMCS_ENUM;
+        return true;
+    case MSR_IA32_VMX_PROCBASED_CTLS2:
+        if (!vmx_has_secondary(env)) {
+            return false;
+        }
+        *val = vmx_ctl_msr(0, vmx_secondary_features(env), true);
+        return true;
+    case MSR_IA32_VMX_EPT_VPID_CAP:
+        if (!(vmx_secondary_features(env) & (VMX_SECONDARY_EXEC_ENABLE_EPT |
+                                            VMX_SECONDARY_EXEC_ENABLE_VPID))) {
+            return false;
+        }
+        *val = vmx_ept_vpid_cap(env);
+        return true;
+    }
+    return false;
+}
+
+/* the allowed settings of a control, from its TRUE capability MSR */
+static bool vmx_ctl_ok(CPUX86State *env, uint32_t msr, uint32_t ctl)
+{
+    uint64_t cap = 0;
+
+    if (!vmx_cap_msr(env, msr, &cap)) {
+        return ctl == 0;
+    }
+    return (ctl & (uint32_t)cap) == (uint32_t)cap &&
+           (ctl & ~(uint32_t)(cap >> 32)) == 0;
+}
+
+/* VMsucceed, VMfailInvalid, VMfailValid(err) */
+static void vmx_succeed(CPUX86State *env)
+{
+    CC_SRC = 0;
+    CC_OP = CC_OP_EFLAGS;
+}
+
+static void vmx_fail_invalid(CPUX86State *env)
+{
+    CC_SRC = CC_C;
+    CC_OP = CC_OP_EFLAGS;
+}
+
+static void vmx_fail(CPUX86State *env, uint32_t err)
+{
+    if (!env->vmx_vmcs_valid) {
+        vmx_fail_invalid(env);
+        return;
+    }
+    vmcs_set(env, VMCS_INSN_ERROR, err);
+    CC_SRC = CC_Z;
+    CC_OP = CC_OP_EFLAGS;
+}
+
+static bool vmx_bad_phys(CPUX86State *env, uint64_t a)
+{
+    return a >> env_archcpu(env)->phys_bits;
+}
+
+static bool vmx_bad_page(CPUX86State *env, uint64_t a)
+{
+    return (a & 0xfff) || vmx_bad_phys(env, a);
+}
+
+static bool vmx_canonical(CPUX86State *env, uint64_t a)
+{
+    int bits = cpu_x86_virtual_addr_width(env);
+
+    return (int64_t)(a << (64 - bits)) >> (64 - bits) == (int64_t)a;
+}
+
+/* the EFER bits this processor has, as WRMSR allows them, and LMA */
+static uint64_t vmx_efer_valid(CPUX86State *env)
+{
+    uint64_t v = 0;
+
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_SYSCALL) {
+        v |= MSR_EFER_SCE;
+    }
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_LM) {
+        v |= MSR_EFER_LME | MSR_EFER_LMA;
+    }
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_NX) {
+        v |= MSR_EFER_NXE;
+    }
+    if (env->features[FEAT_8000_0001_ECX] & CPUID_EXT3_SVM) {
+        v |= MSR_EFER_SVME;
+    }
+    if (env->features[FEAT_8000_0001_EDX] & CPUID_EXT2_FFXSR) {
+        v |= MSR_EFER_FFXSR;
+    }
+    return v;
+}
+
+static bool vmx_long_mode(CPUX86State *env)
+{
+    return env->hflags & HF_LMA_MASK;
+}
+
+/*
+ * Exits.  vmx_vmexit() records why and leaves the instruction, as
+ * cpu_vmexit() does for SVM; vmx_do_vmexit() is the switch itself,
+ * run from the main loop (x86_cpu_do_interrupt, EXCP_VMEXIT).
+ */
+G_NORETURN static void vmx_exit(CPUX86State *env, uint32_t reason,
+                                uint64_t qual, bool insn, uintptr_t ra)
+{
+    CPUState *cs = env_cpu(env);
+
+    if (ra) {
+        cpu_restore_state(cs, ra);
+    }
+    qemu_log_mask(CPU_LOG_INT, "vmx: exit %u qual %#" PRIx64 " rip "
+                  TARGET_FMT_lx "\n", reason, qual, env->eip);
+    env->vmx_exit_reason = reason;
+    env->vmx_exit_qual = qual;
+    env->vmx_exit_insn = insn;
+    cs->exception_index = EXCP_VMEXIT;
+    env->old_exception = -1;
+    cpu_loop_exit(cs);
+}
+
+G_NORETURN void vmx_vmexit(CPUX86State *env, uint32_t reason, uint64_t qual,
+                           uintptr_t ra)
+{
+    env->vmx_exit_intr_info = 0;
+    vmx_exit(env, reason, qual, false, ra);
+}
+
+/* an exit caused by an instruction: its length and information are reported */
+G_NORETURN static void vmx_exit_insn(CPUX86State *env, uint32_t reason,
+                                     uint64_t qual, uintptr_t ra)
+{
+    env->vmx_exit_intr_info = 0;
+    vmx_exit(env, reason, qual, true, ra);
+}
+
+/* an exit for an exception or NMI, with its interruption information */
+G_NORETURN static void vmx_exit_event(CPUX86State *env, int vec, int type,
+                                      bool has_err, uint32_t err,
+                                      uint64_t qual, uintptr_t ra)
+{
+    env->vmx_exit_intr_info = VMX_INTR_VALID | (type << 8) | vec |
+                              (has_err ? VMX_INTR_ERROR_VALID : 0);
+    env->vmx_exit_intr_err = err;
+    vmx_exit(env, VMX_EXIT_EXCEPTION_NMI, qual,
+             type == VMX_INTR_TYPE_SW_EXCEPTION ||
+             type == VMX_INTR_TYPE_PRIV_SW_EXCEPTION, ra);
+}
+
+/*
+ * #UD and #GP as every VMX instruction checks them, and the exit each
+ * causes in VMX non-root operation.
+ */
+static void vmx_insn_check(CPUX86State *env, uint32_t reason, uintptr_t ra)
+{
+    if (!env->vmx_on || !(env->cr[0] & CR0_PE_MASK) ||
+        (env->eflags & VM_MASK) ||
+        (vmx_long_mode(env) && !(env->hflags & HF_CS64_MASK))) {
+        raise_exception_ra(env, EXCP06_ILLOP, ra);
+    }
+    if (env->vmx_nonroot) {
+        vmx_exit_insn(env, reason, env->vmx_insn_disp, ra);
+    }
+    if (env->hflags & HF_CPL_MASK) {
+        raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+    }
+}
+
+static uint64_t vmx_read_operand(CPUX86State *env, target_ulong addr,
+                                 uintptr_t ra)
+{
+    return cpu_ldq_data_ra(env, addr, ra);
+}
+
+void helper_vmxon(CPUX86State *env, target_ulong addr)
+{
+    CPUState *cs = env_cpu(env);
+    uintptr_t ra = GETPC();
+    uint64_t ptr;
+    uint32_t rev;
+
+    if (!(env->cr[4] & CR4_VMXE_MASK) || !(env->cr[0] & CR0_PE_MASK) ||
+        (env->eflags & VM_MASK) ||
+        (vmx_long_mode(env) && !(env->hflags & HF_CS64_MASK))) {
+        raise_exception_ra(env, EXCP06_ILLOP, ra);
+    }
+    if (env->vmx_nonroot) {
+        vmx_exit_insn(env, VMX_EXIT_VMXON, env->vmx_insn_disp, ra);
+    }
+    if (env->hflags & HF_CPL_MASK) {
+        raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+    }
+    if (env->vmx_on) {
+        vmx_fail(env, VMXERR_VMXON_IN_ROOT);
+        return;
+    }
+    if ((env->cr[0] & vmx_cr0_fixed0()) != vmx_cr0_fixed0() ||
+        (env->cr[4] & ~vmx_cr4_fixed1(env)) ||
+        (env->msr_ia32_feature_control & 5) != 5 ||
+        (env->hflags & HF_SMM_MASK)) {
+        raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+    }
+    ptr = vmx_read_operand(env, addr, ra);
+    if (vmx_bad_page(env, ptr)) {
+        vmx_fail_invalid(env);
+        return;
+    }
+    rev = x86_ldl_phys(cs, ptr);
+    if (rev != VMX_VMCS_REVISION) {
+        vmx_fail_invalid(env);
+        return;
+    }
+    env->vmx_on = true;
+    env->vmx_vmxon_ptr = ptr;
+    env->vmx_vmcs_valid = false;
+    vmx_succeed(env);
+}
+
+void helper_vmxoff(CPUX86State *env)
+{
+    uintptr_t ra = GETPC();
+
+    vmx_insn_check(env, VMX_EXIT_VMXOFF, ra);
+    vmx_flush_vmcs(env);
+    env->vmx_on = false;
+    env->vmx_vmcs_valid = false;
+    if (env->vmx_init_latched) {
+        env->vmx_init_latched = false;
+        bql_lock();
+        cpu_interrupt(env_cpu(env), CPU_INTERRUPT_INIT);
+        bql_unlock();
+    }
+    vmx_succeed(env);
+}
+
+void helper_vmclear(CPUX86State *env, target_ulong addr)
+{
+    uintptr_t ra = GETPC();
+    uint64_t ptr;
+
+    vmx_insn_check(env, VMX_EXIT_VMCLEAR, ra);
+    ptr = vmx_read_operand(env, addr, ra);
+    if (vmx_bad_page(env, ptr)) {
+        vmx_fail(env, VMXERR_VMCLEAR_BAD_ADDR);
+        return;
+    }
+    if (ptr == env->vmx_vmxon_ptr) {
+        vmx_fail(env, VMXERR_VMCLEAR_VMXON_PTR);
+        return;
+    }
+    if (env->vmx_vmcs_valid && env->vmx_vmcs_ptr == ptr) {
+        env->vmx_launched = false;
+        vmx_flush_vmcs(env);
+        env->vmx_vmcs_valid = false;
+    } else {
+        x86_stl_phys(env_cpu(env), ptr + VMX_VMCS_LAUNCH_STATE, 0);
+    }
+    vmx_succeed(env);
+}
+
+void helper_vmptrld(CPUX86State *env, target_ulong addr)
+{
+    uintptr_t ra = GETPC();
+    uint64_t ptr;
+
+    vmx_insn_check(env, VMX_EXIT_VMPTRLD, ra);
+    ptr = vmx_read_operand(env, addr, ra);
+    if (vmx_bad_page(env, ptr)) {
+        vmx_fail(env, VMXERR_VMPTRLD_BAD_ADDR);
+        return;
+    }
+    if (ptr == env->vmx_vmxon_ptr) {
+        vmx_fail(env, VMXERR_VMPTRLD_VMXON_PTR);
+        return;
+    }
+    if (x86_ldl_phys(env_cpu(env), ptr) != VMX_VMCS_REVISION) {
+        vmx_fail(env, VMXERR_VMPTRLD_BAD_REVISION);
+        return;
+    }
+    if (!env->vmx_vmcs_valid || env->vmx_vmcs_ptr != ptr) {
+        vmx_flush_vmcs(env);
+        vmx_load_vmcs(env, ptr);
+    }
+    vmx_succeed(env);
+}
+
+void helper_vmptrst(CPUX86State *env, target_ulong addr)
+{
+    uintptr_t ra = GETPC();
+
+    vmx_insn_check(env, VMX_EXIT_VMPTRST, ra);
+    cpu_stq_data_ra(env, addr,
+                    env->vmx_vmcs_valid ? env->vmx_vmcs_ptr : ~0ull, ra);
+    vmx_succeed(env);
+}
+
+/*
+ * VMREAD to a register (reg >= 0) or to memory at addr; the operand
+ * is 64 bits in 64-bit mode and 32 bits otherwise.  On failure the
+ * destination is left alone, so it is written here.
+ */
+void helper_vmread(CPUX86State *env, target_ulong field, target_ulong addr,
+                   int reg)
+{
+    uintptr_t ra = GETPC();
+    bool op64 = env->hflags & HF_CS64_MASK;
+    uint64_t val;
+    int slot;
+
+    vmx_insn_check(env, VMX_EXIT_VMREAD, ra);
+    if (!env->vmx_vmcs_valid) {
+        vmx_fail_invalid(env);
+        return;
+    }
+    if (!op64) {
+        field = (uint32_t)field;
+    }
+    slot = field > 0xffffffffull ? -1 : vmcs_lookup(field);
+    if (slot < 0) {
+        vmx_fail(env, VMXERR_UNSUPPORTED_FIELD);
+        return;
+    }
+    val = env->vmx_field[slot];
+    if (field & 1) {
+        val >>= 32;
+    }
+    if (reg >= 0) {
+        env->regs[reg] = op64 ? val : (uint32_t)val;
+    } else if (op64) {
+        cpu_stq_data_ra(env, addr, val, ra);
+    } else {
+        cpu_stl_data_ra(env, addr, val, ra);
+    }
+    vmx_succeed(env);
+}
+
+/*
+ * VMWRITE from a register (mem 0, val its value) or from memory (mem
+ * 1, val the address), read here so that the checks come first.
+ */
+void helper_vmwrite(CPUX86State *env, target_ulong field, target_ulong val,
+                    int mem)
+{
+    uintptr_t ra = GETPC();
+    bool op64 = env->hflags & HF_CS64_MASK;
+    int slot;
+
+    vmx_insn_check(env, VMX_EXIT_VMWRITE, ra);
+    if (mem) {
+        val = op64 ? cpu_ldq_data_ra(env, val, ra) :
+                     cpu_ldl_data_ra(env, val, ra);
+    }
+    if (!env->vmx_vmcs_valid) {
+        vmx_fail_invalid(env);
+        return;
+    }
+    if (!op64) {
+        field = (uint32_t)field;
+        val = (uint32_t)val;
+    }
+    slot = field > 0xffffffffull ? -1 : vmcs_lookup(field);
+    if (slot < 0) {
+        vmx_fail(env, VMXERR_UNSUPPORTED_FIELD);
+        return;
+    }
+    if (((field >> 10) & 3) == 1) {
+        vmx_fail(env, VMXERR_VMWRITE_READ_ONLY);
+        return;
+    }
+    if (field & 1) {
+        env->vmx_field[slot] = (uint32_t)env->vmx_field[slot] |
+                               ((uint64_t)(uint32_t)val << 32);
+    } else {
+        vmcs_set(env, field, val);
+    }
+    vmx_succeed(env);
+}
+
+void helper_vmcall(CPUX86State *env)
+{
+    uintptr_t ra = GETPC();
+
+    if (env->vmx_nonroot) {
+        vmx_exit_insn(env, VMX_EXIT_VMCALL, 0, ra);
+    }
+    if (!env->vmx_on) {
+        raise_exception_ra(env, EXCP06_ILLOP, ra);
+    }
+    if (env->hflags & HF_CPL_MASK) {
+        raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+    }
+    /* no dual-monitor treatment: VMCALL in VMX root operation fails */
+    vmx_fail(env, VMXERR_VMCALL_ROOT);
+}
+
+static bool vmx_eptp_ok(CPUX86State *env, uint64_t eptp)
+{
+    uint64_t cap = vmx_ept_vpid_cap(env);
+
+    switch (eptp & 7) {
+    case 0:
+        if (!(cap & MSR_VMX_EPT_UC)) {
+            return false;
+        }
+        break;
+    case 6:
+        if (!(cap & MSR_VMX_EPT_WB)) {
+            return false;
+        }
+        break;
+    default:
+        return false;
+    }
+    if (((eptp >> 3) & 7) != 3) {
+        return false;
+    }
+    if (eptp & (1 << 6) && !(cap & MSR_VMX_EPT_AD_BITS)) {
+        return false;
+    }
+    return !(eptp & 0xf80) && !vmx_bad_phys(env, eptp);
+}
+
+void helper_invept(CPUX86State *env, target_ulong type, target_ulong addr)
+{
+    uintptr_t ra = GETPC();
+    uint64_t cap = vmx_ept_vpid_cap(env);
+    uint64_t eptp, rsvd;
+
+    if (!(cap & MSR_VMX_EPT_INVEPT)) {
+        raise_exception_ra(env, EXCP06_ILLOP, ra);
+    }
+    vmx_insn_check(env, VMX_EXIT_INVEPT, ra);
+    if (!(env->hflags & HF_CS64_MASK)) {
+        type = (uint32_t)type;
+    }
+    eptp = cpu_ldq_data_ra(env, addr, ra);
+    rsvd = cpu_ldq_data_ra(env, addr + 8, ra);
+    switch (type) {
+    case 1:
+        if (!(cap & MSR_VMX_EPT_INVEPT_SINGLE_CONTEXT) ||
+            !vmx_eptp_ok(env, eptp)) {
+            vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+            return;
+        }
+        break;
+    case 2:
+        if (!(cap & MSR_VMX_EPT_INVEPT_ALL_CONTEXT)) {
+            vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+            return;
+        }
+        break;
+    default:
+        vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+        return;
+    }
+    (void)rsvd;
+    /*
+     * The guest-physical mappings this processor holds are its TLB
+     * entries for the nested (EPT) index and every guest entry
+     * combined with them.
+     */
+    tlb_flush(env_cpu(env));
+    vmx_succeed(env);
+}
+
+void helper_invvpid(CPUX86State *env, target_ulong type, target_ulong addr)
+{
+    uintptr_t ra = GETPC();
+    uint64_t cap = vmx_ept_vpid_cap(env);
+    uint64_t lo, la;
+    uint16_t vpid;
+
+    if (!(cap & MSR_VMX_EPT_INVVPID)) {
+        raise_exception_ra(env, EXCP06_ILLOP, ra);
+    }
+    vmx_insn_check(env, VMX_EXIT_INVVPID, ra);
+    if (!(env->hflags & HF_CS64_MASK)) {
+        type = (uint32_t)type;
+    }
+    lo = cpu_ldq_data_ra(env, addr, ra);
+    la = cpu_ldq_data_ra(env, addr + 8, ra);
+    if (lo >> 16) {
+        vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+        return;
+    }
+    vpid = lo;
+    switch (type) {
+    case 0:
+        if (!(cap & MSR_VMX_EPT_INVVPID_SINGLE_ADDR) || vpid == 0 ||
+            !vmx_canonical(env, la)) {
+            vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+            return;
+        }
+        break;
+    case 1:
+        if (!(cap & MSR_VMX_EPT_INVVPID_SINGLE_CONTEXT) || vpid == 0) {
+            vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+            return;
+        }
+        break;
+    case 2:
+        if (!(cap & MSR_VMX_EPT_INVVPID_ALL_CONTEXT)) {
+            vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+            return;
+        }
+        break;
+    case 3:
+        if (!(cap & MSR_VMX_EPT_INVVPID_SINGLE_CONTEXT_NOGLOBALS) ||
+            vpid == 0) {
+            vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+            return;
+        }
+        break;
+    default:
+        vmx_fail(env, VMXERR_INVEPT_INVVPID_OPERAND);
+        return;
+    }
+    /*
+     * Mappings are not kept per VPID: every entry and exit flushes the
+     * TLB, so all that is left to invalidate is what this side holds.
+     */
+    tlb_flush(env_cpu(env));
+    vmx_succeed(env);
+}
+
+/*
+ * Segment access rights <-> the descriptor flags QEMU keeps.  An
+ * unusable segment is kept not present; its other attributes are
+ * kept, SS.DPL among them, which is the CPL.
+ */
+static uint32_t vmx_ar_from_flags(uint32_t flags)
+{
+    uint32_t ar = ((flags >> 8) & 0xff) | ((flags >> 8) & 0xf000);
+
+    if (!(flags & DESC_P_MASK)) {
+        ar |= VMX_AR_UNUSABLE;
+    }
+    return ar;
+}
+
+static uint32_t vmx_flags_from_ar(uint32_t ar)
+{
+    uint32_t flags = ((ar & 0xff) << 8) | ((ar & 0xf000) << 8);
+
+    if (ar & VMX_AR_UNUSABLE) {
+        flags &= ~DESC_P_MASK;
+    }
+    return flags;
+}
+
+static bool vmx_limit_ar_ok(uint32_t limit, uint32_t ar)
+{
+    if (ar & 0xfffe0f00) {
+        return false;
+    }
+    if (ar & (1 << 15)) {
+        return (limit & 0xfff) == 0xfff;
+    }
+    return (limit & 0xfff00000) == 0;
+}
+
+static bool vmx_pdptes_ok(CPUX86State *env, const uint64_t *pdpte)
+{
+    uint64_t rsvd = 0x1e6 | ~MAKE_64BIT_MASK(0, env_archcpu(env)->phys_bits);
+    int i;
+
+    for (i = 0; i < 4; i++) {
+        if ((pdpte[i] & PG_PRESENT_MASK) && (pdpte[i] & rsvd)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* 26.2.1: the VM-execution, exit and entry control fields */
+static bool vmx_check_controls(CPUX86State *env)
+{
+    uint32_t pin = vmcs_get(env, VMCS_PIN_CONTROLS);
+    uint32_t proc = vmcs_get(env, VMCS_PROC_CONTROLS);
+    uint32_t proc2 = 0;
+    uint32_t exitc = vmcs_get(env, VMCS_EXIT_CONTROLS);
+    uint32_t entryc = vmcs_get(env, VMCS_ENTRY_CONTROLS);
+    uint32_t info = vmcs_get(env, VMCS_ENTRY_INTR_INFO);
+    uint32_t n;
+
+    if (!vmx_ctl_ok(env, MSR_IA32_VMX_TRUE_PINBASED_CTLS, pin) ||
+        !vmx_ctl_ok(env, MSR_IA32_VMX_TRUE_PROCBASED_CTLS, proc)) {
+        return false;
+    }
+    if (proc & VMX_CPU_BASED_ACTIVATE_SECONDARY_CONTROLS) {
+        proc2 = vmcs_get(env, VMCS_PROC_CONTROLS2);
+        if (!vmx_ctl_ok(env, MSR_IA32_VMX_PROCBASED_CTLS2, proc2)) {
+            return false;
+        }
+    }
+    if (vmcs_get(env, VMCS_CR3_TARGET_COUNT) > 4) {
+        return false;
+    }
+    if ((proc & VMX_CPU_BASED_USE_IO_BITMAPS) &&
+        (vmx_bad_page(env, vmcs_get(env, VMCS_IO_BITMAP_A)) ||
+         vmx_bad_page(env, vmcs_get(env, VMCS_IO_BITMAP_B)))) {
+        return false;
+    }
+    if ((proc & VMX_CPU_BASED_USE_MSR_BITMAPS) &&
+        vmx_bad_page(env, vmcs_get(env, VMCS_MSR_BITMAP))) {
+        return false;
+    }
+    if (proc2 & VMX_SECONDARY_EXEC_ENABLE_EPT) {
+        if (!vmx_eptp_ok(env, vmcs_get(env, VMCS_EPTP))) {
+            return false;
+        }
+    } else if (proc2 & VMX_SECONDARY_EXEC_UNRESTRICTED_GUEST) {
+        return false;
+    }
+    if ((proc2 & VMX_SECONDARY_EXEC_ENABLE_VPID) &&
+        vmcs_get(env, VMCS_VPID) == 0) {
+        return false;
+    }
+
+    if (!vmx_ctl_ok(env, MSR_IA32_VMX_TRUE_EXIT_CTLS, exitc)) {
+        return false;
+    }
+    n = vmcs_get(env, VMCS_EXIT_MSR_STORE_COUNT);
+    if (n) {
+        uint64_t a = vmcs_get(env, VMCS_EXIT_MSR_STORE_ADDR);
+
+        if ((a & 0xf) || vmx_bad_phys(env, a + 16ull * n - 1)) {
+            return false;
+        }
+    }
+    n = vmcs_get(env, VMCS_EXIT_MSR_LOAD_COUNT);
+    if (n) {
+        uint64_t a = vmcs_get(env, VMCS_EXIT_MSR_LOAD_ADDR);
+
+        if ((a & 0xf) || vmx_bad_phys(env, a + 16ull * n - 1)) {
+            return false;
+        }
+    }
+
+    if (!vmx_ctl_ok(env, MSR_IA32_VMX_TRUE_ENTRY_CTLS, entryc)) {
+        return false;
+    }
+    n = vmcs_get(env, VMCS_ENTRY_MSR_LOAD_COUNT);
+    if (n) {
+        uint64_t a = vmcs_get(env, VMCS_ENTRY_MSR_LOAD_ADDR);
+
+        if ((a & 0xf) || vmx_bad_phys(env, a + 16ull * n - 1)) {
+            return false;
+        }
+    }
+
+    if (info & VMX_INTR_VALID) {
+        int vec = info & 0xff;
+        int type = (info >> 8) & 7;
+        bool err = info & VMX_INTR_ERROR_VALID;
+        bool want_err = false;
+        uint32_t len = vmcs_get(env, VMCS_ENTRY_INSN_LEN);
+
+        if (info & 0x7ffff000) {
+            return false;
+        }
+        switch (type) {
+        case VMX_INTR_TYPE_EXTERNAL:
+            break;
+        case VMX_INTR_TYPE_NMI:
+            if (vec != 2) {
+                return false;
+            }
+            break;
+        case VMX_INTR_TYPE_HW_EXCEPTION:
+            if (vec > 31) {
+                return false;
+            }
+            want_err = exception_has_error_code(vec);
+            break;
+        case VMX_INTR_TYPE_SW_INTERRUPT:
+        case VMX_INTR_TYPE_PRIV_SW_EXCEPTION:
+        case VMX_INTR_TYPE_SW_EXCEPTION:
+            if (len > 15 ||
+                (len == 0 && !(env->features[FEAT_VMX_MISC] &
+                               MSR_VMX_MISC_ZERO_LEN_INJECT))) {
+                return false;
+            }
+            break;
+        default:
+            return false;
+        }
+        /* with unrestricted guest, a real-mode guest takes no error code */
+        if ((proc2 & VMX_SECONDARY_EXEC_UNRESTRICTED_GUEST) &&
+            !(vmcs_get(env, VMCS_GUEST_CR0) & CR0_PE_MASK)) {
+            want_err = false;
+        }
+        if (err != want_err) {
+            return false;
+        }
+        if (err && (vmcs_get(env, VMCS_ENTRY_EXCEPTION_ERROR) & 0xffff8000)) {
+            return false;
+        }
+    }
+    return true;
+}
+
+/* 26.2.2 and 26.2.3: the host-state area */
+static bool vmx_check_host(CPUX86State *env)
+{
+    uint32_t exitc = vmcs_get(env, VMCS_EXIT_CONTROLS);
+    uint32_t entryc = vmcs_get(env, VMCS_ENTRY_CONTROLS);
+    bool host64 = exitc & VMX_VM_EXIT_HOST_ADDR_SPACE_SIZE;
+    uint64_t cr0 = vmcs_get(env, VMCS_HOST_CR0);
+    uint64_t cr4 = vmcs_get(env, VMCS_HOST_CR4);
+    uint64_t rip = vmcs_get(env, VMCS_HOST_RIP);
+    int i;
+
+    if (vmx_long_mode(env)) {
+        if (!host64) {
+            return false;
+        }
+    } else if (host64 || (entryc & VMX_VM_ENTRY_IA32E_MODE)) {
+        return false;
+    }
+    if ((cr0 & vmx_cr0_fixed0()) != vmx_cr0_fixed0() || (cr0 >> 32) ||
+        !(cr4 & CR4_VMXE_MASK) || (cr4 & ~vmx_cr4_fixed1(env)) ||
+        vmx_bad_phys(env, vmcs_get(env, VMCS_HOST_CR3))) {
+        return false;
+    }
+    if (!vmx_canonical(env, vmcs_get(env, VMCS_HOST_SYSENTER_ESP)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_HOST_SYSENTER_EIP))) {
+        return false;
+    }
+    if (exitc & VMX_VM_EXIT_LOAD_IA32_PAT) {
+        uint64_t pat = vmcs_get(env, VMCS_HOST_PAT);
+
+        for (i = 0; i < 8; i++) {
+            int t = (pat >> (8 * i)) & 0xff;
+
+            if (t == 2 || t == 3 || t > 7) {
+                return false;
+            }
+        }
+    }
+    if (exitc & VMX_VM_EXIT_LOAD_IA32_EFER) {
+        uint64_t efer = vmcs_get(env, VMCS_HOST_EFER);
+        bool lma = efer & MSR_EFER_LMA, lme = efer & MSR_EFER_LME;
+
+        if ((efer & ~vmx_efer_valid(env)) || lma != host64 || lme != host64) {
+            return false;
+        }
+    }
+    for (i = 0; i < 6; i++) {
+        if (vmcs_get(env, VMCS_HOST_ES_SEL + 2 * i) & 7) {
+            return false;
+        }
+    }
+    if ((vmcs_get(env, VMCS_HOST_TR_SEL) & 7) ||
+        vmcs_get(env, VMCS_HOST_CS_SEL) == 0 ||
+        vmcs_get(env, VMCS_HOST_TR_SEL) == 0 ||
+        (!host64 && vmcs_get(env, VMCS_HOST_SS_SEL) == 0)) {
+        return false;
+    }
+    if (!vmx_canonical(env, vmcs_get(env, VMCS_HOST_FS_BASE)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_HOST_GS_BASE)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_HOST_TR_BASE)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_HOST_GDTR_BASE)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_HOST_IDTR_BASE))) {
+        return false;
+    }
+    if (host64) {
+        if (!(cr4 & CR4_PAE_MASK) || !vmx_canonical(env, rip)) {
+            return false;
+        }
+    } else if ((rip >> 32) || (cr4 & CR4_PCIDE_MASK)) {
+        return false;
+    }
+    return true;
+}
+
+static const char *const vmx_segname[] = { "ES", "CS", "SS", "DS", "FS", "GS" };
+
+/*
+ * 26.3.1: the guest-state area.  Returns 0 when it may be loaded, or
+ * the basic exit reason of the failed entry (33), with *qual its
+ * exit qualification.
+ */
+static uint32_t vmx_check_guest(CPUX86State *env, uint64_t *qual)
+{
+    CPUState *cs = env_cpu(env);
+    uint32_t proc2 = env->vmx_proc2;
+    uint32_t entryc = env->vmx_entryctl;
+    bool unrestricted = proc2 & VMX_SECONDARY_EXEC_UNRESTRICTED_GUEST;
+    bool guest64 = entryc & VMX_VM_ENTRY_IA32E_MODE;
+    uint64_t rflags = vmcs_get(env, VMCS_GUEST_RFLAGS);
+    uint64_t cr0 = vmcs_get(env, VMCS_GUEST_CR0);
+    uint64_t cr4 = vmcs_get(env, VMCS_GUEST_CR4);
+    uint64_t fixed0 = vmx_cr0_fixed0();
+    bool v86 = rflags & VM_MASK;
+    uint32_t sel[6], lim[6], ar[6];
+    uint64_t base[6];
+    uint32_t intr = vmcs_get(env, VMCS_GUEST_INTERRUPTIBILITY);
+    uint32_t act = vmcs_get(env, VMCS_GUEST_ACTIVITY);
+    uint32_t info = vmcs_get(env, VMCS_ENTRY_INTR_INFO);
+    uint64_t link, pdbg;
+    int i, cstype;
+
+    *qual = 0;
+#define FAIL(...) do { \
+        qemu_log_mask(LOG_GUEST_ERROR, "vmx: VM entry: " __VA_ARGS__); \
+        qemu_log_mask(LOG_GUEST_ERROR, "\n"); \
+        return VMX_EXIT_ENTRY_GUEST_STATE; \
+    } while (0)
+
+    /* control registers, debug registers, MSRs */
+    if (unrestricted) {
+        fixed0 &= ~(CR0_PE_MASK | CR0_PG_MASK);
+        if ((cr0 & CR0_PG_MASK) && !(cr0 & CR0_PE_MASK)) {
+            FAIL("CR0.PG without CR0.PE");
+        }
+    }
+    if ((cr0 & fixed0) != fixed0 || (cr0 >> 32)) {
+        FAIL("CR0 %#" PRIx64, cr0);
+    }
+    if (!(cr4 & CR4_VMXE_MASK) || (cr4 & ~vmx_cr4_fixed1(env))) {
+        FAIL("CR4 %#" PRIx64, cr4);
+    }
+    if (vmx_bad_phys(env, vmcs_get(env, VMCS_GUEST_CR3))) {
+        FAIL("CR3");
+    }
+    if (guest64) {
+        if (!(cr0 & CR0_PG_MASK) || !(cr4 & CR4_PAE_MASK)) {
+            FAIL("IA-32e mode guest without paging and PAE");
+        }
+    } else if (cr4 & CR4_PCIDE_MASK) {
+        FAIL("CR4.PCIDE outside IA-32e mode");
+    }
+    if ((entryc & VMX_VM_ENTRY_LOAD_DEBUG_CONTROLS) &&
+        (vmcs_get(env, VMCS_GUEST_DR7) >> 32)) {
+        FAIL("DR7");
+    }
+    if (!vmx_canonical(env, vmcs_get(env, VMCS_GUEST_SYSENTER_ESP)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_GUEST_SYSENTER_EIP))) {
+        FAIL("SYSENTER_ESP/EIP");
+    }
+    if (entryc & VMX_VM_ENTRY_LOAD_IA32_PAT) {
+        uint64_t pat = vmcs_get(env, VMCS_GUEST_PAT);
+
+        for (i = 0; i < 8; i++) {
+            int t = (pat >> (8 * i)) & 0xff;
+
+            if (t == 2 || t == 3 || t > 7) {
+                FAIL("PAT");
+            }
+        }
+    }
+    if (entryc & VMX_VM_ENTRY_LOAD_IA32_EFER) {
+        uint64_t efer = vmcs_get(env, VMCS_GUEST_EFER);
+        bool lma = efer & MSR_EFER_LMA, lme = efer & MSR_EFER_LME;
+
+        if (efer & ~vmx_efer_valid(env)) {
+            FAIL("EFER reserved bits %#" PRIx64, efer);
+        }
+        if (lma != guest64 || ((cr0 & CR0_PG_MASK) && lma != lme)) {
+            FAIL("EFER %#" PRIx64 " and IA-32e mode guest", efer);
+        }
+    }
+
+    /* segment registers */
+    for (i = 0; i < 6; i++) {
+        sel[i] = vmcs_get(env, VMCS_GUEST_ES_SEL + 2 * i);
+        base[i] = vmcs_get(env, VMCS_GUEST_ES_BASE + 2 * i);
+        lim[i] = vmcs_get(env, VMCS_GUEST_ES_LIMIT + 2 * i);
+        ar[i] = vmcs_get(env, VMCS_GUEST_ES_AR + 2 * i);
+    }
+    if (v86) {
+        if (guest64) {
+            FAIL("virtual-8086 mode in an IA-32e mode guest");
+        }
+        for (i = 0; i < 6; i++) {
+            if (base[i] != (uint64_t)sel[i] << 4 || lim[i] != 0xffff ||
+                ar[i] != 0xf3) {
+                FAIL("virtual-8086 %s", vmx_segname[i]);
+            }
+        }
+    } else {
+        for (i = 0; i < 6; i++) {
+            int type = ar[i] & 15;
+            int dpl = (ar[i] >> 5) & 3;
+
+            if (i >= R_FS && !vmx_canonical(env, base[i])) {
+                FAIL("%s base not canonical", vmx_segname[i]);
+            }
+            if (i != R_CS && (ar[i] & VMX_AR_UNUSABLE)) {
+                continue;
+            }
+            if (i < R_FS && (base[i] >> 32)) {
+                FAIL("%s base above 4 GiB", vmx_segname[i]);
+            }
+            if (!(ar[i] & (1 << 4)) || !(ar[i] & (1 << 7)) ||
+                !vmx_limit_ar_ok(lim[i], ar[i])) {
+                FAIL("%s access rights %#x limit %#x", vmx_segname[i],
+                     ar[i], lim[i]);
+            }
+            switch (i) {
+            case R_CS:
+                if (!(type == 9 || type == 11 || type == 13 || type == 15 ||
+                      (unrestricted && type == 3 && dpl == 0))) {
+                    FAIL("CS type %d", type);
+                }
+                if (guest64 && (ar[i] & (1 << 13)) && (ar[i] & (1 << 14))) {
+                    FAIL("CS.L and CS.D in an IA-32e mode guest");
+                }
+                break;
+            case R_SS:
+                if (type != 3 && type != 7) {
+                    FAIL("SS type %d", type);
+                }
+                break;
+            default:
+                if (!(type & 1) || ((type & 8) && !(type & 2))) {
+                    FAIL("%s type %d", vmx_segname[i], type);
+                }
+                if (!unrestricted && type <= 11 && (sel[i] & 3) > dpl) {
+                    FAIL("%s RPL above DPL", vmx_segname[i]);
+                }
+                break;
+            }
+        }
+        cstype = ar[R_CS] & 15;
+        if ((cstype == 9 || cstype == 11) &&
+            ((ar[R_CS] >> 5) & 3) != ((ar[R_SS] >> 5) & 3)) {
+            FAIL("CS.DPL and SS.DPL");
+        }
+        if ((cstype == 13 || cstype == 15) &&
+            ((ar[R_CS] >> 5) & 3) > ((ar[R_SS] >> 5) & 3)) {
+            FAIL("conforming CS.DPL above SS.DPL");
+        }
+        if (!unrestricted) {
+            if ((sel[R_SS] & 3) != (sel[R_CS] & 3) ||
+                (sel[R_SS] & 3) != ((ar[R_SS] >> 5) & 3)) {
+                FAIL("SS.RPL, CS.RPL and SS.DPL");
+            }
+        } else if ((!(cr0 & CR0_PE_MASK) || cstype == 3) &&
+                   ((ar[R_SS] >> 5) & 3) != 0) {
+            FAIL("SS.DPL in real mode");
+        }
+    }
+
+    /* GDTR, IDTR, LDTR, TR */
+    if (!vmx_canonical(env, vmcs_get(env, VMCS_GUEST_GDTR_BASE)) ||
+        !vmx_canonical(env, vmcs_get(env, VMCS_GUEST_IDTR_BASE)) ||
+        vmcs_get(env, VMCS_GUEST_GDTR_LIMIT) > 0xffff ||
+        vmcs_get(env, VMCS_GUEST_IDTR_LIMIT) > 0xffff) {
+        FAIL("GDTR or IDTR");
+    }
+    {
+        uint32_t a = vmcs_get(env, VMCS_GUEST_LDTR_AR);
+
+        if (!(a & VMX_AR_UNUSABLE)) {
+            if ((vmcs_get(env, VMCS_GUEST_LDTR_SEL) & 4) || (a & 15) != 2 ||
+                (a & (1 << 4)) || !(a & (1 << 7)) ||
+                !vmx_limit_ar_ok(vmcs_get(env, VMCS_GUEST_LDTR_LIMIT), a) ||
+                !vmx_canonical(env, vmcs_get(env, VMCS_GUEST_LDTR_BASE))) {
+                FAIL("LDTR");
+            }
+        }
+        a = vmcs_get(env, VMCS_GUEST_TR_AR);
+        if ((a & VMX_AR_UNUSABLE) || (vmcs_get(env, VMCS_GUEST_TR_SEL) & 4) ||
+            (a & (1 << 4)) || !(a & (1 << 7)) ||
+            !vmx_limit_ar_ok(vmcs_get(env, VMCS_GUEST_TR_LIMIT), a) ||
+            !vmx_canonical(env, vmcs_get(env, VMCS_GUEST_TR_BASE)) ||
+            !((a & 15) == 11 || ((a & 15) == 3 && !guest64))) {
+            FAIL("TR sel %#" PRIx64 " base %#" PRIx64 " limit %#" PRIx64
+                 " ar %#x", vmcs_get(env, VMCS_GUEST_TR_SEL),
+                 vmcs_get(env, VMCS_GUEST_TR_BASE),
+                 vmcs_get(env, VMCS_GUEST_TR_LIMIT), a);
+        }
+    }
+
+    /* RIP and RFLAGS */
+    if ((!guest64 || !(ar[R_CS] & (1 << 13))) &&
+        (vmcs_get(env, VMCS_GUEST_RIP) >> 32)) {
+        FAIL("RIP above 4 GiB outside 64-bit mode");
+    }
+    if ((rflags & 0xffffffffffc08028ull) || !(rflags & 2)) {
+        FAIL("RFLAGS %#" PRIx64, rflags);
+    }
+    if (v86 && !(cr0 & CR0_PE_MASK)) {
+        FAIL("RFLAGS.VM in real mode");
+    }
+    if ((info & VMX_INTR_VALID) &&
+        ((info >> 8) & 7) == VMX_INTR_TYPE_EXTERNAL && !(rflags & IF_MASK)) {
+        FAIL("external interrupt injected with RFLAGS.IF clear");
+    }
+
+    /* activity and interruptibility */
+    if (act > VMX_ACTIVITY_HLT) {
+        FAIL("activity state %u", act);
+    }
+    if (act == VMX_ACTIVITY_HLT && ((ar[R_SS] >> 5) & 3) != 0) {
+        FAIL("HLT activity state above CPL 0");
+    }
+    if (intr & ~0x1fu) {
+        FAIL("interruptibility %#x", intr);
+    }
+    if ((intr & (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS)) ==
+        (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS)) {
+        FAIL("blocking by STI and by MOV SS");
+    }
+    if ((intr & VMX_BLOCKING_STI) && !(rflags & IF_MASK)) {
+        FAIL("blocking by STI with RFLAGS.IF clear");
+    }
+    if ((intr & (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS)) &&
+        act != VMX_ACTIVITY_ACTIVE) {
+        FAIL("blocking in a non-active state");
+    }
+    if (intr & (VMX_BLOCKING_SMI | 0x10)) {
+        FAIL("blocking by SMI outside SMM");
+    }
+    if (info & VMX_INTR_VALID) {
+        int type = (info >> 8) & 7;
+
+        if ((type == VMX_INTR_TYPE_EXTERNAL || type == VMX_INTR_TYPE_NMI) &&
+            (intr & (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS))) {
+            FAIL("event injected while blocked");
+        }
+    }
+
+    /* pending debug exceptions */
+    pdbg = vmcs_get(env, VMCS_GUEST_PENDING_DBG);
+    if (pdbg & 0xffffffffffffaff0ull) {
+        FAIL("pending debug exceptions %#" PRIx64, pdbg);
+    }
+    if ((intr & (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS)) ||
+        act == VMX_ACTIVITY_HLT) {
+        bool bs = pdbg & (1 << 14);
+        bool tf = rflags & TF_MASK;
+        bool btf = vmcs_get(env, VMCS_GUEST_DEBUGCTL) & 2;
+
+        if ((bs && !tf) || (bs && btf) || (!bs && tf && !btf)) {
+            FAIL("pending BS and RFLAGS.TF");
+        }
+    }
+
+    /* VMCS link pointer: there is no VMCS shadowing */
+    link = vmcs_get(env, VMCS_LINK_POINTER);
+    if (link != ~0ull) {
+        *qual = 4;
+        FAIL("VMCS link pointer %#" PRIx64, link);
+    }
+
+    /* PDPTEs, PAE paging outside IA-32e mode */
+    if (!guest64 && (cr0 & CR0_PG_MASK) && (cr4 & CR4_PAE_MASK)) {
+        uint64_t pdpte[4];
+
+        for (i = 0; i < 4; i++) {
+            if (proc2 & VMX_SECONDARY_EXEC_ENABLE_EPT) {
+                pdpte[i] = vmcs_get(env, VMCS_GUEST_PDPTE0 + 2 * i);
+            } else {
+                pdpte[i] = x86_ldq_phys(cs,
+                    (vmcs_get(env, VMCS_GUEST_CR3) & ~0x1full) + 8 * i);
+            }
+        }
+        if (!vmx_pdptes_ok(env, pdpte)) {
+            *qual = 2;
+            FAIL("PDPTEs %#" PRIx64 " %#" PRIx64 " %#" PRIx64 " %#" PRIx64
+                 " from %s", pdpte[0], pdpte[1], pdpte[2], pdpte[3],
+                 (proc2 & VMX_SECONDARY_EXEC_ENABLE_EPT) ? "the VMCS" : "CR3");
+        }
+    }
+#undef FAIL
+    return 0;
+}
+
+/* load or store one entry of an MSR list; false fails the list */
+static bool vmx_msr_list_load(CPUX86State *env, hwaddr a)
+{
+    CPUState *cs = env_cpu(env);
+    uint64_t lo = x86_ldq_phys(cs, a);
+    uint64_t val = x86_ldq_phys(cs, a + 8);
+    uint32_t idx = lo;
+
+    if (lo >> 32) {
+        return false;
+    }
+    if (idx == MSR_FSBASE || idx == MSR_GSBASE || (idx >> 8) == 8 ||
+        idx == MSR_IA32_SMBASE || idx == 0x9b) {
+        return false;
+    }
+    return x86_cpu_wrmsr_tcg(env, idx, val, 0);
+}
+
+static bool vmx_msr_list_store(CPUX86State *env, hwaddr a)
+{
+    CPUState *cs = env_cpu(env);
+    uint64_t lo = x86_ldq_phys(cs, a);
+    uint64_t val;
+    uint32_t idx = lo;
+
+    if (lo >> 32 || (idx >> 8) == 8 || idx == MSR_IA32_SMBASE) {
+        return false;
+    }
+    if (!x86_cpu_rdmsr_tcg(env, idx, &val, 0)) {
+        return false;
+    }
+    x86_stq_phys(cs, a + 8, val);
+    return true;
+}
+
+/*
+ * A VMX abort: the processor writes the abort indicator into the
+ * VMCS region and shuts down.
+ */
+G_NORETURN static void vmx_abort(CPUX86State *env, uint32_t indicator)
+{
+    CPUState *cs = env_cpu(env);
+
+    qemu_log_mask(LOG_GUEST_ERROR, "vmx: VMX abort %u\n", indicator);
+    x86_stl_phys(cs, env->vmx_vmcs_ptr + 4, indicator);
+    env->vmx_nonroot = false;
+    env->hflags &= ~HF_GUEST_MASK;
+    qemu_system_reset_request(SHUTDOWN_CAUSE_GUEST_RESET);
+    cs->halted = 1;
+    cs->exception_index = EXCP_HLT;
+    cpu_loop_exit(cs);
+}
+
+static void vmx_load_seg(CPUX86State *env, int seg, uint16_t sel,
+                         uint64_t base, uint32_t limit, uint32_t ar)
+{
+    cpu_x86_load_seg_cache(env, seg, sel, base, limit, vmx_flags_from_ar(ar));
+}
+
+/*
+ * Event delivery through the guest's IDT, and the exits that happen
+ * in the middle of one: do_interrupt_all() marks each delivery as it
+ * starts and when it completes, and an exit in between reports the
+ * event in the IDT-vectoring information.
+ */
+void vmx_event_begin(CPUX86State *env, int intno, int is_int, int error_code,
+                     int is_hw)
+{
+    uint32_t type, info;
+
+    if (is_hw) {
+        type = intno == EXCP02_NMI ? VMX_INTR_TYPE_NMI : VMX_INTR_TYPE_EXTERNAL;
+    } else if (is_int) {
+        if (intno == EXCP03_INT3 || intno == EXCP04_INTO) {
+            type = VMX_INTR_TYPE_SW_EXCEPTION;
+        } else {
+            type = VMX_INTR_TYPE_SW_INTERRUPT;
+        }
+    } else {
+        type = VMX_INTR_TYPE_HW_EXCEPTION;
+    }
+    info = VMX_INTR_VALID | (type << 8) | intno;
+    if (type == VMX_INTR_TYPE_HW_EXCEPTION && (env->cr[0] & CR0_PE_MASK) &&
+        exception_has_error_code(intno)) {
+        info |= VMX_INTR_ERROR_VALID;
+    }
+    env->vmx_idt_info = info;
+    env->vmx_idt_err = error_code;
+    /* an event delivered wakes the guest from HLT */
+    env->vmx_activity = VMX_ACTIVITY_ACTIVE;
+}
+
+void vmx_event_end(CPUX86State *env)
+{
+    env->vmx_idt_info = 0;
+}
+
+/*
+ * VM entry, VMLAUNCH or VMRESUME.  Returns only when the instruction
+ * fails (VMfail); a failed entry that loads host state (exit reasons
+ * 33 and 34) and a successful one both leave through the main loop.
+ */
+static void vmx_enter(CPUX86State *env, bool resume, uintptr_t ra)
+{
+    CPUState *cs = env_cpu(env);
+    uint64_t cr0, cr4, efer, rflags, qual;
+    uint32_t reason, intr, info, n, i;
+    bool guest64;
+
+    if (!env->vmx_vmcs_valid) {
+        vmx_fail_invalid(env);
+        return;
+    }
+    if ((env->hflags & (HF_INHIBIT_IRQ_MASK | HF_MOVSS_MASK)) ==
+        (HF_INHIBIT_IRQ_MASK | HF_MOVSS_MASK)) {
+        vmx_fail(env, VMXERR_ENTRY_MOV_SS);
+        return;
+    }
+    if (!resume && env->vmx_launched) {
+        vmx_fail(env, VMXERR_VMLAUNCH_NOT_CLEAR);
+        return;
+    }
+    if (resume && !env->vmx_launched) {
+        vmx_fail(env, VMXERR_VMRESUME_NOT_LAUNCHED);
+        return;
+    }
+    if (!vmx_check_controls(env)) {
+        vmx_fail(env, VMXERR_ENTRY_BAD_CONTROLS);
+        return;
+    }
+    if (!vmx_check_host(env)) {
+        vmx_fail(env, VMXERR_ENTRY_BAD_HOST_STATE);
+        return;
+    }
+
+    env->vmx_pin = vmcs_get(env, VMCS_PIN_CONTROLS);
+    env->vmx_proc = vmcs_get(env, VMCS_PROC_CONTROLS);
+    env->vmx_proc2 = (env->vmx_proc & VMX_CPU_BASED_ACTIVATE_SECONDARY_CONTROLS) ?
+                     vmcs_get(env, VMCS_PROC_CONTROLS2) : 0;
+    env->vmx_exitctl = vmcs_get(env, VMCS_EXIT_CONTROLS);
+    env->vmx_entryctl = vmcs_get(env, VMCS_ENTRY_CONTROLS);
+    env->vmx_exc_bitmap = vmcs_get(env, VMCS_EXCEPTION_BITMAP);
+    env->vmx_pfec_mask = vmcs_get(env, VMCS_PFEC_MASK);
+    env->vmx_pfec_match = vmcs_get(env, VMCS_PFEC_MATCH);
+    env->vmx_cr0_mask = vmcs_get(env, VMCS_CR0_MASK);
+    env->vmx_cr0_shadow = vmcs_get(env, VMCS_CR0_SHADOW);
+    env->vmx_cr4_mask = vmcs_get(env, VMCS_CR4_MASK);
+    env->vmx_cr4_shadow = vmcs_get(env, VMCS_CR4_SHADOW);
+    env->vmx_eptp = vmcs_get(env, VMCS_EPTP);
+
+    reason = vmx_check_guest(env, &qual);
+    if (reason) {
+        env->vmx_entry_failed = true;
+        env->vmx_exit_intr_info = 0;
+        env->vmx_idt_info = 0;
+        env->vmx_exit_reason = VMX_EXIT_ENTRY_FAILURE | reason;
+        env->vmx_exit_qual = qual;
+        env->vmx_exit_insn = false;
+        cs->exception_index = EXCP_VMEXIT;
+        env->old_exception = -1;
+        cpu_loop_exit_restore(cs, ra);
+    }
+
+    /*
+     * Load the guest.  EFER before the control registers' mode switch
+     * is seen and before CS, whose cached mode depends on EFER.LMA.
+     */
+    guest64 = env->vmx_entryctl & VMX_VM_ENTRY_IA32E_MODE;
+    cr0 = vmcs_get(env, VMCS_GUEST_CR0);
+    cr4 = vmcs_get(env, VMCS_GUEST_CR4);
+    if (env->vmx_entryctl & VMX_VM_ENTRY_LOAD_IA32_EFER) {
+        efer = vmcs_get(env, VMCS_GUEST_EFER);
+    } else {
+        efer = env->efer;
+        if (guest64) {
+            efer |= MSR_EFER_LMA | MSR_EFER_LME;
+        } else if (cr0 & CR0_PG_MASK) {
+            efer &= ~(MSR_EFER_LMA | MSR_EFER_LME);
+        } else {
+            efer &= ~MSR_EFER_LMA;
+        }
+    }
+
+    env->vmx_on = true;
+    env->vmx_nonroot = true;
+    env->vmx_entry_failed = false;
+    env->hflags |= HF_GUEST_MASK;
+    env->hflags2 &= ~HF2_NPT_MASK;
+
+    cpu_x86_update_cr0(env, (env->cr[0] & 0x60000000) | (cr0 & ~0x60000000ull));
+    cpu_x86_update_cr4(env, cr4);
+    cpu_x86_update_cr3(env, vmcs_get(env, VMCS_GUEST_CR3));
+    cpu_load_efer(env, efer);
+    if (env->vmx_entryctl & VMX_VM_ENTRY_LOAD_DEBUG_CONTROLS) {
+        cpu_x86_update_dr7(env, (vmcs_get(env, VMCS_GUEST_DR7) & ~0xc000) | 0x400);
+    }
+    if (env->vmx_entryctl & VMX_VM_ENTRY_LOAD_IA32_PAT) {
+        env->pat = vmcs_get(env, VMCS_GUEST_PAT);
+    }
+    env->sysenter_cs = vmcs_get(env, VMCS_GUEST_SYSENTER_CS);
+    env->sysenter_esp = vmcs_get(env, VMCS_GUEST_SYSENTER_ESP);
+    env->sysenter_eip = vmcs_get(env, VMCS_GUEST_SYSENTER_EIP);
+
+    rflags = vmcs_get(env, VMCS_GUEST_RFLAGS);
+    env->eflags = 0;
+    cpu_load_eflags(env, rflags,
+                    ~(CC_O | CC_S | CC_Z | CC_A | CC_P | CC_C | DF_MASK));
+
+    for (i = 0; i < 6; i++) {
+        vmx_load_seg(env, i, vmcs_get(env, VMCS_GUEST_ES_SEL + 2 * i),
+                     vmcs_get(env, VMCS_GUEST_ES_BASE + 2 * i),
+                     vmcs_get(env, VMCS_GUEST_ES_LIMIT + 2 * i),
+                     vmcs_get(env, VMCS_GUEST_ES_AR + 2 * i));
+    }
+    vmx_load_seg(env, R_LDTR, vmcs_get(env, VMCS_GUEST_LDTR_SEL),
+                 vmcs_get(env, VMCS_GUEST_LDTR_BASE),
+                 vmcs_get(env, VMCS_GUEST_LDTR_LIMIT),
+                 vmcs_get(env, VMCS_GUEST_LDTR_AR));
+    vmx_load_seg(env, R_TR, vmcs_get(env, VMCS_GUEST_TR_SEL),
+                 vmcs_get(env, VMCS_GUEST_TR_BASE),
+                 vmcs_get(env, VMCS_GUEST_TR_LIMIT),
+                 vmcs_get(env, VMCS_GUEST_TR_AR));
+    env->gdt.base = vmcs_get(env, VMCS_GUEST_GDTR_BASE);
+    env->gdt.limit = vmcs_get(env, VMCS_GUEST_GDTR_LIMIT);
+    env->idt.base = vmcs_get(env, VMCS_GUEST_IDTR_BASE);
+    env->idt.limit = vmcs_get(env, VMCS_GUEST_IDTR_LIMIT);
+
+    env->eip = vmcs_get(env, VMCS_GUEST_RIP);
+    env->regs[R_ESP] = vmcs_get(env, VMCS_GUEST_RSP);
+
+    env->tsc_offset = (env->vmx_proc & VMX_CPU_BASED_USE_TSC_OFFSETING) ?
+                      vmcs_get(env, VMCS_TSC_OFFSET) : 0;
+
+    env->vmx_pdptes_valid = false;
+    if (env->vmx_proc2 & VMX_SECONDARY_EXEC_ENABLE_EPT) {
+        env->hflags2 |= HF2_NPT_MASK;
+        if (!guest64 && (cr0 & CR0_PG_MASK) && (cr4 & CR4_PAE_MASK)) {
+            for (i = 0; i < 4; i++) {
+                env->vmx_pdpte[i] = vmcs_get(env, VMCS_GUEST_PDPTE0 + 2 * i);
+            }
+            env->vmx_pdptes_valid = true;
+        }
+    }
+    /* there are no VPIDs here: mappings do not survive entry or exit */
+    tlb_flush(cs);
+
+    intr = vmcs_get(env, VMCS_GUEST_INTERRUPTIBILITY);
+    info = vmcs_get(env, VMCS_ENTRY_INTR_INFO);
+    env->hflags &= ~(HF_INHIBIT_IRQ_MASK | HF_MOVSS_MASK);
+    if ((intr & (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS)) &&
+        !(info & VMX_INTR_VALID)) {
+        env->hflags |= HF_INHIBIT_IRQ_MASK;
+        if (intr & VMX_BLOCKING_MOV_SS) {
+            env->hflags |= HF_MOVSS_MASK;
+        }
+    }
+    if (intr & VMX_BLOCKING_NMI) {
+        env->hflags2 |= HF2_NMI_MASK;
+    } else {
+        env->hflags2 &= ~HF2_NMI_MASK;
+    }
+    env->vmx_activity = vmcs_get(env, VMCS_GUEST_ACTIVITY);
+    env->vmx_idt_info = 0;
+    /*
+     * Pending debug exceptions (B0-B3, BS) join the next #DB, which in
+     * a MOV SS or STI shadow is the single-step trap after the next
+     * instruction.  An injected event discards them.
+     */
+    env->vmx_pending_dbg = (info & VMX_INTR_VALID) ? 0 :
+                           vmcs_get(env, VMCS_GUEST_PENDING_DBG) & 0x400f;
+
+    /* the MSR-load area, last: a failure here undoes the entry */
+    n = vmcs_get(env, VMCS_ENTRY_MSR_LOAD_COUNT);
+    for (i = 0; i < n; i++) {
+        if (!vmx_msr_list_load(env,
+                vmcs_get(env, VMCS_ENTRY_MSR_LOAD_ADDR) + 16ull * i)) {
+            env->vmx_entry_failed = true;
+            env->vmx_exit_intr_info = 0;
+            env->vmx_exit_reason = VMX_EXIT_ENTRY_FAILURE |
+                                   VMX_EXIT_ENTRY_MSR_LOAD;
+            env->vmx_exit_qual = i + 1;
+            env->vmx_exit_insn = false;
+            cs->exception_index = EXCP_VMEXIT;
+            env->old_exception = -1;
+            cpu_loop_exit(cs);
+        }
+    }
+
+    env->vmx_launched = true;
+    qemu_log_mask(CPU_LOG_INT, "vmx: %s rip " TARGET_FMT_lx "\n",
+                  resume ? "VMRESUME" : "VMLAUNCH", env->eip);
+
+    /*
+     * An INIT held off in root operation is still pending: in non-root
+     * operation it exits (reason 3), which consumes it.
+     */
+    if (env->vmx_init_latched) {
+        env->vmx_init_latched = false;
+        cs->interrupt_request |= CPU_INTERRUPT_INIT;
+    }
+
+    /* interrupt-window exiting is an interrupt request of its own */
+    if (env->vmx_proc & VMX_CPU_BASED_VIRTUAL_INTR_PENDING) {
+        cs->interrupt_request |= CPU_INTERRUPT_VIRQ;
+    } else {
+        cs->interrupt_request &= ~CPU_INTERRUPT_VIRQ;
+    }
+
+    /* event injection */
+    if (info & VMX_INTR_VALID) {
+        int vec = info & 0xff;
+        int type = (info >> 8) & 7;
+        uint32_t err = vmcs_get(env, VMCS_ENTRY_EXCEPTION_ERROR);
+        uint32_t len = vmcs_get(env, VMCS_ENTRY_INSN_LEN);
+
+        env->vmx_activity = VMX_ACTIVITY_ACTIVE;
+        switch (type) {
+        case VMX_INTR_TYPE_EXTERNAL:
+            do_interrupt_x86_hardirq(env, vec, 1);
+            break;
+        case VMX_INTR_TYPE_NMI:
+            env->hflags2 |= HF2_NMI_MASK;
+            do_interrupt_x86_hardirq(env, vec, 1);
+            break;
+        case VMX_INTR_TYPE_HW_EXCEPTION:
+            do_interrupt_all(env_archcpu(env), vec, 0,
+                             (info & VMX_INTR_ERROR_VALID) ? err : 0,
+                             0, 0);
+            break;
+        default:
+            do_interrupt_all(env_archcpu(env), vec, 1, 0,
+                             env->eip + len, 0);
+            break;
+        }
+        vmx_event_end(env);
+    } else if (env->vmx_pending_dbg &&
+               !(intr & (VMX_BLOCKING_STI | VMX_BLOCKING_MOV_SS))) {
+        /*
+         * Pending debug exceptions with nothing blocking them are
+         * delivered as the entry completes.  Inside a shadow they wait
+         * for the next #DB (the single-step trap when RFLAGS.TF is set);
+         * without TF the processor would raise them after the next
+         * instruction, which is not modelled.
+         */
+        vmx_debug_exit(env, 0);
+        raise_exception(env, EXCP01_DB);
+    } else if (env->vmx_activity == VMX_ACTIVITY_HLT) {
+        cs->halted = 1;
+        cs->exception_index = EXCP_HLT;
+        cpu_loop_exit(cs);
+    }
+    cs->exception_index = -1;
+    cpu_loop_exit(cs);
+}
+
+void helper_vmlaunch(CPUX86State *env, int resume)
+{
+    uintptr_t ra = GETPC();
+
+    vmx_insn_check(env, resume ? VMX_EXIT_VMRESUME : VMX_EXIT_VMLAUNCH, ra);
+    vmx_enter(env, resume, ra);
+}
+
+/* save the guest's state into the VMCS at a VM exit (27.3) */
+static void vmx_save_guest(CPUX86State *env)
+{
+    uint32_t intr = 0;
+    int i;
+
+    vmcs_set(env, VMCS_GUEST_CR0, env->cr[0]);
+    vmcs_set(env, VMCS_GUEST_CR3, env->cr[3]);
+    vmcs_set(env, VMCS_GUEST_CR4, env->cr[4]);
+    if (env->vmx_exitctl & VMX_VM_EXIT_SAVE_DEBUG_CONTROLS) {
+        vmcs_set(env, VMCS_GUEST_DR7, env->dr[7]);
+    }
+    vmcs_set(env, VMCS_GUEST_RIP, env->eip);
+    vmcs_set(env, VMCS_GUEST_RSP, env->regs[R_ESP]);
+    vmcs_set(env, VMCS_GUEST_RFLAGS, cpu_compute_eflags(env));
+    for (i = 0; i < 6; i++) {
+        SegmentCache *sc = &env->segs[i];
+
+        vmcs_set(env, VMCS_GUEST_ES_SEL + 2 * i, sc->selector);
+        vmcs_set(env, VMCS_GUEST_ES_BASE + 2 * i, sc->base);
+        vmcs_set(env, VMCS_GUEST_ES_LIMIT + 2 * i, sc->limit);
+        vmcs_set(env, VMCS_GUEST_ES_AR + 2 * i, vmx_ar_from_flags(sc->flags));
+    }
+    vmcs_set(env, VMCS_GUEST_LDTR_SEL, env->ldt.selector);
+    vmcs_set(env, VMCS_GUEST_LDTR_BASE, env->ldt.base);
+    vmcs_set(env, VMCS_GUEST_LDTR_LIMIT, env->ldt.limit);
+    vmcs_set(env, VMCS_GUEST_LDTR_AR, vmx_ar_from_flags(env->ldt.flags));
+    vmcs_set(env, VMCS_GUEST_TR_SEL, env->tr.selector);
+    vmcs_set(env, VMCS_GUEST_TR_BASE, env->tr.base);
+    vmcs_set(env, VMCS_GUEST_TR_LIMIT, env->tr.limit);
+    vmcs_set(env, VMCS_GUEST_TR_AR, vmx_ar_from_flags(env->tr.flags));
+    vmcs_set(env, VMCS_GUEST_GDTR_BASE, env->gdt.base);
+    vmcs_set(env, VMCS_GUEST_GDTR_LIMIT, env->gdt.limit);
+    vmcs_set(env, VMCS_GUEST_IDTR_BASE, env->idt.base);
+    vmcs_set(env, VMCS_GUEST_IDTR_LIMIT, env->idt.limit);
+    vmcs_set(env, VMCS_GUEST_SYSENTER_CS, env->sysenter_cs);
+    vmcs_set(env, VMCS_GUEST_SYSENTER_ESP, env->sysenter_esp);
+    vmcs_set(env, VMCS_GUEST_SYSENTER_EIP, env->sysenter_eip);
+    if (env->vmx_exitctl & VMX_VM_EXIT_SAVE_IA32_PAT) {
+        vmcs_set(env, VMCS_GUEST_PAT, env->pat);
+    }
+    if (env->vmx_exitctl & VMX_VM_EXIT_SAVE_IA32_EFER) {
+        vmcs_set(env, VMCS_GUEST_EFER, env->efer);
+    }
+    /* the PDPTE registers of PAE paging outside IA-32e mode, under EPT */
+    if (env->vmx_pdptes_valid) {
+        for (i = 0; i < 4; i++) {
+            vmcs_set(env, VMCS_GUEST_PDPTE0 + 2 * i, env->vmx_pdpte[i]);
+        }
+    }
+    vmcs_set(env, VMCS_GUEST_PENDING_DBG,
+             env->vmx_pending_dbg ? env->vmx_pending_dbg | (1 << 12) : 0);
+    env->vmx_pending_dbg = 0;
+    vmcs_set(env, VMCS_GUEST_ACTIVITY, env->vmx_activity);
+
+    if (env->hflags & HF_INHIBIT_IRQ_MASK) {
+        intr |= (env->hflags & HF_MOVSS_MASK) ? VMX_BLOCKING_MOV_SS :
+                                                VMX_BLOCKING_STI;
+    }
+    if (env->hflags2 & HF2_NMI_MASK) {
+        intr |= VMX_BLOCKING_NMI;
+    }
+    vmcs_set(env, VMCS_GUEST_INTERRUPTIBILITY, intr);
+
+    /* IA32_VMX_MISC bit 5: the IA-32e mode guest control follows EFER.LMA */
+    if (env->efer & MSR_EFER_LMA) {
+        env->vmx_entryctl |= VMX_VM_ENTRY_IA32E_MODE;
+    } else {
+        env->vmx_entryctl &= ~VMX_VM_ENTRY_IA32E_MODE;
+    }
+    vmcs_set(env, VMCS_ENTRY_CONTROLS, env->vmx_entryctl);
+}
+
+/* load the host's state from the VMCS at a VM exit (27.5) */
+static void vmx_load_host(CPUX86State *env)
+{
+    bool host64 = vmcs_get(env, VMCS_EXIT_CONTROLS) &
+                  VMX_VM_EXIT_HOST_ADDR_SPACE_SIZE;
+    uint32_t dflags = DESC_G_MASK | DESC_B_MASK | DESC_P_MASK | DESC_S_MASK |
+                      DESC_W_MASK | DESC_A_MASK;
+    uint32_t cflags = DESC_G_MASK | DESC_P_MASK | DESC_S_MASK | DESC_CS_MASK |
+                      DESC_R_MASK | DESC_A_MASK |
+                      (host64 ? DESC_L_MASK : DESC_B_MASK);
+    uint64_t efer = env->efer;
+    int i;
+
+    if (vmcs_get(env, VMCS_EXIT_CONTROLS) & VMX_VM_EXIT_LOAD_IA32_EFER) {
+        efer = vmcs_get(env, VMCS_HOST_EFER);
+    } else if (host64) {
+        efer |= MSR_EFER_LMA | MSR_EFER_LME;
+    } else {
+        efer &= ~(MSR_EFER_LMA | MSR_EFER_LME);
+    }
+    cpu_x86_update_cr0(env, (env->cr[0] & 0x60000010) |
+                       (vmcs_get(env, VMCS_HOST_CR0) & ~0x60000010ull));
+    cpu_x86_update_cr4(env, vmcs_get(env, VMCS_HOST_CR4));
+    cpu_x86_update_cr3(env, vmcs_get(env, VMCS_HOST_CR3));
+    cpu_load_efer(env, efer);
+    cpu_x86_update_dr7(env, 0x400);
+    env->sysenter_cs = vmcs_get(env, VMCS_HOST_SYSENTER_CS);
+    env->sysenter_esp = vmcs_get(env, VMCS_HOST_SYSENTER_ESP);
+    env->sysenter_eip = vmcs_get(env, VMCS_HOST_SYSENTER_EIP);
+    if (vmcs_get(env, VMCS_EXIT_CONTROLS) & VMX_VM_EXIT_LOAD_IA32_PAT) {
+        env->pat = vmcs_get(env, VMCS_HOST_PAT);
+    }
+
+    env->eflags = 0;
+    cpu_load_eflags(env, 2, ~(CC_O | CC_S | CC_Z | CC_A | CC_P | CC_C |
+                              DF_MASK));
+
+    cpu_x86_load_seg_cache(env, R_CS, vmcs_get(env, VMCS_HOST_CS_SEL), 0,
+                           0xffffffff, cflags);
+    for (i = 0; i < 6; i++) {
+        uint16_t sel = vmcs_get(env, VMCS_HOST_ES_SEL + 2 * i);
+        uint64_t base = 0;
+
+        if (i == R_CS) {
+            continue;
+        }
+        if (i == R_FS) {
+            base = vmcs_get(env, VMCS_HOST_FS_BASE);
+        } else if (i == R_GS) {
+            base = vmcs_get(env, VMCS_HOST_GS_BASE);
+        }
+        /* a null selector leaves the segment unusable, SS's DPL 0 */
+        cpu_x86_load_seg_cache(env, i, sel, base, sel ? 0xffffffff : 0,
+                               sel ? dflags : 0);
+    }
+    cpu_x86_load_seg_cache(env, R_TR, vmcs_get(env, VMCS_HOST_TR_SEL),
+                           vmcs_get(env, VMCS_HOST_TR_BASE), 0x67,
+                           DESC_P_MASK | (11 << DESC_TYPE_SHIFT));
+    cpu_x86_load_seg_cache(env, R_LDTR, 0, 0, 0, 0);
+    env->gdt.base = vmcs_get(env, VMCS_HOST_GDTR_BASE);
+    env->gdt.limit = 0xffff;
+    env->idt.base = vmcs_get(env, VMCS_HOST_IDTR_BASE);
+    env->idt.limit = 0xffff;
+    env->eip = vmcs_get(env, VMCS_HOST_RIP);
+    env->regs[R_ESP] = vmcs_get(env, VMCS_HOST_RSP);
+}
+
+void vmx_do_vmexit(CPUX86State *env)
+{
+    CPUState *cs = env_cpu(env);
+    uint32_t reason = env->vmx_exit_reason;
+    bool failed = env->vmx_entry_failed;
+    uint32_t n, i;
+
+    vmcs_set(env, VMCS_EXIT_REASON, reason);
+    vmcs_set(env, VMCS_EXIT_QUALIFICATION, env->vmx_exit_qual);
+    vmcs_set(env, VMCS_EXIT_INTR_INFO, env->vmx_exit_intr_info);
+    vmcs_set(env, VMCS_EXIT_INTR_ERROR, env->vmx_exit_intr_err);
+    vmcs_set(env, VMCS_IDT_VECTORING_INFO, env->vmx_idt_info);
+    vmcs_set(env, VMCS_IDT_VECTORING_ERROR, env->vmx_idt_err);
+    if (env->vmx_exit_insn ||
+        ((env->vmx_idt_info & VMX_INTR_VALID) &&
+         ((env->vmx_idt_info >> 8) & 7) >= VMX_INTR_TYPE_SW_INTERRUPT)) {
+        vmcs_set(env, VMCS_EXIT_INSN_LEN, env->vmx_insn_len);
+        vmcs_set(env, VMCS_EXIT_INSN_INFO, env->vmx_insn_info);
+    }
+    if ((reason & 0xffff) == VMX_EXIT_EPT_VIOLATION ||
+        (reason & 0xffff) == VMX_EXIT_EPT_MISCONFIG) {
+        vmcs_set(env, VMCS_GUEST_PHYSICAL_ADDR, env->vmx_exit_gpa);
+        vmcs_set(env, VMCS_GUEST_LINEAR_ADDR, env->vmx_exit_gla);
+    } else if ((reason & 0xffff) == VMX_EXIT_IO) {
+        vmcs_set(env, VMCS_GUEST_LINEAR_ADDR, env->vmx_exit_gla);
+    }
+    env->vmx_idt_info = 0;
+    env->vmx_exit_intr_info = 0;
+
+    if (!failed) {
+        /* every exit clears the valid bit of the entry's injected event */
+        vmcs_set(env, VMCS_ENTRY_INTR_INFO,
+                 vmcs_get(env, VMCS_ENTRY_INTR_INFO) & ~VMX_INTR_VALID);
+        vmx_save_guest(env);
+        /* IA32_TSC is stored as the VMM reads it, without the guest's offset */
+        env->tsc_offset = 0;
+        n = vmcs_get(env, VMCS_EXIT_MSR_STORE_COUNT);
+        for (i = 0; i < n; i++) {
+            if (!vmx_msr_list_store(env,
+                    vmcs_get(env, VMCS_EXIT_MSR_STORE_ADDR) + 16ull * i)) {
+                vmx_abort(env, 1);
+            }
+        }
+    }
+
+    env->vmx_nonroot = false;
+    env->vmx_entry_failed = false;
+    env->vmx_pdptes_valid = false;
+    env->vmx_activity = VMX_ACTIVITY_ACTIVE;
+    env->hflags &= ~(HF_GUEST_MASK | HF_INHIBIT_IRQ_MASK | HF_MOVSS_MASK);
+    env->hflags2 &= ~HF2_NPT_MASK;
+    env->tsc_offset = 0;
+    cs->interrupt_request &= ~CPU_INTERRUPT_VIRQ;
+
+    vmx_load_host(env);
+    tlb_flush(cs);
+
+    /* an NMI that caused the exit leaves NMIs blocked; nothing else does */
+    if ((reason & 0xffff) == VMX_EXIT_EXCEPTION_NMI &&
+        (vmcs_get(env, VMCS_EXIT_INTR_INFO) >> 8 & 7) == VMX_INTR_TYPE_NMI) {
+        env->hflags2 |= HF2_NMI_MASK;
+    } else if (!failed) {
+        env->hflags2 &= ~HF2_NMI_MASK;
+    }
+
+    n = vmcs_get(env, VMCS_EXIT_MSR_LOAD_COUNT);
+    for (i = 0; i < n; i++) {
+        if (!vmx_msr_list_load(env,
+                vmcs_get(env, VMCS_EXIT_MSR_LOAD_ADDR) + 16ull * i)) {
+            vmx_abort(env, 4);
+        }
+    }
+    qemu_log_mask(CPU_LOG_INT, "vmx: exit %#x to host rip " TARGET_FMT_lx
+                  "\n", reason, env->eip);
+}
+
+/*
+ * Exceptions.  An exception that the exception bitmap names exits
+ * instead of being delivered; #PF is further filtered by the error
+ * code (26.2.1.1's mask and match).
+ */
+bool vmx_exception_exits(CPUX86State *env, int vec, int error_code)
+{
+    if (!env->vmx_nonroot || vec > 31) {
+        return false;
+    }
+    if (vec == EXCP0E_PAGE) {
+        bool match = (error_code & env->vmx_pfec_mask) == env->vmx_pfec_match;
+
+        return ((env->vmx_exc_bitmap >> 14) & 1) == match;
+    }
+    return (env->vmx_exc_bitmap >> vec) & 1;
+}
+
+/* reads of the MSR and I/O bitmaps, which are in host-physical memory */
+static bool vmx_bitmap_bit(CPUX86State *env, hwaddr base, uint32_t bit)
+{
+    return (x86_ldub_phys(env_cpu(env), base + bit / 8) >> (bit % 8)) & 1;
+}
+
+static bool vmx_msr_exits(CPUX86State *env, uint32_t msr, bool write)
+{
+    hwaddr b;
+
+    if (!(env->vmx_proc & VMX_CPU_BASED_USE_MSR_BITMAPS)) {
+        return true;
+    }
+    b = vmcs_get(env, VMCS_MSR_BITMAP) + (write ? 2048 : 0);
+    if (msr <= 0x1fff) {
+        return vmx_bitmap_bit(env, b, msr);
+    }
+    if (msr >= 0xc0000000 && msr <= 0xc0001fff) {
+        return vmx_bitmap_bit(env, b + 1024, msr - 0xc0000000);
+    }
+    return true;
+}
+
+/*
+ * The SVM intercept points, in VMX non-root operation.  param is
+ * what each passes: the error code for an exception, 0 or 1 (write)
+ * for an MSR, the vector of a software interrupt.
+ */
+void vmx_check_intercept(CPUX86State *env, uint32_t type, uint64_t param,
+                         uintptr_t ra)
+{
+    CPUState *cs = env_cpu(env);
+    uint32_t proc = env->vmx_proc;
+
+    switch (type) {
+    case SVM_EXIT_EXCP_BASE ... SVM_EXIT_EXCP_BASE + 31: {
+        int vec = type - SVM_EXIT_EXCP_BASE;
+        bool has_err = (env->cr[0] & CR0_PE_MASK) &&
+                       exception_has_error_code(vec);
+        uint64_t qual = 0;
+
+        if (!vmx_exception_exits(env, vec, param)) {
+            return;
+        }
+        /* #PF's address and #DB's DR6 bits, set where they were raised */
+        if (vec == EXCP0E_PAGE || vec == EXCP01_DB) {
+            qual = env->vmx_exit_qual;
+        }
+        vmx_exit_event(env, vec, VMX_INTR_TYPE_HW_EXCEPTION, has_err,
+                       has_err ? param : 0, qual, ra);
+    }
+    case SVM_EXIT_ICEBP:
+        /* INT1: a privileged software exception, by the #DB bit */
+        if (vmx_exception_exits(env, EXCP01_DB, 0)) {
+            vmx_exit_event(env, EXCP01_DB, VMX_INTR_TYPE_PRIV_SW_EXCEPTION,
+                           false, 0, 0, ra);
+        }
+        return;
+    case SVM_EXIT_SWINT:
+        /* INT3 and INTO are software exceptions; INT n never exits */
+        if ((param == EXCP03_INT3 || param == EXCP04_INTO) &&
+            vmx_exception_exits(env, param, 0)) {
+            vmx_exit_event(env, param, VMX_INTR_TYPE_SW_EXCEPTION, false, 0,
+                           0, ra);
+        }
+        return;
+    case SVM_EXIT_INTR:
+        if (env->vmx_pin & VMX_PIN_BASED_EXT_INTR_MASK) {
+            uint32_t info = 0;
+
+            if (env->vmx_exitctl & VMX_VM_EXIT_ACK_INTR_ON_EXIT) {
+                int intno;
+
+                cs->interrupt_request &= ~CPU_INTERRUPT_HARD;
+                intno = cpu_get_pic_interrupt(env);
+                info = VMX_INTR_VALID | (VMX_INTR_TYPE_EXTERNAL << 8) |
+                       (intno & 0xff);
+            }
+            env->vmx_exit_intr_info = info;
+            env->vmx_exit_intr_err = 0;
+            vmx_exit(env, VMX_EXIT_EXTERNAL_INTERRUPT, 0, false, ra);
+        }
+        return;
+    case SVM_EXIT_NMI:
+        if (env->vmx_pin & VMX_PIN_BASED_NMI_EXITING) {
+            cs->interrupt_request &= ~CPU_INTERRUPT_NMI;
+            vmx_exit_event(env, EXCP02_NMI, VMX_INTR_TYPE_NMI, false, 0, 0, ra);
+        }
+        return;
+    case SVM_EXIT_VINTR:
+        vmx_vmexit(env, VMX_EXIT_INTERRUPT_WINDOW, 0, ra);
+    case SVM_EXIT_INIT:
+        cs->interrupt_request &= ~CPU_INTERRUPT_INIT;
+        vmx_vmexit(env, VMX_EXIT_INIT, 0, ra);
+    case SVM_EXIT_SHUTDOWN:
+        vmx_vmexit(env, VMX_EXIT_TRIPLE_FAULT, 0, ra);
+    case SVM_EXIT_CPUID:
+        vmx_exit_insn(env, VMX_EXIT_CPUID, 0, ra);
+    case SVM_EXIT_INVD:
+        vmx_exit_insn(env, VMX_EXIT_INVD, 0, ra);
+    case SVM_EXIT_XSETBV:
+        vmx_exit_insn(env, VMX_EXIT_XSETBV, 0, ra);
+    case SVM_EXIT_HLT:
+        if (proc & VMX_CPU_BASED_HLT_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_HLT, 0, ra);
+        }
+        env->vmx_activity = VMX_ACTIVITY_HLT;
+        return;
+    case SVM_EXIT_INVLPG:
+        if (proc & VMX_CPU_BASED_INVLPG_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_INVLPG, param, ra);
+        }
+        return;
+    case SVM_EXIT_RDPMC:
+        if (proc & VMX_CPU_BASED_RDPMC_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_RDPMC, 0, ra);
+        }
+        return;
+    case SVM_EXIT_RDTSC:
+        if (proc & VMX_CPU_BASED_RDTSC_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_RDTSC, 0, ra);
+        }
+        return;
+    case SVM_EXIT_RDTSCP:
+        if (!(env->vmx_proc2 & VMX_SECONDARY_EXEC_RDTSCP)) {
+            raise_exception_ra(env, EXCP06_ILLOP, ra);
+        }
+        if (proc & VMX_CPU_BASED_RDTSC_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_RDTSCP, 0, ra);
+        }
+        return;
+    case SVM_EXIT_MWAIT:
+        if (proc & VMX_CPU_BASED_MWAIT_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_MWAIT, 0, ra);
+        }
+        return;
+    case SVM_EXIT_MONITOR:
+        if (proc & VMX_CPU_BASED_MONITOR_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_MONITOR, 0, ra);
+        }
+        return;
+    case SVM_EXIT_PAUSE:
+        if (proc & VMX_CPU_BASED_PAUSE_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_PAUSE, 0, ra);
+        }
+        return;
+    case SVM_EXIT_WBINVD:
+        if (env->vmx_proc2 & VMX_SECONDARY_EXEC_WBINVD_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_WBINVD, 0, ra);
+        }
+        return;
+    case SVM_EXIT_MSR:
+        if (vmx_msr_exits(env, env->regs[R_ECX], param)) {
+            vmx_exit_insn(env, param ? VMX_EXIT_WRMSR : VMX_EXIT_RDMSR, 0, ra);
+        }
+        return;
+    case SVM_EXIT_READ_DR0 ... SVM_EXIT_READ_DR0 + 7:
+    case SVM_EXIT_WRITE_DR0 ... SVM_EXIT_WRITE_DR0 + 7:
+        if (proc & VMX_CPU_BASED_MOV_DR_EXITING) {
+            bool rd = type < SVM_EXIT_WRITE_DR0;
+            int dr = rd ? type - SVM_EXIT_READ_DR0 : type - SVM_EXIT_WRITE_DR0;
+            int gpr = env->vmx_insn_regs & 15;
+
+            vmx_exit_insn(env, VMX_EXIT_DR_ACCESS,
+                          dr | (rd ? 1 << 4 : 0) | (gpr << 8), ra);
+        }
+        return;
+    default:
+        /*
+         * The rest are SVM's own (VMRUN and its kin, which #UD on an
+         * Intel processor before they get here), the control
+         * registers (vmx_cr_*), and the descriptor-table and task
+         * intercepts, whose VMX controls are not advertised.
+         */
+        return;
+    }
+}
+
+/*
+ * IN, OUT, INS and OUTS.  param is SVM's EXITINFO1 encoding; the exit
+ * qualification is rebuilt from it.  imm is set when the port came
+ * from the instruction rather than DX; seg is OUTS's source segment.
+ */
+void vmx_check_io(CPUX86State *env, uint32_t port, uint32_t param,
+                  bool imm, int seg, uintptr_t ra)
+{
+    uint32_t proc = env->vmx_proc;
+    int size = (param >> SVM_IOIO_SIZE_SHIFT) & 7;
+    bool exits;
+    uint64_t qual;
+    int i;
+
+    size = size == 4 ? 4 : size == 2 ? 2 : 1;
+    if (proc & VMX_CPU_BASED_USE_IO_BITMAPS) {
+        exits = false;
+        for (i = 0; i < size; i++) {
+            uint32_t p = port + i;
+
+            if (p > 0xffff) {
+                exits = true;
+                break;
+            }
+            if (vmx_bitmap_bit(env, vmcs_get(env, p < 0x8000 ?
+                                             VMCS_IO_BITMAP_A : VMCS_IO_BITMAP_B),
+                               p & 0x7fff)) {
+                exits = true;
+                break;
+            }
+        }
+    } else {
+        exits = proc & VMX_CPU_BASED_UNCOND_IO_EXITING;
+    }
+    if (!exits) {
+        return;
+    }
+    qual = (size - 1) | ((param & SVM_IOIO_TYPE_MASK) ? 1 << 3 : 0) |
+           ((param & SVM_IOIO_STR_MASK) ? 1 << 4 : 0) |
+           ((param & SVM_IOIO_REP_MASK) ? 1 << 5 : 0) |
+           (imm ? 1 << 6 : 0) | ((uint64_t)port << 16);
+    if (param & SVM_IOIO_STR_MASK) {
+        /* INS writes ES:rDI, OUTS reads seg:rSI */
+        int asz = (param >> SVM_IOIO_ASIZE_SHIFT) & 7;
+        uint64_t amask = asz == 4 ? ~0ull : asz == 2 ? 0xffffffffull : 0xffff;
+        if (param & SVM_IOIO_TYPE_MASK) {
+            seg = R_ES;
+        }
+        uint64_t off = (param & SVM_IOIO_TYPE_MASK) ? env->regs[R_EDI] :
+                       env->regs[R_ESI];
+
+        env->vmx_exit_gla = env->segs[seg].base + (off & amask);
+        if (!(env->hflags & HF_CS64_MASK)) {
+            env->vmx_exit_gla = (uint32_t)env->vmx_exit_gla;
+        }
+    }
+    vmx_exit_insn(env, VMX_EXIT_IO, qual, ra);
+}
+
+/*
+ * The control registers.  A guest's MOV to CR0 or CR4 exits when it
+ * would change a bit the host owns (the guest/host mask) from what the
+ * read shadow says; otherwise the owned bits keep their real values.
+ * Reads of an owned bit return the shadow.
+ */
+static uint64_t vmx_cr_qual(int cr, int access, int gpr)
+{
+    return cr | (access << 4) | (gpr << 8);
+}
+
+target_ulong vmx_read_cr(CPUX86State *env, int cr, uintptr_t ra)
+{
+    int gpr = env->vmx_insn_regs & 15;
+
+    switch (cr) {
+    case 0:
+        return (env->cr[0] & ~env->vmx_cr0_mask) |
+               (env->vmx_cr0_shadow & env->vmx_cr0_mask);
+    case 3:
+        if (env->vmx_proc & VMX_CPU_BASED_CR3_STORE_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(3, 1, gpr), ra);
+        }
+        return env->cr[3];
+    case 4:
+        return (env->cr[4] & ~env->vmx_cr4_mask) |
+               (env->vmx_cr4_shadow & env->vmx_cr4_mask);
+    case 8:
+        if (env->vmx_proc & VMX_CPU_BASED_CR8_STORE_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(8, 1, gpr), ra);
+        }
+        return cpu_get_apic_tpr(env_archcpu(env)->apic_state);
+    }
+    return env->cr[cr];
+}
+
+/*
+ * A MOV to a control register: exits, or returns the value to write,
+ * with the host-owned bits of CR0 and CR4 kept.
+ */
+target_ulong vmx_write_cr(CPUX86State *env, int cr, target_ulong val,
+                          uintptr_t ra)
+{
+    int gpr = env->vmx_insn_regs & 15;
+    int i, n;
+
+    switch (cr) {
+    case 0: {
+        uint64_t fixed0 = vmx_cr0_fixed0();
+
+        if ((val ^ env->vmx_cr0_shadow) & env->vmx_cr0_mask) {
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(0, 0, gpr), ra);
+        }
+        val = (val & ~env->vmx_cr0_mask) | (env->cr[0] & env->vmx_cr0_mask);
+        if (env->vmx_proc2 & VMX_SECONDARY_EXEC_UNRESTRICTED_GUEST) {
+            fixed0 &= ~(CR0_PE_MASK | CR0_PG_MASK);
+        }
+        /* a bit VMX fixes, not owned by the host, may not be changed */
+        if ((val & fixed0) != fixed0) {
+            raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+        }
+        return val;
+    }
+    case 3:
+        if (env->vmx_proc & VMX_CPU_BASED_CR3_LOAD_EXITING) {
+            n = vmcs_get(env, VMCS_CR3_TARGET_COUNT);
+            for (i = 0; i < n; i++) {
+                if (vmcs_get(env, VMCS_CR3_TARGET0 + 2 * i) == val) {
+                    return val;
+                }
+            }
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(3, 0, gpr), ra);
+        }
+        return val;
+    case 4:
+        if ((val ^ env->vmx_cr4_shadow) & env->vmx_cr4_mask) {
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(4, 0, gpr), ra);
+        }
+        val = (val & ~env->vmx_cr4_mask) | (env->cr[4] & env->vmx_cr4_mask);
+        if (!(val & CR4_VMXE_MASK)) {
+            raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+        }
+        return val;
+    case 8:
+        if (env->vmx_proc & VMX_CPU_BASED_CR8_LOAD_EXITING) {
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(8, 0, gpr), ra);
+        }
+        return val;
+    }
+    return val;
+}
+
+/* CLTS: returns whether CR0.TS is the guest's to clear */
+bool vmx_clts(CPUX86State *env, uintptr_t ra)
+{
+    if (env->vmx_cr0_mask & CR0_TS_MASK) {
+        if (env->vmx_cr0_shadow & CR0_TS_MASK) {
+            vmx_exit_insn(env, VMX_EXIT_CR_ACCESS, vmx_cr_qual(0, 2, 0), ra);
+        }
+        return false;
+    }
+    return true;
+}
+
+/* LMSW: exits, or returns the new CR0 */
+target_ulong vmx_lmsw(CPUX86State *env, uint32_t src, bool mem, uintptr_t ra)
+{
+    uint64_t mask = env->vmx_cr0_mask & 0xf;
+    uint64_t shadow = env->vmx_cr0_shadow;
+    uint64_t cr0 = env->cr[0];
+
+    /* LMSW never clears PE */
+    if (((src ^ shadow) & mask & 0xe) ||
+        ((mask & CR0_PE_MASK) && (src & CR0_PE_MASK) &&
+         !(shadow & CR0_PE_MASK))) {
+        vmx_exit_insn(env, VMX_EXIT_CR_ACCESS,
+                      vmx_cr_qual(0, 3, 0) | (mem ? 1 << 6 : 0) |
+                      ((uint64_t)(src & 0xffff) << 16), ra);
+    }
+    src &= 0xf & ~mask;
+    return (cr0 & ~(0xeull & ~mask)) | src | (cr0 & CR0_PE_MASK);
+}
+
+/*
+ * An INIT: in VMX non-root operation it exits; in root operation it
+ * is blocked, and is delivered when VMXOFF leaves VMX operation.
+ * Returns true when the caller is to treat it as an INIT.
+ */
+bool vmx_init_signal(CPUX86State *env)
+{
+    CPUState *cs = env_cpu(env);
+
+    if (env->vmx_nonroot) {
+        vmx_check_intercept(env, SVM_EXIT_INIT, 0, 0);
+    }
+    if (env->vmx_on) {
+        cs->interrupt_request &= ~CPU_INTERRUPT_INIT;
+        env->vmx_init_latched = true;
+        return false;
+    }
+    return true;
+}
+
+/*
+ * After a MOV to CR0, CR3 or CR4 in a guest using EPT: PAE paging
+ * outside IA-32e mode loads the PDPTE registers, from guest-physical
+ * memory through EPT; a reserved bit in one is #GP.
+ */
+void vmx_load_pdptes(CPUX86State *env, uintptr_t ra)
+{
+    uint64_t pdpte[4];
+    int i;
+
+    env->vmx_pdptes_valid = false;
+    if (!env->vmx_nonroot || !(env->vmx_proc2 & VMX_SECONDARY_EXEC_ENABLE_EPT) ||
+        !(env->cr[0] & CR0_PG_MASK) || !(env->cr[4] & CR4_PAE_MASK) ||
+        (env->efer & MSR_EFER_LMA)) {
+        return;
+    }
+    for (i = 0; i < 4; i++) {
+        pdpte[i] = cpu_ldq_mmuidx_ra(env, (env->cr[3] & ~0x1full) + 8 * i,
+                                     MMU_NESTED_IDX, ra);
+    }
+    if (!vmx_pdptes_ok(env, pdpte)) {
+        raise_exception_err_ra(env, EXCP0D_GPF, 0, ra);
+    }
+    memcpy(env->vmx_pdpte, pdpte, sizeof pdpte);
+    env->vmx_pdptes_valid = true;
+}
+
+/* MOV to CR0/CR4 in VMX root operation may not leave VMX's fixed bits */
+bool vmx_root_cr_ok(CPUX86State *env, int cr, target_ulong val)
+{
+    if (!env->vmx_on || env->vmx_nonroot) {
+        return true;
+    }
+    if (cr == 0) {
+        return (val & vmx_cr0_fixed0()) == vmx_cr0_fixed0();
+    }
+    if (cr == 4) {
+        return (val & CR4_VMXE_MASK) != 0;
+    }
+    return true;
+}
