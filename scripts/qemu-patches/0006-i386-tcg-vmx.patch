+                 (gpa & (page_size - 1));
+    out->prot = ((allowed & VMX_EPT_R) ? PAGE_READ : 0) |
+                ((allowed & VMX_EPT_W) ? PAGE_WRITE : 0) |
+                ((allowed & VMX_EPT_X) ? PAGE_EXEC : 0);
+    out->page_size = page_size;
+    return true;
+
+violation:
+    *err = (TranslateFault){
+        .error_code = access | ((pte & 7 ? allowed : 0) << VMX_EPTQ_RWX_SHIFT),
+        .cr2 = gpa,
+        .stage2 = S2_GPA,
+        .linear = gpa,
+    };
+    return false;
+misconfig:
+    *err = (TranslateFault){
+        .error_code = VMX_EPTQ_MISCONFIG,
+        .cr2 = gpa,
+        .stage2 = S2_GPA,
+        .linear = gpa,
+    };
+    return false;
