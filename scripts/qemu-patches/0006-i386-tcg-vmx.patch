+/*
+ * EPT (SDM 29.3).  Four levels from the EPTP, 1 GiB and 2 MiB leaves
+ * where bit 7 says so.  A walk that meets an entry with no access is
+ * a violation; one that meets a write-only or write-execute entry, a
+ * reserved bit or a bad memory type is a misconfiguration.  On
+ * failure err->error_code is the violation's exit qualification, its
+ * access in bits 2:0 and what the entries allowed in bits 5:3, or
+ * VMX_EPTQ_MISCONFIG.
+ */
+static bool ept_translate(CPUX86State *env, hwaddr gpa,
+                          MMUAccessType access_type, TranslateResult *out,
+                          TranslateFault *err)
+{
+    CPUState *cs = env_cpu(env);
+    int phys = env_archcpu(env)->phys_bits;
+    uint64_t rsvd_addr = ~MAKE_64BIT_MASK(0, phys) & VMX_EPT_ADDR;
+    uint64_t table = env->vmx_eptp & VMX_EPT_ADDR;
+    uint64_t pte = 0, allowed = 7;
+    uint64_t access;
+    int level, page_size = 4096;
+
+    access = access_type == MMU_DATA_STORE ? VMX_EPTQ_WRITE :
+             access_type == MMU_INST_FETCH ? VMX_EPTQ_FETCH : VMX_EPTQ_READ;
+
+    for (level = 4; level >= 1; level--) {
+        int shift = 12 + 9 * (level - 1);
+        bool leaf;
+
+        pte = x86_ldq_phys(cs, table + ((gpa >> shift) & 0x1ff) * 8);
+        if (!(pte & 7)) {
+            goto violation;
+        }
+        /* write without read; execute-only is advertised */
+        if ((pte & 3) == VMX_EPT_W) {
+            goto misconfig;
+        }
+        if (pte & rsvd_addr) {
+            goto misconfig;
+        }
+        allowed &= pte & 7;
+        leaf = level == 1 || ((level == 2 || level == 3) &&
+                              (pte & VMX_EPT_LARGE));
+        if (level == 4 && (pte & (0x1full << 3))) {
+            goto misconfig;
+        }
+        if (leaf) {
+            int mt = (pte >> 3) & 7;
+
+            if (mt == 2 || mt == 3 || mt == 7) {
+                goto misconfig;
+            }
+            if (level > 1) {
+                page_size = 1 << shift;
+                /* the address bits a large page leaves out are reserved */
+                if (pte & MAKE_64BIT_MASK(12, shift - 12)) {
+                    goto misconfig;
+                }
+            }
+            break;
+        }
+        /* non-leaf entries: bits 7:3 are reserved */
+        if (pte & (0x1full << 3)) {
+            goto misconfig;
+        }
+        table = pte & VMX_EPT_ADDR;
+    }
+
+    if (!(allowed & access)) {
+        goto violation;
+    }
